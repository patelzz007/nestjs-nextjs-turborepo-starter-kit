.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.source/

.pnpm-store
# Astro generated types (apps/docs)
.astro

# Playwright browser-suite output (apps/*/e2e/*.browser.ts)
test-results/
playwright-report/

# Server logs written by the CI browser e2e job / pnpm ci:local
.ci-logs/
