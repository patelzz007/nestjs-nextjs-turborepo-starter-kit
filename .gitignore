# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

.git_2 
# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage
# Vitest's local run cache / reporter output (e.g. .vitest/json/output.json)
.vitest/

# next.js
.next/
out/

# production
build
dist

# turbo
.turbo

# Everything tools write: ci (ci:local and CI server logs), dev-timing, logs (the API's plain-text
# transaction log, TRANSACTION_LOG_DIR), playwright/<app> (browser-suite output)
/.artifacts/
# The transaction log's folder before `.artifacts/`: an existing .env or server may still write here, and it
# must never be committed.
/logs/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# Every env file and copy (.env, .env.local, .env_bak, .env.bak, …) — only the documented examples are committed.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.source/

.pnpm-store
# Astro generated types (apps/docs)
.astro

# Playwright sessions saved by a sign-in setup project (apps/admin/e2e/sign-in.setup.ts)
**/e2e/.auth/
playwright-report/

# Where the transaction log was written before 2026-10-26 (relative to apps/api)
apps/api/logs/
# The seed's pinned geo dataset, downloaded once (prisma/seed/geo-dataset.ts); CI caches it.
apps/api/.cache/
