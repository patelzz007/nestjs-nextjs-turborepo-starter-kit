<style>
body{background:#14161b;color:#eef1f6;font-family:Geist,sans-serif}
.hd{display:flex;align-items:center;justify-content:space-between;padding:52px 20px 0}
.ib{width:40px;height:40px;border-radius:12px;background:#1f232b;display:flex;align-items:center;justify-content:center}
.ib svg{width:20px;height:20px;stroke:#eef1f6;fill:none;stroke-width:2;stroke-linecap:round}
.pill{font:600 11px Geist;letter-spacing:.06em;text-transform:uppercase;color:#7ed69a;background:#1c2a22;padding:5px 9px;border-radius:999px}
h1{font:700 40px/1 "Barlow Condensed";letter-spacing:.005em;margin:18px 20px 2px;text-transform:uppercase}
.sub{margin:0 20px;color:#9aa2b1;font-size:14px}
.acct{margin:20px 20px 0;display:flex;gap:14px;align-items:center;padding:14px;border-radius:18px;background:#1f232b}
.av{width:48px;height:48px;border-radius:14px;background:#f2b33d;color:#2a1c00;font:700 20px "Barlow Condensed";display:flex;align-items:center;justify-content:center}
.nm{font:600 17px Geist}.em{font-size:13px;color:#9aa2b1}
.tag{margin-left:auto;text-align:right}.tag b{display:block;font:700 26px/1 "Barlow Condensed";color:#f2b33d}.tag i{font:600 10px Geist;letter-spacing:.08em;color:#9aa2b1;font-style:normal}
.sec{display:flex;align-items:baseline;gap:10px;margin:28px 20px 12px}
.no{font:700 13px "Barlow Condensed";color:#14161b;background:#f2b33d;border-radius:5px;padding:2px 6px}
.st{font:700 22px "Barlow Condensed";text-transform:uppercase;letter-spacing:.02em}
.rail{display:flex;gap:12px;padding:0 20px;overflow:hidden}
.stall{flex:0 0 250px;border-radius:20px;overflow:hidden;background:#1f232b}
.canopy{height:14px;background:repeating-linear-gradient(90deg,#d8432f 0 26px,#eef1f6 26px 52px)}
.sb{padding:16px}.k{font:600 11px Geist;letter-spacing:.08em;text-transform:uppercase;color:#9aa2b1}
.big{font:700 44px/1 "Barlow Condensed";color:#f2b33d;margin:6px 0 2px}
.t{font:600 16px Geist;margin-top:8px}.b{font-size:13px;color:#9aa2b1;margin-top:4px;line-height:1.4}
.btn{margin-top:14px;display:inline-block;background:#f2b33d;color:#221700;font:600 14px Geist;padding:10px 16px;border-radius:12px}
.stall.blue .canopy{background:repeating-linear-gradient(90deg,#2f6bd8 0 26px,#eef1f6 26px 52px)}
</style>
<div class="hd"><div class="ib"><svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h10"/></svg></div><div style="display:flex;gap:8px;align-items:center"><span class="pill">Online</span><div class="ib"><svg viewBox="0 0 24 24"><path d="M6 9a6 6 0 0 1 12 0c0 6 3 7 3 7H3s3-1 3-7M10 20a2 2 0 0 0 4 0"/></svg></div></div></div>
<h1>Home</h1><div class="sub">Your account at a glance</div>
<div class="acct"><div class="av">AD</div><div><div class="nm">Admin User</div><div class="em">admin@example.com</div></div><div class="tag"><b>7</b><i>BACKUP CODES</i></div></div>
<div class="sec"><span class="no">01</span><span class="st">Discover</span><span style="color:#9aa2b1;font-size:13px">A few things to try first.</span></div>
<div class="rail"><div class="stall"><div class="canopy"></div><div class="sb"><div class="k">Last 7 days</div><div class="big">RM 248</div><div class="t">See your activity</div><div class="b">Spending, visits and rewards over the last week, month or quarter.</div><span class="btn">Open analytics</span></div></div>
<div class="stall blue"><div class="canopy"></div><div class="sb"><div class="k">Security</div><div class="big">OFF</div><div class="t">Lock the app</div></div></div></div>
