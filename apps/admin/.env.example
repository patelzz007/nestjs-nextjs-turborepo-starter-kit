[TEMPLATE]
# ============================================
# apps/admin/.env.example
# Copy to .env and fill in real values.
# NEVER commit the real .env (it is git-ignored).
#
# Validated by lib/env/env.client.ts (NEXT_PUBLIC_*) and lib/env/env.server.ts
# (server-only). A missing/invalid REQUIRED value fails `next build` /
# server start with an error naming the variable. See docs/configuration.md.
# ============================================

# ── Public (NEXT_PUBLIC_*) — inlined into the browser bundle at BUILD time ──
# Every value here is public. Changing one requires a rebuild.

# REQUIRED. Base URL of the NestJS API (absolute http/https URL).
NEXT_PUBLIC_API_URL=http://localhost:8080

# REQUIRED. This app's own public origin. Sent as `Origin` when the proxy /
# SSR refreshes the session, so it must be listed in the API's CORS_ORIGINS.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# REQUIRED. Consumer web app origin ("Returning to main website" link and the
# impersonation banner's consumer-portal link).
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# REQUIRED. Merchant portal origin (impersonation banner link).
NEXT_PUBLIC_MERCHANT_URL=http://localhost:3003

# OPTIONAL (default false). One-click demo account on the login page.
# Exactly `true` or `false`. Leave unset/`false` in production.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true

# OPTIONAL. Session-status badge steady-poll interval, in milliseconds.
# The badge (admin topbar) fetches GET /session ONCE on mount and computes the
# countdown LOCALLY from the JWT exp claim (served as `expiresAt`) — so it
# works with zero polling by default.
#   - unset / empty / 0 -> steady polling DISABLED (default). The badge fetches
#     on mount + tab-return; rotation detection waits for a navigation fetch.
#   - positive integer  -> OPT-IN steady poll every N ms (e.g. 60000) for
#     proactive rotation/session-death detection while idling.
#   - anything else     -> startup fails (it is never silently ignored).
# NOTE: this is the OBSERVATION cadence, NOT the token lifetime. Do not tie it
# to JWT_ACCESS_EXPIRY.
# NEXT_PUBLIC_SESSION_POLL_MS=60000

# ── Server-only — read at RUNTIME by the Node server, never bundled ──
# NODE_ENV is set by Next.js itself; do not set it here.

# OPTIONAL. Domain attribute used when the proxy CLEARS auth cookies. Must
# match the API's COOKIE_DOMAIN (`localhost` locally, `.example.com` in prod).
# COOKIE_DOMAIN=localhost

# ── Test harness only (not read by the app) ──
# OPTIONAL. Enables the opt-in e2e smoke suite (see e2e/README.md).
# ADMIN_E2E_BASE_URL=http://localhost:3001
