[TEMPLATE]
# ============================================
# apps/admin/.env.example
# Copy to .env and fill in real values.
# NEVER commit the real .env (it is git-ignored).
# ============================================

# Base URL of the API (NestJS). Used by the AuthProvider for
# login/logout/me requests. Vars prefixed NEXT_PUBLIC_ are exposed
# to the browser bundle.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Base URL of the web app (Next.js :3000). Used on the login page for
# the "Returning to main website" link.
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# One-click demo account on the login page (local/dev convenience).
# Set to `true` locally; leave unset/`false` in production so the
# demo credentials never render.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true

# Session-status badge steady-poll interval, in milliseconds.
# The badge (admin topbar) fetches GET /session ONCE on mount and computes the
# countdown LOCALLY from the JWT exp claim (served as `expiresAt`) — so it
# works with zero polling by default.
#   - unset / empty / 0 -> steady polling DISABLED (default). The badge fetches
#     on mount + tab-return; rotation detection waits for a navigation fetch.
#   - positive int      -> OPT-IN steady poll every N ms (e.g. 60000) for
#     proactive rotation/session-death detection while idling.
# NOTE: this is the OBSERVATION cadence, NOT the token lifetime. Do not tie it
# to JWT_ACCESS_EXPIRY.
# NEXT_PUBLIC_SESSION_POLL_MS=60000
