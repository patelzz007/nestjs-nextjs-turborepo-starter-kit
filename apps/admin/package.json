{
	"name": "@workspace/admin",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "next dev -p 3001",
		"build": "next build",
		"start": "next start",
		"lint": "oxfmt --check \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\" && oxlint",
		"format": "oxfmt \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\"",
		"typecheck": "next typegen && tsrs --noEmit",
		"test": "vitest run --coverage",
		"test:browser": "playwright test --project=browser",
		"showcase:generate": "node scripts/showcase-features.ts && node scripts/showcase-content.ts && node scripts/showcase-api.ts && oxfmt components/component-showcase/generated"
	},
