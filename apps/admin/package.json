		"@tanstack/react-table": "^9.3.1",
		"@workspace/client": "workspace:*",
		"@workspace/shared": "workspace:*",
		"@workspace/tokens": "workspace:*",
		"@workspace/ui": "workspace:*",
		"date-fns": "^4.4.0",
		"framer-motion": "^14.12.0",
		"lucide-react": "^1.72.0",
		"mdast-util-to-string": "4.0.0",
		"next": "16.4.6",
		"next-themes": "^0.4.6",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-markdown": "10.1.0",
		"recharts": "3.10.1",
		"remark-gfm": "^4.0.1",
