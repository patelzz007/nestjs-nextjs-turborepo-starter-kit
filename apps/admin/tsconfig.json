{
	"extends": "@workspace/typescript-config/nextjs.json",
	"compilerOptions": {
		"paths": {
			"@/*": ["./*"]
		},
		"plugins": [
			{
				"name": "next"
			}
		],
		"customConditions": ["development"],
		// scripts/ run on Node directly (type stripping), so they import each other with `.ts`.
		"allowImportingTsExtensions": true
	},
	"include": ["next-env.d.ts", "next.config.ts", "**/*.ts", "**/*.tsx", "**/*.mts", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
	"exclude": ["node_modules"]
}
