# ============================================
# apps/analytics-consumer/.env.example
# Copy to .env and fill in real values. NEVER commit the real .env (git-ignored).
#
# The consumer reads ONLY the variables below (validated by src/env.ts; an
# invalid value stops it with an error naming the variable, never its value).
# It does not read apps/api/.env and never sees the API's secrets.
# `pnpm dev`, `db:provision-login`, `kafka:provision-topics` and `test:e2e`
# load this file with dotenv-cli; `pnpm start` (production) reads the real env.
# Full guide: docs/technical/messaging.md#analytics-consumer
# ============================================

# ── Postgres ───────────────────────────────────────────────────────────────

# REQUIRED. The consumer's OWN login — a member of the least-privilege
# `analytics_consumer` role (apps/api/prisma/rls/90-analytics-consumer.sql):
# INSERT/SELECT/DELETE on its three tables only. NEVER the superuser / migrating
# user. Create it with `pnpm --filter @workspace/analytics-consumer db:provision-login`
# (password ≥ 16 chars, user a lower-case identifier).
ANALYTICS_CONSUMER_DATABASE_URL=postgresql://analytics_consumer_app:change-me-run-pnpm-secrets-generate@localhost:5432/nestjs-nextjs-turborepo-starter-kit

# db:provision-login and test:e2e ONLY (the worker never reads it): a role
# allowed to CREATE ROLE — locally the API's DATABASE_URL user.
ANALYTICS_CONSUMER_DB_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/nestjs-nextjs-turborepo-starter-kit

# OPTIONAL. Pool size and bounded waits (defaults shown).
# ANALYTICS_DB_POOL_MAX=5
# ANALYTICS_DB_CONNECTION_TIMEOUT_MS=10000
# ANALYTICS_DB_IDLE_TIMEOUT_MS=30000
# Server-side statement_timeout for every query.
# ANALYTICS_DB_STATEMENT_TIMEOUT_MS=30000

# ── Kafka ──────────────────────────────────────────────────────────────────

# REQUIRED. Bootstrap servers, comma-separated host:port. Local broker:
# 127.0.0.1 (what compose.yml publishes and advertises; `localhost` may
# resolve to ::1 first, which nothing listens on).
KAFKA_BROKERS=127.0.0.1:9092

# OPTIONAL. Client id (default analytics-consumer); admin request budget.
# KAFKA_CLIENT_ID=analytics-consumer
# KAFKA_ADMIN_TIMEOUT_MS=30000

# OPTIONAL. Transport security (the local compose broker is plaintext).
# KAFKA_SSL=true enables TLS (certificates are always verified);
# KAFKA_SSL_CA_LOCATION = PEM file of the CA (unset = system trust store).
# SASL: plain (requires KAFKA_SSL=true) | scram-sha-256 | scram-sha-512.
# KAFKA_SSL=false
# KAFKA_SSL_CA_LOCATION=/etc/kafka/ca.pem
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=analytics-consumer
# KAFKA_SASL_PASSWORD=change-me-run-pnpm-secrets-generate

# OPTIONAL. Retention (days) of the platform.* topics — the provisioning step
# creates them with it, and it is the Kafka redelivery horizon the inbox
# window must exceed. Default 7. Keep it equal to the topics' real retention.ms.
# KAFKA_TOPIC_RETENTION_DAYS=7

# kafka:provision-topics ONLY — REQUIRED there, no default on purpose (the
# broker default of 1 partition / replication 1 is what auto-created topics got).
# Local single-broker compose: replication 1. Production: 3 (or your cluster's min).
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1

# OPTIONAL. Where a consumer group with NO committed offset starts:
# earliest (default — the whole retained backlog) | latest (new records only).
# A group with a committed offset always resumes from it.
# ANALYTICS_CONSUMER_START_FROM=earliest

# ── Processing ─────────────────────────────────────────────────────────────

# OPTIONAL. Bounded retry for failures that are not the record's fault
# (connection loss, timeout, deadlock, …): attempts incl. the first, then the
# record is parked as RETRIES_EXHAUSTED. Backoff base × 2^n capped, ±20% jitter.
# ANALYTICS_MAX_PROCESSING_ATTEMPTS=5
# ANALYTICS_RETRY_BASE_DELAY_MS=500
# ANALYTICS_RETRY_MAX_DELAY_MS=10000

# OPTIONAL. Graceful-shutdown budget.
# SHUTDOWN_TIMEOUT_MS=15000

# ── Retention ──────────────────────────────────────────────────────────────

# OPTIONAL. Days an inbox claim is kept. Must be GREATER than
# KAFKA_TOPIC_RETENTION_DAYS. Default: KAFKA_TOPIC_RETENTION_DAYS × 2.
# ANALYTICS_INBOX_RETENTION_DAYS=14

# OPTIONAL. Days a parked message (inbox_dead_letters) is kept. Default 30.
# ANALYTICS_DEAD_LETTER_RETENTION_DAYS=30

# OPTIONAL. Stored copy of a parked value is capped at this many bytes
# (default 1048576 = Kafka's default max message size). A larger value is
# stored truncated with its original size, SHA-256 and a truncated flag.
# ANALYTICS_DEAD_LETTER_MAX_PAYLOAD_BYTES=1048576
