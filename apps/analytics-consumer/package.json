{
	"name": "@workspace/analytics-consumer",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "dotenv run -q -- tsx watch src/main.ts",
		"start": "tsx src/main.ts",
		"db:provision-login": "dotenv run -q -- tsx src/cli/provision-db-login.ts",
		"kafka:provision-topics": "dotenv run -q -- tsx src/cli/provision-kafka-topics.ts",
		"format": "prettier --write \"**/*.{ts,tsx}\" --ignore-path ../../.prettierignore",
		"lint": "eslint",
		"typecheck": "tsrs --noEmit",
		"test": "vitest run --config vitest.config.ts",
		"test:e2e": "dotenv run -q -- vitest run --config vitest.config.e2e.ts"
	},
	"dependencies": {
		"@confluentinc/kafka-javascript": "1.11.0",
		"@workspace/messaging": "workspace:*",
		"@workspace/shared": "workspace:*",
		"pg": "^8.23.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"@types/pg": "^8.23.1",
		"@workspace/eslint-config": "workspace:^",
		"@workspace/typescript-config": "workspace:*",
		"dotenv": "^18.0.9",
		"eslint": "^9.39.5",
		"tsrs": "0.18.0-ts7.1.0-dev.20260929",
		"tsx": "^4.23.15",
		"typescript": "6.0.3",
		"vitest": "^5.0.5"
	}
}
