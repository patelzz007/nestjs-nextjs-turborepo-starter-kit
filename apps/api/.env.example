```dotenv
# =============================================================================
# LinkHub API — Environment Variables
# =============================================================================
#
# Copy this file to:
#   apps/api/.env
#
# Then replace the placeholder values with your local / environment-specific
# configuration.
#
# IMPORTANT:
#   - Never commit the real .env file.
#   - Keep secrets out of source control.
#   - Generate strong, random secrets for production.
# =============================================================================


# =============================================================================
# APPLICATION
# =============================================================================

# Runtime environment
# Options: development | test | production
NODE_ENV=development

# Application name
APP_NAME=LinkHub

# Public URL of the API
APP_URL=http://localhost:8080

# API server port
PORT=8080


# =============================================================================
# CORS
# =============================================================================

# Comma-separated list of frontend origins allowed to access the API.
#
# Local development:
#   http://localhost:3000
#   http://localhost:3001
#
# Production example:
#   https://app.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001


# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL connection string
#
# Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hello_world


# =============================================================================
# AUTHENTICATION
# =============================================================================

# -----------------------------------------------------------------------------
# JWT — Access Token
# -----------------------------------------------------------------------------

# Secret used to sign access tokens.
# MUST be at least 32 characters.
JWT_ACCESS_SECRET=change-me-access-secret-32-chars-minimum

# Access token lifetime
JWT_ACCESS_EXPIRY=15m


# -----------------------------------------------------------------------------
# JWT — Refresh Token
# -----------------------------------------------------------------------------

# Secret used to sign refresh tokens.
# MUST be at least 32 characters.
#
# Keep this secret different from JWT_ACCESS_SECRET.
JWT_REFRESH_SECRET=change-me-refresh-secret-32-chars-minimum

# Refresh token lifetime
JWT_REFRESH_EXPIRY=7d


# -----------------------------------------------------------------------------
# Email Verification
# -----------------------------------------------------------------------------

# Secret used to sign email verification tokens.
# MUST be at least 32 characters.
EMAIL_VERIFICATION_SECRET=change-me-email-verify-secret-32-chars


# -----------------------------------------------------------------------------
# Password Hashing
# -----------------------------------------------------------------------------

# Number of bcrypt salt rounds.
# Higher values increase security but also increase hashing time.
BCRYPT_SALT_ROUNDS=12


# =============================================================================
# EMAIL
# =============================================================================

# Email provider: Resend
# https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# Sender
# -----------------------------------------------------------------------------

# Default address used for outbound emails.
EMAIL_FROM_ADDRESS=noreply@example.com


# -----------------------------------------------------------------------------
# Delivery Mode
# -----------------------------------------------------------------------------

# Controls how emails are handled.
#
# send     → Send emails through Resend
# log-only → Print emails to the console instead of sending
# noop     → Skip email delivery entirely
#
# Defaults to "send" if not specified.
# EMAIL_MODE=send


# -----------------------------------------------------------------------------
# Development / Testing
# -----------------------------------------------------------------------------

# Redirect ALL outbound emails to this address.
#
# Useful during development to prevent accidentally sending emails
# to real users.
#
# Example:
# EMAIL_TEST_TO=you@example.com
# EMAIL_TEST_TO=you@example.com


# -----------------------------------------------------------------------------
# Reply-To
# -----------------------------------------------------------------------------

# Optional address used as the Reply-To header for outbound emails.
#
# Example:
# EMAIL_REPLY_TO=hello@example.com
# EMAIL_REPLY_TO=hello@example.com


# -----------------------------------------------------------------------------
# Delivery Tuning
# -----------------------------------------------------------------------------

# Maximum number of delivery attempts.
# EMAIL_MAX_ATTEMPTS=3

# Timeout for each email provider request, in milliseconds.
# EMAIL_TIMEOUT_MS=10000

# Maximum number of emails that can be sent per minute.
#
# 0 = unlimited
# EMAIL_RATE_LIMIT_PER_MINUTE=0


# -----------------------------------------------------------------------------
# Webhooks
# -----------------------------------------------------------------------------

# Secret used to verify incoming Resend webhook requests.
#
# Required if the application receives delivery events such as:
#   - email.delivered
#   - email.bounced
#   - email.failed
#
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Per-IP webhook requests/minute (0 = disabled; defense-in-depth on top of signatures)
WEBHOOK_RATE_LIMIT_PER_MINUTE=120

# Public base URL where the API's open-tracking pixel is reachable.
# Must be reachable from the RECIPIENT's mail client (tunnel or public API URL).
# If unset, falls back to APP_URL.
```
