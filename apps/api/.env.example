# =============================================================================
# apps/api — Environment Variables
# =============================================================================
#
# Copy this file to apps/api/.env and fill in the blanks:
#
#   cp apps/api/.env.example apps/api/.env
#   pnpm secrets:generate apps/api/.env      # fills every app-owned secret
#
# How it is validated (docs/technical/configuration/api.md):
#   - ONE zod schema (apps/api/src/config/api-config.schema.ts) parses the whole
#     environment ONCE at startup, before Nest bootstraps.
#   - Any missing/invalid variable stops the API with a list of EVERY bad
#     variable by name. Values are never printed.
#   - Secrets have NO defaults in any environment. The API will not boot
#     without them.
#   - An empty value (FOO=) counts as unset.
#
# Legend:  [required]  must be set
#          [optional]  commented out = the documented default applies
#          [secret]    never commit a real value; leave empty in this file
#
# NEVER commit apps/api/.env.


# =============================================================================
# RUNTIME
# =============================================================================

# [required] development | test | production. Runtime NODE_ENV is authoritative
# (the production build does not force it). `pnpm dev` always runs the API
# with NODE_ENV=development (`rspack --watch --node-env development`; an
# exported shell NODE_ENV still wins) — this value applies to `pnpm start`,
# scripts and tests.
NODE_ENV=development

# [required] Application name (email templates, authenticator issuer).
APP_NAME=NestJS + NextJS Turborepo Starter Template


# =============================================================================
# HTTP SERVER
# =============================================================================

# [optional] Bind address and port (defaults: 127.0.0.1 / 8080).
# 127.0.0.1 avoids slow IPv6 localhost resolution; use 0.0.0.0 in containers, and in
# development when a phone runs the mobile app (it calls the API over the network).
# HOST=127.0.0.1
PORT=8080

# [optional] Public base URL of THIS API (local-storage download/upload links).
# Default: http://HOST:PORT. Set it when the API sits behind a proxy/tunnel.
# API_PUBLIC_URL=https://api.example.com

# [optional] The reverse proxies in front of the API whose X-Forwarded-For is
# trusted: comma-separated IPs, CIDRs and/or loopback / linklocal / uniquelocal
# (e.g. "loopback" for a local cloudflared/nginx, "10.0.0.0/8" for an LB subnet).
# Unset (default) = trust none: the client IP is the TCP peer and forwarding
# headers are ignored. "1"/"true" (trust every peer) is rejected — it would let
# any client spoof its IP. Used by rate limits, sessions and the audit log.
# TRUST_PROXY=loopback

# [optional] Graceful shutdown budget in ms (default 15000). Ctrl+C / SIGTERM
# closes HTTP, Postgres, Redis, BullMQ and Kafka before exiting.
# SHUTDOWN_TIMEOUT_MS=15000

# [optional] 0/1/true/false. Helmet + global rate limiting. Default: on in
# production, off elsewhere.
# SECURITY_HARDENING_ENABLED=1

# [optional] 0/1/true/false. Swagger UI at /v1/docs (+ /v1/docs-json).
#   Development/test: ON by default and public — set 0 to turn it off.
#   Production (NODE_ENV=production): OFF by default — set 1 to mount it, and
#   then every docs URL answers only a signed-in platform SuperAdmin (401/403
#   otherwise). Every endpoint still enforces its own auth either way.
# SWAGGER_ENABLED=0


# =============================================================================
# CORS, COOKIES & MUTATION INTENT (CSRF protection for cookie auth)
# =============================================================================
#
# The API only accepts "change something" requests (POST/PUT/PATCH/DELETE) from
# OUR frontends: header X-Mutation-Intent: same-origin AND an Origin/Referer in
# CORS_ORIGINS. Safe reads and Bearer-token clients skip the check.

# [required] Comma-separated absolute http(s) origins of the frontends.
#   local:      http://localhost:3000 (web), :3001 (admin), :3003 (merchant)
#   production: https://app.example.com,https://admin.example.com,https://merchant.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3003

# [optional] Bare host for auth cookies (no scheme/port). "localhost" shares the
# httpOnly cookies across the local ports; unset = host-only cookies.
# Production: your parent domain (e.g. .example.com). Cookies are Secure in production.
COOKIE_DOMAIN=localhost


# =============================================================================
# FRONTEND URLS (email links)
# =============================================================================

# [required] Web / consumer app (NOT the API URL).
APP_URL=http://localhost:3000

# [required] Admin panel (admin-specific links such as password reset).
ADMIN_APP_URL=http://localhost:3001

# [required] Merchant portal (onboarding invite links).
MERCHANT_APP_URL=http://localhost:3003


# =============================================================================
# DATABASE
# =============================================================================

# [required] postgres:// or postgresql:// connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs-nextjs-turborepo-starter-kit?schema=public

# [optional] Throwaway database for `pnpm db:check-drift`, which replays
# prisma/migrations into it and compares the result with schema.prisma.
# Not read by the API. Prisma wipes it on every run, so it must be a separate,
# empty database (create it once: `createdb nestjs-nextjs-turborepo-starter-kit_shadow`).
# SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs-nextjs-turborepo-starter-kit_shadow?schema=public

# [optional] RLS pool tuning (defaults: 10 connections, 30000 ms idle timeout).
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT_MS=30000


# =============================================================================
# AUTHENTICATION
# =============================================================================
#
# Every signing secret: at least 32 characters, not the "change-me" placeholder,
# and all four must differ. Generate them with: pnpm secrets:generate apps/api/.env

# [required][secret] Signs access tokens.
JWT_ACCESS_SECRET=

# [optional] Access token lifetime: <n> minutes or <n>s|m|h|d (default 15m).
JWT_ACCESS_EXPIRY=150m

# [required][secret] Signs refresh tokens.
JWT_REFRESH_SECRET=

# [optional] Refresh token lifetime (default 7d).
JWT_REFRESH_EXPIRY=30d

# [required][secret] Signs email verification tokens.
EMAIL_VERIFICATION_SECRET=

# [required][secret] Signs short-lived 2FA login step tokens.
TWO_FACTOR_PENDING_SECRET=

# [optional] Issuer shown in authenticator apps (default: APP_NAME).
# TWO_FACTOR_ISSUER=My App

# [optional] new-device | always | disabled (default new-device). When a password
# login must also pass the emailed one-time code: only from an unrecognized
# device, on every login (ignores the trusted-device cache — handy in dev), or
# never. `disabled` is rejected in production; automated test runs use it.
LOGIN_VERIFICATION_MODE=always

# [optional] bcrypt work factor, 10–15 (default 12).
BCRYPT_SALT_ROUNDS=12


# =============================================================================
# MOBILE APP
# =============================================================================

# [optional] Oldest mobile app version the API still serves (semver, default
# 1.0.0). A request with X-Client-Type: mobile whose X-App-Version header is
# missing, malformed or lower gets 426 APP_VERSION_UNSUPPORTED and the app shows
# a blocking "please update" screen. Prereleases rank below their release
# (1.0.0-beta < 1.0.0); build metadata (+417) is ignored. Raise it only after the
# new build is live in both stores. Browser apps are never checked.
# MOBILE_MIN_SUPPORTED_VERSION=1.0.0


# =============================================================================
# DEVICE SESSIONS
# =============================================================================

# [optional] Where the location of a signed-in device comes from (shown in the
# "Signed-in devices" list). Only `none` exists today: no lookup, the location
# stays hidden. A GeoIP provider is a pending decision (docs/adr/README.md).
# SESSION_LOCATION_PROVIDER=none

# [optional] Milliseconds a sign-in waits for the location lookup (1-5000,
# default 300). A slower or failing lookup is logged and the session is stored
# without a location — it never blocks sign-in.
# SESSION_LOCATION_TIMEOUT_MS=300


# =============================================================================
# MFA & ENCRYPTION
# =============================================================================

# [required][secret] JSON object: key version → base64 of EXACTLY 32 bytes.
# The highest version encrypts; keep older versions to decrypt existing secrets.
#   Format:   MFA_ENCRYPTION_KEYS='{"1":"<openssl rand -base64 32>"}'
#   Rotation: MFA_ENCRYPTION_KEYS='{"1":"<old>","2":"<new>"}'
MFA_ENCRYPTION_KEYS=

# [required][secret] HMAC key ring for reward QR tokens and backup codes (lookup hashes).
# Same format as MFA_ENCRYPTION_KEYS; the highest version hashes new codes and every version
# is tried on lookup, so adding a version never invalidates issued codes.
#   Format:   REWARD_CODE_HASH_KEYS='{"1":"<openssl rand -base64 32>"}'
#   Generate: pnpm secrets:generate apps/api/.env
REWARD_CODE_HASH_KEYS=

# [optional] MFA timings in ms (defaults: 30 days / 24 hours / 5 minutes).
# MFA_ENROLLMENT_DEADLINE_MS=2592000000
# MFA_RECOVERY_DELAY_MS=86400000
# MFA_STEP_UP_TTL_MS=300000

# [required][secret] Tenant envelope-encryption master key (KEK): base64 of
# exactly 32 bytes. Wraps every NEW organization data key. No fallback key
# exists in any environment. Generate with: openssl rand -base64 32
TENANT_ENCRYPTION_MASTER_KEY=

# [optional] Version of TENANT_ENCRYPTION_MASTER_KEY (default 1). To rotate the
# KEK: move the current key into TENANT_ENCRYPTION_PREVIOUS_MASTER_KEYS under its
# version, set a new key and a higher version, deploy, then run
# `pnpm --filter @workspace/api db:rewrap-tenant-keys -- --actor-user-id <superadmin id>`.
# TENANT_ENCRYPTION_MASTER_KEY_VERSION=1

# [optional][secret] Retired KEKs that may still unwrap data keys until they are
# re-wrapped: JSON {"<version>":"<base64 32 bytes>"}, versions below the current one.
# TENANT_ENCRYPTION_PREVIOUS_MASTER_KEYS={"1":"<base64 key>"}

# [required in production] Provider that wraps tenant data keys. `local` keeps
# the KEK in this environment (the only provider today); production must set it
# explicitly so the choice is never implicit. Default outside production: local.
# TENANT_KMS_PROVIDER=local

# [optional][secret] HMAC secret (≥ 32 chars) for signed tenant job contexts.
# Unset = job-context signing is disabled and fails closed (sign throws, verify rejects).
# TENANT_JOB_HMAC_SECRET=


# =============================================================================
# EMAIL (Resend)
# =============================================================================

# [optional] send | log-only | noop (default send).
#   send     → deliver through Resend (requires RESEND_API_KEY)
#   log-only → print the rendered email instead of sending
#   noop     → skip delivery entirely (fastest for local dev)
# log-only lets a fresh clone boot without a Resend account; switch to send
# once RESEND_API_KEY is set.
EMAIL_MODE=log-only

# [required when EMAIL_MODE=send][secret] https://resend.com API key.
RESEND_API_KEY=

# [required] Default sender address.
EMAIL_FROM_ADDRESS=noreply@example.com

# [optional] Reply-to address appended to every outbound email.
# EMAIL_REPLY_TO=hello@example.com

# [optional] DEV ONLY: redirect EVERY outbound email to one inbox. Rejected in
# production.
# EMAIL_TEST_TO=you@example.com

# [optional] Delivery tuning (defaults: 3 attempts, 10000 ms timeout, 0 = no
# per-recipient rate limit).
# EMAIL_MAX_ATTEMPTS=3
# EMAIL_TIMEOUT_MS=10000
# EMAIL_RATE_LIMIT_PER_MINUTE=0

# [secret] Verifies Resend delivery webhooks (email.delivered, email.bounced, …).
#   REQUIRED on a deployed production API with EMAIL_MODE=send (boot fails
#   without it); optional elsewhere. Unset = every webhook POST is answered 503
#   (never acknowledged, never trusted), so Resend retries it once it is set.
RESEND_WEBHOOK_SECRET=

# [optional] Per-IP webhook requests/minute (default 120; 0 disables).
# WEBHOOK_RATE_LIMIT_PER_MINUTE=120


# =============================================================================
# RATE LIMITS & CACHES
# =============================================================================

# [optional] HTTP throttlers per client IP (defaults: 300 / 30 per 60000 ms).
# Increase locally if dashboards hit 429.
# THROTTLE_DEFAULT_LIMIT=300
# THROTTLE_STRICT_LIMIT=30
# THROTTLE_TTL_MS=60000

# [optional] Max in-memory security counters (rate limits, throttler fallback)
# per instance (default 50000). New keys are rejected when full (fail closed).
# SECURITY_COUNTER_MAX_KEYS=50000

# [optional] memory | redis | auto (default auto = redis when REDIS_URL is set
# and NODE_ENV is not development).
# AUTHORIZATION_CACHE_BACKEND=auto
# USER_SESSION_CACHE_BACKEND=auto

# [optional] Cache TTLs (ms) and sizes (defaults: 300000 / 10000, 1800000 /
# 10000, 30000 / 50000).
# AUTHORIZATION_CACHE_TTL_MS=300000
# AUTHORIZATION_CACHE_MAX_ENTRIES=10000
# USER_SESSION_CACHE_TTL_MS=1800000
# USER_SESSION_CACHE_MAX_ENTRIES=10000
# ACCESS_TOKEN_STATE_CACHE_TTL_MS=30000
# ACCESS_TOKEN_STATE_CACHE_MAX_ENTRIES=50000


# =============================================================================
# REDIS / BULLMQ / KAFKA / RABBITMQ (local Docker — see compose.yml)
# =============================================================================

# [optional in development/test, required in production] redis:// or rediss://
# URL. Enables BullMQ queues, distributed cache invalidation and rate limits.
REDIS_URL=redis://localhost:6379

# [optional] Key prefix of EVERY BullMQ queue and worker (default bull = Bull
# Board's BULL_PREFIX in compose.yml). Letters, digits, ':', '_', '-'; max 64.
# Two processes on one Redis share jobs only if they share this prefix — e2e
# runs use their own per-run prefix (e2e:<uuid>). Also read by
# scripts/cleanup-stale-bullmq-repeat-jobs.ts.
# BULLMQ_PREFIX=bull

# [optional] Namespace of every raw Redis key and pub/sub channel the API uses
# (authz:invalidate channel, user-session cache, throttler, login verification,
# email rate limits): <namespace>:<key>. Same character rules as BULLMQ_PREFIX.
# Default: <APP_NAME slug>:<NODE_ENV>. APIs on one Redis hear each other's
# authorization invalidations and share cached sessions ONLY with the same
# namespace — set it explicitly whenever two APIs on DIFFERENT databases share a
# Redis with the same APP_NAME and NODE_ENV (a second local API, staging next to
# production). e2e runs use their own per-run namespace (<e2e prefix>-kv).
# REDIS_NAMESPACE=

# [optional] Kafka bootstrap servers, comma-separated host:port. Unset = Kafka
# is disabled: the outbox keeps events PENDING and the dispatcher skips them
# (a direct publish fails with KafkaProducerDisabledError — never a fake success).
# Topics are never auto-created: provision them first with
# `pnpm --filter @workspace/analytics-consumer kafka:provision-topics`.
# Local broker: use 127.0.0.1, the IPv4 address compose.yml publishes AND
# advertises — `localhost` may resolve to ::1 first, which nothing listens on.
KAFKA_BROKERS=127.0.0.1:9092

# [optional] amqp:// or amqps:// URL (placeholder health check only).
RABBITMQ_URL=amqp://rabbit:rabbit@localhost:5672

# [optional] Kafka client id and Redis connection name (default hello-world-api).
# MESSAGING_CLIENT_ID=hello-world-api
# MESSAGING_CONNECTION_NAME=hello-world-api

# [optional] Kafka transport security for the producer (the local compose
# broker is plaintext). KAFKA_SSL=true enables TLS — certificates are always
# verified; KAFKA_SSL_CA_LOCATION = PEM file of the CA (unset = system trust
# store). SASL mechanism: plain (requires KAFKA_SSL=true) | scram-sha-256 |
# scram-sha-512, with username + password. Inconsistent combinations fail boot.
# KAFKA_SSL=false
# KAFKA_SSL_CA_LOCATION=/etc/kafka/ca.pem
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=api
# KAFKA_SASL_PASSWORD=change-me-run-pnpm-secrets-generate

# [optional] Upper bound (ms) on one Kafka publish, retries included
# (librdkafka message.timeout.ms; minimum 1000, default 30000). Past it the
# publish fails and the outbox dispatcher retries the row with backoff.
# KAFKA_DELIVERY_TIMEOUT_MS=30000

# The analytics consumer has its OWN env file: apps/analytics-consumer/.env.example.


# =============================================================================
# OBJECT STORAGE — guides: docs/technical/storage/overview.md, aws-s3.md, firebase.md
# =============================================================================
#
# One provider per deployment:
#   local    → files on disk under apps/api/.object-storage (default, no cloud account).
#              Development only: rejected on a deployed production environment.
#   s3       → AWS S3: private bucket for every upload, public-origin bucket +
#              CloudFront for public assets. Credentials come from an IAM role.
#   firebase → Firebase / GCS with Application Default Credentials
# Unset STORAGE_PROVIDER = s3 when STORAGE_S3_PRIVATE_BUCKET / STORAGE_S3_BUCKET
# names a real (non local-*) bucket, otherwise local. s3 and firebase REQUIRE a
# private container (STORAGE_PRIVATE_CONTAINER or one of its aliases).

# [optional] local | s3 | firebase
# STORAGE_PROVIDER=local

# [optional] Private container (uploads land here). Aliases, in precedence
# order: STORAGE_S3_PRIVATE_BUCKET, STORAGE_S3_BUCKET (legacy single bucket),
# FIREBASE_STORAGE_BUCKET. Default for local: local-private-bucket.
# STORAGE_PRIVATE_CONTAINER=app-development-private
# STORAGE_S3_PRIVATE_BUCKET=app-development-private
# STORAGE_S3_BUCKET=rewardhub

# [required for s3] Public container (alias STORAGE_S3_PUBLIC_BUCKET): the
# CloudFront origin bucket. READY public assets (product images, logos,
# banners, avatars) are copied here and withdrawn on delete. Must differ from
# the private container. Unused by local/firebase (default local-public-bucket).
# STORAGE_PUBLIC_CONTAINER=app-development-public-origin
# STORAGE_S3_PUBLIC_BUCKET=app-development-public-origin

# [required for s3] Bare CloudFront host (no https://, no path) public asset
# URLs are built from: https://<host>/<key>.
# STORAGE_CLOUDFRONT_PUBLIC_DOMAIN=d123456abcdef.cloudfront.net

# [required for s3] Id of that CloudFront distribution (stack output
# CloudFrontDistributionId). Deleting a public asset purges its key from the
# CloudFront cache through a retried background job.
# STORAGE_CLOUDFRONT_DISTRIBUTION_ID=E2QWRUHAPOMQZL

# [optional] AWS region of the buckets (default ap-southeast-1).
# AWS_REGION=ap-southeast-1

# AWS CREDENTIALS — an IAM role, never an IAM user's keys. The API passes no
# credentials to the S3 client: the AWS SDK default credential chain resolves
# them (ECS task role, EC2 instance profile, EKS IRSA / Pod Identity; on a
# laptop: `aws sso login` + AWS_PROFILE, read by the SDK itself).
# [optional][secret] LOCAL DEVELOPMENT ONLY: static keys of a personal,
# least-privilege identity. Set BOTH or NEITHER. REJECTED on a deployed
# production environment (NODE_ENV=production and APP_URL not localhost).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=my-sso-profile

# [optional] Firebase project / default bucket. On GCP, attach a service
# account; locally, point GOOGLE_APPLICATION_CREDENTIALS (read by the Google
# SDK itself) at a service-account JSON file.
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# [optional] Signed download URL lifetime in seconds (default 300).
# KYB_DOCUMENT_DOWNLOAD_TTL_SECONDS is a legacy alias, used only when
# STORAGE_DOWNLOAD_TTL_SECONDS is unset.
# STORAGE_DOWNLOAD_TTL_SECONDS=300
# KYB_DOCUMENT_DOWNLOAD_TTL_SECONDS=300

# [optional] Delay before physically deleting soft-deleted objects, in ms
# (default: 30 days in production, 1 hour elsewhere).
# STORAGE_PHYSICAL_DELETE_DELAY_MS=2592000000

# [optional][secret] Shared secret (≥ 32 chars) for POST /files/processing-callback.
# Unset = every callback is rejected (fail closed, in every environment).
# STORAGE_PROCESSING_CALLBACK_SECRET=

# [required] Malware scanner for uploads. No default — choose explicitly:
#   none — no scanner is configured. Uploads still pass the size, SHA-256 and
#          file-type checks, then become READY with scan status NOT_SCANNED
#          (recorded on every file, shown in the API, warned about at boot).
#          A file is never reported as CLEAN without a scanner verdict.
# A real scanner (planned: AWS GuardDuty Malware Protection, verdicts posted to
# POST /files/processing-callback) will be one more value here.
MALWARE_SCANNER=none


# =============================================================================
# TENANCY / RLS
# =============================================================================

# [optional] true/false (default false). Multi-tenant mode: staff with admin
# access do NOT bypass RLS; single-tenant (false): they do (template default).
# TENANCY_ENABLED=false

# [required in single-tenant mode] Id (uuid) of the REAL organization a
# single-tenant deployment serves. The API verifies at boot that it is a live
# organization and refuses to start otherwise. This value is the organization
# `pnpm db:seed` creates (Brew & Bean KL); point it at your own organization in
# a real deployment. Unused in multi-tenant mode (no fallback organization).
DEFAULT_ORGANIZATION_ID=a178a4d1-6915-4eb3-bf84-6fb14e1feb6c


# =============================================================================
# OBSERVABILITY
# =============================================================================

# [optional] fatal | error | warn | info | debug | trace | silent (default: info in
# development, so `pnpm dev` lists the mapped routes; warn in test and production).
# The ONE log level of the API, in every environment: Fastify's pino request
# logger AND every Nest logger (`[Nest] … DEBUG [SomeService] …` lines) follow
# it (Nest mapping: info → LOG, debug → DEBUG, trace → VERBOSE). Use debug for
# developer detail (cache invalidations, …); debug/trace also turn on Prisma
# query/info event logging.
# LOG_LEVEL=info

# [optional] true/false (default false; always on in production). Leak
# detection on the heap measured right after each major GC (MemoryMonitorService):
# one warning when the post-GC heap floor (minimum) of the later half of
# MEMORY_LEAK_WINDOW_MS is MEMORY_LEAK_GROWTH_THRESHOLD_MB or more above the
# earlier half's, judged only after MEMORY_LEAK_WARMUP_MS from boot, at most
# one warning per window. Raw heapUsed between GCs is NOT a
# leak signal (garbage waits for the next major GC), so it is never compared.
# MEMORY_MONITORING=false
# [optional] ms after boot before heap samples count (default 300000 = 5 min; min 0).
# MEMORY_LEAK_WARMUP_MS=300000
# [optional] trend window and minimum gap between warnings (default 1800000 = 30 min; min 300000).
# MEMORY_LEAK_WINDOW_MS=1800000
# [optional] floor rise between the window halves that is reported (default 64; min 1).
# MEMORY_LEAK_GROWTH_THRESHOLD_MB=64

# [optional] NestJS Observe (observe.nestjs.com). On in production when both
# credentials are set; elsewhere set OBSERVE_ENABLED=1 (then both are required).
# OBSERVE_ENABLED=1
# [optional][secret]
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
# [optional] Service id reported to Observe (default freebuff-api).
OBSERVE_SERVICE_ID=hello-world


# =============================================================================
# SCRIPTS ONLY (read by apps/api/scripts/*, never by the running API)
# =============================================================================

# [optional] Target URL for scripts/test-webhook-signature.ts.
# WEBHOOK_URL=http://localhost:8080/notifications/email-webhook
