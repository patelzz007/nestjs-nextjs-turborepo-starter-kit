# ============================================
# apps/api/.env.example
# Copy to .env and fill in real values.
# NEVER commit the real .env (it is git-ignored).
# ============================================

# ── App ──────────────────────────────────────
NODE_ENV=development
APP_NAME=LinkHub
APP_URL=http://localhost:8080
PORT=8080

# Comma-separated list of allowed frontend origins
# (add your deployed domains here, e.g. https://app.example.com)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Database (PostgreSQL) ────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/monorepo?schema=public"

# ── Auth / JWT ───────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRY=7d
EMAIL_VERIFICATION_SECRET=change-me-email-verification-secret
BCRYPT_SALT_ROUNDS=10

# ── Email (Resend) ───────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=noreply@example.com
