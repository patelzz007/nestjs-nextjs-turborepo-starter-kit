```dotenv
# =============================================================================
# LinkHub API — Environment Variables
# =============================================================================
#
# Copy this file to:
#   apps/api/.env
#
# Then replace the placeholder values with your local / environment-specific
# configuration.
#
# IMPORTANT:
#   - Never commit the real .env file.
#   - Keep secrets out of source control.
#   - Generate strong, random secrets for production.
# =============================================================================


# =============================================================================
# APPLICATION
# =============================================================================

# Runtime environment
# Options: development | test | production
NODE_ENV=development

# Application name
APP_NAME=LinkHub

# Public URL of the API
APP_URL=http://localhost:8080

# API server port
PORT=8080


# =============================================================================
# CORS
# =============================================================================

# Comma-separated list of frontend origins allowed to access the API.
#
# Local development:
#   http://localhost:3000
#   http://localhost:3001
#
# Production example:
#   https://app.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001


# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL connection string
#
# Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hello_world


# =============================================================================
# AUTHENTICATION
# =============================================================================

# -----------------------------------------------------------------------------
# JWT — Access Token
# -----------------------------------------------------------------------------

# Secret used to sign access tokens.
# MUST be at least 32 characters.
JWT_ACCESS_SECRET=change-me-access-secret-32-chars-minimum

# Access token lifetime
JWT_ACCESS_EXPIRY=15m


# -----------------------------------------------------------------------------
# JWT — Refresh Token
# -----------------------------------------------------------------------------

# Secret used to sign refresh tokens.
# MUST be at least 32 characters.
#
# Keep this secret different from JWT_ACCESS_SECRET.
JWT_REFRESH_SECRET=change-me-refresh-secret-32-chars-minimum

# Refresh token lifetime
JWT_REFRESH_EXPIRY=7d


# -----------------------------------------------------------------------------
# Email Verification
# -----------------------------------------------------------------------------

# Secret used to sign email verification tokens.
# MUST be at least 32 characters.
EMAIL_VERIFICATION_SECRET=change-me-email-verify-secret-32-chars


# -----------------------------------------------------------------------------
# Password Hashing
# -----------------------------------------------------------------------------

# Number of bcrypt salt rounds.
# Higher values increase security but also increase hashing time.
BCRYPT_SALT_ROUNDS=12


# =============================================================================
# EMAIL
# =============================================================================

# Email provider: Resend
# https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# Sender
# -----------------------------------------------------------------------------

# Default address used for outbound emails.
EMAIL_FROM_ADDRESS=noreply@example.com


# -----------------------------------------------------------------------------
# Delivery Mode
# -----------------------------------------------------------------------------

# Controls how emails are handled.
#
# send     → Send emails through Resend
# log-only → Print emails to the console instead of sending
# noop     → Skip email delivery entirely
#
# Defaults to "send" if not specified.
# EMAIL_MODE=send


# -----------------------------------------------------------------------------
# Development / Testing
# -----------------------------------------------------------------------------

# Redirect ALL outbound emails to this address.
#
# Useful during development to prevent accidentally sending emails
# to real users.
#
# Example:
# EMAIL_TEST_TO=you@example.com
# EMAIL_TEST_TO=you@example.com


# -----------------------------------------------------------------------------
# Reply-To
# -----------------------------------------------------------------------------

# Optional address used as the Reply-To header for outbound emails.
#
# Example:
# EMAIL_REPLY_TO=hello@example.com
# EMAIL_REPLY_TO=hello@example.com


# -----------------------------------------------------------------------------
# Delivery Tuning
# -----------------------------------------------------------------------------

# Maximum number of delivery attempts.
# EMAIL_MAX_ATTEMPTS=3

# Timeout for each email provider request, in milliseconds.
# EMAIL_TIMEOUT_MS=10000

# Maximum number of emails that can be sent per minute.
#
# 0 = unlimited
# EMAIL_RATE_LIMIT_PER_MINUTE=0


# -----------------------------------------------------------------------------
# Webhooks
# -----------------------------------------------------------------------------

# Secret used to verify incoming Resend webhook requests.
#
# Required if the application receives delivery events such as:
#   - email.delivered
#   - email.bounced
#   - email.failed
#
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Per-IP webhook requests/minute (0 = disabled; defense-in-depth on top of signatures)
WEBHOOK_RATE_LIMIT_PER_MINUTE=120

# Public base URL where the API's open-tracking pixel is reachable.
# Must be reachable from the RECIPIENT's mail client (tunnel or public API URL).
# If unset, falls back to APP_URL.
```


# =============================================================================
# TELESCOPE (local dev observability console — docs/telescope.md)
# =============================================================================
# Master switch. FAIL-CLOSED: NODE_ENV=production forces this to false unless
# explicitly set to true here.
TELESCOPE_ENABLED=true
# memory (default, zero config) | postgres (persisted — requires DATABASE_URL)
TELESCOPE_MODE=memory
# Ring-buffer cap in memory mode
TELESCOPE_MAX_REQUESTS=10000
# none | headers | full (full bodies are sanitized + truncated at capture)
TELESCOPE_BODY_CAPTURE=headers
# 0-1 fraction of requests captured (production default 0.01)
TELESCOPE_SAMPLE_RATE=1.0
# Postgres-mode retention only (requests/queries; exceptions always 30 days)
TELESCOPE_RETENTION_DAYS=7
# Queue flush interval (ms) + batch size
TELESCOPE_FLUSH_MS=1000
TELESCOPE_FLUSH_BATCH=100
# Feature 18 — alert webhook URL; threshold alerts fire only when this is set
TELESCOPE_ALERT_WEBHOOK_URL=
# Feature 18 — duration threshold (ms) for "duration" alerts
TELESCOPE_ALERT_DURATION_MS=2000
# Feature 18 — per-route+reason alert dedupe window (minutes)
TELESCOPE_ALERT_WINDOW_MINUTES=5
# Feature 7 — request replay targets as name:baseUrl pairs (comma-separated); `local` always exists
TELESCOPE_REPLAY_TARGETS=
# Feature 7 — the API's own origin used as the `local` replay target
TELESCOPE_LOCAL_BASE_URL=http://localhost:8080
# Improvement 14 — capture budget: max spans (children) captured per request
TELESCOPE_MAX_SPANS_PER_REQUEST=200
# Improvement 14 — capture budget: max console entries captured per request
TELESCOPE_MAX_CONSOLE_ENTRIES=100
# Improvement 15 — PII handling: redact (mask values) | flag (record only, no masking)
TELESCOPE_PII_MODE=redact
