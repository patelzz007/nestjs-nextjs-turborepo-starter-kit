```dotenv
# =============================================================================
# My App — API Environment Variables
# =============================================================================
#
# Copy this file to:
#   apps/api/.env
#
# Then replace the placeholder values with your local / environment-specific
# configuration.
#
# IMPORTANT:
#   - NEVER commit the real .env file.
#   - Keep secrets out of source control.
#   - This file should be git-ignored.
#   - Generate strong, random secrets for production.

# =============================================================================


# =============================================================================
# APPLICATION
# =============================================================================

# Runtime environment
NODE_ENV=development

# Application name
APP_NAME=NestJS + NextJS Turborepo Starter Template

# Public API URL
APP_URL=http://localhost:8080

# Merchant portal URL for onboarding invite links (defaults to APP_URL)
MERCHANT_APP_URL=http://localhost:3003

# API server port
PORT=8080

# Bind address (127.0.0.1 avoids slow IPv6 localhost resolution on some hosts)
HOST=127.0.0.1

# Graceful shutdown timeout (ms) — Ctrl+C / SIGTERM closes HTTP, Postgres, Redis, BullMQ, Kafka
# SHUTDOWN_TIMEOUT_MS=15000

# Swagger UI at /v1/docs (on by default; set to 0 to disable in dev)
# SWAGGER_ENABLED=0


# =============================================================================
# CORS
# =============================================================================

# Comma-separated list of allowed frontend origins.
#
# Add your deployed frontend domains here when deploying.
# Local development:
#   http://localhost:3000  (web / consumer)
#   http://localhost:3001  (admin)
#   http://localhost:3003  (merchant portal)
#
# Production example:
#   https://app.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3003


# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL connection string
#
# Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs-nextjs-turborepo-starter-kit?schema=public


# =============================================================================
# AUTHENTICATION
# =============================================================================

# -----------------------------------------------------------------------------
# JWT — Access Token
# -----------------------------------------------------------------------------

# Secret used to sign access tokens.
# Secrets must be at least 32 characters.
JWT_ACCESS_SECRET=1003b706fa989fe10494060c999c2288b16a942d87e25afda32b2bf7cdd410abaccec3266dbe80c58b3107d22b6f0721d1970db2c2a37babf568bf2e814ae182

# Access token lifetime
JWT_ACCESS_EXPIRY=150m


# -----------------------------------------------------------------------------
# JWT — Refresh Token
# -----------------------------------------------------------------------------

# Secret used to sign refresh tokens.
# Secrets must be at least 32 characters.
JWT_REFRESH_SECRET=1d81e589b19ad5d883cafacf3fb595be922c0e988f0bf10e5ec71fae8a653fe5740a99772d4f2df2b3169fc2b9d9be5a616887e4e592754b81e8abebebc3e739

# Refresh token lifetime
JWT_REFRESH_EXPIRY=30d


# -----------------------------------------------------------------------------
# Email Verification
# -----------------------------------------------------------------------------

# Secret used to sign email verification tokens.
EMAIL_VERIFICATION_SECRET=dev-email-verification-secret-change-in-prod


# -----------------------------------------------------------------------------
# Password Hashing
# -----------------------------------------------------------------------------

# Number of bcrypt salt rounds.
# Higher values increase security but also increase hashing time.
BCRYPT_SALT_ROUNDS=12


# =============================================================================
# EMAIL
# =============================================================================

# Email provider: Resend
# https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# Sender
# -----------------------------------------------------------------------------

# Default sender address used for sending outbound emails.
EMAIL_FROM_ADDRESS=noreply@example.com


# -----------------------------------------------------------------------------
# Delivery Mode
# -----------------------------------------------------------------------------

# Send mode:
#   send     → Send through Resend
#   log-only → Print emails instead of sending
#   noop     → Skip email delivery
#
# Defaults to "send" if not specified.
# EMAIL_MODE=send


# -----------------------------------------------------------------------------
# Development / Testing
# -----------------------------------------------------------------------------

# Dev-only: redirect EVERY outbound email to one inbox.#
# Useful during development to prevent accidentally sending emails
# to real users.
#
# Example:
# EMAIL_TEST_TO=you@example.com
EMAIL_TEST_TO=patelzz007@gmail.com


# -----------------------------------------------------------------------------
# Reply-To
# -----------------------------------------------------------------------------

# Reply-to address appended to every outbound email.
#
# EMAIL_REPLY_TO=hello@example.com


# -----------------------------------------------------------------------------
# Delivery Tuning
# -----------------------------------------------------------------------------

# Maximum number of delivery attempts.
# EMAIL_MAX_ATTEMPTS=3

# Request timeout in milliseconds.
# EMAIL_TIMEOUT_MS=10000

# Maximum emails allowed per minute.
# 0 = unlimited
# EMAIL_RATE_LIMIT_PER_MINUTE=0


# -----------------------------------------------------------------------------
# Webhooks
# -----------------------------------------------------------------------------


# Secret used to verify incoming Resend webhook requests.
#
# Required to receive Resend delivery webhooks:
#   - email.delivered
#   - email.bounced
#   - email.failed
#   - …
RESEND_WEBHOOK_SECRET=whsec_tPq1h97xpnPMrc1s9XilS4eDHyQNDwYC

# Per-IP webhook requests/minute (0 = disabled; defense-in-depth on top of signatures)
WEBHOOK_RATE_LIMIT_PER_MINUTE=120

# Must be reachable from the RECIPIENT's mail client (tunnel or public API URL).
```
COOKIE_DOMAIN=localhost


# =============================================================================
# AUTHORIZATION CACHE
# =============================================================================

# Backend for RBAC resolution cache invalidation across API instances.
# memory — local in-process Map (default for development)
# redis  — local Map + Redis pub/sub invalidation (deployed environments)
# auto   — redis when REDIS_URL is set and NODE_ENV is not development
AUTHORIZATION_CACHE_BACKEND=auto

# Redis URL for distributed authorization cache invalidation.
REDIS_URL=redis://localhost:6379

# TTL for cached authorization entries in milliseconds (default 300000 = 5 min).
# AUTHORIZATION_CACHE_TTL_MS=300000


# =============================================================================
# REDIS / BULLMQ
# =============================================================================

# Redis connection URL — powers URL cache, authorization cache, and BullMQ workers.
# Start the bundled Redis container: docker compose up -d
REDIS_URL=redis://localhost:6379

# BullMQ queue key prefix (default: urlshortener)
BULLMQ_PREFIX=hello-world


# =============================================================================
# MESSAGE BROKERS (local Docker — see compose.yml at repo root)
# =============================================================================

# Kafka bootstrap servers (comma-separated for clusters).
KAFKA_BROKERS=localhost:9092

# RabbitMQ connection URL (AMQP).
RABBITMQ_URL=amqp://rabbit:rabbit@localhost:5672

# BullMQ uses Redis — point workers at the same REDIS_URL above.
# Queue dashboard (Bull Board): http://localhost:3030

# =============================================================================
# TENANCY / RLS
# =============================================================================

# Multi-tenant mode: staff with admin access do NOT bypass RLS globally.
# Single-tenant (false): staff with admin access bypass RLS (template default).
# TENANCY_ENABLED=false

# Default organization id for single-tenant mode and fallback in multi-tenant.
# DEFAULT_ORGANIZATION_ID=default

COOKIE_DOMAIN=localhost

# NestJS Observe — auto-instrumented observability (observe.nestjs.com)
# Requires OBSERVE_ENABLED=1 plus credentials below (off by default in development).
# OBSERVE_ENABLED=1
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=hello-world

USER_SESSION_CACHE_BACKEND=redis
USER_SESSION_CACHE_TTL_MS=300000

SHUTDOWN_TIMEOUT_MS=15000