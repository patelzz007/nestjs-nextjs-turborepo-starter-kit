# Environment
# Every env file and copy (.env, .env.local, .env_bak, .env.bak, …) — only the documented examples are committed.
.env*
!.env.example

# Build output
dist/

# Database backups (pg_dump output — never commit)
backups/

# Local storage driver objects (STORAGE_PROVIDER=local; development/test only)
.object-storage/
