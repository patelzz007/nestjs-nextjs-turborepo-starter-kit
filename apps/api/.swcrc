{
	"$schema": "https://swc.rs/schema.json",
	"jsc": {
		"target": "es2022",
		"keepClassNames": true,
		"parser": {
			"syntax": "typescript",
			"decorators": true,
			"dynamicImport": true
		},
		"transform": {
			"legacyDecorator": true,
			"decoratorMetadata": true
		}
	},
	"module": {
		"type": "es6"
	}
}
