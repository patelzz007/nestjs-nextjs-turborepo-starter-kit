exports[`OpenAPI document (e2e) > POST /api/v1/auth/login documents email + password with examples for Try-it-out (snapshot) 1`] = `
{
  "additionalProperties": false,
  "properties": {
    "email": {
      "description": "User email address",
      "example": "admin@example.com",
      "format": "email",
      "maxLength": 100,
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string",
    },
    "password": {
      "description": "User password",
      "example": "Admin@123",
      "minLength": 1,
      "type": "string",
    },
  },
  "required": [
    "email",
    "password",
  ],
  "type": "object",
}
`;

