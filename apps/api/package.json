{
	"name": "@workspace/api",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "rspack --watch --mode development",
		"build": "rspack build --mode production",
		"start": "node dist/main.js",
		"db:push": "dotenv -e .env -- prisma db push --accept-data-loss && pnpm db:rls",
		"db:rls": "bash scripts/apply-rls.sh",
		"lint": "eslint",
		"format": "prettier --write \"**/*.{ts,tsx}\"",
		"typecheck": "tsc --noEmit",
		"test:unit": "vitest run --config vitest.config.unit.ts",
		"test:e2e": "vitest run --config vitest.config.e2e.ts",
		"db:generate": "dotenv -e .env -- prisma generate",
		"db:migrate": "dotenv -e .env -- prisma migrate dev && pnpm db:rls",
		"db:migrate:create": "dotenv -e .env -- prisma migrate dev --create-only",
		"db:deploy": "dotenv -e .env -- prisma migrate deploy && pnpm db:rls",
		"db:migrate:status": "dotenv -e .env -- prisma migrate status",
		"db:seed": "dotenv -e .env -- tsx prisma/seed.ts",
		"db:studio": "dotenv -e .env -- prisma studio",
		"db:reset": "dotenv -e .env -- prisma migrate reset --force && pnpm db:rls && pnpm db:seed",
		"telescope:cli": "tsx scripts/telescope-cli.ts",
		"telescope:docs": "tsx scripts/gen-telescope-docs.ts"
	},
	"dependencies": {
		"@fastify/compress": "^9.2.0",
		"@fastify/cookie": "^11.1.2",
		"@fastify/cors": "^11.3.0",
		"@fastify/etag": "^6.2.0",
		"@fastify/helmet": "^13.1.1",
		"@fastify/rate-limit": "^11.2.0",
		"@fastify/request-context": "^7.0.0",
		"@fastify/static": "^10.1.3",
		"@fastify/under-pressure": "^9.1.0",
		"@nestjs/bullmq": "^12.0.0",
		"@nestjs/common": "^12.0.1",
		"@nestjs/config": "^12.0.0",
		"@nestjs/core": "^12.0.1",
		"@nestjs/jwt": "^12.0.1",
		"@nestjs/mapped-types": "^12.0.0",
		"@nestjs/observe": "^0.1.8",
		"@nestjs/platform-fastify": "^12.0.1",
		"@nestjs/schedule": "^12.0.1",
		"@nestjs/swagger": "^12.0.1",
		"@nestjs/terminus": "^12.0.0",
		"@nestjs/throttler": "^6.5.0",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"@workspace/messaging": "workspace:*",
		"@workspace/shared": "workspace:*",
		"ajv": "^8.20.0",
		"bcrypt": "^6.0.0",
		"bullmq": "^6.3.4",
		"chokidar": "^5.0.0",
		"date-fns": "^4.4.0",
		"dotenv": "^17.4.2",
		"fastify": "5.12.1",
		"ioredis": "^6.0.0",
		"jsonwebtoken": "^9.0.3",
		"kafkajs": "^2.2.4",
		"nanoid": "^5.1.16",
		"nestjs-zod": "^5.5.0",
		"pg": "^8.23.0",
		"reflect-metadata": "^0.2.2",
		"resend": "^6.25.0",
		"rxjs": "^7.8.2",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@nestjs/cli": "^12.0.0",
		"@nestjs/schematics": "^12.0.0",
		"@nestjs/testing": "^12.0.1",
		"@prisma/config": "^7.10.0",
		"@rspack/cli": "^2.2.2",
		"@rspack/core": "^2.2.2",
		"@types/bcrypt": "^6.0.0",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.4.0",
		"@types/pdfkit": "^0.17.6",
		"@types/pg": "^8.23.1",
		"@workspace/eslint-config": "workspace:^",
		"@workspace/typescript-config": "workspace:*",
		"dotenv-cli": "^11.0.0",
		"eslint": "^9.39.5",
		"prisma": "^7.10.0",
		"run-script-webpack-plugin": "^0.2.3",
		"tsx": "^4.23.13",
		"typescript": "6.0.2",
		"vitest": "^4.1.11",
		"webpack-node-externals": "^3.0.0"
	}
}
