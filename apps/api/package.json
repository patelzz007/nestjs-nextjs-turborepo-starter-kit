    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@workspace/shared": "workspace:*",
    "dotenv": "^17.4.2",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
