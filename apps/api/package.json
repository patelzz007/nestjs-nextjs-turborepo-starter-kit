{
	"name": "@workspace/api",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "nest build",
		"dev": "nest start --watch",
		"prestart": "test -f dist/main.js || pnpm build",
		"start": "nest start --prod",
		"start:prod": "node dist/main.js",
		"db:push": "dotenv -e .env -- prisma db push --accept-data-loss",
		"lint": "eslint",
		"format": "prettier --write \"**/*.{ts,tsx}\"",
		"typecheck": "tsc --noEmit",
		"test:unit": "vitest run --config vitest.config.unit.ts",
		"test:e2e": "vitest run --config vitest.config.e2e.ts",
		"db:generate": "dotenv -e .env -- prisma generate",
		"db:migrate": "dotenv -e .env -- prisma migrate dev",
		"db:migrate:create": "dotenv -e .env -- prisma migrate dev --create-only",
		"db:deploy": "dotenv -e .env -- prisma migrate deploy",
		"db:migrate:status": "dotenv -e .env -- prisma migrate status",
		"db:seed": "dotenv -e .env -- tsx prisma/seed.ts",
		"db:studio": "prisma studio",
		"db:reset": "dotenv -e .env -- prisma migrate reset --force && pnpm db:seed",
		"telescope:cli": "tsx scripts/telescope-cli.ts",
		"telescope:docs": "tsx scripts/gen-telescope-docs.ts"
	},
	"dependencies": {
		"@nestjs/common": "^11.1.28",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.1.28",
		"@nestjs/jwt": "^11.0.2",
		"@nestjs/mapped-types": "^2.1.1",
		"@nestjs/platform-express": "^11.1.28",
		"@nestjs/schedule": "^6.1.3",
		"@nestjs/swagger": "^11.4.6",
		"@nestjs/terminus": "^11.1.1",
		"@nestjs/throttler": "^6.5.0",
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@workspace/shared": "workspace:*",
		"bcrypt": "^6.0.0",
		"cookie-parser": "^1.4.7",
		"date-fns": "^4.4.0",
		"dotenv": "^17.4.2",
		"helmet": "^8.3.0",
		"jsonwebtoken": "^9.0.3",
		"nanoid": "^5.1.16",
		"nestjs-pino": "^4.6.1",
		"nestjs-zod": "^5.5.0",
		"pg": "^8.22.0",
		"pino-http": "^11.0.0",
		"pino-pretty": "^13.1.3",
		"reflect-metadata": "^0.2.2",
		"resend": "^6.18.1",
		"rxjs": "^7.8.2",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.24",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.1.28",
		"@types/supertest": "^7.2.1",
		"@prisma/config": "^7.9.1",
		"@types/bcrypt": "^6.0.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"supertest": "^7.1.4",
		"vitest": "^4.1.10",
		"@types/node": "^26.1.2",
		"@types/pdfkit": "^0.17.6",
		"@types/pg": "^8.20.4",
		"@workspace/eslint-config": "workspace:^",
		"@workspace/typescript-config": "workspace:*",
		"dotenv-cli": "^11.0.0",
		"eslint": "^9.39.5",
		"prisma": "^7.9.1",
		"tsx": "^4.23.7",
		"typescript": "6.0.2"
	}
}
