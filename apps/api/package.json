{
	"name": "@workspace/api",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "nest build && node scripts/bundle-prod.mjs",
		"dev": "nest start --watch -e tsx",
		"prestart": "test -f dist/main.bundle.js || pnpm build",
		"start": "tsx dist/src/main.js",
		"start:prod": "node dist/main.bundle.js",
		"db:push": "dotenv -e .env -- prisma db push --accept-data-loss && pnpm db:rls",
		"db:rls": "bash scripts/apply-rls.sh",
		"lint": "eslint",
		"format": "prettier --write \"**/*.{ts,tsx}\"",
		"typecheck": "tsc --noEmit",
		"test:unit": "vitest run --config vitest.config.unit.ts",
		"test:e2e": "vitest run --config vitest.config.e2e.ts",
		"db:generate": "dotenv -e .env -- prisma generate",
		"db:migrate": "dotenv -e .env -- prisma migrate dev && pnpm db:rls",
		"db:migrate:create": "dotenv -e .env -- prisma migrate dev --create-only",
		"db:deploy": "dotenv -e .env -- prisma migrate deploy && pnpm db:rls",
		"db:migrate:status": "dotenv -e .env -- prisma migrate status",
		"db:seed": "dotenv -e .env -- tsx prisma/seed.ts",
		"db:studio": "dotenv -e .env -- prisma studio",
		"db:reset": "dotenv -e .env -- prisma migrate reset --force && pnpm db:rls && pnpm db:seed",
		"telescope:cli": "tsx scripts/telescope-cli.ts",
		"telescope:docs": "tsx scripts/gen-telescope-docs.ts",
		"bundle": "node scripts/bundle-prod.mjs"
	},
	"dependencies": {
		"@fastify/compress": "^9.2.0",
		"@fastify/cookie": "^11.1.2",
		"@fastify/cors": "^11.3.0",
		"@fastify/etag": "^6.2.0",
		"@fastify/helmet": "^13.1.0",
		"@fastify/rate-limit": "^11.2.0",
		"@fastify/request-context": "^7.0.0",
		"@fastify/static": "^10.1.3",
		"@fastify/under-pressure": "^9.1.0",
		"@nestjs/common": "^11.1.28",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.1.28",
		"@nestjs/jwt": "^11.0.2",
		"@nestjs/mapped-types": "^2.1.1",
		"@nestjs/platform-fastify": "^11.2.1",
		"@nestjs/schedule": "^6.1.3",
		"@nestjs/swagger": "^11.4.6",
		"@nestjs/terminus": "^11.1.1",
		"@nestjs/throttler": "^6.5.0",
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@workspace/shared": "workspace:*",
		"ajv": "^8.20.0",
		"bcrypt": "^6.0.0",
		"date-fns": "^4.4.0",
		"dotenv": "^17.4.2",
		"fastify": "5.11.3",
		"jsonwebtoken": "^9.0.3",
		"nanoid": "^5.1.16",
		"nestjs-zod": "^5.5.0",
		"pg": "^8.22.0",
		"reflect-metadata": "^0.2.2",
		"resend": "^6.18.1",
		"rxjs": "^7.8.2",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.24",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.1.28",
		"@prisma/config": "^7.9.1",
		"@swc/cli": "^0.8.1",
		"@swc/core": "^1.15.47",
		"@types/bcrypt": "^6.0.0",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.1.2",
		"@types/pdfkit": "^0.17.6",
		"@types/pg": "^8.20.4",
		"@workspace/eslint-config": "workspace:^",
		"@workspace/typescript-config": "workspace:*",
		"dotenv-cli": "^11.0.0",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"prisma": "^7.9.1",
		"tsx": "^4.23.7",
		"typescript": "6.0.2",
		"vitest": "^4.1.10"
	}
}
