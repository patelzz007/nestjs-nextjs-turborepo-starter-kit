{
	"name": "@workspace/api",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "rspack --watch --mode development --node-env development",
		"build": "rspack build --mode production",
		"start": "node dist/main.js",
		"db:push": "pnpm db:schema && dotenv run -q -- prisma db push --accept-data-loss && pnpm db:apply-security",
		"db:apply-security": "dotenv run -q -- tsx scripts/db.ts apply-security",
		"github:webhook-tunnel": "dotenv run -q -- tsx scripts/dev.ts github-webhook",
		"db:rls": "pnpm db:apply-security",
		"db:check-rls-manifest": "tsx scripts/db.ts check-rls-manifest",
		"db:schema": "tsx scripts/db.ts schema",
		"db:generate-system-operation-scopes": "tsx scripts/db.ts generate-system-operation-scopes",
		"db:check-drift": "dotenv run -q -- tsx scripts/db.ts check-drift",
		"db:check-seed-coverage": "dotenv run -q -- tsx scripts/db.ts check-seed-coverage",
		"db:carry-github-link": "dotenv run -q -- tsx scripts/db/carry-github-link.ts",
		"db:check-tenant-integrity": "dotenv run -q -- tsx scripts/db/check-tenant-integrity.ts",
		"db:kanban-convert": "dotenv run -q -- tsx scripts/db/kanban-convert.ts",
		"db:rewrap-tenant-keys": "dotenv run -q -- tsx src/platform/infrastructure/encryption/rewrap-tenant-keys.cli.ts",
		"db:sync-reference-data": "dotenv run -q -- tsx src/contexts/authorization/infrastructure/reference-data/sync-reference-data.cli.ts",
		"admin:bootstrap-superadmin": "dotenv run -q -- tsx src/contexts/identity/presentation/cli/superadmin-bootstrap.cli.ts",
		"lint": "oxfmt --check \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\" && oxlint",
		"format": "oxfmt \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\"",
		"typecheck": "tsrs --noEmit -p tsconfig.typecheck.json && tsrs --noEmit -p tsconfig.json",
		"test": "vitest run --config vitest.config.unit.ts",
		"test:unit": "vitest run --config vitest.config.unit.ts",
		"test:e2e": "vitest run --config vitest.config.e2e.ts --exclude 'test/tenancy/single/**'",
		"test:e2e:tenancy": "cross-env TENANCY_E2E_SUITE=multi vitest run --config vitest.config.e2e.ts test/tenancy/multi",
		"test:e2e:tenancy:single": "cross-env TENANCY_E2E_SUITE=single vitest run --config vitest.config.e2e.ts test/tenancy/single",
		"test:e2e:rls": "vitest run --config vitest.config.e2e.ts test/rls/ test/tenant-transaction-session.e2e-spec.ts",
		"openapi:export": "vitest run --config vitest.config.e2e.ts test/openapi-artifact.e2e-spec.ts --update",
		"db:generate": "pnpm db:schema && dotenv run -q -- prisma generate",
		"db:migrate": "pnpm db:schema && dotenv run -q -- prisma migrate dev && pnpm db:apply-security",
		"db:migrate:create": "pnpm db:schema && dotenv run -q -- prisma migrate dev --create-only",
		"db:deploy": "dotenv run -q -- prisma migrate deploy && pnpm db:apply-security",
		"db:migrate:status": "dotenv run -q -- prisma migrate status",
		"db:seed": "dotenv run -q -- tsx prisma/seed.ts",
		"db:studio": "dotenv run -q -- prisma studio",
		"db:reset": "pnpm db:schema && dotenv run -q -- prisma migrate reset --force && pnpm db:generate && pnpm db:apply-security && pnpm db:seed",
		"mail:latest": "dotenv run -q -- tsx scripts/dev.ts mail",
		"dev:tunnel": "dotenv run -q -- tsx scripts/dev.ts tunnel",
		"webhook:test-signature": "dotenv run -q -- tsx scripts/dev.ts webhook-signature",
		"email:previews": "dotenv run -q -- tsx scripts/dev.ts email-previews"
	},
	"dependencies": {
		"@aws-sdk/client-cloudfront": "^3.1156.0",
		"@aws-sdk/client-lambda": "^3.1156.0",
		"@aws-sdk/client-s3": "^3.1156.0",
		"@aws-sdk/s3-presigned-post": "^3.1156.0",
		"@aws-sdk/s3-request-presigner": "^3.1156.0",
		"@cedar-policy/cedar-wasm": "4.14.0",
		"@confluentinc/kafka-javascript": "1.11.0",
		"@fastify/compress": "^9.2.2",
		"@fastify/cookie": "^11.1.3",
		"@fastify/cors": "^11.3.1",
		"@fastify/etag": "^6.2.1",
		"@fastify/helmet": "^13.2.0",
		"@fastify/multipart": "^10.1.6",
		"@fastify/rate-limit": "^11.2.1",
		"@fastify/static": "^10.1.7",
		"@fastify/under-pressure": "^9.2.1",
		"@nestjs/bullmq": "^12.0.0",
		"@nestjs/common": "^12.2.0",
		"@nestjs/config": "^12.0.1",
		"@nestjs/core": "^12.2.0",
		"@nestjs/cqrs": "^12.1.1",
		"@nestjs/jwt": "^12.0.3",
		"@nestjs/mapped-types": "^12.0.0",
		"@nestjs/observe": "^0.3.17",
		"@nestjs/platform-fastify": "^12.2.0",
		"@nestjs/schedule": "^12.0.2",
		"@nestjs/swagger": "^12.0.3",
		"@nestjs/terminus": "^12.1.0",
		"@nestjs/throttler": "^6.7.1",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"@smithy/node-http-handler": "^4.12.1",
		"@workspace/messaging": "workspace:*",
		"@workspace/shared": "workspace:*",
		"ajv": "^8.20.0",
		"bcrypt": "^6.0.0",
		"bullmq": "^6.4.0",
		"date-fns": "^4.4.0",
		"dotenv": "^18.0.9",
		"fastify": "5.12.7",
		"fflate": "^0.8.3",
		"firebase-admin": "^14.5.0",
		"fontkit": "2.0.4",
		"ioredis": "^6.0.0",
		"jsonwebtoken": "^9.0.3",
		"nanoid": "^6.0.2",
		"nestjs-zod": "^5.5.0",
		"otplib": "^13.5.0",
		"pdfkit": "^0.20.2",
		"pg": "^8.23.1",
		"reflect-metadata": "^0.2.2",
		"resend": "^6.34.1",
		"rxjs": "^7.8.2",
		"sharp": "0.35.5",
		"write-excel-file": "^4.1.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@nestjs/cli": "^12.0.10",
		"@nestjs/schematics": "^12.0.10",
		"@nestjs/testing": "^12.2.0",
		"@prisma/config": "^7.10.1",
		"@rspack/cli": "^2.2.9",
		"@rspack/core": "^2.2.9",
		"@types/bcrypt": "^6.0.0",
		"@types/fontkit": "^2.0.9",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.6.5",
		"@types/pdfkit": "^0.17.7",
		"@types/pg": "8.23.1",
		"@workspace/oxlint-config": "workspace:^",
		"@workspace/typescript-config": "workspace:*",
		"cross-env": "^10.1.0",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "7.0.2005",
		"prisma": "^7.10.1",
		"read-excel-file": "^9.3.12",
		"run-script-webpack-plugin": "^0.2.3",
		"tsrs": "0.18.0-ts7.1.0-dev.20260929",
		"tsx": "^4.23.15",
		"typescript": "7.0.2",
		"vitest": "^5.0.5",
		"webpack-node-externals": "^3.0.0"
	}
}
