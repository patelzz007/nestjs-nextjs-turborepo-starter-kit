// Password Reset Tokens
// ---------------------------------------------------------------------------

/// RLS: own row — `app_owns(userId)`.
/// @extends BaseModel
model PasswordResetToken {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  userId      String
  token       String  @unique @db.Text
  tokenDigest String? @unique @db.VarChar(64)
  expiresAt   BigInt
  usedAt      BigInt?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([tokenDigest])
}

/// RLS: own row — `app_owns(userId)`.
/// @extends BaseModel
model PasswordHistory {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  userId       String
  passwordHash String @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Soft-deleted (never DELETEd) when MFA is reset or recovered: a revoked set
/// keeps `isDeleted = true` + `deletedAt` + `deletedBy` (the user who reset
/// MFA, or the SuperAdmin who approved the recovery). Readers filter `isDeleted = false`.
/// RLS: own row — `app_owns(userId)`.
/// @extends BaseModel
model BackupCode {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  userId   String
  codeHash String  @db.Text
  usedAt   BigInt?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Temporary 2FA enrollment state — expires after 15 minutes.
/// RLS: own row — `app_owns(userId)`.
/// @extends BaseModel
model TwoFactorPendingSetup {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  userId            String @unique
  secretCiphertext  String @db.Text
  secretIv          String @db.VarChar(32)
  secretKeyVersion  Int
  backupCodesHashes Json
  expiresAt         BigInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// Short-lived MFA verification challenge during login or secret rotation.
/// RLS: own row — `app_owns(userId)`.
/// @extends BaseModel
model TwoFactorLoginChallenge {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  userId       String
  purpose      TwoFactorLoginChallengePurpose
  clientType   String?
  deviceInfo   String?                        @db.VarChar(255)
  ipAddress    String?                        @db.VarChar(45)
  attemptCount Int                            @default(0)
  maxAttempts  Int                            @default(5)
  consumedAt   BigInt?
  expiresAt    BigInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

/// Admin-reviewed MFA recovery / account unlock request.
/// Status transitions are compare-and-set on `status`; the reviewer must be a
/// SuperAdmin other than the requester. At most one open (PENDING or APPROVED)
/// request per user: creation runs under a per-user transaction advisory lock.
/// RLS: own row — `app_owns(userId)`.
/// @extends BaseModel
model MfaRecoveryRequest {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  userId            String
  status            MfaRecoveryRequestStatus @default(PENDING)
  requestedAt       BigInt
  reviewedBy        String?
  reviewedAt        BigInt?
  scheduledUnlockAt BigInt?
  completedAt       BigInt?
  notes             String?                  @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

/// Append-only domain audit of the MFA recovery lifecycle: one row per status
/// transition (requested / approved / denied / completed), written in the SAME
/// transaction as the transition. `actorUserId` is the real actor — the
/// requester, the reviewing SuperAdmin, or (for the scheduled unlock) the
/// SuperAdmin whose approval it executes. Correlates with `AuditLog` through
/// `correlationId`. No foreign keys: an audit row outlives what it describes.
/// Not a business entity: never updated or deleted.
/// RLS: bypass-only (`app_rls_bypass()`); UPDATE/DELETE revoked from app_runtime.
/// @extends BaseModel
model MfaRecoveryAuditLog {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  requestId      String
  subjectUserId  String
  actorUserId    String
  action         String                    @db.VarChar(64)
  fromStatus     MfaRecoveryRequestStatus?
  toStatus       MfaRecoveryRequestStatus
  /// The real SuperAdmin when the actor acted through an impersonation session.
  impersonatorId String?
  correlationId  String?                   @db.VarChar(64)
  ipAddress      String?                   @db.VarChar(64)
  userAgent      String?                   @db.VarChar(512)

  @@index([requestId, createdAt])
  @@index([subjectUserId])
}

/// One device session: the refresh token a signed-in device holds (rotated in place on every refresh,
/// so `id` is the stable session id — the `sid` claim of its access tokens, ADR 034).
/// Client-reported details (browser, OS, device model and name, app version) are display-only,
/// length-limited and zod-validated before storage; they never influence authorization.
/// Columns that are NULL on a session created before piece 4 of the mobile plan stay NULL.
/// RLS: own row — `app_owns("userId")`.
/// @extends BaseModel
model RefreshToken {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  token             String  @db.Text
  previousTokenHash String? @db.Text
  rotationVersion   Int     @default(0)
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The app that signed in (server-classified from `X-Client-Type`).
  clientType      SessionClientType?
  /// Browser / HTTP client parsed from the User-Agent (`Chrome`, `CFNetwork`).
  browserName     String?              @db.VarChar(64)
  browserVersion  String?              @db.VarChar(32)
  /// Operating system parsed from the User-Agent (`macOS`, `iOS`).
  osName          String?              @db.VarChar(64)
  osVersion       String?              @db.VarChar(32)
  /// Device class parsed from the User-Agent.
  deviceType      DeviceType?
  /// Device model: `X-Device-Model` for client type mobile, else the User-Agent's model (`iPhone 15 Pro`, `Pixel 8`).
  deviceModel     String?              @db.VarChar(64)
  /// The device's own name (`X-Device-Name`, client type mobile only).
  deviceName      String?              @db.VarChar(64)
  /// The mobile app's version (`X-App-Version`, client type mobile only).
  appVersion      String?              @db.VarChar(64)
  /// The login flow that created the session.
  signInMethod    SessionSignInMethod?
  /// Request IP at sign-in.
  ipAddress       String?              @db.VarChar(45)
  /// Request IP of the most recent refresh.
  lastIpAddress   String?              @db.VarChar(45)
  /// Set at sign-in and on every refresh.
  lastActiveAt    BigInt               @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  /// Location of the sign-in IP from the `SessionLocationResolver` port (ISO 3166-1 alpha-2); NULL while the port resolves nothing.
  locationCountry String?              @db.VarChar(2)
  locationRegion  String?              @db.VarChar(64)
  locationCity    String?              @db.VarChar(128)

  expiresAt BigInt

  @@index([userId])
  /// `GET /auth/sessions` default order (most recently active first) within one user.
  @@index([userId, lastActiveAt(sort: Desc), id(sort: Desc)])
  @@index([token])
}

// ---------------------------------------------------------------------------
// Impersonation Audit Log
// ---------------------------------------------------------------------------

/// RLS: INSERT + SELECT need `app_rls_bypass()`; UPDATE/DELETE revoked for `app_runtime` (immutable audit).
/// @extends BaseModel
model ImpersonationAuditLog {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  impersonatorId String
  targetUserId   String
  action         String // "START" | "STOP"
  ipAddress      String? @db.VarChar(45)
  userAgent      String? @db.Text
  /// The server-side impersonation session this START/STOP row belongs to.
  sessionId      String?

  impersonator User                  @relation("Impersonator", fields: [impersonatorId], references: [id], onDelete: Cascade)
  targetUser   User                  @relation("ImpersonationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  session      ImpersonationSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([impersonatorId])
  @@index([targetUserId])
  @@index([sessionId])
  @@index([createdAt])
}

/// Why an impersonation session ended before its `expiresAt`.
enum ImpersonationSessionEndReason {
  /// The super-admin stopped impersonating (`POST /auth/stop-impersonation`).
  STOPPED
}

/// Server-side record of one SuperAdmin impersonation session. The
/// impersonation access token carries this row's `id` as its
/// `impersonationSessionId` claim; `AuthGuard` rejects the token unless the
/// row exists, matches the token's impersonator + target, has not ended, has
/// not expired, and the impersonator is still an active, non-deleted
/// SuperAdmin. Stopping ends the row with a compare-and-set on `endedAt IS NULL`.
/// Rows are never deleted — an ended session is part of the forensic record.
/// RLS: bypass-only (`app_rls_bypass()`): written under `platform.superadmin` /
/// `route.rls_bypass`, read by `AuthGuard` under `request.pre_handler`.
/// @extends BaseModel
model ImpersonationSession {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  impersonatorId String
  targetUserId   String
  startedAt      BigInt
  expiresAt      BigInt
  endedAt        BigInt?
  endedBy        String?
  endReason      ImpersonationSessionEndReason?
  ipAddress      String?                        @db.VarChar(45)
  userAgent      String?                        @db.Text

  impersonator User                    @relation("ImpersonationSessionImpersonator", fields: [impersonatorId], references: [id], onDelete: Restrict)
  targetUser   User                    @relation("ImpersonationSessionTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  auditLogs    ImpersonationAuditLog[]

  @@index([impersonatorId, endedAt])
  @@index([targetUserId])
}

/// RLS: via user ownership.
/// @extends BaseModel
model UserAvatar {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
