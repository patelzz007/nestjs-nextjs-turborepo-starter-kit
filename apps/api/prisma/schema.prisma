// ============================================================================
// Kanban
// ============================================================================
// The platform staff's two linked boards (apps/api/src/contexts/kanban): a
// PLANNING board of epics and features and an EXECUTION board of stories and
// their tasks, joined by each item's parent. Every table is bypass-only under
// RLS: reached through `kanban.board.read` / `kanban.board.write` after the
// KANBAN_TASK permission check. Positions are 0-based per board (columns) and
// per column (items), rewritten under the board's advisory lock, so they never collide.

/// Which board a column belongs to (shared `KanbanBoardKindSchema`).
enum KanbanBoardKind {
  PLANNING
  EXECUTION
}

/// What a column stands for in the workflow (shared `KanbanColumnKindSchema`): the card reads it.
enum KanbanColumnKind {
  BACKLOG
  REFINING
  READY
  PLANNED
  IN_PROGRESS
  REVIEW
  DONE
}

/// An item's level in the hierarchy (shared `KanbanItemTypeSchema`): EPIC → FEATURE → STORY → TASK → SUBTASK.
/// Epics and features live on the PLANNING board; stories, tasks and subtasks on the EXECUTION board.
/// The levels below a subtask (sub-subtask, sub-sub-subtask) are its nested checklist (`STEPS`).
enum KanbanItemType {
  EPIC
  FEATURE
  STORY
  TASK
  SUBTASK
}

/// A planning column's stage (shared `KanbanPlanningStageSchema`). Columns are renamed freely; the stage never changes.
enum KanbanPlanningStage {
  BACKLOG
  REFINING
  READY
  PLANNED
  DELIVERED
}

/// An execution column's work state (shared `KanbanWorkStateSchema`). Columns are renamed freely; the state never changes.
enum KanbanWorkState {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

/// One stage of the one-off board conversion (`pnpm db:kanban-convert`), in the order it runs.
enum KanbanConversionStep {
  /// Level counters seeded and every item given its key, in creation order.
  KEYS
  /// The shared columns split into planning and execution columns.
  COLUMNS
  /// Planning items in the retired "In progress" stage moved to Refining or Ready.
  PLANNING_TRIAGE
  /// Each task's subtask checklist turned into subtask items.
  CHECKLISTS
}

/// Which list of an item a checklist row belongs to (shared `KanbanChecklistKindSchema`).
enum KanbanChecklistKind {
  /// Retired: a task's checklist breakdown before subtasks became items. The conversion script turns
  /// these rows into SUBTASK items and their steps; migration 2 drops the value.
  SUBTASKS
  /// A subtask's breakdown: sub-subtask (depth 0), sub-sub-subtask (1).
  STEPS
  /// A feature's or story's acceptance criteria (always depth 0).
  ACCEPTANCE_CRITERIA
}

/// How two items are linked, stored one way round: `BLOCKS` reads "source blocks target".
enum KanbanLinkKind {
  BLOCKS
  RELATES_TO
}

/// What an activity row records (shared `KanbanActivityKindSchema`).
enum KanbanActivityKind {
  CREATED
  UPDATED
  MOVED
  COMMENTED
  ATTACHED
  DETACHED
  LINKED
  UNLINKED
  CHECKED
  UNCHECKED
}

/// The field an `UPDATED` activity row changed (shared `KanbanActivityFieldSchema`).
enum KanbanActivityField {
  TITLE
  DESCRIPTION
  PRIORITY
  TEAM
  START
  DUE
  STORY_POINTS
  PROGRESS
  ASSIGNEE
  PARENT
  LABELS
  SUBTASKS
  STEPS
  ACCEPTANCE_CRITERIA
}

enum KanbanTaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum KanbanTeam {
  BACKEND
  DATA
  DESIGN
  PLATFORM
  PRODUCT
  QA
  SECURITY
}

/// A PDF is a `DOCUMENT`; an image is an `ATTACHMENT` — decided from the stored file's type.
enum KanbanAttachmentKind {
  ATTACHMENT
  DOCUMENT
}

/// Retired: the column both boards shared before the planning/execution split. Read only by the
/// conversion script (`pnpm db:kanban-convert`); migration 2 drops it with `KanbanTask.columnId`.
/// @extends BaseModel
model KanbanColumn {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  /// The board the column belongs to; existing rows predate the planning board.
  board    KanbanBoardKind  @default(EXECUTION)
  title    String           @db.VarChar(60)
  kind     KanbanColumnKind
  /// 0-based place on its board among the board's live columns.
  position Int
  /// Soft work-in-progress limit: the board warns when the column holds more live items. NULL = no limit.
  wipLimit Int?
  /// Optimistic-lock token: a column move or edit must send the version it read; each one increments it.
  version  Int              @default(0)

  tasks KanbanTask[]

  @@index([board, isDeleted, position])
}

/// One planning-board column (epics and features), left to right by `position`. Planning has no WIP limit.
/// @extends BaseModel
model KanbanPlanningColumn {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  title    String              @db.VarChar(60)
  /// What the column stands for; renaming the column never changes it.
  stage    KanbanPlanningStage
  /// 0-based place on the planning board among its live columns.
  position Int
  /// Optimistic-lock token: a column move must send the version it read; each one increments it.
  version  Int                 @default(0)

  tasks KanbanTask[] @relation("KanbanTaskPlanningColumn")

  @@index([isDeleted, position])
}

/// One execution-board column (stories, tasks and subtasks), left to right by `position`.
/// @extends BaseModel
model KanbanExecutionColumn {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  title    String          @db.VarChar(60)
  /// What the column stands for; renaming the column never changes it.
  state    KanbanWorkState
  /// 0-based place on the execution board among its live columns.
  position Int
  /// Soft work-in-progress limit on stories and tasks (subtasks never count). NULL = no limit.
  wipLimit Int?
  /// Optimistic-lock token: a column move or edit must send the version it read; each one increments it.
  version  Int             @default(0)

  tasks KanbanTask[] @relation("KanbanTaskExecutionColumn")

  @@index([isDeleted, position])
}

/// The last key number handed out per level (`STORY-142` → 142). Incremented in the transaction that
/// creates the item, so a number is never handed out twice — nor reused after a soft delete.
/// @extends BaseModel
model KanbanLevelCounter {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  level      KanbanItemType @unique
  lastNumber Int            @default(0)
}

/// A finished stage of the one-off board conversion (`pnpm db:kanban-convert`): its resume marker and report.
/// @extends BaseModel
model KanbanConversionStage {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
