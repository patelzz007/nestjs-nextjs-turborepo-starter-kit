/// Outbox row lifecycle. FAILED is the dead-letter state (malformed envelope or retries exhausted) —
/// an operator re-queues a row by setting it back to PENDING (docs/technical/messaging.md).
enum OutboxEventStatus {
  PENDING
  PUBLISHED
  FAILED
}

/// Transactional outbox for durable Kafka publishing (docs/adr/015-transactional-outbox-and-inbox.md).
/// Rows are INSERTed in the SAME transaction as the domain change they describe; `id` is the stable
/// event id carried on the wire (`eventId`) so consumer inboxes can dedupe redeliveries.
/// RLS: append-only INSERT of fresh PENDING rows from any app session; read/update is bypass-only
/// (dispatcher, `outbox.publish` system operation). Seed: intentionally empty (runtime ledger).
model OutboxEvent {
  id            String            @id @default(uuid())
  topic         String            @db.VarChar(100)
  eventType     String            @map("event_type") @db.VarChar(100)
  partitionKey  String?           @map("partition_key") @db.VarChar(255)
  correlationId String?           @map("correlation_id") @db.VarChar(64)
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  lastError     String?           @map("last_error") @db.Text
  /// Epoch ms before which the dispatcher must not claim the row: set to a lease on claim and to the
  /// exponential-backoff deadline after a failed publish.
  availableAt   BigInt            @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("available_at")
  publishedAt   BigInt?           @map("published_at")
  createdAt     BigInt            @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt     BigInt            @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  @@index([status, createdAt])
  @@index([status, availableAt])
  @@map("outbox_events")
}

/// Consumer inbox (idempotency ledger) — one row per (consumer, event id) a Kafka consumer has
/// applied. Written in the SAME transaction as the consumer's side effect with
/// `INSERT … ON CONFLICT DO NOTHING`; the composite primary key is the dedupe guarantee, so a
/// redelivered or republished event is applied exactly once per consumer.
/// RLS: bypass-only infrastructure table. Seed: intentionally empty (runtime ledger).
model InboxProcessedEvent {
  consumer    String @db.VarChar(100)
  eventId     String @map("event_id") @db.Uuid
  topic       String @db.VarChar(100)
  eventType   String @map("event_type") @db.VarChar(100)
  processedAt BigInt @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("processed_at")

  @@id([consumer, eventId])
  @@index([processedAt])
  @@map("inbox_processed_events")
}

/// Why a consumer parked a Kafka message instead of applying it.
enum InboxDeadLetterReason {
  EMPTY_MESSAGE
  MALFORMED_JSON
  SCHEMA_VIOLATION
  PERMANENT_PROCESSING_ERROR
  /// A transient failure (connection loss, timeout, deadlock, …) outlasted the bounded retry budget.
  RETRIES_EXHAUSTED
}

/// Poison messages a Kafka consumer could not apply. Parking (instead of throwing) keeps the
/// partition flowing; the unique Kafka coordinates make re-parking the same record a no-op.
/// Operators inspect `raw_value` / `error`, fix the cause, and replay (docs/technical/messaging.md);
/// the consumer purges rows older than ANALYTICS_DEAD_LETTER_RETENTION_DAYS.
/// RLS: app_runtime bypass + the least-privilege analytics_consumer role (prisma/rls/90-analytics-consumer.sql).
/// Seed: the development scenario parks one sample record (prisma/seed).
model InboxDeadLetter {
  id                String                @id @default(uuid())
  consumer          String                @db.VarChar(100)
  topic             String                @db.VarChar(255)
  partition         Int
  /// Kafka offsets are int64 — stored as their decimal string form.
  offset            String                @db.VarChar(32)
  /// Stable event id when the message parsed far enough to carry one.
  eventId           String?               @map("event_id") @db.Uuid
  reason            InboxDeadLetterReason
  /// Why it was parked (bounded; a cut is marked with the original length).
  error             String                @db.Text
  /// Processing attempts made before parking (1 when the record could not be decoded).
  attempts          Int                   @default(1)
  /// Raw message value as bytes (binary-safe) for diagnosis and replay — whole unless
  /// `raw_value_truncated`; null for a tombstone.
  rawValue          Bytes?                @map("raw_value")
  /// Size of the ORIGINAL value in bytes (also when the stored copy is truncated).
  rawValueSizeBytes Int?                  @map("raw_value_size_bytes")
  /// SHA-256 (hex) of the ORIGINAL value — verifies a replay / identifies a truncated copy.
  rawValueSha256    String?               @map("raw_value_sha256") @db.Char(64)
  /// True when `raw_value` holds only the first ANALYTICS_DEAD_LETTER_MAX_PAYLOAD_BYTES bytes.
  rawValueTruncated Boolean               @default(false) @map("raw_value_truncated")
  receivedAt        BigInt                @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("received_at")

  @@unique([consumer, topic, partition, offset])
  @@index([consumer, receivedAt])
  @@map("inbox_dead_letters")
}

/// Analytics staging table populated by the analytics-consumer service.
model AnalyticsEvent {
  id            String  @id @default(uuid())
  topic         String  @db.VarChar(100)
  eventType     String  @map("event_type") @db.VarChar(100)
  correlationId String? @map("correlation_id") @db.VarChar(64)
  partitionKey  String? @map("partition_key") @db.VarChar(255)
  payload       Json
  occurredAt    BigInt  @map("occurred_at")
  ingestedAt    BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("ingested_at")

  @@index([topic, occurredAt])
  @@index([eventType, occurredAt])
  @@map("analytics_events")
}

/// Outcome of one audited HTTP request.
enum AuditOutcome {
  /// The handler completed and the response was sent with a 2xx/3xx status.
  SUCCEEDED
  /// The request failed (guard, validation, handler or server error) — `errorCode` says why.
  FAILED
}

/// How the caller of one audited HTTP request authenticated (NULL on the row = anonymous).
enum AuditAuthMethod {
  /// An access token sent as `Authorization: Bearer` (API clients, Swagger UI).
  BEARER_TOKEN
  /// The access-token cookie of a frontend session (web / admin / merchant cookie set).
  SESSION_COOKIE
  /// The refresh-token cookie of a browser client type (`/auth/refresh`, logout).
  REFRESH_COOKIE
  /// The refresh token in the request body (`{ refreshToken }`, client type `mobile` — ADR 029).
  REFRESH_BODY
  /// A machine API key (merchant POS terminals).
  API_KEY
}

/// What kind of address an audited request came from (IANA special-purpose registries).
enum IpAddressScope {
  /// Globally routable — a real client on the internet.
  PUBLIC
  /// RFC 1918 / RFC 4193 private network (10/8, 172.16/12, 192.168/16, fc00::/7).
  PRIVATE
  /// The machine itself (127/8, ::1).
  LOOPBACK
  /// Link-local (169.254/16, fe80::/10).
  LINK_LOCAL
  /// Carrier-grade NAT shared address space (100.64/10, RFC 6598).
  SHARED
  /// Documentation / benchmarking ranges (192.0.2/24, 198.51.100/24, 203.0.113/24, 198.18/15, 2001:db8::/32).
  DOCUMENTATION
  /// Multicast (224/4, ff00::/8).
  MULTICAST
  /// Any other IANA-reserved range (0/8, 240/4, 255.255.255.255, ::).
  RESERVED
}

/// Global HTTP audit trail (rules/10 → "Audit logging", docs/adr/025-global-http-audit-log.md):
/// exactly one append-only row per HTTP request (every method — reads included; only the health
/// probes and SSE streams are exempt), successful or failed, written by `AuditLogInterceptor` (success) / `GlobalExceptionFilter` (failure) under
/// the `audit.http_request.record` system operation — or inside the handler's own transaction
/// when the handler opts in (`AuditTrailService.recordInTransaction`). Bodies are redacted
/// (common/logging/redaction.ts) and size-capped before they are stored.
/// Domain audit tables (organization_audit_logs, reward_audit_logs, permission_audit_logs,
/// impersonation_audit_logs, authorization_audits) keep their domain events; they correlate with
/// this table through `correlation_id`. No foreign keys: an audit row outlives what it describes.
/// The organization is the tenant in this platform, so there is no separate tenant column.
/// RLS: INSERT only under a named system operation (or by the acting user inside their own
/// transaction); SELECT bypass-only; UPDATE/DELETE revoked from app_runtime (append-only).
/// Read by the admin audit viewer (`GET /admin/audit-logs`) under `audit.http_request.read`,
/// after the AUDIT_LOG permission check. Request-metadata columns added after the table was
/// created (trace id onwards) are NULL on rows written before them.
/// Not a business entity: never soft-deleted, never updated. Seed: prisma/seed/http-audit.ts.
model AuditLog {
  id                     String           @id @default(uuid())
  correlationId          String           @map("correlation_id") @db.VarChar(64)
  /// Distributed trace id (equal to `correlationId` until W3C trace context is propagated).
  traceId                String?          @map("trace_id") @db.VarChar(64)
  /// Request start (epoch ms).
  occurredAt             BigInt           @map("occurred_at")
  /// When the outcome was known (epoch ms).
  completedAt            BigInt           @map("completed_at")
  method                 String           @db.VarChar(10)
  /// Route template (`/api/v1/geo/regions/:id`) — groups requests by endpoint.
  endpoint               String           @db.VarChar(512)
  /// Concrete request URL with sensitive query parameters redacted.
  path                   String           @db.VarChar(2048)
  outcome                AuditOutcome
  responseStatus         Int              @map("response_status")
  /// Machine error code (`errorCode` of the error envelope) for FAILED rows.
  errorCode              String?          @map("error_code") @db.VarChar(64)
  actorUserId            String?          @map("actor_user_id") @db.VarChar(64)
  /// The real (super-admin) user behind an impersonation session.
  impersonatorUserId     String?          @map("impersonator_user_id") @db.VarChar(64)
  /// The server-side impersonation session (`impersonation_sessions.id`) the request ran under.
  impersonationSessionId String?          @map("impersonation_session_id") @db.VarChar(64)
  /// How the caller authenticated; NULL for an anonymous request.
  authMethod             AuditAuthMethod? @map("auth_method")
  apiKeyId               String?          @map("api_key_id") @db.VarChar(64)
  terminalId             String?          @map("terminal_id") @db.VarChar(64)
  organizationId         String?          @map("organization_id") @db.VarChar(64)
  storeId                String?          @map("store_id") @db.VarChar(64)
  locationId             String?          @map("location_id") @db.VarChar(64)
  ipAddress              String?          @map("ip_address") @db.VarChar(64)
  /// The calling device (User-Agent, bounded).
  userAgent              String?          @map("user_agent") @db.VarChar(512)
  /// Browser / HTTP client parsed from the User-Agent (`Chrome`, `Safari`, `curl`).
  browserName            String?          @map("browser_name") @db.VarChar(64)
  browserVersion         String?          @map("browser_version") @db.VarChar(32)
  /// Operating system parsed from the User-Agent (`macOS`, `Android`).
  osName                 String?          @map("os_name") @db.VarChar(64)
  osVersion              String?          @map("os_version") @db.VarChar(32)
  /// Device class parsed from the User-Agent.
  deviceType             DeviceType?      @map("device_type")
  /// Device model when the User-Agent names one (`iPhone`, `Pixel 8`, `SM-S918B`).
  deviceModel            String?          @map("device_model") @db.VarChar(64)
  /// 4 or 6.
  ipVersion              Int?             @map("ip_version") @db.SmallInt
  /// Address class of `ipAddress` (public, private, loopback, …).
  ipScope                IpAddressScope?  @map("ip_scope")
  /// ISO 3166-1 alpha-2 country of the client, from the CDN edge's geo headers (trusted proxies only).
  geoCountry             String?          @map("geo_country") @db.VarChar(2)
  /// Region / subdivision from the CDN edge (`14`, `Selangor`).
  geoRegion              String?          @map("geo_region") @db.VarChar(64)
  /// City from the CDN edge.
  geoCity                String?          @map("geo_city") @db.VarChar(128)
  /// IANA time zone from the CDN edge (`Asia/Kuala_Lumpur`).
  geoTimeZone            String?          @map("geo_time_zone") @db.VarChar(64)
  /// The frontend the caller CLAIMS to be (`X-Client-Type`, bounded, unverified — e.g. web / admin / merchant).
  clientType             String?          @map("client_type") @db.VarChar(32)
  /// HTTP protocol version of the connection (`1.1`, `2.0`).
  httpVersion            String?          @map("http_version") @db.VarChar(8)
  /// `Host` the request was addressed to.
  host                   String?          @db.VarChar(255)
  /// `Origin` header (browser requests).
  origin                 String?          @db.VarChar(512)
  /// `Referer` header, with sensitive query parameters redacted.
  referer                String?          @db.VarChar(2048)
  /// `Accept-Language` header.
  acceptLanguage         String?          @map("accept_language") @db.VarChar(256)
  /// `Content-Type` of the request body.
  requestContentType     String?          @map("request_content_type") @db.VarChar(256)
  /// Declared request body size (`Content-Length`, bytes).
  requestBytes           Int?             @map("request_bytes")
  /// `Idempotency-Key` header the request carried (joins the idempotency record).
  idempotencyKey         String?          @map("idempotency_key") @db.VarChar(255)
  /// Route params + query string (redacted).
  requestParams          Json?            @map("request_params")
  requestBody            Json?            @map("request_body")
  responseBody           Json?            @map("response_body")
  /// Allowlisted system operations (RLS bypasses) the request ran, in first-use order.
  systemOperations       String[]         @map("system_operations")
  createdAt              BigInt           @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")

  @@index([organizationId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([impersonatorUserId, occurredAt])
  @@index([outcome, occurredAt])
  @@index([deviceType, occurredAt])
  @@index([correlationId])
  /// Trigram GIN indexes serve the viewer's case-insensitive `?search=` (ILIKE '%…%') without a scan.
  @@index([path(ops: raw("gin_trgm_ops"))], map: "audit_logs_path_trgm_idx", type: Gin)
  @@index([endpoint(ops: raw("gin_trgm_ops"))], map: "audit_logs_endpoint_trgm_idx", type: Gin)
  @@index([errorCode(ops: raw("gin_trgm_ops"))], map: "audit_logs_error_code_trgm_idx", type: Gin)
  @@index([ipAddress(ops: raw("gin_trgm_ops"))], map: "audit_logs_ip_address_trgm_idx", type: Gin)
  @@index([userAgent(ops: raw("gin_trgm_ops"))], map: "audit_logs_user_agent_trgm_idx", type: Gin)
  @@index([occurredAt])
  @@map("audit_logs")
}

/// Lifecycle of an idempotency record (platform/idempotency, docs/technical/api/routes.md → Idempotency).
enum IdempotencyRecordStatus {
  /// A request holding this key is executing; duplicates get 409 IDEMPOTENCY_REQUEST_IN_PROGRESS until `expiresAt` (the lease).
  IN_PROGRESS
  /// The response is stored in `responseBody` and replayed for identical requests until `expiresAt`.
  COMPLETED
}

/// Idempotency records for `@Idempotent()` HTTP endpoints.
/// Ephemeral infrastructure state (not a business entity): an expired row is
/// taken over in place by the next request with the same key — never deleted.
model PlatformResourceIdempotencyRecord {
  id             String                  @id @default(uuid())
  scope          String                  @db.VarChar(200)
  idempotencyKey String                  @map("idempotency_key") @db.VarChar(128)
  requestHash    String                  @map("request_hash") @db.VarChar(128)
  status         IdempotencyRecordStatus
  /// Fencing token of the request that holds (or last held) the lease: complete/release only
  /// succeed for the holder, so a request whose lease expired can never overwrite its successor.
  leaseToken     String                  @map("lease_token") @db.Uuid
  /// Null while IN_PROGRESS.
  responseBody   Json?                   @map("response_body")
  /// IN_PROGRESS: lease end (a crashed request frees the key). COMPLETED: end of the replay window.
  /// Always set explicitly by the app (no default).
  expiresAt      BigInt                  @map("expires_at")
  createdAt      BigInt                  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt      BigInt                  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  @@unique([scope, idempotencyKey], map: "platform_resource_idempotency_scope_key")
  @@index([expiresAt], map: "platform_resource_idempotency_expires_at_idx")
  @@map("platform_resource_idempotency_records")
}

/// Platform resource model (SampleCategory).
model SampleCategory {
  id          String    @id @default(uuid())
  description String?   @db.Text
  isActive    Boolean?  @map("is_active")
  name        String    @db.VarChar(200)
  slug        String    @db.VarChar(200)
  sortOrder   Int?      @map("sort_order")
  /// Optimistic-lock token: PATCH must send the version it read; every update increments it.
  version     Int       @default(0)
  deletedAt   BigInt?   @map("deleted_at")
  createdAt   BigInt    @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt   BigInt    @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")
  products    Product[]

  @@map("sample_category")
}

/// Platform resource model (Product).
model Product {
  id               String          @id @default(uuid())
  brand            String?         @db.VarChar(120)
  categoryId       String          @map("category_id")
  compareAtPrice   Decimal?        @map("compare_at_price") @db.Decimal(18, 2)
  description      String?         @db.Text
  imageUrl         String?         @map("image_url") @db.VarChar(2048)
  isActive         Boolean?        @map("is_active")
  isFeatured       Boolean?        @map("is_featured")
  name             String          @db.VarChar(200)
  price            Decimal         @db.Decimal(18, 2)
  shortDescription String?         @map("short_description") @db.VarChar(500)
  sku              String          @db.VarChar(64)
  slug             String          @db.VarChar(200)
  stockQuantity    Int?            @map("stock_quantity")
  weightGrams      Int?            @map("weight_grams")
  version          Int             @default(0)
  deletedAt        BigInt?         @map("deleted_at")
  createdAt        BigInt          @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt        BigInt          @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")
  category         SampleCategory? @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  storedFiles      StoredFile[]    @relation("StoredFileProduct")

  @@map("product")
}
