  customerBans TenantCustomerBan[]

  @@index([tenantId])
  @@index([locationId])
  @@index([userId])
  @@index([redeemedAt])
  @@index([saleId])
  /// Analytics: one merchant's redemptions in a range (series, totals, store / reward / method breakdowns).
  @@index([tenantId, redeemedAt])
  /// Analytics: one customer's redemptions in a range.
  @@index([userId, redeemedAt])
}

/// One paid POS bill on which a customer redeemed one or more rewards
/// (`POST /redemptions/checkout`). The source of every "sales" figure:
/// merchant/admin sales analytics and the customer's spending breakdown.
/// Money is stored in minor units (sen) with an explicit ISO-4217 currency.
/// RLS: tenant-owned (`tenantId`): members of the tenant read its sales, the customer (`userId`) reads
/// their own, and the tenant's API key reads and inserts (prisma/rls/40-api-key-principal.sql); every other
/// write is bypass-only (`app_rls_bypass_on('RewardSale')`).
/// @extends BaseModel
model RewardSale {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  tenantId       String
  /// The store the bill was paid at (store-scoped API key, else the registered terminal's store); null when unknown.
  locationId     String?
  /// The customer whose rewards were redeemed.
  userId         String
  terminalId     String  @db.VarChar(100)
  apiKeyId       String?
  /// Bill total in minor units (sen). 64-bit so platform-wide sums never overflow; the API carries
  /// amounts as JSON safe integers (≤ Number.MAX_SAFE_INTEGER) and refuses anything larger.
  billTotalMinor BigInt
  currency       String  @db.VarChar(3)
  idempotencyKey String  @db.VarChar(64)
  /// sha256 of the canonical request — a retried key with a different payload is rejected, never replayed.
  requestHash    String  @db.VarChar(64)
  paidAt         BigInt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location    Location?          @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  apiKey      TenantApiKey?      @relation(fields: [tenantId, apiKeyId], references: [tenantId, id], onDelete: Restrict)
  redemptions RewardRedemption[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, paidAt])
  @@index([userId, paidAt])
  @@index([locationId])
  @@index([paidAt])
}

