/// Malware-scan state of a stored file (`StoredObjectScanStatusSchema` in packages/shared).
/// NOT_SCANNED = no scanner configured (MALWARE_SCANNER=none); never presented as CLEAN.
enum KybDocumentScanStatus {
  SCANNING
  CLEAN
  INFECTED
  NOT_SCANNED
}

enum FileStatus {
  PENDING
  UPLOADED
  PROCESSING
  SCANNING
  READY
  FAILED
  QUARANTINED
  DELETED
}

enum FileCategory {
  PRODUCT_IMAGE
  STORE_LOGO
  STORE_BANNER
  USER_AVATAR
  MERCHANT_KYB
  /// A reward image (16:9, at least 4K) — uploaded to the organization, then listed in `RewardImage`.
  REWARD_IMAGE
  /// A picture an admin attaches to a GitHub comment from the app (ADR 052) — public, linked from the comment.
  GITHUB_COMMENT_IMAGE
}

enum FileVisibility {
  PUBLIC
  PRIVATE
}

enum StorageProvider {
  local
  s3
  firebase
}

/// Renditions of an image, smallest to largest; the widths of each category live in its shared `imageRules`.
enum FileVariantKind {
  ORIGINAL
  THUMBNAIL
  MEDIUM
  LARGE
  XLARGE
  UHD
}

/// RLS: owner-scoped via uploadedById and relation tables.
/// @extends BaseModel
model StoredFile {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  category         FileCategory
  visibility       FileVisibility
  originalName     String                 @db.VarChar(255)
  mimeType         String                 @db.VarChar(100)
  sizeBytes        Int
  expectedChecksum String                 @db.VarChar(64)
  actualChecksum   String?                @db.VarChar(64)
  storageProvider  StorageProvider?
  storageContainer String?                @db.VarChar(255)
  objectRevision   String?                @db.VarChar(64)
  storageBucket    String                 @db.VarChar(255)
  storagePath      String                 @db.VarChar(500)
  publicPath       String?                @db.VarChar(500)
  objectGeneration String?                @db.VarChar(64)
  /// Pixel size of an image upload, read from the stored bytes when it is verified (null for documents).
  imageWidth       Int?
  imageHeight      Int?
  status           FileStatus             @default(PENDING)
  scanStatus       KybDocumentScanStatus?
  scannedAt        BigInt?
  scanResult       String?                @db.VarChar(500)
  uploadedById     String
  organizationId   String?
  /// Product a PRODUCT_IMAGE upload is bound to (set at upload-url time, never parsed from the object path).
  productId        String?

  uploadedBy         User                  @relation("StoredFileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  organization       Organization?         @relation("StoredFileOrganization", fields: [organizationId], references: [id], onDelete: SetNull)
  product            Product?              @relation("StoredFileProduct", fields: [productId], references: [id], onDelete: SetNull)
  variants           FileVariant[]
  productImages      ProductImage[]
  organizationAssets OrganizationAsset[]
  userAvatar         UserAvatar?
  kybFiles           OrganizationKybFile[]
  rewardImages       RewardImage[]

  @@index([uploadedById])
  @@index([organizationId])
  @@index([productId])
