  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  stage       KanbanConversionStep @unique
  /// Epoch ms the stage committed.
  completedAt BigInt
  /// What the stage changed (counts and the item mapping), as the script printed it.
  report      Json
}

/// One card, top to bottom in its column by `position`. The person who creates it owns it.
/// @extends BaseModel
model KanbanTask {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  /// Retired shared column; NULL for items created after the planning/execution split. Dropped by migration 2.
  columnId          String?
  /// The planning column an epic or feature sits in; NULL for every other level.
  planningColumnId  String?
  /// The execution column a story, task or subtask sits in; NULL for epics and features.
  executionColumnId String?
  /// The item's key, its level and a number (`STORY-142`), from `KanbanLevelCounter`; never reused.
  /// NULL only on rows the conversion script has not keyed yet.
  key               String?            @unique @db.VarChar(24)
  /// The item's level; existing rows predate the hierarchy and were stories.
  type              KanbanItemType     @default(STORY)
  /// The item one level up (a feature's epic, a story's feature, a task's story); NULL = none.
  /// Required for a task; never set on an epic. Checked under the board lock.
  parentId          String?
  /// The reporter: who created the item.
  ownerId           String
  /// Who works on it; NULL = unassigned.
  assigneeId        String?
  title             String             @db.VarChar(120)
  description       String             @db.VarChar(2000)
  priority          KanbanTaskPriority
  team              KanbanTeam
  /// Epoch ms the item starts; NULL = no start date. A task has none: it inherits its story's.
  startAt           BigInt?
  /// Epoch ms the item is due; NULL = no due date. A task has none: it inherits its story's.
  dueAt             BigInt?
  /// Estimate in story points (`KANBAN_STORY_POINT_OPTIONS`); stories only, NULL = not estimated.
  /// Epics and features show the sum of their stories instead.
  storyPoints       Int?
  /// Percent complete, 0–100 (`KANBAN_TASK_PROGRESS_MAX`).
  progress          Int                @default(0)
  /// Lower-case labels (`KanbanLabelSchema`), at most `KANBAN_TASK_LABEL_LIMIT`.
  labels            String[]           @default([]) @db.VarChar(24)
  /// 0-based place in its column among live items.
  position          Int
  /// Optimistic-lock token: an edit or a move must send the version it read; each one increments it.
  version           Int                @default(0)

  column          KanbanColumn?          @relation(fields: [columnId], references: [id], onDelete: Restrict)
  planningColumn  KanbanPlanningColumn?  @relation("KanbanTaskPlanningColumn", fields: [planningColumnId], references: [id], onDelete: Restrict)
  executionColumn KanbanExecutionColumn? @relation("KanbanTaskExecutionColumn", fields: [executionColumnId], references: [id], onDelete: Restrict)
  parent          KanbanTask?            @relation("KanbanTaskHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        KanbanTask[]           @relation("KanbanTaskHierarchy")
  owner           User                   @relation("KanbanTaskOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  assignee        User?                  @relation("KanbanTaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  comments        KanbanTaskComment[]
  attachments     KanbanTaskAttachment[]
  checklist       KanbanChecklistItem[]
  watchers        KanbanTaskWatcher[]
  outgoingLinks   KanbanTaskLink[]       @relation("KanbanTaskLinkSource")
  incomingLinks   KanbanTaskLink[]       @relation("KanbanTaskLinkTarget")
  activity        KanbanTaskActivity[]

  @@index([columnId, isDeleted, position])
  @@index([planningColumnId, isDeleted, position])
  @@index([executionColumnId, isDeleted, position])
  @@index([parentId, isDeleted])
  @@index([ownerId])
  @@index([assigneeId])
}

/// A comment on a task, newest first on the task page.
/// @extends BaseModel
model KanbanTaskComment {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
