generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Row Level Security (Postgres)
//
// Prisma 7 PSL cannot emit CREATE ROLE, GRANT, ENABLE/FORCE RLS, or POLICY.
// Those statements live at the **bottom** of `migrations/20260818235200_init`
// and MUST stay there when this folder is squashed or regenerated.
//
// Schema-owned pieces (columns, indexes, maps) always land in this file first.
//
// Runtime (apps/api):
//   - Role `app_runtime` (NOLOGIN NOSUPERUSER NOINHERIT NOBYPASSRLS)
//   - GRANT USAGE ON SCHEMA public + table DML to app_runtime (PG 15+ public
//     schema has no PUBLIC grants — without this, SET ROLE fails with 42501)
//   - RlsPool: SET ROLE app_runtime on every checkout
//   - Session: app.current_user_id, app.rls_bypass (RlsInterceptor ALS)
//   - Helpers: app_rls_bypass(), app_current_user_id(), app_owns(owner_id)
// See docs/prisma.md §10.
// ---------------------------------------------------------------------------

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum RedirectType {
  PERMANENT // 301
  TEMPORARY // 302
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  BOT
  UNKNOWN
}

// Enums
enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  LIST
  MANAGE
}

enum PermissionResource {
  USER
  PROFILE
  ROLE
  PERMISSION
  ADMIN_DASHBOARD
  SYSTEM_SETTINGS
  URL
  TAG
  API_KEY
  ANALYTICS
  AUDIT_LOG
  REPORT
  EMAIL
  GEO
  REWARD
  MERCHANT_ORG
  REDEMPTION
}

// Tables
/// RLS: own row — `app_owns(id)`. Public login/signup uses bypass.
model User {
  id           String  @id @default(uuid())
  fullName     String  @db.VarChar(100)
  email        String  @unique @db.VarChar(100)
  passwordHash String  @db.Text
  isActive     Boolean @default(true)
  isSuperAdmin Boolean @default(false)

  // Incremented on every role/permission mutation. The JWT carries this
  // value; the AuthorizationGuard rejects tokens with a stale version,
  // forcing the user to re-login (or refresh) after an authorization
  // change — without needing Redis or a token blacklist.
  tokenVersion Int @default(0) @map("token_version")

  failedLoginAttempts Int     @default(0) @map("failed_login_attempts")
  lockedUntil         BigInt? @map("locked_until")

  provider          String? // "google" | "github" | null
  providerId        String? @map("provider_id")
  plan              Plan    @default(FREE)
  monthlyUrlLimit   Int     @default(50) @map("monthly_url_limit")
  monthlyClickLimit Int     @default(10000) @map("monthly_click_limit")

  // Relations
  refreshTokens   RefreshToken[]
  userRoles       UserRole[]
  userPermissions UserPermission[]

  emailVerifiedAt     BigInt?                 @map("email_verified_at")
  phone               String?                 @db.VarChar(20)
  phoneVerifiedAt     BigInt?                 @map("phone_verified_at")
  lastLoginAt         BigInt?                 @map("last_login_at")
  pendingAttributionToken      String?        @map("pending_attribution_token") @db.VarChar(64)
  pendingAttributionExpiresAt  BigInt?        @map("pending_attribution_expires_at")
  isDeleted           Boolean                 @default(false) @map("is_deleted")
  deletedAt           BigInt?                 @map("deleted_at")
  createdAt           BigInt                  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  updatedAt           BigInt                  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  urls                Url[]
  tags                Tag[]
  apiKeys             ApiKey[]
  passwordResetTokens PasswordResetToken[]
  impersonatedBy      ImpersonationAuditLog[] @relation("Impersonator")
  impersonatedUser    ImpersonationAuditLog[] @relation("ImpersonationTarget")

  merchantMembers            MerchantMember[]
  merchantApiKeysCreated     MerchantApiKey[]         @relation("MerchantApiKeyCreator")
  merchantInvitesCreated     MerchantInvite[]         @relation("MerchantInviteCreator")
  merchantInvitesAccepted    MerchantInvite[]         @relation("MerchantInviteAcceptor")
  rewardClaims               RewardClaim[]
  rewardRedemptions          RewardRedemption[]
  rewardReferralsAsReferrer  RewardReferral[]         @relation("ReferrerUser")
  rewardReferralsAsReferee   RewardReferral[]         @relation("RefereeUser")
  rewardOtpChallenges        RewardOtpChallenge[]
  rewardLegalAcceptances     RewardLegalAcceptance[]
  rewardNotifications        RewardNotification[]
  rewardAuditLogs            RewardAuditLog[]

  @@unique([provider, providerId])
  @@index([pendingAttributionToken])
  @@map("users")
}

/// RLS: catalog — SELECT true; writes need `app_rls_bypass()`.
model Role {
  id          String  @id @default(uuid())
  name        String  @unique @db.VarChar(100)
  description String? @db.Text
  isActive    Boolean @default(true)

  // Self-referential hierarchy — a role can inherit permissions from a parent role.
  parentId String? @map("parent_id")
  parent   Role?   @relation("RoleHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Role[]  @relation("RoleHierarchy")

  // Relations
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  menuItemRoles   MenuItemRole[]

  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  updatedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))

  @@index([parentId])
  @@map("roles")
}

/// RLS: catalog — SELECT true; writes need `app_rls_bypass()`.
model Permission {
  id          String             @id @default(uuid())
  action      PermissionAction
  resource    PermissionResource
  description String?            @db.Text

  group      String? @db.VarChar(100)
  isSystem   Boolean @default(false)
  conditions Json?

  // Relations
  rolePermissions     RolePermission[]
  userPermissions     UserPermission[]
  menuItemPermissions MenuItemPermission[]

  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  updatedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))

  @@unique([action, resource])
  @@map("permissions")
}

// ---------------------------------------------------------------------------
// Permission Audit Trail
// ---------------------------------------------------------------------------

/// RLS: bypass only (`app_rls_bypass()`).
model PermissionAuditLog {
  id           String  @id @default(uuid())
  actorId      String  @map("actor_id")
  targetUserId String? @map("target_user_id")
  targetRoleId String? @map("target_role_id")
  permissionId String? @map("permission_id")
  action       String
  detail       String? @db.Text
  isDeleted    Boolean @default(false) @map("is_deleted")
  deletedAt    BigInt? @map("deleted_at")
  createdAt    BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt    BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  @@index([actorId])
  @@index([targetUserId])
  @@index([targetRoleId])
  @@index([createdAt])
  @@map("permission_audit_logs")
}

// ---------------------------------------------------------------------------
// Sidebar / Menu
// ---------------------------------------------------------------------------

enum MenuMatchType {
  ANY
  ALL
}

/// RLS: catalog — SELECT true; writes need `app_rls_bypass()`.
model MenuItem {
  id       String  @id @default(uuid())
  name     String  @db.VarChar(100)
  label    String? @db.VarChar(100)
  icon     String? @db.VarChar(50)
  path     String? @db.VarChar(255)
  parentId String? @map("parent_id")
  order    Int     @default(0)
  isActive Boolean @default(true) @map("is_active")

  parent   MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children MenuItem[] @relation("MenuHierarchy")

  menuItemPermissions MenuItemPermission[]
  menuItemRoles       MenuItemRole[]

  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  updatedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))

  @@index([parentId])
  @@map("menu_items")
}

/// RLS: catalog — SELECT true; writes need `app_rls_bypass()`.
model MenuItemPermission {
  id           String        @id @default(uuid())
  menuItemId   String        @map("menu_item_id")
  permissionId String        @map("permission_id")
  matchType    MenuMatchType @default(ANY) @map("match_type")

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  updatedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))

  @@unique([menuItemId, permissionId])
  @@map("menu_item_permissions")
}

/// RLS: catalog — SELECT true; writes need `app_rls_bypass()`.
model MenuItemRole {
  id         String @id @default(uuid())
  menuItemId String @map("menu_item_id")
  roleId     String @map("role_id")

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  updatedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))

  @@unique([menuItemId, roleId])
  @@map("menu_item_roles")
}

// ---------------------------------------------------------------------------
// Password Reset Tokens
// ---------------------------------------------------------------------------

/// RLS: own row — `app_owns(user_id)`.
model PasswordResetToken {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  token     String  @unique @db.Text
  expiresAt BigInt  @map("expires_at")
  usedAt    BigInt? @map("used_at")
  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

/// RLS: own row — `app_owns("userId")`.
model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  assignedBy String?

  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  updatedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))

  @@unique([userId, roleId])
  @@map("user_roles")
}

/// RLS: own row — `app_owns("userId")`.
model UserPermission {
  id           String @id @default(uuid())
  userId       String
  permissionId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  assignedBy String?
  expiresAt  BigInt?

  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  updatedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

/// RLS: catalog — SELECT true; writes need `app_rls_bypass()`.
model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  assignedBy String?

  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  updatedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

/// RLS: own row — `app_owns("userId")`.
model RefreshToken {
  id     String @id @default(uuid())
  token  String @db.Text
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceInfo String? @db.VarChar(255)
  ipAddress  String? @db.VarChar(45)

  expiresAt BigInt
  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  updatedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

/// RLS: own row — `app_owns(user_id)`. Public redirects use bypass.
model Url {
  id           String       @id @default(uuid())
  userId       String?      @map("user_id")
  shortCode    String       @unique @map("short_code")
  customAlias  String?      @unique @map("custom_alias")
  originalUrl  String       @map("original_url") @db.Text
  title        String?
  redirectType RedirectType @default(TEMPORARY) @map("redirect_type")
  isActive     Boolean      @default(true) @map("is_active")
  passwordHash String?      @map("password_hash")
  clickLimit   Int?         @map("click_limit")
  clickCount   Int          @default(0) @map("click_count")
  expiresAt    BigInt?      @map("expires_at")
  isDeleted    Boolean      @default(false) @map("is_deleted")
  deletedAt    BigInt?      @map("deleted_at")
  createdAt    BigInt       @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt    BigInt       @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  user   User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  clicks Click[]
  tags   UrlTag[]

  @@index([shortCode])
  @@index([userId])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("urls")
}

/// RLS: own row — `app_owns(user_id)`.
model Tag {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  name      String
  color     String  @default("#6366f1")
  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  urls UrlTag[]

  @@unique([userId, name])
  @@map("tags")
}

/// RLS: via parent url — `app_owns(urls.user_id)`.
model UrlTag {
  id    String @id @default(uuid())
  urlId String @map("url_id")
  tagId String @map("tag_id")

  url Url @relation(fields: [urlId], references: [id], onDelete: Cascade)
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  updatedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))

  @@unique([urlId, tagId])
  @@map("url_tags")
}

/// RLS: via parent url — `app_owns(urls.user_id)`.
model Click {
  id          String     @id @default(uuid())
  urlId       String     @map("url_id")
  ipAddress   String?    @map("ip_address")
  country     String?
  city        String?
  deviceType  DeviceType @default(UNKNOWN) @map("device_type")
  os          String?
  browser     String?
  referrer    String?    @db.Text
  utmSource   String?    @map("utm_source")
  utmMedium   String?    @map("utm_medium")
  utmCampaign String?    @map("utm_campaign")
  clickedAt   BigInt     @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("clicked_at")
  isDeleted   Boolean    @default(false) @map("is_deleted")
  deletedAt   BigInt?    @map("deleted_at")
  createdAt   BigInt     @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  updatedAt   BigInt     @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  url         Url        @relation(fields: [urlId], references: [id], onDelete: Cascade)

  @@index([urlId])
  @@index([clickedAt])
  @@index([urlId, clickedAt])
  @@map("clicks")
}

/// RLS: own row — `app_owns(user_id)`.
model ApiKey {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  name          String
  keyHash       String   @unique @map("key_hash")
  keyPrefix     String   @map("key_prefix")
  scopes        String[] @default(["read", "write"])
  rateLimitTier String   @default("standard") @map("rate_limit_tier")
  totalRequests Int      @default(0) @map("total_requests")
  lastUsedAt    BigInt?  @map("last_used_at")
  expiresAt     BigInt?  @map("expires_at")
  isActive      Boolean  @default(true) @map("is_active")
  isDeleted     Boolean  @default(false) @map("is_deleted")
  deletedAt     BigInt?  @map("deleted_at")
  createdAt     BigInt   @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt     BigInt   @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageLogs ApiKeyUsageLog[]

  @@index([userId])
  @@index([keyHash])
  @@index([deletedAt])
  @@map("api_keys")
}

// ---------------------------------------------------------------------------
// Impersonation Audit Log
// ---------------------------------------------------------------------------

/// RLS: INSERT + SELECT need `app_rls_bypass()`; UPDATE/DELETE revoked for `app_runtime` (immutable audit).
model ImpersonationAuditLog {
  id             String  @id @default(uuid())
  impersonatorId String  @map("impersonator_id")
  targetUserId   String  @map("target_user_id")
  action         String // "START" | "STOP"
  ipAddress      String? @map("ip_address") @db.VarChar(45)
  userAgent      String? @map("user_agent") @db.Text
  createdAt      BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")

  impersonator User @relation("Impersonator", fields: [impersonatorId], references: [id], onDelete: Cascade)
  targetUser   User @relation("ImpersonationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([impersonatorId])
  @@index([targetUserId])
  @@index([createdAt])
  @@map("impersonation_audit_logs")
}

/// RLS: INSERT open (request capture); SELECT/UPDATE/DELETE need bypass.
model Log {
  id            String   @id @default(uuid())
  level         String
  message       String   @db.Text
  context       String?
  userId        String?
  correlationId String?  @map("correlation_id")
  metadata      Json?
  durationMs    Int?     @map("duration_ms")
  errorGroup    String?  @map("error_group")
  tags          String[] @default([])
  timestamp     BigInt   @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  createdAt     BigInt   @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))

  @@index([level])
  @@index([timestamp])
  @@index([context])
  @@index([message])
  @@index([userId])
  @@index([correlationId])
  @@index([errorGroup])
  @@map("logs")
}

/// RLS: via parent api_key — `app_owns(api_keys.user_id)`.
model ApiKeyUsageLog {
  id             String  @id @default(uuid())
  apiKeyId       String  @map("api_key_id")
  endpoint       String  @db.VarChar(255)
  method         String  @db.VarChar(10)
  statusCode     Int     @map("status_code")
  ipAddress      String? @map("ip_address") @db.VarChar(45)
  userAgent      String? @map("user_agent") @db.Text
  responseTimeMs Int?    @map("response_time_ms")
  isDeleted      Boolean @default(false) @map("is_deleted")
  deletedAt      BigInt? @map("deleted_at")
  createdAt      BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt      BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([apiKeyId, createdAt])
  @@index([createdAt])
  @@map("api_key_usage_logs")
}

// ---------------------------------------------------------------------------
// Email Audit Trail
// ---------------------------------------------------------------------------

/// RLS: INSERT open (mail send); SELECT/UPDATE/DELETE need bypass.
model EmailLog {
  id          String  @id @default(uuid())
  templateKey String  @map("template_key")
  to          String  @db.VarChar(255)
  subject     String  @db.VarChar(255)
  status      String // "sent" | "delivered" | "bounced" | "complained" | "failed"
  resendId    String? @map("resend_id")
  error       String? @db.Text
  metadata    Json?
  createdAt   BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt   BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  @@index([status])
  @@index([templateKey])
  @@index([to])
  @@index([resendId])
  @@index([createdAt])
  @@map("email_logs")
}

// ---------------------------------------------------------------------------
// Geographical data (Country / State / City)
// Source: dr5hn/countries-states-cities-database
// ---------------------------------------------------------------------------

model Region {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(255)
  translations Json?
  wikiDataId   String?  @db.VarChar(255)
  flag         Boolean  @default(true)
  createdAt    DateTime @default(dbgenerated("'2014-01-01 12:01:01'")) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  countries  Country[]
  subregions Subregion[]

  @@map("regions")
}

model Subregion {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(255)
  translations Json?
  wikiDataId   String?  @db.VarChar(255)
  flag         Boolean  @default(true)
  createdAt    DateTime @default(dbgenerated("'2014-01-01 12:01:01'")) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  region    Region    @relation(fields: [regionId], references: [id])
  regionId  Int       @map("region_id")
  countries Country[]

  @@index([regionId])
  @@map("subregions")
}

model Country {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(255)
  iso3           String?  @db.VarChar(3)
  numericCode    String?  @map("numeric_code") @db.VarChar(3)
  iso2           String?  @db.VarChar(2)
  phonecode      String?  @db.VarChar(255)
  capital        String?  @db.VarChar(255)
  currency       String?  @db.VarChar(255)
  currencyName   String?  @map("currency_name") @db.VarChar(255)
  currencySymbol String?  @map("currency_symbol") @db.VarChar(255)
  tld            String?  @db.VarChar(255)
  native         String?  @db.VarChar(255)
  population     BigInt?  @db.BigInt
  gdp            BigInt?  @db.BigInt
  region         String?  @db.VarChar(255)
  subregion      String?  @db.VarChar(255)
  nationality    String?  @db.VarChar(255)
  timezones      Json?
  translations   Json?
  latitude       Decimal? @db.Decimal(10, 8)
  longitude      Decimal? @db.Decimal(11, 8)
  emoji          String?  @db.VarChar(191)
  emojiU         String?  @db.VarChar(191)
  wikiDataId     String?  @db.VarChar(255)
  flag           Boolean  @default(true)
  createdAt      DateTime @default(dbgenerated("'2014-01-01 12:01:01'")) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  regionRelation    Region?    @relation(fields: [regionId], references: [id])
  regionId          Int?       @map("region_id")
  subregionRelation Subregion? @relation(fields: [subregionId], references: [id])
  subregionId       Int?       @map("subregion_id")

  states State[]
  cities City[]

  @@index([regionId])
  @@index([subregionId])
  @@map("countries")
}

model State {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(255)
  countryCode  String   @map("country_code") @db.VarChar(2)
  fipsCode     String?  @map("fips_code") @db.VarChar(255)
  iso2         String?  @db.VarChar(255)
  iso3166_2    String?  @db.VarChar(255)
  type         String?  @db.VarChar(191)
  level        Int?
  parentId     Int?     @map("parent_id")
  native       String?  @db.VarChar(255)
  latitude     Decimal? @db.Decimal(10, 8)
  longitude    Decimal? @db.Decimal(11, 8)
  timezone     String?  @db.VarChar(255)
  translations Json?
  wikiDataId   String?  @db.VarChar(255)
  flag         Boolean  @default(true)
  createdAt    DateTime @default(dbgenerated("'2014-01-01 12:01:01'")) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  country   Country @relation(fields: [countryId], references: [id])
  countryId Int     @map("country_id")
  cities    City[]

  @@index([countryId])
  @@map("states")
}

model City {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(255)
  stateCode    String   @map("state_code") @db.VarChar(255)
  countryCode  String   @map("country_code") @db.VarChar(2)
  latitude     Decimal  @db.Decimal(10, 8)
  longitude    Decimal  @db.Decimal(11, 8)
  native       String?  @db.VarChar(255)
  timezone     String?  @db.VarChar(255)
  translations Json?
  wikiDataId   String?  @db.VarChar(255)
  flag         Boolean  @default(true)
  createdAt    DateTime @default(dbgenerated("'2014-01-01 12:01:01'")) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  state     State   @relation(fields: [stateId], references: [id])
  stateId   Int     @map("state_id")
  country   Country @relation(fields: [countryId], references: [id])
  countryId Int     @map("country_id")

  @@index([stateId])
  @@index([countryId])
  @@map("cities")
}

// ---------------------------------------------------------------------------
// Rewards Platform (Phase 1 — see docs/rewards-platform-prd.md)
// ---------------------------------------------------------------------------

enum PilotCity {
  KUALA_LUMPUR
  MELAKA
}

enum MerchantOrgStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

enum KybStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MerchantMemberRole {
  OWNER
  CASHIER
}

enum RewardType {
  DISCOUNT
  FREE_ITEM
  CASHBACK
  POINTS
  BOGO
}

enum RewardStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  EXPIRED
  DISABLED
}

enum RewardKind {
  CONSUMER
  REFERRER
}

enum RewardClaimStatus {
  PENDING
  REDEEMED
  EXPIRED
}

enum RewardRedemptionMethod {
  SCAN
  MANUAL
}

enum RewardReferralStatus {
  PENDING
  CREDITED
  BLOCKED
}

enum RewardOtpPurpose {
  CLAIM
}

/// RLS: org members + bypass — policies added in migration SQL.
model MerchantOrg {
  id           String             @id @default(uuid())
  businessName String             @map("business_name") @db.VarChar(200)
  legalName    String?            @map("legal_name") @db.VarChar(200)
  category     String             @db.VarChar(100)
  addressText  String?            @map("address_text") @db.Text
  city         PilotCity
  kybStatus    KybStatus          @default(PENDING) @map("kyb_status")
  kybFields    Json?              @map("kyb_fields")
  status       MerchantOrgStatus  @default(ONBOARDING)
  contactEmail String             @map("contact_email") @db.VarChar(100)
  contactPhone String?            @map("contact_phone") @db.VarChar(20)
  isDeleted    Boolean            @default(false) @map("is_deleted")
  deletedAt    BigInt?            @map("deleted_at")
  createdAt    BigInt             @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt    BigInt             @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  members     MerchantMember[]
  apiKeys     MerchantApiKey[]
  terminals   MerchantTerminal[]
  invites     MerchantInvite[]
  rewards     Reward[]
  redemptions RewardRedemption[]
  auditLogs   RewardAuditLog[]

  @@index([city])
  @@index([status])
  @@index([kybStatus])
  @@map("merchant_orgs")
}

/// RLS: via merchant_org_id membership.
model MerchantMember {
  id              String             @id @default(uuid())
  userId          String             @map("user_id")
  merchantOrgId   String             @map("merchant_org_id")
  role            MerchantMemberRole
  isDeleted       Boolean            @default(false) @map("is_deleted")
  deletedAt       BigInt?            @map("deleted_at")
  createdAt       BigInt             @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt       BigInt             @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantOrg MerchantOrg @relation(fields: [merchantOrgId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantOrgId])
  @@index([merchantOrgId])
  @@map("merchant_members")
}

/// RLS: org owner writes; POS auth uses key hash lookup with bypass.
model MerchantApiKey {
  id              String  @id @default(uuid())
  merchantOrgId   String  @map("merchant_org_id")
  name            String  @db.VarChar(100)
  keyHash         String  @unique @map("key_hash") @db.Text
  keyPrefix       String  @map("key_prefix") @db.VarChar(16)
  createdByUserId String  @map("created_by_user_id")
  revokedAt       BigInt? @map("revoked_at")
  lastUsedAt      BigInt? @map("last_used_at")
  isDeleted       Boolean @default(false) @map("is_deleted")
  deletedAt       BigInt? @map("deleted_at")
  createdAt       BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt       BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  merchantOrg MerchantOrg @relation(fields: [merchantOrgId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("MerchantApiKeyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([merchantOrgId])
  @@map("merchant_api_keys")
}

/// RLS: via merchant_org_id.
model MerchantTerminal {
  id            String  @id @default(uuid())
  merchantOrgId String  @map("merchant_org_id")
  terminalId    String  @map("terminal_id") @db.VarChar(100)
  label         String? @db.VarChar(100)
  isDeleted     Boolean @default(false) @map("is_deleted")
  deletedAt     BigInt? @map("deleted_at")
  createdAt     BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt     BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  merchantOrg MerchantOrg @relation(fields: [merchantOrgId], references: [id], onDelete: Cascade)

  @@unique([merchantOrgId, terminalId])
  @@map("merchant_terminals")
}

/// RLS: bypass for admin create; accept flow uses token lookup with bypass.
model MerchantInvite {
  id                 String     @id @default(uuid())
  email              String     @db.VarChar(100)
  tokenHash          String     @unique @map("token_hash") @db.Text
  businessName       String     @map("business_name") @db.VarChar(200)
  city               PilotCity
  merchantOrgId      String?    @map("merchant_org_id")
  createdByAdminId   String     @map("created_by_admin_id")
  acceptedByUserId   String?    @map("accepted_by_user_id")
  expiresAt          BigInt     @map("expires_at")
  acceptedAt         BigInt?    @map("accepted_at")
  isDeleted          Boolean    @default(false) @map("is_deleted")
  deletedAt          BigInt?    @map("deleted_at")
  createdAt          BigInt     @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt          BigInt     @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  merchantOrg   MerchantOrg? @relation(fields: [merchantOrgId], references: [id], onDelete: SetNull)
  createdByAdmin User         @relation("MerchantInviteCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  acceptedByUser User?        @relation("MerchantInviteAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([expiresAt])
  @@map("merchant_invites")
}

/// RLS: merchant org members for writes; public read for published consumer rewards.
model Reward {
  id                    String       @id @default(uuid())
  merchantOrgId         String       @map("merchant_org_id")
  title                 String       @db.VarChar(200)
  description           String       @db.Text
  rewardType            RewardType   @map("reward_type")
  rewardValue           Int          @default(0) @map("reward_value")
  termsConditions       String?      @map("terms_conditions") @db.Text
  rewardKind            RewardKind   @default(CONSUMER) @map("reward_kind")
  category              String       @db.VarChar(100)
  placeholderImageKey   String       @map("placeholder_image_key") @db.VarChar(100)
  rules                 Json?
  quantityTotal         Int          @map("quantity_total")
  quantityRemaining     Int          @map("quantity_remaining")
  quantityReserved      Int          @default(0) @map("quantity_reserved")
  startDate             BigInt?      @map("start_date")
  expiryDate            BigInt       @map("expiry_date")
  status                RewardStatus @default(DRAFT)
  claimCount            Int          @default(0) @map("claim_count")
  redemptionCount       Int          @default(0) @map("redemption_count")
  metadata              Json?
  referralsEnabled      Boolean      @default(true) @map("referrals_enabled")
  referralPoolTotal     Int?         @map("referral_pool_total")
  referralPoolRemaining Int?         @map("referral_pool_remaining")
  referrerRewardId      String?      @map("referrer_reward_id")
  parentConsumerRewardId String?     @map("parent_consumer_reward_id")
  submittedForReviewAt  BigInt?      @map("submitted_for_review_at")
  autoPublishAt         BigInt?      @map("auto_publish_at")
  reviewedAt            BigInt?      @map("reviewed_at")
  reviewedByUserId      String?      @map("reviewed_by_user_id")
  rejectionReason       String?      @map("rejection_reason") @db.Text
  isDeleted             Boolean      @default(false) @map("is_deleted")
  deletedAt             BigInt?      @map("deleted_at")
  createdAt             BigInt       @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt             BigInt       @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  merchantOrg          MerchantOrg    @relation(fields: [merchantOrgId], references: [id], onDelete: Cascade)
  referrerReward       Reward?        @relation("ConsumerReferrerReward", fields: [referrerRewardId], references: [id], onDelete: SetNull)
  consumerRewards      Reward[]       @relation("ConsumerReferrerReward")
  parentConsumerReward Reward?        @relation("ReferrerCloneParent", fields: [parentConsumerRewardId], references: [id], onDelete: SetNull)
  referrerClones       Reward[]       @relation("ReferrerCloneParent")
  claims               RewardClaim[]
  referrals            RewardReferral[]

  @@index([merchantOrgId])
  @@index([status])
  @@index([category])
  @@index([expiryDate])
  @@index([autoPublishAt])
  @@index([rewardKind])
  @@map("rewards")
}

/// RLS: app_owns(user_id).
model RewardClaim {
  id                   String            @id @default(uuid())
  userId               String            @map("user_id")
  rewardId             String            @map("reward_id")
  referralId           String?           @map("referral_id")
  redemptionTokenHash  String            @unique @map("redemption_token_hash") @db.Text
  backupCodeHash       String            @unique @map("backup_code_hash") @db.Text
  status               RewardClaimStatus @default(PENDING)
  isReferrerCredit     Boolean           @default(false) @map("is_referrer_credit")
  claimedAt            BigInt            @map("claimed_at")
  claimExpiresAt       BigInt            @map("claim_expires_at")
  redeemedAt           BigInt?           @map("redeemed_at")
  backupFailedAttempts Int               @default(0) @map("backup_failed_attempts")
  backupLockedUntil    BigInt?           @map("backup_locked_until")
  isDeleted            Boolean           @default(false) @map("is_deleted")
  deletedAt            BigInt?           @map("deleted_at")
  createdAt            BigInt            @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt            BigInt            @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward      Reward             @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  referral    RewardReferral?    @relation(fields: [referralId], references: [id], onDelete: SetNull)
  redemption  RewardRedemption?

  @@index([userId])
  @@index([rewardId])
  @@index([status])
  @@index([claimExpiresAt])
  @@map("reward_claims")
}

/// RLS: merchant org + user own row.
model RewardRedemption {
  id              String                 @id @default(uuid())
  claimId         String                 @unique @map("claim_id")
  merchantOrgId   String                 @map("merchant_org_id")
  userId          String                 @map("user_id")
  terminalId      String                 @map("terminal_id") @db.VarChar(100)
  redemptionMethod RewardRedemptionMethod @map("redemption_method")
  idempotencyKey  String                 @map("idempotency_key") @db.VarChar(64)
  redeemedAt      BigInt                 @map("redeemed_at")
  isDeleted       Boolean                @default(false) @map("is_deleted")
  deletedAt       BigInt?                @map("deleted_at")
  createdAt       BigInt                 @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt       BigInt                 @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  claim       RewardClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  merchantOrg MerchantOrg @relation(fields: [merchantOrgId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([merchantOrgId, idempotencyKey])
  @@index([merchantOrgId])
  @@index([userId])
  @@index([redeemedAt])
  @@map("reward_redemptions")
}

/// RLS: referrer/referee own rows + bypass.
model RewardReferral {
  id                 String               @id @default(uuid())
  referrerUserId     String               @map("referrer_user_id")
  refereeUserId      String?              @map("referee_user_id")
  rewardId           String               @map("reward_id")
  attributionToken   String               @unique @map("attribution_token") @db.VarChar(64)
  status             RewardReferralStatus @default(PENDING)
  refereeDeviceHash  String?              @map("referee_device_hash") @db.VarChar(128)
  refereeIp          String?              @map("referee_ip") @db.VarChar(45)
  creditedAt         BigInt?              @map("credited_at")
  blockedReason      String?              @map("blocked_reason") @db.Text
  isDeleted          Boolean              @default(false) @map("is_deleted")
  deletedAt          BigInt?              @map("deleted_at")
  createdAt          BigInt               @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt          BigInt               @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  referrerUser User          @relation("ReferrerUser", fields: [referrerUserId], references: [id], onDelete: Cascade)
  refereeUser  User?         @relation("RefereeUser", fields: [refereeUserId], references: [id], onDelete: SetNull)
  reward       Reward        @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  claims       RewardClaim[]

  @@index([referrerUserId])
  @@index([refereeUserId])
  @@index([rewardId])
  @@index([status])
  @@map("reward_referrals")
}

/// RLS: app_owns(user_id).
model RewardOtpChallenge {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  phone         String           @db.VarChar(20)
  purpose       RewardOtpPurpose
  rewardId      String?          @map("reward_id")
  codeHash      String           @map("code_hash") @db.Text
  expiresAt     BigInt           @map("expires_at")
  attempts      Int              @default(0)
  failedAttempts Int             @default(0) @map("failed_attempts")
  consumedAt    BigInt?          @map("consumed_at")
  isDeleted     Boolean          @default(false) @map("is_deleted")
  deletedAt     BigInt?          @map("deleted_at")
  createdAt     BigInt           @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt     BigInt           @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([phone])
  @@index([expiresAt])
  @@map("reward_otp_challenges")
}

/// RLS: app_owns(user_id).
model RewardLegalAcceptance {
  id             String @id @default(uuid())
  userId         String @map("user_id")
  termsVersion   String @map("terms_version") @db.VarChar(32)
  privacyVersion String @map("privacy_version") @db.VarChar(32)
  acceptedAt     BigInt @map("accepted_at")
  isDeleted      Boolean @default(false) @map("is_deleted")
  deletedAt      BigInt? @map("deleted_at")
  createdAt      BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt      BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("reward_legal_acceptances")
}

/// RLS: app_owns(user_id).
model RewardNotification {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  type      String  @db.VarChar(64)
  title     String  @db.VarChar(200)
  body      String  @db.Text
  metadata  Json?
  readAt    BigInt? @map("read_at")
  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readAt])
  @@index([createdAt])
  @@map("reward_notifications")
}

/// RLS: bypass for validate audit; org members can read org events.
model RewardAuditLog {
  id          String  @id @default(uuid())
  actorUserId String? @map("actor_user_id")
  merchantOrgId String? @map("merchant_org_id")
  action      String  @db.VarChar(64)
  metadata    Json?
  createdAt   BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")

  actorUser   User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  merchantOrg MerchantOrg? @relation(fields: [merchantOrgId], references: [id], onDelete: SetNull)

  @@index([merchantOrgId])
  @@index([action])
  @@index([createdAt])
  @@map("reward_audit_logs")
}

/// RLS: bypass — tracks confirm idempotency conflicts (token reused with different key).
model RewardRedemptionIdempotencyRecord {
  id             String @id @default(uuid())
  redemptionTokenHash String @map("redemption_token_hash") @db.Text
  idempotencyKey String @map("idempotency_key") @db.VarChar(64)
  redemptionId   String? @map("redemption_id")
  createdAt      BigInt @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")

  @@unique([redemptionTokenHash, idempotencyKey])
  @@index([redemptionTokenHash])
  @@map("reward_redemption_idempotency_records")
}
