/// RLS: TENANT — canonical tenant root.
/// @extends BaseModel
model Tenant {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  slug                String               @unique @db.VarChar(64)
  displayName         String               @db.VarChar(200)
  lifecycleState      TenantLifecycleState @default(PROVISIONING)
  /// IANA time zone the merchant operates in (e.g. Asia/Kuala_Lumpur): merchant analytics bucket weeks
  /// at Monday 00:00 in this zone. Validated by `IanaTimeZoneSchema`; the default is
  /// `PLATFORM_DISPLAY_REGION.timeZone` (packages/shared) and must stay equal to it.
  timeZone            String               @default("Asia/Kuala_Lumpur") @db.VarChar(64)
  deletionGraceEndsAt BigInt?

  slugHistory              TenantSlugHistory[]
  locations                Location[]
  memberships              Membership[]
  merchantProfile          TenantMerchantProfile?
  invitations              TenantInvitation[]
  accessRequests           TenantAccessRequest[]
  lifecycleEvents          TenantLifecycleEvent[]
  placement                TenantPlacement?
  policyDrafts             AuthorizationPolicyDraft[]
  policyVersions           AuthorizationPolicyVersion[]
  supportGrants            SupportAccessGrant[]
  encryptionKeys           TenantEncryptionKey[]
  auditLogs                TenantAuditLog[]
  rewards                  Reward[]
  redemptions              RewardRedemption[]
  rewardSales              RewardSale[]
  rewardAuditLogs          RewardAuditLog[]
  apiKeys                  TenantApiKey[]
  kybFiles                 TenantKybFile[]
  assets                   TenantAsset[]
  terminals                TenantTerminal[]
  storedFiles              StoredFile[]                    @relation("StoredFileTenant")
  rewardImages             RewardImage[]
  membershipLocationScopes MembershipLocationScope[]
  invitationLocationScopes TenantInvitationLocationScope[]
  rewardLocationScopes     RewardLocationScope[]
  suspensionAppeals        TenantSuspensionAppeal[]
  customerBans             TenantCustomerBan[]

  @@index([lifecycleState])
}

/// RLS: TENANT — reserved slug aliases for safe redirects.
/// @extends BaseModel
model TenantSlugHistory {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  tenantId      String
  slug          String  @db.VarChar(64)
  reservedUntil BigInt?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([slug])
  @@index([tenantId])
}

/// RLS: TENANT — store/site within a tenant.
/// @extends BaseModel
model Location {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  tenantId          String
  name              String         @db.VarChar(200)
  code              String         @db.VarChar(64)
  addressText       String?        @db.Text
  city              PilotCity?
  contactPhone      String?        @db.VarChar(20)
  status            LocationStatus @default(PENDING_APPROVAL)
  rejectionReason   String?        @db.Text
  requestedByUserId String?
  reviewedByUserId  String?
  reviewedAt        BigInt?
  isPrimary         Boolean        @default(false)
  /// Why the store was closed (bankruptcy, lease ended, ...); set together with the soft-delete fields when it is closed.
  closureReason     String?        @db.Text

  tenant                   Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy              User?                           @relation("LocationRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  reviewedBy               User?                           @relation("LocationReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  locationScopes           MembershipLocationScope[]
  invitationLocationScopes TenantInvitationLocationScope[]
  rewardLocationScopes     RewardLocationScope[]
  terminals                TenantTerminal[]
  redemptions              RewardRedemption[]
  rewardSales              RewardSale[]
  apiKeys                  TenantApiKey[]

  @@unique([tenantId, code])
  /// At most one live primary location per tenant (partial unique — soft-deleted rows ignored).
  @@unique([tenantId], where: { isPrimary: true, isDeleted: false })
  /// Composite target of the tenant-scoped foreign keys (multi-tenancy plan §7): a child row
  /// can reference this row only from the same tenant.
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, status])
}

/// RLS: MEMBERSHIP — user membership in a tenant.
/// @extends BaseModel
model Membership {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  tenantId    String
  userId      String
  role        MembershipRole
  status      MembershipStatus @default(ACTIVE)
  /// The member's own name for this tenant (`PATCH /tenants/:tenantSlug/members/me`); trimmed, at most
  /// `TENANT_MEMBER_DISPLAY_NAME_MAX_LENGTH` (100) characters; NULL = show the account's full name.
  displayName String?          @db.VarChar(100)

  tenant         Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User                      @relation("Memberships", fields: [userId], references: [id], onDelete: Cascade)
  locationScopes MembershipLocationScope[]

  @@unique([tenantId, userId], where: { isDeleted: false })
  /// Composite target of the tenant-scoped foreign keys (multi-tenancy plan §7): a child row
  /// can reference this row only from the same tenant.
  @@unique([tenantId, id])
  @@index([userId])
  @@index([tenantId, status])
  /// `GET /tenants/:tenantSlug/members` (join order within one tenant) and `GET /tenants/memberships` (one user's, in join order).
  @@index([tenantId, createdAt, id])
  @@index([userId, createdAt, id])
}

/// RLS: MEMBERSHIP — location scope for a membership.
/// @extends BaseModel
model MembershipLocationScope {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  tenantId     String
  membershipId String
  scopeType    LocationScopeType
  locationId   String?
  /// The location role (an RBAC `Role`, e.g. Location Manager) the member holds wherever this scope
  /// reaches: its permissions apply only at the scope's location (ALL_LOCATIONS: every location of the
  /// tenant). NULL = the scope only limits where the member's tenant role applies.
  roleId       String?

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  location   Location?  @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade)
  role       Role?      @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([membershipId, locationId], where: { isDeleted: false })
  @@index([tenantId])
  @@index([roleId])
}

