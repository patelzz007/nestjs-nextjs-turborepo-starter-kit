/// RLS: TENANT — a merchant's ban of one customer from its rewards: while it is active (`liftedAt`
/// null) the customer cannot claim the merchant's rewards and the merchant's tills refuse their
/// codes. Made from one of the customer's redemptions (merchants never see who a customer is); a
/// lifted ban stays as history. At most one active ban per tenant and customer.
/// @extends BaseModel
model TenantCustomerBan {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  tenantId           String
  customerUserId     String
  /// The redemption the merchant banned the customer from; null once that redemption no longer exists.
  sourceRedemptionId String?
  /// Why, in the merchant's words; trimmed, at most `TENANT_CUSTOMER_BAN_REASON_MAX_LENGTH`. Never shown to the customer.
  reason             String  @db.Text
  bannedByUserId     String?
  bannedAt           BigInt
  liftedByUserId     String?
  /// When the merchant lifted the ban; null while it is active.
  liftedAt           BigInt?

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer         User              @relation("TenantCustomerBanCustomer", fields: [customerUserId], references: [id], onDelete: Cascade)
  sourceRedemption RewardRedemption? @relation(fields: [sourceRedemptionId], references: [id], onDelete: SetNull)
  bannedBy         User?             @relation("TenantCustomerBanIssuer", fields: [bannedByUserId], references: [id], onDelete: SetNull)
  liftedBy         User?             @relation("TenantCustomerBanLifter", fields: [liftedByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, customerUserId], where: { liftedAt: null, isDeleted: false })
  @@index([tenantId, bannedAt])
  @@index([customerUserId])
}

