  DENIED
}

/// RLS: TENANT + GLOBAL — Cedar policy drafts.
/// @extends BaseModel
model AuthorizationPolicyDraft {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  tenantId       String?
  scope          AuthorizationPolicyScope
  name           String                           @db.VarChar(120)
  description    String?                          @db.Text
  builderPayload Json
  cedarSource    String                           @db.Text
  sqlPredicate   String?                          @db.Text
  status         AuthorizationPolicyStatus        @default(DRAFT)
  createdById    String
  /// The second SuperAdmin who approved a FOUR_EYES publish; NULL for PLATFORM_DEFAULT_TEMPLATE.
  approvedById   String?
  /// NULL until the draft is published.
  approvalKind   AuthorizationPolicyApprovalKind?

  tenant      Tenant?                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator     User                            @relation("AuthorizationPolicyDraftCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy  User?                           @relation("AuthorizationPolicyDraftApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  versions    AuthorizationPolicyVersion[]
  simulations AuthorizationPolicySimulation[]

  @@index([tenantId, status])
}

/// RLS: TENANT + GLOBAL — immutable published policy versions.
/// @extends BaseModel
model AuthorizationPolicyVersion {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  tenantId      String?
  draftId       String
  scope         AuthorizationPolicyScope
  version       Int
  cedarSource   String                   @db.Text
  sqlPredicate  String?                  @db.Text
  contentHash   String                   @db.VarChar(64)
  publishedAt   BigInt
  publishedById String
  supersededAt  BigInt?

  tenant      Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  draft       AuthorizationPolicyDraft @relation(fields: [draftId], references: [id], onDelete: Restrict)
  publishedBy User                     @relation("AuthorizationPolicyPublisher", fields: [publishedById], references: [id], onDelete: Restrict)

  @@unique([tenantId, scope, version])
  @@unique([scope, version], where: { tenantId: null })
  @@unique([tenantId, scope], where: { supersededAt: null })
  @@unique([scope], where: { tenantId: null, supersededAt: null })
  @@index([tenantId, publishedAt])
}

/// RLS: OPERATIONAL — policy simulation runs.
/// @extends BaseModel
model AuthorizationPolicySimulation {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  draftId             String
  actorUserId         String
  result              Json
  passed              Boolean
  /// sha256 of the published policy versions the draft was simulated against.
  /// Publishing requires it to equal the current baseline (NULL = recorded before
  /// baseline tracking existed; never accepted for publish).
  baselineFingerprint String? @db.VarChar(64)

  draft AuthorizationPolicyDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  actor User                     @relation("AuthorizationPolicySimulator", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([draftId, createdAt])
}

