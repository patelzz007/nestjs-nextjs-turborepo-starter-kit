generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Row Level Security (Postgres)
//
// Prisma 7 PSL cannot emit CREATE ROLE, GRANT, ENABLE/FORCE RLS, or POLICY.
// Those statements live at the **bottom** of `migrations/20260818235200_init`
// and MUST stay there when this folder is squashed or regenerated.
//
// Schema-owned pieces (columns, indexes, maps) always land in this file first.
//
// Runtime (apps/api):
//   - Role `app_runtime` (NOLOGIN NOSUPERUSER NOINHERIT NOBYPASSRLS)
//   - GRANT USAGE ON SCHEMA public + table DML to app_runtime (PG 15+ public
//     schema has no PUBLIC grants — without this, SET ROLE fails with 42501)
//   - RlsPool: SET ROLE app_runtime on every checkout
//   - Session: app.current_user_id, app.rls_bypass (RlsInterceptor ALS)
//   - Helpers: app_rls_bypass(), app_current_user_id(), app_owns(owner_id)
// See docs/prisma.md §10.
// ---------------------------------------------------------------------------

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum RedirectType {
  PERMANENT // 301
  TEMPORARY // 302
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  BOT
  UNKNOWN
}

enum TwoFactorLoginChallengePurpose {
  LOGIN
  ROTATE
}

enum MfaRecoveryRequestStatus {
  PENDING
  APPROVED
  DENIED
  COMPLETED
}

// Enums
enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  LIST
  MANAGE
}

enum PermissionResource {
  USER
  PROFILE
  ROLE
  PERMISSION
  ADMIN_DASHBOARD
  SYSTEM_SETTINGS
  URL
  TAG
  API_KEY
  ANALYTICS
  AUDIT_LOG
  REPORT
  EMAIL
  GEO
  REWARD
  MERCHANT_ORG
  REDEMPTION
  SAMPLE_CATEGORY
  PRODUCT
  DEVTOOLS
}

// Tables
/// RLS: own row — `app_owns(id)`. Public login/signup uses bypass.
model User {
  id           String  @id @default(uuid())
  fullName     String  @db.VarChar(100)
  email        String  @unique @db.VarChar(100)
  passwordHash String  @db.Text
  isActive     Boolean @default(true)
  isSuperAdmin Boolean @default(false)

  // Incremented on every role/permission mutation. The JWT carries this
  // value; the AuthorizationGuard rejects tokens with a stale version,
  // forcing the user to re-login (or refresh) after an authorization
  // change — without needing Redis or a token blacklist.
  tokenVersion Int @default(0) @map("token_version")

  failedLoginAttempts Int     @default(0) @map("failed_login_attempts")
  lockedUntil         BigInt? @map("locked_until")

  twoFactorEnabled          Boolean @default(false) @map("two_factor_enabled")
  /// DEPRECATED: plaintext TOTP secret — migrate to encrypted columns in service layer.
  twoFactorSecret           String? @map("two_factor_secret") @db.Text
  twoFactorSecretCiphertext String? @map("two_factor_secret_ciphertext") @db.Text
  twoFactorSecretIv         String? @map("two_factor_secret_iv") @db.VarChar(32)
  twoFactorSecretKeyVersion Int?    @map("two_factor_secret_key_version")
  twoFactorLastTotpStep     BigInt? @map("two_factor_last_totp_step")
  mfaEnrolledAt             BigInt? @map("mfa_enrolled_at")
  mfaEnrollmentDeadline     BigInt? @map("mfa_enrollment_deadline")
  mfaAssuredAt              BigInt? @map("mfa_assured_at")

  provider          String? // "google" | "github" | null
  providerId        String? @map("provider_id")
  plan              Plan    @default(FREE)
  monthlyUrlLimit   Int     @default(50) @map("monthly_url_limit")
  monthlyClickLimit Int     @default(10000) @map("monthly_click_limit")

  // Relations
  refreshTokens   RefreshToken[]
  userRoles       UserRole[]
  userPermissions UserPermission[]

  emailVerifiedAt             BigInt?                   @map("email_verified_at")
  phone                       String?                   @db.VarChar(20)
  phoneVerifiedAt             BigInt?                   @map("phone_verified_at")
  lastLoginAt                 BigInt?                   @map("last_login_at")
  pendingAttributionToken     String?                   @map("pending_attribution_token") @db.VarChar(64)
  pendingAttributionExpiresAt BigInt?                   @map("pending_attribution_expires_at")
  isDeleted                   Boolean                   @default(false) @map("is_deleted")
  deletedAt                   BigInt?                   @map("deleted_at")
  createdAt                   BigInt                    @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  updatedAt                   BigInt                    @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  urls                        Url[]
  tags                        Tag[]
  apiKeys                     ApiKey[]
  passwordResetTokens         PasswordResetToken[]
  passwordHistory             PasswordHistory[]
  backupCodes                 BackupCode[]
  twoFactorPendingSetup       TwoFactorPendingSetup?
  twoFactorLoginChallenges    TwoFactorLoginChallenge[]
  mfaRecoveryRequests         MfaRecoveryRequest[]
  impersonatedBy              ImpersonationAuditLog[]   @relation("Impersonator")
  impersonatedUser            ImpersonationAuditLog[]   @relation("ImpersonationTarget")

  organizationMemberships              OrganizationMembership[]        @relation("OrganizationMemberships")
  organizationInvitationsCreated       OrganizationInvitation[]        @relation("OrganizationInvitationCreator")
  organizationInvitationsAccepted      OrganizationInvitation[]        @relation("OrganizationInvitationAcceptor")
  organizationAccessRequests           OrganizationAccessRequest[]     @relation("OrganizationAccessRequests")
  organizationAccessRequestsReviewed   OrganizationAccessRequest[]     @relation("OrganizationAccessRequestReviewer")
  authorizationPolicyDraftsCreated     AuthorizationPolicyDraft[]      @relation("AuthorizationPolicyDraftCreator")
  authorizationPolicyDraftsApproved    AuthorizationPolicyDraft[]      @relation("AuthorizationPolicyDraftApprover")
  authorizationPolicyVersionsPublished AuthorizationPolicyVersion[]    @relation("AuthorizationPolicyPublisher")
  authorizationPolicySimulations       AuthorizationPolicySimulation[] @relation("AuthorizationPolicySimulator")
  supportAccessGrants                  SupportAccessGrant[]            @relation("SupportAccessGrantSupportUser")
  organizationApiKeysCreated           OrganizationApiKey[]            @relation("OrganizationApiKeyCreator")
  rewardClaims                         RewardClaim[]
  rewardRedemptions                    RewardRedemption[]
  rewardReferralsAsReferrer            RewardReferral[]                @relation("ReferrerUser")
  rewardReferralsAsReferee             RewardReferral[]                @relation("RefereeUser")
  rewardOtpChallenges                  RewardOtpChallenge[]
  rewardLegalAcceptances               RewardLegalAcceptance[]
  rewardNotifications                  RewardNotification[]
  rewardAuditLogs                      RewardAuditLog[]
  avatar                               UserAvatar?
  storedFilesUploaded                  StoredFile[]                    @relation("StoredFileUploader")

  @@unique([provider, providerId])
  @@index([pendingAttributionToken])
  @@map("users")
}

/// RLS: catalog — SELECT true; writes need `app_rls_bypass()`.
model Role {
  id          String  @id @default(uuid())
  name        String  @unique @db.VarChar(100)
  description String? @db.Text
  isActive    Boolean @default(true)

  // Self-referential hierarchy — a role can inherit permissions from a parent role.
  parentId String? @map("parent_id")
  parent   Role?   @relation("RoleHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Role[]  @relation("RoleHierarchy")

  // Relations
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  updatedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))

  @@index([parentId])
  @@map("roles")
}

/// RLS: catalog — SELECT true; writes need `app_rls_bypass()`.
model Permission {
  id          String             @id @default(uuid())
  action      PermissionAction
  resource    PermissionResource
  description String?            @db.Text

  group      String? @db.VarChar(100)
  isSystem   Boolean @default(false)
  conditions Json?

  // Relations
  rolePermissions      RolePermission[]
  userPermissions      UserPermission[]
  capabilityDefinition CapabilityDefinition?

  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  updatedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))

  @@unique([action, resource])
  @@map("permissions")
}

// ---------------------------------------------------------------------------
// Capability catalog (generic RBAC slugs — platform + tenant scopes)
// ---------------------------------------------------------------------------

enum CapabilityScope {
  PLATFORM
  MERCHANT
  ADMIN
}

/// RLS: catalog — SELECT true; writes need `app_rls_bypass()`.
model CapabilityDefinition {
  id           String          @id @default(uuid())
  slug         String          @unique @db.VarChar(100)
  scope        CapabilityScope
  label        String          @db.VarChar(200)
  description  String?         @db.Text
  groupName    String?         @map("group_name") @db.VarChar(100)
  sortOrder    Int             @default(0) @map("sort_order")
  isSystem     Boolean         @default(false) @map("is_system")
  permissionId String?         @unique @map("permission_id")
  metadata     Json?

  permission Permission? @relation(fields: [permissionId], references: [id], onDelete: SetNull)

  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  @@index([scope])
  @@map("capability_definitions")
}

// ---------------------------------------------------------------------------
// Permission Audit Trail
// ---------------------------------------------------------------------------

/// RLS: bypass only (`app_rls_bypass()`).
model PermissionAuditLog {
  id           String  @id @default(uuid())
  actorId      String  @map("actor_id")
  targetUserId String? @map("target_user_id")
  targetRoleId String? @map("target_role_id")
  permissionId String? @map("permission_id")
  action       String
  detail       String? @db.Text
  isDeleted    Boolean @default(false) @map("is_deleted")
  deletedAt    BigInt? @map("deleted_at")
  createdAt    BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt    BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  @@index([actorId])
  @@index([targetUserId])
  @@index([targetRoleId])
  @@index([createdAt])
  @@map("permission_audit_logs")
}

// ---------------------------------------------------------------------------
// Password Reset Tokens
// ---------------------------------------------------------------------------

/// RLS: own row — `app_owns(user_id)`.
model PasswordResetToken {
  id          String  @id @default(uuid())
  userId      String  @map("user_id")
  token       String  @unique @db.Text
  tokenDigest String? @unique @map("token_digest") @db.VarChar(64)
  expiresAt   BigInt  @map("expires_at")
  usedAt      BigInt? @map("used_at")
  isDeleted   Boolean @default(false) @map("is_deleted")
  deletedAt   BigInt? @map("deleted_at")
  createdAt   BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt   BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([tokenDigest])
  @@map("password_reset_tokens")
}

/// RLS: own row — `app_owns(user_id)`.
model PasswordHistory {
  id           String @id @default(uuid())
  userId       String @map("user_id")
  passwordHash String @map("password_hash") @db.Text
  createdAt    BigInt @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_history")
}

/// RLS: own row — `app_owns(user_id)`.
model BackupCode {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  codeHash  String  @map("code_hash") @db.Text
  usedAt    BigInt? @map("used_at")
  createdAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("backup_codes")
}

/// Temporary 2FA enrollment state — expires after 15 minutes.
/// RLS: own row — `app_owns(user_id)`.
model TwoFactorPendingSetup {
  id                String @id @default(uuid())
  userId            String @unique @map("user_id")
  secretCiphertext  String @map("secret_ciphertext") @db.Text
  secretIv          String @map("secret_iv") @db.VarChar(32)
  secretKeyVersion  Int    @map("secret_key_version")
  backupCodesHashes Json   @map("backup_codes_hashes")
  expiresAt         BigInt @map("expires_at")
  createdAt         BigInt @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("two_factor_pending_setups")
}

/// Short-lived MFA verification challenge during login or secret rotation.
/// RLS: own row — `app_owns(user_id)`.
model TwoFactorLoginChallenge {
  id           String                         @id @default(uuid())
  userId       String                         @map("user_id")
  purpose      TwoFactorLoginChallengePurpose
  clientType   String?                        @map("client_type")
  deviceInfo   String?                        @map("device_info") @db.VarChar(255)
  ipAddress    String?                        @map("ip_address") @db.VarChar(45)
  attemptCount Int                            @default(0) @map("attempt_count")
  maxAttempts  Int                            @default(5) @map("max_attempts")
  consumedAt   BigInt?                        @map("consumed_at")
  expiresAt    BigInt                         @map("expires_at")
  createdAt    BigInt                         @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("two_factor_login_challenges")
}

/// Admin-reviewed MFA recovery / account unlock request.
/// RLS: own row — `app_owns(user_id)`.
model MfaRecoveryRequest {
  id                String                   @id @default(uuid())
  userId            String                   @map("user_id")
  status            MfaRecoveryRequestStatus @default(PENDING)
  requestedAt       BigInt                   @map("requested_at")
  reviewedBy        String?                  @map("reviewed_by")
  reviewedAt        BigInt?                  @map("reviewed_at")
  scheduledUnlockAt BigInt?                  @map("scheduled_unlock_at")
  completedAt       BigInt?                  @map("completed_at")
  notes             String?                  @db.Text
  createdAt         BigInt                   @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt         BigInt                   @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("mfa_recovery_requests")
}

/// RLS: own row — `app_owns("userId")`.
model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  assignedBy String?

  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  updatedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))

  @@unique([userId, roleId])
  @@map("user_roles")
}

/// RLS: own row — `app_owns("userId")`.
model UserPermission {
  id           String @id @default(uuid())
  userId       String
  permissionId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  assignedBy String?
  expiresAt  BigInt?

  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  updatedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

/// RLS: catalog — SELECT true; writes need `app_rls_bypass()`.
model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  assignedBy String?

  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  updatedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

/// RLS: own row — `app_owns("userId")`.
model RefreshToken {
  id                String  @id @default(uuid())
  token             String  @db.Text
  previousTokenHash String? @map("previous_token_hash") @db.Text
  rotationVersion   Int     @default(0) @map("rotation_version")
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceInfo String? @db.VarChar(255)
  ipAddress  String? @db.VarChar(45)

  expiresAt BigInt
  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  updatedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

/// RLS: own row — `app_owns(user_id)`. Public redirects use bypass.
model Url {
  id           String       @id @default(uuid())
  userId       String?      @map("user_id")
  shortCode    String       @unique @map("short_code")
  customAlias  String?      @unique @map("custom_alias")
  originalUrl  String       @map("original_url") @db.Text
  title        String?
  redirectType RedirectType @default(TEMPORARY) @map("redirect_type")
  isActive     Boolean      @default(true) @map("is_active")
  passwordHash String?      @map("password_hash")
  clickLimit   Int?         @map("click_limit")
  clickCount   Int          @default(0) @map("click_count")
  expiresAt    BigInt?      @map("expires_at")
  isDeleted    Boolean      @default(false) @map("is_deleted")
  deletedAt    BigInt?      @map("deleted_at")
  createdAt    BigInt       @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt    BigInt       @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  user   User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  clicks Click[]
  tags   UrlTag[]

  @@index([shortCode])
  @@index([userId])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("urls")
}

/// RLS: own row — `app_owns(user_id)`.
model Tag {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  name      String
  color     String  @default("#6366f1")
  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  urls UrlTag[]

  @@unique([userId, name])
  @@map("tags")
}

/// RLS: via parent url — `app_owns(urls.user_id)`.
model UrlTag {
  id    String @id @default(uuid())
  urlId String @map("url_id")
  tagId String @map("tag_id")

  url Url @relation(fields: [urlId], references: [id], onDelete: Cascade)
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  updatedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))

  @@unique([urlId, tagId])
  @@map("url_tags")
}

/// RLS: via parent url — `app_owns(urls.user_id)`.
model Click {
  id          String     @id @default(uuid())
  urlId       String     @map("url_id")
  ipAddress   String?    @map("ip_address")
  country     String?
  city        String?
  deviceType  DeviceType @default(UNKNOWN) @map("device_type")
  os          String?
  browser     String?
  referrer    String?    @db.Text
  utmSource   String?    @map("utm_source")
  utmMedium   String?    @map("utm_medium")
  utmCampaign String?    @map("utm_campaign")
  clickedAt   BigInt     @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("clicked_at")
  isDeleted   Boolean    @default(false) @map("is_deleted")
  deletedAt   BigInt?    @map("deleted_at")
  createdAt   BigInt     @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  updatedAt   BigInt     @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  url         Url        @relation(fields: [urlId], references: [id], onDelete: Cascade)

  @@index([urlId])
  @@index([clickedAt])
  @@index([urlId, clickedAt])
  @@map("clicks")
}

/// RLS: own row — `app_owns(user_id)`.
model ApiKey {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  name          String
  keyHash       String   @unique @map("key_hash")
  keyPrefix     String   @map("key_prefix")
  scopes        String[] @default(["read", "write"])
  rateLimitTier String   @default("standard") @map("rate_limit_tier")
  totalRequests Int      @default(0) @map("total_requests")
  lastUsedAt    BigInt?  @map("last_used_at")
  expiresAt     BigInt?  @map("expires_at")
  isActive      Boolean  @default(true) @map("is_active")
  isDeleted     Boolean  @default(false) @map("is_deleted")
  deletedAt     BigInt?  @map("deleted_at")
  createdAt     BigInt   @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt     BigInt   @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageLogs ApiKeyUsageLog[]

  @@index([userId])
  @@index([keyHash])
  @@index([deletedAt])
  @@map("api_keys")
}

// ---------------------------------------------------------------------------
// Impersonation Audit Log
// ---------------------------------------------------------------------------

/// RLS: INSERT + SELECT need `app_rls_bypass()`; UPDATE/DELETE revoked for `app_runtime` (immutable audit).
model ImpersonationAuditLog {
  id             String  @id @default(uuid())
  impersonatorId String  @map("impersonator_id")
  targetUserId   String  @map("target_user_id")
  action         String // "START" | "STOP"
  ipAddress      String? @map("ip_address") @db.VarChar(45)
  userAgent      String? @map("user_agent") @db.Text
  createdAt      BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")

  impersonator User @relation("Impersonator", fields: [impersonatorId], references: [id], onDelete: Cascade)
  targetUser   User @relation("ImpersonationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([impersonatorId])
  @@index([targetUserId])
  @@index([createdAt])
  @@map("impersonation_audit_logs")
}

/// RLS: INSERT open (request capture); SELECT/UPDATE/DELETE need bypass.
model Log {
  id            String   @id @default(uuid())
  level         String
  message       String   @db.Text
  context       String?
  userId        String?
  correlationId String?  @map("correlation_id")
  metadata      Json?
  durationMs    Int?     @map("duration_ms")
  errorGroup    String?  @map("error_group")
  tags          String[] @default([])
  timestamp     BigInt   @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))
  createdAt     BigInt   @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint"))

  @@index([level])
  @@index([timestamp])
  @@index([context])
  @@index([message])
  @@index([userId])
  @@index([correlationId])
  @@index([errorGroup])
  @@map("logs")
}

/// RLS: via parent api_key — `app_owns(api_keys.user_id)`.
model ApiKeyUsageLog {
  id             String  @id @default(uuid())
  apiKeyId       String  @map("api_key_id")
  endpoint       String  @db.VarChar(255)
  method         String  @db.VarChar(10)
  statusCode     Int     @map("status_code")
  ipAddress      String? @map("ip_address") @db.VarChar(45)
  userAgent      String? @map("user_agent") @db.Text
  responseTimeMs Int?    @map("response_time_ms")
  isDeleted      Boolean @default(false) @map("is_deleted")
  deletedAt      BigInt? @map("deleted_at")
  createdAt      BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt      BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([apiKeyId, createdAt])
  @@index([createdAt])
  @@map("api_key_usage_logs")
}

// ---------------------------------------------------------------------------
// Email Audit Trail
// ---------------------------------------------------------------------------

/// RLS: INSERT open (mail send); SELECT/UPDATE/DELETE need bypass.
model EmailLog {
  id          String  @id @default(uuid())
  templateKey String  @map("template_key")
  to          String  @db.VarChar(255)
  subject     String  @db.VarChar(255)
  status      String // "sent" | "delivered" | "bounced" | "complained" | "failed"
  resendId    String? @map("resend_id")
  error       String? @db.Text
  metadata    Json?
  createdAt   BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt   BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  @@index([status])
  @@index([templateKey])
  @@index([to])
  @@index([resendId])
  @@index([createdAt])
  @@map("email_logs")
}

// ---------------------------------------------------------------------------
// Geographical data (Country / State / City)
// Source: dr5hn/countries-states-cities-database
// ---------------------------------------------------------------------------

model Region {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(255)
  translations Json?
  wikiDataId   String?  @db.VarChar(255)
  flag         Boolean  @default(true)
  createdAt    DateTime @default(dbgenerated("'2014-01-01 12:01:01'")) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  countries  Country[]
  subregions Subregion[]

  @@map("regions")
}

model Subregion {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(255)
  translations Json?
  wikiDataId   String?  @db.VarChar(255)
  flag         Boolean  @default(true)
  createdAt    DateTime @default(dbgenerated("'2014-01-01 12:01:01'")) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  region    Region    @relation(fields: [regionId], references: [id])
  regionId  Int       @map("region_id")
  countries Country[]

  @@index([regionId])
  @@map("subregions")
}

model Country {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(255)
  iso3           String?  @db.VarChar(3)
  numericCode    String?  @map("numeric_code") @db.VarChar(3)
  iso2           String?  @db.VarChar(2)
  phonecode      String?  @db.VarChar(255)
  capital        String?  @db.VarChar(255)
  currency       String?  @db.VarChar(255)
  currencyName   String?  @map("currency_name") @db.VarChar(255)
  currencySymbol String?  @map("currency_symbol") @db.VarChar(255)
  tld            String?  @db.VarChar(255)
  native         String?  @db.VarChar(255)
  population     BigInt?  @db.BigInt
  gdp            BigInt?  @db.BigInt
  region         String?  @db.VarChar(255)
  subregion      String?  @db.VarChar(255)
  nationality    String?  @db.VarChar(255)
  timezones      Json?
  translations   Json?
  latitude       Decimal? @db.Decimal(10, 8)
  longitude      Decimal? @db.Decimal(11, 8)
  emoji          String?  @db.VarChar(191)
  emojiU         String?  @db.VarChar(191)
  wikiDataId     String?  @db.VarChar(255)
  flag           Boolean  @default(true)
  createdAt      DateTime @default(dbgenerated("'2014-01-01 12:01:01'")) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  regionRelation    Region?    @relation(fields: [regionId], references: [id])
  regionId          Int?       @map("region_id")
  subregionRelation Subregion? @relation(fields: [subregionId], references: [id])
  subregionId       Int?       @map("subregion_id")

  states State[]
  cities City[]

  @@index([regionId])
  @@index([subregionId])
  @@map("countries")
}

model State {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(255)
  countryCode  String   @map("country_code") @db.VarChar(2)
  fipsCode     String?  @map("fips_code") @db.VarChar(255)
  iso2         String?  @db.VarChar(255)
  iso3166_2    String?  @db.VarChar(255)
  type         String?  @db.VarChar(191)
  level        Int?
  parentId     Int?     @map("parent_id")
  native       String?  @db.VarChar(255)
  latitude     Decimal? @db.Decimal(10, 8)
  longitude    Decimal? @db.Decimal(11, 8)
  timezone     String?  @db.VarChar(255)
  translations Json?
  wikiDataId   String?  @db.VarChar(255)
  flag         Boolean  @default(true)
  createdAt    DateTime @default(dbgenerated("'2014-01-01 12:01:01'")) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  country   Country @relation(fields: [countryId], references: [id])
  countryId Int     @map("country_id")
  cities    City[]

  @@index([countryId])
  @@map("states")
}

model City {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(255)
  stateCode    String   @map("state_code") @db.VarChar(255)
  countryCode  String   @map("country_code") @db.VarChar(2)
  latitude     Decimal  @db.Decimal(10, 8)
  longitude    Decimal  @db.Decimal(11, 8)
  native       String?  @db.VarChar(255)
  timezone     String?  @db.VarChar(255)
  translations Json?
  wikiDataId   String?  @db.VarChar(255)
  flag         Boolean  @default(true)
  createdAt    DateTime @default(dbgenerated("'2014-01-01 12:01:01'")) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  state     State   @relation(fields: [stateId], references: [id])
  stateId   Int     @map("state_id")
  country   Country @relation(fields: [countryId], references: [id])
  countryId Int     @map("country_id")

  @@index([stateId])
  @@index([countryId])
  @@map("cities")
}

// ---------------------------------------------------------------------------
// Organization multi-tenancy (see docs/multi-tenancy.md, ADRs 008–013)
// ---------------------------------------------------------------------------

enum PilotCity {
  KUALA_LUMPUR
  MELAKA
}

enum KybStatus {
  PENDING
  APPROVED
  REJECTED
  ACTION_REQUIRED
}

enum OrganizationLifecycleState {
  PROVISIONING
  ACTIVE
  RESTRICTED
  SUSPENDED
  PENDING_DELETION
  DELETED
}

enum OrganizationMembershipRole {
  OWNER
  ADMIN
  MEMBER
  POLICY_ADMIN
  CASHIER
}

enum OrganizationMembershipStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum OrganizationLocationScopeType {
  ALL_LOCATIONS
  SELECTED
}

enum OrganizationInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum OrganizationAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AuthorizationPolicyScope {
  PLATFORM_GUARDRAIL
  PLATFORM
  TENANT
}

enum AuthorizationPolicyStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  SUPERSEDED
  ROLLED_BACK
}

enum SupportAccessGrantMode {
  READ_ONLY
  WRITE_ELEVATED
}

enum SupportAccessGrantStatus {
  PENDING_APPROVAL
  PENDING_TENANT_APPROVAL
  ACTIVE
  EXPIRED
  REVOKED
  DENIED
}

enum TenantPlacementKind {
  SHARED
  DEDICATED
}

enum TenantEncryptionKeyStatus {
  ACTIVE
  ROTATING
  REVOKED
}

/// RLS: TENANT — canonical organization root.
model Organization {
  id                  String                     @id @default(uuid())
  slug                String                     @unique @db.VarChar(64)
  displayName         String                     @map("display_name") @db.VarChar(200)
  lifecycleState      OrganizationLifecycleState @default(PROVISIONING) @map("lifecycle_state")
  deletionGraceEndsAt BigInt?                    @map("deletion_grace_ends_at")
  isDeleted           Boolean                    @default(false) @map("is_deleted")
  deletedAt           BigInt?                    @map("deleted_at")
  createdAt           BigInt                     @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt           BigInt                     @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  slugHistory              OrganizationSlugHistory[]
  locations                OrganizationLocation[]
  memberships              OrganizationMembership[]
  merchantProfile          OrganizationMerchantProfile?
  invitations              OrganizationInvitation[]
  accessRequests           OrganizationAccessRequest[]
  lifecycleEvents          OrganizationLifecycleEvent[]
  placement                TenantPlacement?
  entitlements             OrganizationEntitlement[]
  quotas                   OrganizationQuota[]
  policyDrafts             AuthorizationPolicyDraft[]
  policyVersions           AuthorizationPolicyVersion[]
  supportGrants            SupportAccessGrant[]
  encryptionKeys           TenantEncryptionKey[]
  auditLogs                OrganizationAuditLog[]
  rewards                  Reward[]
  redemptions              RewardRedemption[]
  rewardAuditLogs          RewardAuditLog[]
  apiKeys                  OrganizationApiKey[]
  kybDocuments             OrganizationKybDocument[]
  kybFiles                 OrganizationKybFile[]
  assets                   OrganizationAsset[]
  terminals                OrganizationTerminal[]
  storedFiles              StoredFile[]                          @relation("StoredFileOrganization")
  membershipLocationScopes OrganizationMembershipLocationScope[]
  rewardLocationScopes     RewardLocationScope[]

  @@index([lifecycleState])
  @@map("organizations")
}

/// RLS: TENANT — reserved slug aliases for safe redirects.
model OrganizationSlugHistory {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  slug           String  @db.VarChar(64)
  reservedUntil  BigInt? @map("reserved_until")
  createdAt      BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([slug])
  @@index([organizationId])
  @@map("organization_slug_history")
}

/// RLS: TENANT — store/site within an organization.
model OrganizationLocation {
  id             String     @id @default(uuid())
  organizationId String     @map("organization_id")
  name           String     @db.VarChar(200)
  code           String     @db.VarChar(64)
  addressText    String?    @map("address_text") @db.Text
  city           PilotCity?
  contactPhone   String?    @map("contact_phone") @db.VarChar(20)
  isPrimary      Boolean    @default(false) @map("is_primary")
  isDeleted      Boolean    @default(false) @map("is_deleted")
  deletedAt      BigInt?    @map("deleted_at")
  createdAt      BigInt     @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt      BigInt     @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  organization   Organization                          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationScopes         OrganizationMembershipLocationScope[]
  rewardLocationScopes   RewardLocationScope[]
  terminals              OrganizationTerminal[]
  redemptions            RewardRedemption[]
  apiKeys                OrganizationApiKey[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("organization_locations")
}

/// RLS: MEMBERSHIP — user membership in an organization.
model OrganizationMembership {
  id             String                       @id @default(uuid())
  organizationId String                       @map("organization_id")
  userId         String                       @map("user_id")
  role           OrganizationMembershipRole
  status         OrganizationMembershipStatus @default(ACTIVE)
  displayName    String?                      @map("display_name") @db.VarChar(100)
  attributes     Json?
  isDeleted      Boolean                      @default(false) @map("is_deleted")
  deletedAt      BigInt?                      @map("deleted_at")
  createdAt      BigInt                       @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt      BigInt                       @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  organization   Organization                          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                                  @relation("OrganizationMemberships", fields: [userId], references: [id], onDelete: Cascade)
  locationScopes OrganizationMembershipLocationScope[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
  @@map("organization_memberships")
}

/// RLS: MEMBERSHIP — location scope for a membership.
model OrganizationMembershipLocationScope {
  id             String                        @id @default(uuid())
  organizationId String                        @map("organization_id")
  membershipId   String                        @map("membership_id")
  scopeType      OrganizationLocationScopeType @map("scope_type")
  locationId     String?                       @map("location_id")
  createdAt      BigInt                        @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  location     OrganizationLocation?  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([membershipId, locationId])
  @@index([organizationId])
  @@map("organization_membership_location_scopes")
}

/// RLS: TENANT — merchant-specific organization profile (KYB, contact).
model OrganizationMerchantProfile {
  id             String    @id @default(uuid())
  organizationId String    @unique @map("organization_id")
  legalName      String?   @map("legal_name") @db.VarChar(200)
  category       String    @db.VarChar(100)
  addressText    String?   @map("address_text") @db.Text
  city           PilotCity
  kybStatus      KybStatus @default(PENDING) @map("kyb_status")
  kybFields      Json?     @map("kyb_fields")
  contactEmail   String    @map("contact_email") @db.VarChar(100)
  contactPhone   String?   @map("contact_phone") @db.VarChar(20)
  createdAt      BigInt    @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt      BigInt    @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([kybStatus])
  @@map("organization_merchant_profiles")
}

/// RLS: TENANT — platform-invited organization join.
model OrganizationInvitation {
  id               String                       @id @default(uuid())
  organizationId   String?                      @map("organization_id")
  email            String                       @db.VarChar(100)
  tokenHash        String                       @unique @map("token_hash") @db.Text
  intendedRole     OrganizationMembershipRole   @map("intended_role")
  status           OrganizationInvitationStatus @default(PENDING)
  createdByAdminId String                       @map("created_by_admin_id")
  acceptedByUserId String?                      @map("accepted_by_user_id")
  expiresAt        BigInt                       @map("expires_at")
  acceptedAt       BigInt?                      @map("accepted_at")
  createdAt        BigInt                       @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt        BigInt                       @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdByAdmin User          @relation("OrganizationInvitationCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  acceptedByUser User?         @relation("OrganizationInvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([organizationId])
  @@map("organization_invitations")
}

/// RLS: TENANT — user-requested access to an organization.
model OrganizationAccessRequest {
  id             String                          @id @default(uuid())
  organizationId String                          @map("organization_id")
  userId         String                          @map("user_id")
  status         OrganizationAccessRequestStatus @default(PENDING)
  message        String?                         @db.Text
  reviewedById   String?                         @map("reviewed_by_id")
  reviewedAt     BigInt?                         @map("reviewed_at")
  createdAt      BigInt                          @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt      BigInt                          @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("OrganizationAccessRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("OrganizationAccessRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, status])
  @@index([organizationId, status])
  @@map("organization_access_requests")
}

/// RLS: OPERATIONAL — lifecycle state transition audit.
model OrganizationLifecycleEvent {
  id             String                      @id @default(uuid())
  organizationId String                      @map("organization_id")
  fromState      OrganizationLifecycleState? @map("from_state")
  toState        OrganizationLifecycleState  @map("to_state")
  actorUserId    String?                     @map("actor_user_id")
  reason         String?                     @db.Text
  correlationId  String?                     @map("correlation_id") @db.VarChar(64)
  createdAt      BigInt                      @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("organization_lifecycle_events")
}

/// RLS: TENANT — future placement / shard directory.
model TenantPlacement {
  id             String              @id @default(uuid())
  organizationId String              @unique @map("organization_id")
  kind           TenantPlacementKind @default(SHARED)
  regionCode     String              @default("default") @map("region_code") @db.VarChar(32)
  shardKey       String?             @map("shard_key") @db.VarChar(64)
  createdAt      BigInt              @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt      BigInt              @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("tenant_placements")
}

/// RLS: TENANT — plan entitlements (billing deferred).
model OrganizationEntitlement {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  planCode       String  @map("plan_code") @db.VarChar(64)
  features       Json
  version        Int     @default(1)
  effectiveFrom  BigInt  @map("effective_from")
  effectiveUntil BigInt? @map("effective_until")
  createdAt      BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, effectiveFrom])
  @@map("organization_entitlements")
}

/// RLS: TENANT — usage quotas.
model OrganizationQuota {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  quotaKey       String @map("quota_key") @db.VarChar(64)
  limitValue     BigInt @map("limit_value")
  usedValue      BigInt @default(0) @map("used_value")
  windowStart    BigInt @map("window_start")
  windowEnd      BigInt @map("window_end")
  createdAt      BigInt @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt      BigInt @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, quotaKey, windowStart])
  @@map("organization_quotas")
}

/// RLS: TENANT + GLOBAL — Cedar policy drafts.
model AuthorizationPolicyDraft {
  id             String                    @id @default(uuid())
  organizationId String?                   @map("organization_id")
  scope          AuthorizationPolicyScope
  name           String                    @db.VarChar(120)
  description    String?                   @db.Text
  builderPayload Json                      @map("builder_payload")
  cedarSource    String                    @map("cedar_source") @db.Text
  sqlPredicate   String?                   @map("sql_predicate") @db.Text
  status         AuthorizationPolicyStatus @default(DRAFT)
  createdById    String                    @map("created_by_id")
  approvedById   String?                   @map("approved_by_id")
  createdAt      BigInt                    @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt      BigInt                    @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  organization Organization?                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                            @relation("AuthorizationPolicyDraftCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy   User?                           @relation("AuthorizationPolicyDraftApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  versions     AuthorizationPolicyVersion[]
  simulations  AuthorizationPolicySimulation[]

  @@index([organizationId, status])
  @@map("authorization_policy_drafts")
}

/// RLS: TENANT + GLOBAL — immutable published policy versions.
model AuthorizationPolicyVersion {
  id             String                   @id @default(uuid())
  organizationId String?                  @map("organization_id")
  draftId        String                   @map("draft_id")
  scope          AuthorizationPolicyScope
  version        Int
  cedarSource    String                   @map("cedar_source") @db.Text
  sqlPredicate   String?                  @map("sql_predicate") @db.Text
  contentHash    String                   @map("content_hash") @db.VarChar(64)
  publishedAt    BigInt                   @map("published_at")
  publishedById  String                   @map("published_by_id")
  supersededAt   BigInt?                  @map("superseded_at")

  organization Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  draft        AuthorizationPolicyDraft @relation(fields: [draftId], references: [id], onDelete: Restrict)
  publishedBy  User                     @relation("AuthorizationPolicyPublisher", fields: [publishedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, scope, version])
  @@index([organizationId, publishedAt])
  @@map("authorization_policy_versions")
}

/// RLS: OPERATIONAL — policy simulation runs.
model AuthorizationPolicySimulation {
  id          String  @id @default(uuid())
  draftId     String  @map("draft_id")
  actorUserId String  @map("actor_user_id")
  result      Json
  passed      Boolean
  createdAt   BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")

  draft AuthorizationPolicyDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  actor User                     @relation("AuthorizationPolicySimulator", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([draftId, createdAt])
  @@map("authorization_policy_simulations")
}

/// RLS: OPERATIONAL — JIT support access grants.
model SupportAccessGrant {
  id                  String                   @id @default(uuid())
  organizationId      String                   @map("organization_id")
  supportUserId       String                   @map("support_user_id")
  targetMembershipId  String?                  @map("target_membership_id")
  mode                SupportAccessGrantMode   @default(READ_ONLY)
  status              SupportAccessGrantStatus @default(PENDING_TENANT_APPROVAL)
  reason              String                   @db.Text
  ticketRef           String?                  @map("ticket_ref") @db.VarChar(120)
  tenantApprovedById  String?                  @map("tenant_approved_by_id")
  emergencyApprovedBy String?                  @map("emergency_approved_by") @db.VarChar(120)
  expiresAt           BigInt                   @map("expires_at")
  revokedAt           BigInt?                  @map("revoked_at")
  createdAt           BigInt                   @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supportUser  User         @relation("SupportAccessGrantSupportUser", fields: [supportUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([supportUserId, status])
  @@map("support_access_grants")
}

/// RLS: TENANT — envelope encryption key metadata.
model TenantEncryptionKey {
  id             String                    @id @default(uuid())
  organizationId String                    @map("organization_id")
  keyVersion     Int                       @map("key_version")
  wrappedKey     String                    @map("wrapped_key") @db.Text
  kmsKeyId       String                    @map("kms_key_id") @db.VarChar(255)
  status         TenantEncryptionKeyStatus @default(ACTIVE)
  rotatedAt      BigInt?                   @map("rotated_at")
  createdAt      BigInt                    @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, keyVersion])
  @@map("tenant_encryption_keys")
}

/// RLS: TENANT — security and mutation audit (7-year retention).
model OrganizationAuditLog {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  actorUserId    String? @map("actor_user_id")
  action         String  @db.VarChar(120)
  resourceType   String  @map("resource_type") @db.VarChar(120)
  resourceId     String? @map("resource_id") @db.VarChar(64)
  decision       String? @db.VarChar(32)
  policyVersion  Int?    @map("policy_version")
  correlationId  String? @map("correlation_id") @db.VarChar(64)
  metadata       Json?
  createdAt      BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@map("organization_audit_logs")
}

// ---------------------------------------------------------------------------
// Rewards Platform (Phase 1 — see docs/rewards-platform-prd.md)
// ---------------------------------------------------------------------------

enum KybDocumentScanStatus {
  SCANNING
  CLEAN
  INFECTED
}

enum FileStatus {
  PENDING
  UPLOADED
  PROCESSING
  SCANNING
  READY
  FAILED
  QUARANTINED
  DELETED
}

enum FileCategory {
  PRODUCT_IMAGE
  STORE_LOGO
  STORE_BANNER
  USER_AVATAR
  MERCHANT_KYB
}

enum FileVisibility {
  PUBLIC
  PRIVATE
}

enum StorageProvider {
  local
  s3
  firebase
}

enum OrganizationAssetType {
  LOGO
  BANNER
}

enum FileVariantKind {
  ORIGINAL
  THUMBNAIL
  MEDIUM
  LARGE
}

enum RewardType {
  DISCOUNT
  FREE_ITEM
  CASHBACK
  POINTS
  BOGO
}

enum RewardStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  EXPIRED
  DISABLED
}

enum RewardKind {
  CONSUMER
  REFERRER
}

enum RewardClaimStatus {
  PENDING
  REDEEMED
  EXPIRED
}

enum RewardRedemptionMethod {
  SCAN
  MANUAL
}

enum RewardReferralStatus {
  PENDING
  CREDITED
  BLOCKED
}

enum RewardOtpPurpose {
  CLAIM
}

/// RLS: owner-scoped via uploaded_by_id and relation tables.
model StoredFile {
  id               String                 @id @default(uuid())
  category         FileCategory
  visibility       FileVisibility
  originalName     String                 @map("original_name") @db.VarChar(255)
  mimeType         String                 @map("mime_type") @db.VarChar(100)
  sizeBytes        Int                    @map("size_bytes")
  expectedChecksum String                 @map("expected_checksum") @db.VarChar(64)
  actualChecksum   String?                @map("actual_checksum") @db.VarChar(64)
  storageProvider  StorageProvider?       @map("storage_provider")
  storageContainer String?                @map("storage_container") @db.VarChar(255)
  objectRevision   String?                @map("object_revision") @db.VarChar(64)
  storageBucket    String                 @map("storage_bucket") @db.VarChar(255)
  storagePath      String                 @map("storage_path") @db.VarChar(500)
  publicPath       String?                @map("public_path") @db.VarChar(500)
  objectGeneration String?                @map("object_generation") @db.VarChar(64)
  status           FileStatus             @default(PENDING)
  scanStatus       KybDocumentScanStatus? @map("scan_status")
  scannedAt        BigInt?                @map("scanned_at")
  scanResult       String?                @map("scan_result") @db.VarChar(500)
  uploadedById     String                 @map("uploaded_by_id")
  organizationId   String?                @map("organization_id")
  isDeleted        Boolean                @default(false) @map("is_deleted")
  deletedAt        BigInt?                @map("deleted_at")
  createdAt        BigInt                 @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt        BigInt                 @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  uploadedBy         User                  @relation("StoredFileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  organization       Organization?         @relation("StoredFileOrganization", fields: [organizationId], references: [id], onDelete: SetNull)
  variants           FileVariant[]
  productImages      ProductImage[]
  organizationAssets OrganizationAsset[]
  userAvatar         UserAvatar?
  kybFiles           OrganizationKybFile[]

  @@index([uploadedById])
  @@index([organizationId])
  @@index([status])
  @@index([category])
  @@map("stored_files")
}

/// RLS: via stored_files ownership.
model FileVariant {
  id               String           @id @default(uuid())
  fileId           String           @map("file_id")
  kind             FileVariantKind
  mimeType         String           @map("mime_type") @db.VarChar(100)
  sizeBytes        Int              @map("size_bytes")
  storageProvider  StorageProvider? @map("storage_provider")
  storageContainer String?          @map("storage_container") @db.VarChar(255)
  objectRevision   String?          @map("object_revision") @db.VarChar(64)
  storageBucket    String           @map("storage_bucket") @db.VarChar(255)
  storagePath      String           @map("storage_path") @db.VarChar(500)
  publicPath       String?          @map("public_path") @db.VarChar(500)
  objectGeneration String?          @map("object_generation") @db.VarChar(64)
  isDeleted        Boolean          @default(false) @map("is_deleted")
  deletedAt        BigInt?          @map("deleted_at")
  createdAt        BigInt           @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt        BigInt           @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, kind])
  @@index([fileId])
  @@map("file_variants")
}

/// RLS: via product ownership (catalog).
model ProductImage {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  fileId    String  @map("file_id")
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")
  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  file    StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([fileId])
  @@map("product_images")
}

/// RLS: via organization_id membership.
model OrganizationAsset {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  assetType      OrganizationAssetType @map("asset_type")
  fileId         String                @map("file_id")
  isDeleted      Boolean               @default(false) @map("is_deleted")
  deletedAt      BigInt?               @map("deleted_at")
  createdAt      BigInt                @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt      BigInt                @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  file         StoredFile   @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([organizationId, assetType])
  @@index([fileId])
  @@map("organization_assets")
}

/// RLS: via user ownership.
model UserAvatar {
  id        String  @id @default(uuid())
  userId    String  @unique @map("user_id")
  fileId    String  @unique @map("file_id")
  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@map("user_avatars")
}

/// RLS: via organization_id membership.
model OrganizationKybFile {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  fileId         String  @map("file_id")
  submissionId   String  @map("submission_id")
  isActive       Boolean @default(true) @map("is_active")
  isDeleted      Boolean @default(false) @map("is_deleted")
  deletedAt      BigInt? @map("deleted_at")
  createdAt      BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt      BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  file         StoredFile   @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([submissionId])
  @@index([fileId])
  @@map("organization_kyb_files")
}

/// RLS: via organization_id membership — legacy KYB document metadata (migrated to stored_files).
model OrganizationKybDocument {
  id               String                @id @default(uuid())
  organizationId   String                @map("organization_id")
  submissionId     String                @map("submission_id")
  fileName         String                @map("file_name") @db.VarChar(255)
  mimeType         String                @map("mime_type") @db.VarChar(100)
  sizeBytes        Int                   @map("size_bytes")
  checksumSha256   String                @map("checksum_sha256") @db.VarChar(64)
  storageBucket    String                @map("storage_bucket") @db.VarChar(255)
  storagePath      String                @map("storage_path") @db.VarChar(500)
  objectGeneration String?               @map("object_generation") @db.VarChar(64)
  scanStatus       KybDocumentScanStatus @default(SCANNING) @map("scan_status")
  scannedAt        BigInt?               @map("scanned_at")
  scanResult       String?               @map("scan_result") @db.VarChar(500)
  isActive         Boolean               @default(true) @map("is_active")
  isDeleted        Boolean               @default(false) @map("is_deleted")
  deletedAt        BigInt?               @map("deleted_at")
  createdAt        BigInt                @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt        BigInt                @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([submissionId])
  @@map("organization_kyb_documents")
}

/// RLS: org members write; POS auth uses key hash lookup with bypass.
model OrganizationApiKey {
  id              String  @id @default(uuid())
  organizationId  String  @map("organization_id")
  locationId      String? @map("location_id")
  name            String  @db.VarChar(100)
  keyHash         String  @unique @map("key_hash") @db.Text
  keyPrefix       String  @map("key_prefix") @db.VarChar(16)
  createdByUserId String  @map("created_by_user_id")
  revokedAt       BigInt? @map("revoked_at")
  lastUsedAt      BigInt? @map("last_used_at")
  isDeleted       Boolean @default(false) @map("is_deleted")
  deletedAt       BigInt? @map("deleted_at")
  createdAt       BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt       BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     OrganizationLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy    User                  @relation("OrganizationApiKeyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([locationId])
  @@map("organization_api_keys")
}

/// RLS: via organization_id and location_id.
model OrganizationTerminal {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  locationId     String  @map("location_id")
  terminalId     String  @map("terminal_id") @db.VarChar(100)
  label          String? @db.VarChar(100)
  isDeleted      Boolean @default(false) @map("is_deleted")
  deletedAt      BigInt? @map("deleted_at")
  createdAt      BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt      BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     OrganizationLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, terminalId])
  @@index([locationId])
  @@map("organization_terminals")
}

/// RLS: organization members for writes; public read for published consumer rewards.
model Reward {
  id                     String       @id @default(uuid())
  organizationId         String       @map("organization_id")
  title                  String       @db.VarChar(200)
  description            String       @db.Text
  rewardType             RewardType   @map("reward_type")
  rewardValue            Int          @default(0) @map("reward_value")
  termsConditions        String?      @map("terms_conditions") @db.Text
  rewardKind             RewardKind   @default(CONSUMER) @map("reward_kind")
  category               String       @db.VarChar(100)
  placeholderImageKey    String       @map("placeholder_image_key") @db.VarChar(100)
  rules                  Json?
  quantityTotal          Int          @map("quantity_total")
  quantityRemaining      Int          @map("quantity_remaining")
  quantityReserved       Int          @default(0) @map("quantity_reserved")
  startDate              BigInt?      @map("start_date")
  expiryDate             BigInt       @map("expiry_date")
  status                 RewardStatus @default(DRAFT)
  claimCount             Int          @default(0) @map("claim_count")
  redemptionCount        Int          @default(0) @map("redemption_count")
  metadata               Json?
  referralsEnabled       Boolean      @default(true) @map("referrals_enabled")
  referralPoolTotal      Int?         @map("referral_pool_total")
  referralPoolRemaining  Int?         @map("referral_pool_remaining")
  referrerRewardId       String?      @map("referrer_reward_id")
  parentConsumerRewardId String?                       @map("parent_consumer_reward_id")
  locationScopeType      OrganizationLocationScopeType @default(ALL_LOCATIONS) @map("location_scope_type")
  submittedForReviewAt   BigInt?                       @map("submitted_for_review_at")
  autoPublishAt          BigInt?      @map("auto_publish_at")
  reviewedAt             BigInt?      @map("reviewed_at")
  reviewedByUserId       String?      @map("reviewed_by_user_id")
  rejectionReason        String?      @map("rejection_reason") @db.Text
  isDeleted              Boolean      @default(false) @map("is_deleted")
  deletedAt              BigInt?      @map("deleted_at")
  createdAt              BigInt       @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt              BigInt       @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referrerReward       Reward?          @relation("ConsumerReferrerReward", fields: [referrerRewardId], references: [id], onDelete: SetNull)
  consumerRewards      Reward[]         @relation("ConsumerReferrerReward")
  parentConsumerReward Reward?          @relation("ReferrerCloneParent", fields: [parentConsumerRewardId], references: [id], onDelete: SetNull)
  referrerClones       Reward[]         @relation("ReferrerCloneParent")
  claims               RewardClaim[]
  referrals            RewardReferral[]
  locationScopes       RewardLocationScope[]

  @@index([organizationId])
  @@index([status])
  @@index([category])
  @@index([expiryDate])
  @@index([autoPublishAt])
  @@index([rewardKind])
  @@map("rewards")
}

/// RLS: organization members — which stores a reward is available at.
model RewardLocationScope {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  rewardId       String @map("reward_id")
  locationId     String @map("location_id")
  createdAt      BigInt @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reward       Reward               @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  location     OrganizationLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([rewardId, locationId])
  @@index([organizationId])
  @@index([locationId])
  @@map("reward_location_scopes")
}

/// RLS: app_owns(user_id).
model RewardClaim {
  id                   String            @id @default(uuid())
  userId               String            @map("user_id")
  rewardId             String            @map("reward_id")
  referralId           String?           @map("referral_id")
  redemptionTokenHash  String            @unique @map("redemption_token_hash") @db.Text
  backupCodeHash       String            @unique @map("backup_code_hash") @db.Text
  status               RewardClaimStatus @default(PENDING)
  isReferrerCredit     Boolean           @default(false) @map("is_referrer_credit")
  claimedAt            BigInt            @map("claimed_at")
  claimExpiresAt       BigInt            @map("claim_expires_at")
  redeemedAt           BigInt?           @map("redeemed_at")
  backupFailedAttempts Int               @default(0) @map("backup_failed_attempts")
  backupLockedUntil    BigInt?           @map("backup_locked_until")
  isDeleted            Boolean           @default(false) @map("is_deleted")
  deletedAt            BigInt?           @map("deleted_at")
  createdAt            BigInt            @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt            BigInt            @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward     Reward            @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  referral   RewardReferral?   @relation(fields: [referralId], references: [id], onDelete: SetNull)
  redemption RewardRedemption?

  @@index([userId])
  @@index([rewardId])
  @@index([status])
  @@index([claimExpiresAt])
  @@map("reward_claims")
}

/// RLS: organization member + user own row.
model RewardRedemption {
  id               String                 @id @default(uuid())
  claimId          String                 @unique @map("claim_id")
  organizationId   String                 @map("organization_id")
  locationId       String?                @map("location_id")
  userId           String                 @map("user_id")
  terminalId       String                 @map("terminal_id") @db.VarChar(100)
  redemptionMethod RewardRedemptionMethod @map("redemption_method")
  idempotencyKey   String                 @map("idempotency_key") @db.VarChar(64)
  redeemedAt       BigInt                 @map("redeemed_at")
  isDeleted        Boolean                @default(false) @map("is_deleted")
  deletedAt        BigInt?                @map("deleted_at")
  createdAt        BigInt                 @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt        BigInt                 @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  claim        RewardClaim           @relation(fields: [claimId], references: [id], onDelete: Cascade)
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     OrganizationLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([locationId])
  @@index([userId])
  @@index([redeemedAt])
  @@map("reward_redemptions")
}

/// RLS: referrer/referee own rows + bypass.
model RewardReferral {
  id                String               @id @default(uuid())
  referrerUserId    String               @map("referrer_user_id")
  refereeUserId     String?              @map("referee_user_id")
  rewardId          String               @map("reward_id")
  attributionToken  String               @unique @map("attribution_token") @db.VarChar(64)
  status            RewardReferralStatus @default(PENDING)
  refereeDeviceHash String?              @map("referee_device_hash") @db.VarChar(128)
  refereeIp         String?              @map("referee_ip") @db.VarChar(45)
  creditedAt        BigInt?              @map("credited_at")
  blockedReason     String?              @map("blocked_reason") @db.Text
  isDeleted         Boolean              @default(false) @map("is_deleted")
  deletedAt         BigInt?              @map("deleted_at")
  createdAt         BigInt               @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")
  updatedAt         BigInt               @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("updated_at")

  referrerUser User          @relation("ReferrerUser", fields: [referrerUserId], references: [id], onDelete: Cascade)
  refereeUser  User?         @relation("RefereeUser", fields: [refereeUserId], references: [id], onDelete: SetNull)
  reward       Reward        @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  claims       RewardClaim[]

  @@index([referrerUserId])
  @@index([refereeUserId])
  @@index([rewardId])
  @@index([status])
  @@map("reward_referrals")
}

/// RLS: app_owns(user_id).
model RewardOtpChallenge {
  id             String           @id @default(uuid())
  userId         String           @map("user_id")
  phone          String           @db.VarChar(20)
  purpose        RewardOtpPurpose
  rewardId       String?          @map("reward_id")
  codeHash       String           @map("code_hash") @db.Text
  expiresAt      BigInt           @map("expires_at")
  attempts       Int              @default(0)
  failedAttempts Int              @default(0) @map("failed_attempts")
  consumedAt     BigInt?          @map("consumed_at")
