  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  tenantId          String
  submittedByUserId String
  /// The tenant's case for reactivation; trimmed, at most `TENANT_APPEAL_MESSAGE_MAX_LENGTH`.
  message           String             @db.Text
  status            TenantAppealStatus @default(PENDING)
  reviewedByUserId  String?
  reviewedAt        BigInt?
  /// The platform admin's answer, shown to the tenant; trimmed, at most `TENANT_APPEAL_MESSAGE_MAX_LENGTH`.
  reviewNote        String?            @db.Text

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submittedBy User   @relation("TenantSuspensionAppealSubmitter", fields: [submittedByUserId], references: [id], onDelete: Cascade)
  reviewedBy  User?  @relation("TenantSuspensionAppealReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId], where: { status: "PENDING", isDeleted: false })
  @@index([tenantId, createdAt])
  @@index([status, createdAt])
}

enum TenantAppealStatus {
