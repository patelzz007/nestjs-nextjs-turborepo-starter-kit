/// Whether a linked GitHub token still works: GitHub answering 401 for it marks it REJECTED (ADR 052).
enum GithubAccountLinkStatus {
  ACTIVE
  REJECTED
}

/// An admin's own fine-grained GitHub token, used to read and act on pull requests as them (ADR 052).
/// One row per user: linking again replaces the token in place, unlinking soft-deletes the row.
/// The token is AES-256-GCM encrypted (`iv:tag:ciphertext`) with GITHUB_CREDENTIAL_ENCRYPTION_KEYS
/// version `tokenKeyVersion`, the owner's user id as additional authenticated data.
/// RLS: own row — `app_owns(userId)`.
/// @extends BaseModel
model GithubAccountLink {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  userId          String                  @unique
  /// GitHub's numeric id of the token's account (stable across login renames).
  githubUserId    BigInt
  /// The token account's login at link time (GitHub logins are at most 39 characters).
  githubLogin     String                  @db.VarChar(39)
  tokenCiphertext String                  @db.Text
  tokenKeyVersion Int
  /// Epoch ms when GitHub expires the token; null for a token without an expiry.
  tokenExpiresAt  BigInt?
  status          GithubAccountLinkStatus @default(ACTIVE)
  /// Epoch ms when the current token was linked (a re-link resets it; being marked REJECTED does not).
  linkedAt        BigInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A webhook the API registered on one repository so its pull requests update live in the apps (ADR 052).
/// One row per repository, shared by every admin: turning live updates off soft-deletes it, turning them
/// on again restores it with the new hook. Owner and repository are stored lower-case (GitHub matches
/// them case-insensitively).
/// RLS: bypass-only (`app_rls_bypass_on('GithubWebhookSubscription')`, operation `github.webhook.subscriptions`).
/// @extends BaseModel
model GithubWebhookSubscription {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  owner        String @db.VarChar(39)
  repository   String @db.VarChar(100)
  /// GitHub's id of the hook — what turning live updates off deletes.
  githubHookId BigInt
  /// The admin whose token registered the hook.
  createdBy    String

  creator User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([owner, repository])
  @@index([createdBy])
}

/// One verified GitHub webhook delivery (ADR 052), kept so a redelivery of it is recognised and ignored.
/// Append-only; deliveries older than the retention window are pruned.
/// RLS: bypass-only (`app_rls_bypass_on('GithubWebhookDelivery')`, operation `github.webhook.deliveries`).
/// @extends BaseModel
model GithubWebhookDelivery {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  /// GitHub's `X-GitHub-Delivery` id.
  deliveryId        String @id @db.VarChar(64)
  /// GitHub's `X-GitHub-Event` (`pull_request`, `issue_comment`, …).
  event             String @db.VarChar(64)
  owner             String @db.VarChar(39)
  repository        String @db.VarChar(100)
  /// The pull request it is about; null for an event about the repository (`ping`).
  pullRequestNumber Int?
  receivedAt        BigInt

  @@index([receivedAt])
}

