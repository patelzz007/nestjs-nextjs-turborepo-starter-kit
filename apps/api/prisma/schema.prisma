/// RLS: TENANT — platform onboarding or team-member invite.
/// @extends BaseModel
model OrganizationInvitation {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  organizationId       String?
  /// Case-insensitive (citext), so the one-PENDING-per-(organization, email, kind) unique ignores case.
  email                String                        @db.Citext
  tokenHash            String                        @unique @db.Text
  kind                 OrganizationInvitationKind    @default(PLATFORM_ONBOARDING)
  intendedRole         OrganizationMembershipRole
  locationScopeType    OrganizationLocationScopeType @default(ALL_LOCATIONS)
  status               OrganizationInvitationStatus  @default(PENDING)
  createdByAdminId     String
  acceptedByUserId     String?
  expiresAt            BigInt
  acceptedAt           BigInt?
  /// When the post-acceptance KYB document submission consumed this token (onboarding tokens are single-use).
  documentsSubmittedAt BigInt?

  organization   Organization?                         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdByAdmin User                                  @relation("OrganizationInvitationCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  acceptedByUser User?                                 @relation("OrganizationInvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  locationScopes OrganizationInvitationLocationScope[]

  @@unique([organizationId, email, kind], where: { status: "PENDING" })
  @@index([email])
  @@index([organizationId])
  @@index([organizationId, kind, status])
  /// `GET /orgs/:orgSlug/members/invites`: one organization's pending team invites, newest first.
  @@index([organizationId, kind, status, createdAt(sort: Desc), id(sort: Desc)])
}

