/// RLS: TENANT — envelope encryption key metadata.
/// @extends BaseModel
model TenantEncryptionKey {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  tenantId   String
  keyVersion Int
  /// Provider-serialized ciphertext of the data key (local provider: base64 `iv:tag:ciphertext`, AES-256-GCM).
  wrappedKey String                    @db.Text
  /// Key id of the KEK that wrapped `wrappedKey` (e.g. `local-dev-kek/v2`; legacy `local:pilot`).
  /// `pnpm db:rewrap-tenant-keys` moves every row to the provider's current KEK.
  kmsKeyId   String                    @db.VarChar(255)
  status     TenantEncryptionKeyStatus @default(ACTIVE)
  /// Last time the data key was re-wrapped under a new KEK.
  rotatedAt  BigInt?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, keyVersion])
  /// At most one ACTIVE data key per tenant — concurrent first-key creation cannot create two.
  @@unique([tenantId], where: { status: "ACTIVE" })
  @@index([kmsKeyId])
}

