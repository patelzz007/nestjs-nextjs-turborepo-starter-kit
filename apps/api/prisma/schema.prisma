  createdByUserId            String
  revokedAt                  BigInt?
  lastUsedAt                 BigInt?
  /// POS code-guess lockout (see `PosCodeLockoutService`): unknown QR tokens / backup codes presented with this key in the current window.
  codeFailureCount           Int               @default(0)
  /// Start of the current failure-counting window; null before the first failure.
  codeFailureWindowStartedAt BigInt?
  /// While in the future, every redemption call with this key is refused (429 POS_CODE_LOCKED).
  codeLockedUntil            BigInt?

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location?       @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  creator  User            @relation("TenantApiKeyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sales    RewardSale[]
  terminal TenantTerminal?

  /// Composite target of the tenant-scoped foreign keys (multi-tenancy plan §7): a child row
  /// can reference this row only from the same tenant.
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([locationId])
}

