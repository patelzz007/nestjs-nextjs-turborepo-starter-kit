}

// ---------------------------------------------------------------------------
// Impersonation Audit Log
// ---------------------------------------------------------------------------

/// RLS: INSERT + SELECT need `app_rls_bypass()`; UPDATE/DELETE revoked for `app_runtime` (immutable audit).
model ImpersonationAuditLog {
  id             String  @id @default(uuid())
  impersonatorId String  @map("impersonator_id")
  targetUserId   String  @map("target_user_id")
  action         String // "START" | "STOP"
  ipAddress      String? @map("ip_address") @db.VarChar(45)
  userAgent      String? @map("user_agent") @db.Text
  /// The server-side impersonation session this START/STOP row belongs to.
  sessionId      String? @map("session_id")
  createdAt      BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")

  impersonator User                  @relation("Impersonator", fields: [impersonatorId], references: [id], onDelete: Cascade)
  targetUser   User                  @relation("ImpersonationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  session      ImpersonationSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([impersonatorId])
  @@index([targetUserId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("impersonation_audit_logs")
}

/// Why an impersonation session ended before its `expiresAt`.
enum ImpersonationSessionEndReason {
  /// The super-admin stopped impersonating (`POST /auth/stop-impersonation`).
  STOPPED
}

/// Server-side record of one SuperAdmin impersonation session. The
/// impersonation access token carries this row's `id` as its
/// `impersonationSessionId` claim; `AuthGuard` rejects the token unless the
/// row exists, matches the token's impersonator + target, has not ended, has
/// not expired, and the impersonator is still an active, non-deleted
/// SuperAdmin. Stopping ends the row with a compare-and-set on `endedAt IS NULL`.
/// Rows are never deleted — an ended session is part of the forensic record.
/// RLS: bypass-only (`app_rls_bypass()`): written under `platform.superadmin` /
/// `route.rls_bypass`, read by `AuthGuard` under `request.pre_handler`.
model ImpersonationSession {
  id             String                         @id @default(uuid())
  impersonatorId String                         @map("impersonator_id")
  targetUserId   String                         @map("target_user_id")
  startedAt      BigInt                         @map("started_at")
  expiresAt      BigInt                         @map("expires_at")
  endedAt        BigInt?                        @map("ended_at")
  endedBy        String?                        @map("ended_by")
  endReason      ImpersonationSessionEndReason? @map("end_reason")
  ipAddress      String?                        @map("ip_address") @db.VarChar(45)
  userAgent      String?                        @map("user_agent") @db.Text
  createdAt      BigInt                         @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt      BigInt                         @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  impersonator User                    @relation("ImpersonationSessionImpersonator", fields: [impersonatorId], references: [id], onDelete: Restrict)
  targetUser   User                    @relation("ImpersonationSessionTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  auditLogs    ImpersonationAuditLog[]

  @@index([impersonatorId, endedAt])
  @@index([targetUserId])
  @@map("impersonation_sessions")
}

/// RLS: INSERT open (request capture); SELECT/UPDATE/DELETE need bypass.
model Log {
  id            String   @id @default(uuid())
  level         String
  message       String   @db.Text
  context       String?
  userId        String?
  correlationId String?  @map("correlation_id")
  metadata      Json?
  durationMs    Int?     @map("duration_ms")
  errorGroup    String?  @map("error_group")
  tags          String[] @default([])
  timestamp     BigInt   @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdAt     BigInt   @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))

  @@index([level])
  @@index([timestamp])
  @@index([context])
  @@index([message])
  @@index([userId])
  @@index([correlationId])
  @@index([errorGroup])
  @@map("logs")
}

/// RLS: via parent api_key — `app_owns(api_keys.user_id)`.
model ApiKeyUsageLog {
  id             String  @id @default(uuid())
  apiKeyId       String  @map("api_key_id")
  endpoint       String  @db.VarChar(255)
  method         String  @db.VarChar(10)
  statusCode     Int     @map("status_code")
  ipAddress      String? @map("ip_address") @db.VarChar(45)
  userAgent      String? @map("user_agent") @db.Text
  responseTimeMs Int?    @map("response_time_ms")
  isDeleted      Boolean @default(false) @map("is_deleted")
  deletedAt      BigInt? @map("deleted_at")
  createdAt      BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt      BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([apiKeyId, createdAt])
  @@index([createdAt])
  @@map("api_key_usage_logs")
}

// ---------------------------------------------------------------------------
// Email Audit Trail
// ---------------------------------------------------------------------------

/// RLS: INSERT open (mail send); SELECT/UPDATE/DELETE need bypass.
model EmailLog {
  id          String  @id @default(uuid())
  templateKey String  @map("template_key")
  to          String  @db.VarChar(255)
  subject     String  @db.VarChar(255)
  status      String // EmailLogStatus: "pending" | "sent" | "delivered" | "bounced" | "complained" | "failed"
  resendId    String? @map("resend_id")
  error       String? @db.Text
  metadata    Json?
  /// Epoch ms (provider clock) of the newest delivery webhook event applied to this row — the
  /// ordering guard: an older event that arrives late never overrides a newer outcome.
  lastEventAt BigInt? @map("last_event_at")
  createdAt   BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt   BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  deliveryEvents EmailDeliveryEvent[]

  @@index([status])
  @@index([templateKey])
  @@index([to])
  @@index([resendId])
  @@index([createdAt])
  @@map("email_logs")
}

/// Every Resend delivery webhook event received, verified and recorded once (history of an
/// email's lifecycle; `email_logs.status` is only the latest outcome). `webhook_id` (the signed
/// `webhook-id` / `svix-id` header) is UNIQUE, so a redelivered webhook is a no-op.
/// Infrastructure log, not a business entity: no soft delete. RLS: insert/select/update bypass-only.
model EmailDeliveryEvent {
  id         String               @id @default(uuid())
  webhookId  String               @unique @map("webhook_id") @db.VarChar(255)
  eventType  String               @map("event_type") @db.VarChar(64)
  resendId   String               @map("resend_id") @db.VarChar(255)
  emailLogId String?              @map("email_log_id")
  emailLog   EmailLog?            @relation(fields: [emailLogId], references: [id], onDelete: Restrict)
  /// The EmailLogStatus the event maps to; null for tracking events the log ignores.
  status     EmailLogStatus?
  detail     String?              @db.VarChar(300)
  /// Epoch ms when the provider observed the event (its `created_at`).
  occurredAt BigInt               @map("occurred_at")
  /// What this event did to `email_logs`.
  outcome    EmailDeliveryOutcome
  createdAt  BigInt               @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")

  @@index([resendId])
  @@index([emailLogId, occurredAt])
  @@index([createdAt])
  @@map("email_delivery_events")
}

/// Lifecycle of one outbound email — mirrors `EmailLogStatusSchema` in @workspace/shared
/// (apps/api/src/modules/notifications/email/email-status.enums.spec.ts asserts they are identical).
/// Used by `email_delivery_events.status`. `email_logs.status` is still TEXT: converting an
/// existing populated column to an enum needs a data-preserving cast Prisma does not generate.
enum EmailLogStatus {
  pending
  sent
  delivered
  bounced
  complained
  failed
}

/// What a verified delivery-webhook event did to its `email_logs` row — mirrors
/// `DeliveryEventOutcomeSchema` in @workspace/shared.
enum EmailDeliveryOutcome {
  applied /// moved the row forward
  stale /// older than (or a regression of) the row's newest applied outcome
  unmatched /// no row: an email this system never sent
  ignored /// tracking event (opened / clicked / …) — never changes the row
}

// ---------------------------------------------------------------------------
// Geographical data (Country / State / City)
// Source: dr5hn/countries-states-cities-database
// Reference data: world-readable; written only by SuperAdmins through the
// `geo.reference_data.write` system operation (prisma/rls.sql). Soft-deleted,
// never hard-deleted (a delete cascades the soft delete to the children).
// ---------------------------------------------------------------------------

model Region {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(255)
  translations Json?
  wikiDataId   String?  @db.VarChar(255)
  flag         Boolean  @default(true)
  /// Soft delete (rules/08): reference rows are never hard-deleted; reads filter `isDeleted: false`.
  isDeleted    Boolean  @default(false) @map("is_deleted")
  deletedAt    BigInt?  @map("deleted_at")
  /// User id of the SuperAdmin who soft-deleted the row.
  deletedBy    String?  @map("deleted_by") @db.VarChar(64)
  createdAt    DateTime @default(dbgenerated("'2014-01-01 12:01:01'::timestamp without time zone")) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  countries  Country[]
  subregions Subregion[]

  /// Trigram index for the geo `?search=` similarity filter (`name % $1`).
  @@index([name(ops: raw("gin_trgm_ops"))], map: "regions_name_trgm_idx", type: Gin)
  @@map("regions")
}

model Subregion {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(255)
  translations Json?
  wikiDataId   String?  @db.VarChar(255)
  flag         Boolean  @default(true)
  /// Soft delete (rules/08): reference rows are never hard-deleted; reads filter `isDeleted: false`.
  isDeleted    Boolean  @default(false) @map("is_deleted")
  deletedAt    BigInt?  @map("deleted_at")
  /// User id of the SuperAdmin who soft-deleted the row.
  deletedBy    String?  @map("deleted_by") @db.VarChar(64)
  createdAt    DateTime @default(dbgenerated("'2014-01-01 12:01:01'::timestamp without time zone")) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  region    Region    @relation(fields: [regionId], references: [id])
  regionId  Int       @map("region_id")
  countries Country[]

  @@index([regionId])
  /// Trigram index for the geo `?search=` similarity filter (`name % $1`).
  @@index([name(ops: raw("gin_trgm_ops"))], map: "subregions_name_trgm_idx", type: Gin)
  @@map("subregions")
}

model Country {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(255)
  iso3           String?  @db.VarChar(3)
  numericCode    String?  @map("numeric_code") @db.VarChar(3)
  iso2           String?  @db.VarChar(2)
  phonecode      String?  @db.VarChar(255)
  capital        String?  @db.VarChar(255)
  currency       String?  @db.VarChar(255)
  currencyName   String?  @map("currency_name") @db.VarChar(255)
  currencySymbol String?  @map("currency_symbol") @db.VarChar(255)
  tld            String?  @db.VarChar(255)
  native         String?  @db.VarChar(255)
  population     BigInt?  @db.BigInt
  gdp            BigInt?  @db.BigInt
  region         String?  @db.VarChar(255)
  subregion      String?  @db.VarChar(255)
  nationality    String?  @db.VarChar(255)
  timezones      Json?
  translations   Json?
  latitude       Decimal? @db.Decimal(10, 8)
  longitude      Decimal? @db.Decimal(11, 8)
  emoji          String?  @db.VarChar(191)
  emojiU         String?  @db.VarChar(191)
  wikiDataId     String?  @db.VarChar(255)
  flag           Boolean  @default(true)
  /// Soft delete (rules/08): reference rows are never hard-deleted; reads filter `isDeleted: false`.
  isDeleted      Boolean  @default(false) @map("is_deleted")
  deletedAt      BigInt?  @map("deleted_at")
  /// User id of the SuperAdmin who soft-deleted the row.
  deletedBy      String?  @map("deleted_by") @db.VarChar(64)
  createdAt      DateTime @default(dbgenerated("'2014-01-01 12:01:01'::timestamp without time zone")) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  regionRelation    Region?    @relation(fields: [regionId], references: [id])
  regionId          Int?       @map("region_id")
  subregionRelation Subregion? @relation(fields: [subregionId], references: [id])
  subregionId       Int?       @map("subregion_id")

  states State[]
  cities City[]

  @@index([regionId])
  @@index([subregionId])
  /// Trigram index for the geo `?search=` similarity filter (`name % $1`).
  @@index([name(ops: raw("gin_trgm_ops"))], map: "countries_name_trgm_idx", type: Gin)
  @@map("countries")
}

model State {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(255)
  countryCode  String   @map("country_code") @db.VarChar(2)
  fipsCode     String?  @map("fips_code") @db.VarChar(255)
  iso2         String?  @db.VarChar(255)
  iso3166_2    String?  @db.VarChar(255)
  type         String?  @db.VarChar(191)
  level        Int?
  parentId     Int?     @map("parent_id")
  native       String?  @db.VarChar(255)
  latitude     Decimal? @db.Decimal(10, 8)
  longitude    Decimal? @db.Decimal(11, 8)
  timezone     String?  @db.VarChar(255)
  translations Json?
  wikiDataId   String?  @db.VarChar(255)
  flag         Boolean  @default(true)
  /// Soft delete (rules/08): reference rows are never hard-deleted; reads filter `isDeleted: false`.
  isDeleted    Boolean  @default(false) @map("is_deleted")
  deletedAt    BigInt?  @map("deleted_at")
  /// User id of the SuperAdmin who soft-deleted the row.
  deletedBy    String?  @map("deleted_by") @db.VarChar(64)
  createdAt    DateTime @default(dbgenerated("'2014-01-01 12:01:01'::timestamp without time zone")) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  country   Country @relation(fields: [countryId], references: [id])
  countryId Int     @map("country_id")
  cities    City[]

  @@index([countryId])
  /// Trigram index for the geo `?search=` similarity filter (`name % $1`).
  @@index([name(ops: raw("gin_trgm_ops"))], map: "states_name_trgm_idx", type: Gin)
  @@map("states")
}

model City {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(255)
  stateCode    String   @map("state_code") @db.VarChar(255)
  countryCode  String   @map("country_code") @db.VarChar(2)
  latitude     Decimal  @db.Decimal(10, 8)
  longitude    Decimal  @db.Decimal(11, 8)
  native       String?  @db.VarChar(255)
  timezone     String?  @db.VarChar(255)
  translations Json?
  wikiDataId   String?  @db.VarChar(255)
  flag         Boolean  @default(true)
  /// Soft delete (rules/08): reference rows are never hard-deleted; reads filter `isDeleted: false`.
  isDeleted    Boolean  @default(false) @map("is_deleted")
  deletedAt    BigInt?  @map("deleted_at")
  /// User id of the SuperAdmin who soft-deleted the row.
  deletedBy    String?  @map("deleted_by") @db.VarChar(64)
  createdAt    DateTime @default(dbgenerated("'2014-01-01 12:01:01'::timestamp without time zone")) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  state     State   @relation(fields: [stateId], references: [id])
  stateId   Int     @map("state_id")
  country   Country @relation(fields: [countryId], references: [id])
  countryId Int     @map("country_id")

  @@index([stateId])
  @@index([countryId])
  /// Trigram index for the geo `?search=` similarity filter (`name % $1`).
  @@index([name(ops: raw("gin_trgm_ops"))], map: "cities_name_trgm_idx", type: Gin)
  @@map("cities")
}

// ---------------------------------------------------------------------------
// Organization multi-tenancy (see docs/technical/authorization/tenancy-and-rls.md, ADRs 008–013)
// ---------------------------------------------------------------------------

enum PilotCity {
  KUALA_LUMPUR
  MELAKA
}

enum KybStatus {
  PENDING
  APPROVED
  REJECTED
  ACTION_REQUIRED
}

enum OrganizationLifecycleState {
  PROVISIONING
  ACTIVE
  RESTRICTED
  SUSPENDED
  PENDING_DELETION
  DELETED
}

enum OrganizationMembershipRole {
  OWNER
  ADMIN
  MEMBER
  POLICY_ADMIN
  CASHIER
}

enum OrganizationMembershipStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum OrganizationLocationScopeType {
  ALL_LOCATIONS
  SELECTED
}

enum OrganizationLocationStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  INACTIVE
}

enum OrganizationInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum OrganizationInvitationKind {
  PLATFORM_ONBOARDING
  TEAM_MEMBER
}

enum OrganizationAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AuthorizationPolicyScope {
  PLATFORM_GUARDRAIL
  PLATFORM
  TENANT
}

/// How a published policy draft was approved.
enum AuthorizationPolicyApprovalKind {
  /// Approved and published by a SuperAdmin other than its author (policy control plane).
  FOUR_EYES
  /// The fixed, code-reviewed default tenant template published at organization provisioning;
  /// no human approver exists (`approvedById` is NULL) and the publish is audited with this reason.
  PLATFORM_DEFAULT_TEMPLATE
}

enum AuthorizationPolicyStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  SUPERSEDED
  ROLLED_BACK
}

enum SupportAccessGrantMode {
  READ_ONLY
  WRITE_ELEVATED
}

enum SupportAccessGrantStatus {
  PENDING_APPROVAL
  PENDING_TENANT_APPROVAL
  ACTIVE
  EXPIRED
  REVOKED
  DENIED
}

enum TenantPlacementKind {
  SHARED
  DEDICATED
}

enum TenantEncryptionKeyStatus {
  ACTIVE
  ROTATING
  REVOKED
}

/// RLS: TENANT — canonical organization root.
model Organization {
  id                  String                     @id @default(uuid())
  slug                String                     @unique @db.VarChar(64)
  displayName         String                     @map("display_name") @db.VarChar(200)
  lifecycleState      OrganizationLifecycleState @default(PROVISIONING) @map("lifecycle_state")
  /// IANA time zone the merchant operates in (e.g. Asia/Kuala_Lumpur): merchant analytics bucket weeks
  /// at Monday 00:00 in this zone. Validated by `IanaTimeZoneSchema`; the default is
  /// `PLATFORM_DISPLAY_REGION.timeZone` (packages/shared) and must stay equal to it.
  timeZone            String                     @default("Asia/Kuala_Lumpur") @map("time_zone") @db.VarChar(64)
  deletionGraceEndsAt BigInt?                    @map("deletion_grace_ends_at")
  isDeleted           Boolean                    @default(false) @map("is_deleted")
  deletedAt           BigInt?                    @map("deleted_at")
  createdAt           BigInt                     @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt           BigInt                     @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  slugHistory              OrganizationSlugHistory[]
  locations                OrganizationLocation[]
  memberships              OrganizationMembership[]
  merchantProfile          OrganizationMerchantProfile?
  invitations              OrganizationInvitation[]
  accessRequests           OrganizationAccessRequest[]
  lifecycleEvents          OrganizationLifecycleEvent[]
  placement                TenantPlacement?
  entitlements             OrganizationEntitlement[]
  quotas                   OrganizationQuota[]
  policyDrafts             AuthorizationPolicyDraft[]
  policyVersions           AuthorizationPolicyVersion[]
  supportGrants            SupportAccessGrant[]
  encryptionKeys           TenantEncryptionKey[]
  auditLogs                OrganizationAuditLog[]
  rewards                  Reward[]
  redemptions              RewardRedemption[]
  rewardSales              RewardSale[]
  rewardAuditLogs          RewardAuditLog[]
  apiKeys                  OrganizationApiKey[]
  kybFiles                 OrganizationKybFile[]
  assets                   OrganizationAsset[]
  terminals                OrganizationTerminal[]
  storedFiles              StoredFile[]                          @relation("StoredFileOrganization")
  membershipLocationScopes OrganizationMembershipLocationScope[]
  invitationLocationScopes OrganizationInvitationLocationScope[]
  rewardLocationScopes     RewardLocationScope[]
  stores                   Store[]
  storeMemberships         StoreMembership[]

  @@index([lifecycleState])
  @@map("organizations")
}

/// RLS: TENANT — reserved slug aliases for safe redirects.
model OrganizationSlugHistory {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  slug           String  @db.VarChar(64)
  reservedUntil  BigInt? @map("reserved_until")
  createdAt      BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([slug])
  @@index([organizationId])
  @@map("organization_slug_history")
}

/// RLS: TENANT — store/site within an organization.
model OrganizationLocation {
  id                String                     @id @default(uuid())
  organizationId    String                     @map("organization_id")
  name              String                     @db.VarChar(200)
  code              String                     @db.VarChar(64)
  addressText       String?                    @map("address_text") @db.Text
  city              PilotCity?
  contactPhone      String?                    @map("contact_phone") @db.VarChar(20)
  status            OrganizationLocationStatus @default(PENDING_APPROVAL)
  rejectionReason   String?                    @map("rejection_reason") @db.Text
  requestedByUserId String?                    @map("requested_by_user_id")
  reviewedByUserId  String?                    @map("reviewed_by_user_id")
  reviewedAt        BigInt?                    @map("reviewed_at")
  isPrimary         Boolean                    @default(false) @map("is_primary")
  /// Why the store was closed (bankruptcy, lease ended, ...); set together with the soft-delete fields when it is closed.
  closureReason     String?                    @map("closure_reason") @db.Text
  isDeleted         Boolean                    @default(false) @map("is_deleted")
  deletedAt         BigInt?                    @map("deleted_at")
  deletedBy         String?                    @map("deleted_by")
  createdAt         BigInt                     @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt         BigInt                     @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  organization             Organization                          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy              User?                                 @relation("OrganizationLocationRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  reviewedBy               User?                                 @relation("OrganizationLocationReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  locationScopes           OrganizationMembershipLocationScope[]
  invitationLocationScopes OrganizationInvitationLocationScope[]
  rewardLocationScopes     RewardLocationScope[]
  terminals                OrganizationTerminal[]
  redemptions              RewardRedemption[]
  rewardSales              RewardSale[]
  apiKeys                  OrganizationApiKey[]
  store                    Store?

  @@unique([organizationId, code])
  /// At most one live primary location per organization (partial unique — soft-deleted rows ignored).
  @@unique([organizationId], map: "organization_locations_one_live_primary_key", where: { isPrimary: true, isDeleted: false })
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("organization_locations")
}

/// RLS: MEMBERSHIP — user membership in an organization.
model OrganizationMembership {
  id             String                       @id @default(uuid())
  organizationId String                       @map("organization_id")
  userId         String                       @map("user_id")
  role           OrganizationMembershipRole
  status         OrganizationMembershipStatus @default(ACTIVE)
  /// The member's own name for this organization (`PATCH /orgs/:orgSlug/members/me`); trimmed, at most
  /// `ORGANIZATION_MEMBER_DISPLAY_NAME_MAX_LENGTH` (100) characters; NULL = show the account's full name.
  displayName    String?                      @map("display_name") @db.VarChar(100)
  isDeleted      Boolean                      @default(false) @map("is_deleted")
  deletedAt      BigInt?                      @map("deleted_at")
  createdAt      BigInt                       @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt      BigInt                       @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  organization   Organization                          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                                  @relation("OrganizationMemberships", fields: [userId], references: [id], onDelete: Cascade)
  locationScopes OrganizationMembershipLocationScope[]

  /// One LIVE membership per (organization, user): soft-deleted rows are ignored so a removed member can be re-invited.
  /// Partial unique — not usable with `findUnique`; query it with `findFirst` + `isDeleted: false`.
  @@unique([organizationId, userId], where: { isDeleted: false })
  @@index([userId])
  @@index([organizationId, status])
  @@map("organization_memberships")
}

/// RLS: MEMBERSHIP — location scope for a membership.
model OrganizationMembershipLocationScope {
  id             String                        @id @default(uuid())
  organizationId String                        @map("organization_id")
  membershipId   String                        @map("membership_id")
  scopeType      OrganizationLocationScopeType @map("scope_type")
  locationId     String?                       @map("location_id")
  createdAt      BigInt                        @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  location     OrganizationLocation?  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([membershipId, locationId])
  @@index([organizationId])
  @@map("organization_membership_location_scopes")
}

/// Store lifecycle — mirrors the linked location (ACTIVE only while the location is ACTIVE).
enum StoreStatus {
  ACTIVE
  INACTIVE
}

/// RLS: TENANT — a store within an organization (spec §35). Each store is linked 1:1 to
/// its operational `OrganizationLocation` (terminals, rewards, redemptions) and kept in
/// sync by `OrganizationLocationRepository`.
model Store {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  locationId     String      @unique @map("location_id")
  name           String      @db.VarChar(200)
  code           String      @db.VarChar(64)
  status         StoreStatus @default(INACTIVE)
  isDeleted      Boolean     @default(false) @map("is_deleted")
  deletedAt      BigInt?     @map("deleted_at")
  deletedBy      String?     @map("deleted_by")
  createdAt      BigInt      @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt      BigInt      @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     OrganizationLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  memberships  StoreMembership[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("stores")
}

/// RLS: TENANT — a user's membership in one store with a dynamic RBAC role (spec §36).
/// The role's permissions apply only inside this store (STORE scope).
model StoreMembership {
  id             String                       @id @default(uuid())
  organizationId String                       @map("organization_id")
  storeId        String                       @map("store_id")
  userId         String                       @map("user_id")
  roleId         String                       @map("role_id")
  status         OrganizationMembershipStatus @default(ACTIVE)
  isDeleted      Boolean                      @default(false) @map("is_deleted")
  deletedAt      BigInt?                      @map("deleted_at")
  deletedBy      String?                      @map("deleted_by")
  createdAt      BigInt                       @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt      BigInt                       @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user         User         @relation("StoreMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
  @@index([organizationId])
  @@index([roleId])
  @@map("store_memberships")
}

/// RLS: TENANT — merchant-specific organization profile (KYB, contact).
model OrganizationMerchantProfile {
  id                         String    @id @default(uuid())
  organizationId             String    @unique @map("organization_id")
  legalName                  String?   @map("legal_name") @db.VarChar(200)
  /// Null until the merchant submits it during onboarding (an admin invite does not know it).
  category                   String?   @db.VarChar(100)
  addressText                String?   @map("address_text") @db.Text
  city                       PilotCity
  kybStatus                  KybStatus @default(PENDING) @map("kyb_status")
  kybFields                  Json?     @map("kyb_fields")
  contactEmail               String    @map("contact_email") @db.VarChar(100)
  contactPhone               String?   @map("contact_phone") @db.VarChar(20)
  /// When on, POS calls with a manually created API key must come from a registered terminal id.
  requireRegisteredTerminals Boolean   @default(false) @map("require_registered_terminals")
  createdAt                  BigInt    @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt                  BigInt    @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([kybStatus])
  @@map("organization_merchant_profiles")
}

/// RLS: TENANT — platform onboarding or team-member invite.
model OrganizationInvitation {
  id                   String                        @id @default(uuid())
  organizationId       String?                       @map("organization_id")
  /// Case-insensitive (citext), so the one-PENDING-per-(organization, email, kind) unique ignores case.
  email                String                        @db.Citext
  tokenHash            String                        @unique @map("token_hash") @db.Text
  kind                 OrganizationInvitationKind    @default(PLATFORM_ONBOARDING) @map("kind")
  intendedRole         OrganizationMembershipRole    @map("intended_role")
  locationScopeType    OrganizationLocationScopeType @default(ALL_LOCATIONS) @map("location_scope_type")
  status               OrganizationInvitationStatus  @default(PENDING)
  createdByAdminId     String                        @map("created_by_admin_id")
  acceptedByUserId     String?                       @map("accepted_by_user_id")
  expiresAt            BigInt                        @map("expires_at")
  acceptedAt           BigInt?                       @map("accepted_at")
  /// When the post-acceptance KYB document submission consumed this token (onboarding tokens are single-use).
  documentsSubmittedAt BigInt?                       @map("documents_submitted_at")
  createdAt            BigInt                        @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt            BigInt                        @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  organization   Organization?                         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdByAdmin User                                  @relation("OrganizationInvitationCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  acceptedByUser User?                                 @relation("OrganizationInvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  locationScopes OrganizationInvitationLocationScope[]

  /// At most one PENDING invitation per (organization, email, kind) — concurrent duplicate invites fail with a unique violation (409).
  @@unique([organizationId, email, kind], map: "organization_invitations_one_pending_key", where: { status: "PENDING" })
  @@index([email])
  @@index([organizationId])
  @@index([organizationId, kind, status])
  @@map("organization_invitations")
}

/// RLS: TENANT — selected locations on a pending team invite.
model OrganizationInvitationLocationScope {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  invitationId   String @map("invitation_id")
  locationId     String @map("location_id")
  createdAt      BigInt @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitation   OrganizationInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  location     OrganizationLocation   @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([invitationId, locationId])
  @@index([organizationId])
  @@map("organization_invitation_location_scopes")
}

/// RLS: TENANT — user-requested access to an organization.
model OrganizationAccessRequest {
  id             String                          @id @default(uuid())
  organizationId String                          @map("organization_id")
  userId         String                          @map("user_id")
  status         OrganizationAccessRequestStatus @default(PENDING)
  message        String?                         @db.Text
  reviewedById   String?                         @map("reviewed_by_id")
  reviewedAt     BigInt?                         @map("reviewed_at")
  createdAt      BigInt                          @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt      BigInt                          @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("OrganizationAccessRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("OrganizationAccessRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  /// At most one PENDING access request per (organization, user) — concurrent duplicates fail with a unique violation (409).
  @@unique([organizationId, userId], map: "organization_access_requests_one_pending_key", where: { status: "PENDING" })
  @@index([organizationId, userId, status])
  @@index([organizationId, status])
  @@map("organization_access_requests")
}

/// RLS: OPERATIONAL — lifecycle state transition audit.
model OrganizationLifecycleEvent {
  id             String                      @id @default(uuid())
  organizationId String                      @map("organization_id")
  fromState      OrganizationLifecycleState? @map("from_state")
  toState        OrganizationLifecycleState  @map("to_state")
  actorUserId    String?                     @map("actor_user_id")
  reason         String?                     @db.Text
  /// The request's correlation id (or the system operation's, for background work) the transition ran under.
  /// Written only by `OrganizationLifecycleEventRecorder`, which reads it from the transaction (`app.correlation_id`).
  correlationId  String                      @map("correlation_id") @db.VarChar(64)
  createdAt      BigInt                      @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("organization_lifecycle_events")
}

/// RLS: TENANT — future placement / shard directory.
model TenantPlacement {
  id             String              @id @default(uuid())
  organizationId String              @unique @map("organization_id")
  kind           TenantPlacementKind @default(SHARED)
  regionCode     String              @default("default") @map("region_code") @db.VarChar(32)
  createdAt      BigInt              @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt      BigInt              @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("tenant_placements")
}

/// RLS: TENANT — plan entitlements (billing deferred).
model OrganizationEntitlement {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  planCode       String @map("plan_code") @db.VarChar(64)
  features       Json
  version        Int    @default(1)
  effectiveFrom  BigInt @map("effective_from")
  createdAt      BigInt @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, effectiveFrom])
  @@map("organization_entitlements")
}

/// RLS: TENANT — usage quotas.
model OrganizationQuota {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  quotaKey       String @map("quota_key") @db.VarChar(64)
  limitValue     BigInt @map("limit_value")
  usedValue      BigInt @default(0) @map("used_value")
  windowStart    BigInt @map("window_start")
  windowEnd      BigInt @map("window_end")
  createdAt      BigInt @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt      BigInt @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, quotaKey, windowStart])
  @@map("organization_quotas")
}

/// RLS: TENANT + GLOBAL — Cedar policy drafts.
model AuthorizationPolicyDraft {
  id             String                           @id @default(uuid())
  organizationId String?                          @map("organization_id")
  scope          AuthorizationPolicyScope
  name           String                           @db.VarChar(120)
  description    String?                          @db.Text
  builderPayload Json                             @map("builder_payload")
  cedarSource    String                           @map("cedar_source") @db.Text
  sqlPredicate   String?                          @map("sql_predicate") @db.Text
  status         AuthorizationPolicyStatus        @default(DRAFT)
  createdById    String                           @map("created_by_id")
  /// The second SuperAdmin who approved a FOUR_EYES publish; NULL for PLATFORM_DEFAULT_TEMPLATE.
  approvedById   String?                          @map("approved_by_id")
  /// NULL until the draft is published.
  approvalKind   AuthorizationPolicyApprovalKind? @map("approval_kind")
  createdAt      BigInt                           @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt      BigInt                           @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  organization Organization?                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                            @relation("AuthorizationPolicyDraftCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy   User?                           @relation("AuthorizationPolicyDraftApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  versions     AuthorizationPolicyVersion[]
  simulations  AuthorizationPolicySimulation[]

  @@index([organizationId, status])
  @@map("authorization_policy_drafts")
}

/// RLS: TENANT + GLOBAL — immutable published policy versions.
model AuthorizationPolicyVersion {
  id             String                   @id @default(uuid())
  organizationId String?                  @map("organization_id")
  draftId        String                   @map("draft_id")
  scope          AuthorizationPolicyScope
  version        Int
  cedarSource    String                   @map("cedar_source") @db.Text
  sqlPredicate   String?                  @map("sql_predicate") @db.Text
  contentHash    String                   @map("content_hash") @db.VarChar(64)
  publishedAt    BigInt                   @map("published_at")
  publishedById  String                   @map("published_by_id")
  supersededAt   BigInt?                  @map("superseded_at")

  organization Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  draft        AuthorizationPolicyDraft @relation(fields: [draftId], references: [id], onDelete: Restrict)
  publishedBy  User                     @relation("AuthorizationPolicyPublisher", fields: [publishedById], references: [id], onDelete: Restrict)

  /// Version numbers are unique per (organization, scope) slot and at most one version per slot is
  /// active. Platform-scope rows have a NULL organizationId, which a plain unique index treats as
  /// distinct — so the platform slots get their own partial unique indexes (organizationId IS NULL).
  @@unique([organizationId, scope, version])
  @@unique([scope, version], map: "authorization_policy_versions_platform_scope_version_key", where: { organizationId: null })
  @@unique([organizationId, scope], map: "authorization_policy_versions_one_active_per_scope_key", where: { supersededAt: null })
  @@unique([scope], map: "authorization_policy_versions_platform_one_active_per_scope_key", where: { organizationId: null, supersededAt: null })
  @@index([organizationId, publishedAt])
  @@map("authorization_policy_versions")
}

/// RLS: OPERATIONAL — policy simulation runs.
model AuthorizationPolicySimulation {
  id                  String  @id @default(uuid())
  draftId             String  @map("draft_id")
  actorUserId         String  @map("actor_user_id")
  result              Json
  passed              Boolean
  /// sha256 of the published policy versions the draft was simulated against.
  /// Publishing requires it to equal the current baseline (NULL = recorded before
  /// baseline tracking existed; never accepted for publish).
  baselineFingerprint String? @map("baseline_fingerprint") @db.VarChar(64)
  createdAt           BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")

  draft AuthorizationPolicyDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  actor User                     @relation("AuthorizationPolicySimulator", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([draftId, createdAt])
  @@map("authorization_policy_simulations")
}

/// RLS: OPERATIONAL — JIT support access grants.
model SupportAccessGrant {
  id                 String                   @id @default(uuid())
  organizationId     String                   @map("organization_id")
  supportUserId      String                   @map("support_user_id")
  mode               SupportAccessGrantMode   @default(READ_ONLY)
  status             SupportAccessGrantStatus @default(PENDING_TENANT_APPROVAL)
  reason             String                   @db.Text
  ticketRef          String?                  @map("ticket_ref") @db.VarChar(120)
  tenantApprovedById String?                  @map("tenant_approved_by_id")
  expiresAt          BigInt                   @map("expires_at")
  revokedAt          BigInt?                  @map("revoked_at")
  createdAt          BigInt                   @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supportUser  User         @relation("SupportAccessGrantSupportUser", fields: [supportUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([supportUserId, status])
  @@map("support_access_grants")
}

/// RLS: TENANT — envelope encryption key metadata.
model TenantEncryptionKey {
  id             String                    @id @default(uuid())
  organizationId String                    @map("organization_id")
  keyVersion     Int                       @map("key_version")
  /// Provider-serialized ciphertext of the data key (local provider: base64 `iv:tag:ciphertext`, AES-256-GCM).
  wrappedKey     String                    @map("wrapped_key") @db.Text
  /// Key id of the KEK that wrapped `wrappedKey` (e.g. `local-dev-kek/v2`; legacy `local:pilot`).
  /// `pnpm db:rewrap-tenant-keys` moves every row to the provider's current KEK.
  kmsKeyId       String                    @map("kms_key_id") @db.VarChar(255)
  status         TenantEncryptionKeyStatus @default(ACTIVE)
  /// Last time the data key was re-wrapped under a new KEK.
  rotatedAt      BigInt?                   @map("rotated_at")
  createdAt      BigInt                    @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, keyVersion])
  /// At most one ACTIVE data key per organization — concurrent first-key creation cannot create two.
  @@unique([organizationId], map: "tenant_encryption_keys_one_active_per_organization_key", where: { status: "ACTIVE" })
  @@index([kmsKeyId])
  @@map("tenant_encryption_keys")
}

/// RLS: TENANT — security and mutation audit (7-year retention).
model OrganizationAuditLog {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  actorUserId    String? @map("actor_user_id")
  action         String  @db.VarChar(120)
  resourceType   String  @map("resource_type") @db.VarChar(120)
  resourceId     String? @map("resource_id") @db.VarChar(64)
  decision       String? @db.VarChar(32)
  policyVersion  Int?    @map("policy_version")
  correlationId  String? @map("correlation_id") @db.VarChar(64)
  metadata       Json?
  createdAt      BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@map("organization_audit_logs")
}

