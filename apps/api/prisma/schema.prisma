generator client {
  provider        = "prisma-client-js"
  // `@@unique(..., where: ...)` — uniqueness that ignores soft-deleted rows.
  // `postgresqlExtensions` — the datasource `extensions` list (citext below);
  // Prisma 7.10 rejects `extensions` without this preview feature.
  previewFeatures = ["partialIndexes", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  /// citext: case-insensitive text for email addresses (users, invitations) —
  /// uniqueness and lookups ignore case at the database, not only at the API.
  /// pg_trgm: trigram similarity (`similarity()`, `%`) behind the geo `?search=`
  /// filters (GeoRepository.fuzzySearchIds), served by the `*_name_trgm_idx`
  /// GIN indexes on the five geo tables.
  extensions = [citext, pg_trgm]
}

// ---------------------------------------------------------------------------
// Row Level Security (Postgres)
//
// Prisma 7 PSL cannot emit CREATE ROLE, GRANT, ENABLE/FORCE RLS, or POLICY.
// **Do not append RLS to migrations/*/migration.sql** — squashed migrations
// would drop it. Canonical SQL: `prisma/rls.sql` + `prisma/rls/*.sql`, applied
// automatically by `pnpm db:migrate` / `db:reset` / `db:deploy` (`db:apply-security`).
//
// Schema-owned pieces (columns, indexes, maps) always land in this file first.
// Each model may document its RLS profile with `/// RLS:` comments.
//
// Runtime (apps/api):
//   - Role `app_runtime` (NOLOGIN NOSUPERUSER NOINHERIT NOBYPASSRLS)
//   - RlsPool + TenantTransactionService: SET ROLE + transaction-local set_config
//   - Session: app.current_user_id, app.current_organization_id, app.rls_bypass
//   - RBAC: roles/permissions (data) — guards, not per-role RLS policies
//   - ACL: organization_memberships + location scopes — generic SQL helpers
// See docs/technical/security/database-security.md.
// ---------------------------------------------------------------------------

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum RedirectType {
  PERMANENT // 301
  TEMPORARY // 302
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  BOT
  UNKNOWN
}

/// The app a device session belongs to (`X-Client-Type`, validated server-side). Mirrors `AuthClientTypeSchema`.
enum SessionClientType {
  web
  admin
  merchant
  mobile
}

/// How a device session was signed in — the proofs the login flow required. Mirrors `SessionSignInMethodSchema`.
enum SessionSignInMethod {
  /// Password only.
  PASSWORD
  /// Password, then the emailed new-device code.
  PASSWORD_NEW_DEVICE_CODE
  /// Password and an authenticator (TOTP) code.
  PASSWORD_TOTP
  /// Password, TOTP, then the emailed new-device code.
  PASSWORD_TOTP_NEW_DEVICE_CODE
  /// Password and a single-use backup code.
  PASSWORD_BACKUP_CODE
  /// Password, a backup code, then the emailed new-device code.
  PASSWORD_BACKUP_CODE_NEW_DEVICE_CODE
  /// A staff account created from a team invite (the password was set in the same request).
  TEAM_INVITE_REGISTRATION
  /// Team-invite registration, then the emailed new-device code.
  TEAM_INVITE_REGISTRATION_NEW_DEVICE_CODE
}

enum TwoFactorLoginChallengePurpose {
  LOGIN
  ROTATE
}

enum MfaRecoveryRequestStatus {
  PENDING
  APPROVED
  DENIED
  COMPLETED
}

// Enums
enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  LIST
  MANAGE
}

enum PermissionResource {
  USER
  PROFILE
  ROLE
  PERMISSION
  ADMIN_DASHBOARD
  SYSTEM_SETTINGS
  URL
  TAG
  API_KEY
  ANALYTICS
  AUDIT_LOG
  REPORT
  EMAIL
  GEO
  REWARD
  MERCHANT_ORG
  REDEMPTION
  SAMPLE_CATEGORY
  PRODUCT
  DEVTOOLS
  ORDER
  PAYMENT
  INVENTORY
  ORGANIZATION
  LOCATION
  STORE
}

enum PermissionScope {
  GLOBAL
  ORGANIZATION
  STORE
  LOCATION
  RESOURCE
  OWN
}

enum AclEffect {
  ALLOW
  DENY
}

enum PolicyEffect {
  ALLOW
  DENY
}

enum AuthorizationDecision {
  ALLOW
  DENY
}

// Tables
/// RLS: own row — `app_owns(id)`. Public login/signup uses bypass.
model User {
  id           String  @id @default(uuid())
  fullName     String  @db.VarChar(100)
  /// Case-insensitive (citext): `Alice@x.com` and `alice@x.com` are one account. The API stores the
  /// lower-cased canonical form (CanonicalEmailSchema, max 100 chars).
  email        String  @unique @db.Citext
  passwordHash String  @db.Text
  isActive     Boolean @default(true)
  isSuperAdmin Boolean @default(false)

  /// Optimistic-lock token of the self-service profile fields (`full_name`): every write of those
  /// fields increments it, and `PATCH /auth/profile` applies only while it still equals the
  /// `version` the client read (409 otherwise). Unrelated to `token_version`.
  profileVersion Int @default(0) @map("profile_version")

  // Incremented on every role/permission mutation. The JWT carries this
  // value; the AuthorizationGuard rejects tokens with a stale version,
  // forcing the user to re-login (or refresh) after an authorization
  // change — without needing Redis or a token blacklist.
  tokenVersion Int @default(0) @map("token_version")

  failedLoginAttempts Int     @default(0) @map("failed_login_attempts")
  lockedUntil         BigInt? @map("locked_until")

  twoFactorEnabled          Boolean @default(false) @map("two_factor_enabled")
  twoFactorSecretCiphertext String? @map("two_factor_secret_ciphertext") @db.Text
  twoFactorSecretIv         String? @map("two_factor_secret_iv") @db.VarChar(32)
  twoFactorSecretKeyVersion Int?    @map("two_factor_secret_key_version")
  twoFactorLastTotpStep     BigInt? @map("two_factor_last_totp_step")
  mfaEnrolledAt             BigInt? @map("mfa_enrolled_at")
  mfaEnrollmentDeadline     BigInt? @map("mfa_enrollment_deadline")
  mfaAssuredAt              BigInt? @map("mfa_assured_at")

  plan              Plan @default(FREE)
  monthlyUrlLimit   Int  @default(50) @map("monthly_url_limit")
  monthlyClickLimit Int  @default(10000) @map("monthly_click_limit")

  // Relations
  refreshTokens   RefreshToken[]
  userRoles       UserRole[]
  userPermissions UserPermission[]

  emailVerifiedAt             BigInt?                   @map("email_verified_at")
  phone                       String?                   @db.VarChar(20)
  phoneVerifiedAt             BigInt?                   @map("phone_verified_at")
  lastLoginAt                 BigInt?                   @map("last_login_at")
  pendingAttributionToken     String?                   @map("pending_attribution_token") @db.VarChar(64)
  pendingAttributionExpiresAt BigInt?                   @map("pending_attribution_expires_at")
  isDeleted                   Boolean                   @default(false) @map("is_deleted")
  deletedAt                   BigInt?                   @map("deleted_at")
  createdAt                   BigInt                    @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedAt                   BigInt                    @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  urls                        Url[]
  tags                        Tag[]
  apiKeys                     ApiKey[]
  passwordResetTokens         PasswordResetToken[]
  passwordHistory             PasswordHistory[]
  backupCodes                 BackupCode[]
  twoFactorPendingSetup       TwoFactorPendingSetup?
  twoFactorLoginChallenges    TwoFactorLoginChallenge[]
  mfaRecoveryRequests         MfaRecoveryRequest[]
  impersonatedBy              ImpersonationAuditLog[]   @relation("Impersonator")
  impersonatedUser            ImpersonationAuditLog[]   @relation("ImpersonationTarget")
  impersonationSessionsRun    ImpersonationSession[]    @relation("ImpersonationSessionImpersonator")
  impersonationSessionsOf     ImpersonationSession[]    @relation("ImpersonationSessionTarget")

  organizationMemberships                OrganizationMembership[]        @relation("OrganizationMemberships")
  organizationInvitationsCreated         OrganizationInvitation[]        @relation("OrganizationInvitationCreator")
  organizationInvitationsAccepted        OrganizationInvitation[]        @relation("OrganizationInvitationAcceptor")
  organizationAccessRequests             OrganizationAccessRequest[]     @relation("OrganizationAccessRequests")
  organizationAccessRequestsReviewed     OrganizationAccessRequest[]     @relation("OrganizationAccessRequestReviewer")
  authorizationPolicyDraftsCreated       AuthorizationPolicyDraft[]      @relation("AuthorizationPolicyDraftCreator")
  authorizationPolicyDraftsApproved      AuthorizationPolicyDraft[]      @relation("AuthorizationPolicyDraftApprover")
  authorizationPolicyVersionsPublished   AuthorizationPolicyVersion[]    @relation("AuthorizationPolicyPublisher")
  authorizationPolicySimulations         AuthorizationPolicySimulation[] @relation("AuthorizationPolicySimulator")
  supportAccessGrants                    SupportAccessGrant[]            @relation("SupportAccessGrantSupportUser")
  organizationApiKeysCreated             OrganizationApiKey[]            @relation("OrganizationApiKeyCreator")
  organizationTerminalsCreated           OrganizationTerminal[]          @relation("OrganizationTerminalCreator")
  organizationTerminalPairingCodesIssued OrganizationTerminal[]          @relation("OrganizationTerminalPairingCodeIssuer")
  organizationLocationsRequested         OrganizationLocation[]          @relation("OrganizationLocationRequestedBy")
  organizationLocationsReviewed          OrganizationLocation[]          @relation("OrganizationLocationReviewedBy")
  storeMemberships                       StoreMembership[]               @relation("StoreMemberships")
  rewardClaims                           RewardClaim[]
  rewardRedemptions                      RewardRedemption[]
  rewardSales                            RewardSale[]
  rewardReferralsAsReferrer              RewardReferral[]                @relation("ReferrerUser")
  rewardReferralsAsReferee               RewardReferral[]                @relation("RefereeUser")
  signupReferralCodes                    SignupReferralCode[]
  signupReferralsAsReferrer              SignupReferral[]                @relation("SignupReferrerUser")
  signupReferralsAsReferee               SignupReferral?                 @relation("SignupRefereeUser")
  rewardOtpChallenges                    RewardOtpChallenge[]
  rewardLegalAcceptances                 RewardLegalAcceptance[]
  rewardNotifications                    RewardNotification[]
  rewardAuditLogs                        RewardAuditLog[]
  avatar                                 UserAvatar?
  storedFilesUploaded                    StoredFile[]                    @relation("StoredFileUploader")

  @@index([pendingAttributionToken])
  @@map("users")
}

/// RLS: catalog — SELECT true; writes need `app_rls_bypass()`.
model Role {
  id          String  @id @default(uuid())
  name        String  @unique @db.VarChar(100)
  description String? @db.Text
  isActive    Boolean @default(true)
  /// Server-controlled: platform roles the code depends on by name (seeded). API callers can never
  /// set this flag, and a system role cannot be renamed, deactivated, re-parented, re-permissioned or deleted.
  isSystem    Boolean @default(false)

  // Self-referential hierarchy — a role can inherit permissions from a parent role.
  parentId String? @map("parent_id")
  parent   Role?   @relation("RoleHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Role[]  @relation("RoleHierarchy")

  // Relations
  userRoles        UserRole[]
  rolePermissions  RolePermission[]
  storeMemberships StoreMembership[]

  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))

  @@index([parentId])
  @@map("roles")
}

/// RLS: catalog — SELECT true; writes need `app_rls_bypass()`.
model Permission {
  id          String             @id @default(uuid())
  action      PermissionAction
  resource    PermissionResource
  description String?            @db.Text
  scope       PermissionScope    @default(GLOBAL)

  group      String? @db.VarChar(100)
  isSystem   Boolean @default(false)
  conditions Json?

  // Relations
  rolePermissions      RolePermission[]
  userPermissions      UserPermission[]
  capabilityDefinition CapabilityDefinition?

  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))

  @@unique([action, resource, scope])
  @@map("permissions")
}

// ---------------------------------------------------------------------------
// Capability catalog (generic RBAC slugs — platform + tenant scopes)
// ---------------------------------------------------------------------------

enum CapabilityScope {
  PLATFORM
  MERCHANT
  ADMIN
}

/// RLS: catalog — SELECT true; writes need `app_rls_bypass()`.
model CapabilityDefinition {
  id           String          @id @default(uuid())
  slug         String          @unique @db.VarChar(100)
  scope        CapabilityScope
  label        String          @db.VarChar(200)
  description  String?         @db.Text
  groupName    String?         @map("group_name") @db.VarChar(100)
  sortOrder    Int             @default(0) @map("sort_order")
  isSystem     Boolean         @default(false) @map("is_system")
  permissionId String?         @unique @map("permission_id")

  permission Permission? @relation(fields: [permissionId], references: [id], onDelete: SetNull)

  createdAt BigInt @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt BigInt @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  @@index([scope])
  @@map("capability_definitions")
}

// ---------------------------------------------------------------------------
// Permission Audit Trail
// ---------------------------------------------------------------------------

/// Who performed an RBAC change recorded in `permission_audit_logs`.
enum PermissionAuditActorKind {
  /// An authenticated user — `actorId` is a `users.id`.
  USER
  /// An allowlisted system operation (scheduled job) — `actorId` is the operation name from
  /// `src/prisma/system-operation.registry.ts`, e.g. `maintenance.permission_expiry`.
  SYSTEM_OPERATION
}

/// RLS: bypass only (`app_rls_bypass()`).
model PermissionAuditLog {
  id             String                   @id @default(uuid())
  actorKind      PermissionAuditActorKind @default(USER) @map("actor_kind")
  actorId        String                   @map("actor_id")
  targetUserId   String?                  @map("target_user_id")
  targetRoleId   String?                  @map("target_role_id")
  permissionId   String?                  @map("permission_id")
  action         String
  detail         String?                  @db.Text
  /// Request correlation id — joins this domain entry to the global HTTP audit entry and logs.
  correlationId  String?                  @map("correlation_id") @db.VarChar(64)
  /// The real (super-admin) user behind an impersonation session, when the actor was impersonated.
  impersonatorId String?                  @map("impersonator_id")
  isDeleted      Boolean                  @default(false) @map("is_deleted")
  deletedAt      BigInt?                  @map("deleted_at")
  createdAt      BigInt                   @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt      BigInt                   @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  @@index([actorId])
  @@index([targetUserId])
  @@index([targetRoleId])
  @@index([createdAt])
  @@index([correlationId])
  @@map("permission_audit_logs")
}

// ---------------------------------------------------------------------------
// Password Reset Tokens
// ---------------------------------------------------------------------------

/// RLS: own row — `app_owns(user_id)`.
model PasswordResetToken {
  id          String  @id @default(uuid())
  userId      String  @map("user_id")
  token       String  @unique @db.Text
  tokenDigest String? @unique @map("token_digest") @db.VarChar(64)
  expiresAt   BigInt  @map("expires_at")
  usedAt      BigInt? @map("used_at")
  isDeleted   Boolean @default(false) @map("is_deleted")
  deletedAt   BigInt? @map("deleted_at")
  createdAt   BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt   BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([tokenDigest])
  @@map("password_reset_tokens")
}

/// RLS: own row — `app_owns(user_id)`.
model PasswordHistory {
  id           String @id @default(uuid())
  userId       String @map("user_id")
  passwordHash String @map("password_hash") @db.Text
  createdAt    BigInt @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_history")
}

/// Soft-deleted (never DELETEd) when MFA is reset or recovered: a revoked set
/// keeps `isDeleted = true` + `deletedAt` + `deletedBy` (the user who reset
/// MFA, or the SuperAdmin who approved the recovery). Readers filter `isDeleted = false`.
/// RLS: own row — `app_owns(user_id)`.
model BackupCode {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  codeHash  String  @map("code_hash") @db.Text
  usedAt    BigInt? @map("used_at")
  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  deletedBy String? @map("deleted_by")
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("backup_codes")
}

/// Temporary 2FA enrollment state — expires after 15 minutes.
/// RLS: own row — `app_owns(user_id)`.
model TwoFactorPendingSetup {
  id                String @id @default(uuid())
  userId            String @unique @map("user_id")
  secretCiphertext  String @map("secret_ciphertext") @db.Text
  secretIv          String @map("secret_iv") @db.VarChar(32)
  secretKeyVersion  Int    @map("secret_key_version")
  backupCodesHashes Json   @map("backup_codes_hashes")
  expiresAt         BigInt @map("expires_at")
  createdAt         BigInt @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("two_factor_pending_setups")
}

/// Short-lived MFA verification challenge during login or secret rotation.
/// RLS: own row — `app_owns(user_id)`.
model TwoFactorLoginChallenge {
  id           String                         @id @default(uuid())
  userId       String                         @map("user_id")
  purpose      TwoFactorLoginChallengePurpose
  clientType   String?                        @map("client_type")
  deviceInfo   String?                        @map("device_info") @db.VarChar(255)
  ipAddress    String?                        @map("ip_address") @db.VarChar(45)
  attemptCount Int                            @default(0) @map("attempt_count")
  maxAttempts  Int                            @default(5) @map("max_attempts")
  consumedAt   BigInt?                        @map("consumed_at")
  expiresAt    BigInt                         @map("expires_at")
  createdAt    BigInt                         @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("two_factor_login_challenges")
}

/// Admin-reviewed MFA recovery / account unlock request.
/// Status transitions are compare-and-set on `status`; the reviewer must be a
/// SuperAdmin other than the requester. At most one open (PENDING or APPROVED)
/// request per user: creation runs under a per-user transaction advisory lock.
/// RLS: own row — `app_owns(user_id)`.
model MfaRecoveryRequest {
  id                String                   @id @default(uuid())
  userId            String                   @map("user_id")
  status            MfaRecoveryRequestStatus @default(PENDING)
  requestedAt       BigInt                   @map("requested_at")
  reviewedBy        String?                  @map("reviewed_by")
  reviewedAt        BigInt?                  @map("reviewed_at")
  scheduledUnlockAt BigInt?                  @map("scheduled_unlock_at")
  completedAt       BigInt?                  @map("completed_at")
  notes             String?                  @db.Text
  createdAt         BigInt                   @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt         BigInt                   @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("mfa_recovery_requests")
}

/// Append-only domain audit of the MFA recovery lifecycle: one row per status
/// transition (requested / approved / denied / completed), written in the SAME
/// transaction as the transition. `actorUserId` is the real actor — the
/// requester, the reviewing SuperAdmin, or (for the scheduled unlock) the
/// SuperAdmin whose approval it executes. Correlates with `audit_logs` through
/// `correlationId`. No foreign keys: an audit row outlives what it describes.
/// Not a business entity: never updated or deleted.
/// RLS: bypass-only (`app_rls_bypass()`); UPDATE/DELETE revoked from app_runtime.
model MfaRecoveryAuditLog {
  id             String                    @id @default(uuid())
  requestId      String                    @map("request_id")
  subjectUserId  String                    @map("subject_user_id")
  actorUserId    String                    @map("actor_user_id")
  action         String                    @db.VarChar(64)
  fromStatus     MfaRecoveryRequestStatus? @map("from_status")
  toStatus       MfaRecoveryRequestStatus  @map("to_status")
  /// The real SuperAdmin when the actor acted through an impersonation session.
  impersonatorId String?                   @map("impersonator_id")
  correlationId  String?                   @map("correlation_id") @db.VarChar(64)
  ipAddress      String?                   @map("ip_address") @db.VarChar(64)
  userAgent      String?                   @map("user_agent") @db.VarChar(512)
  createdAt      BigInt                    @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")

  @@index([requestId, createdAt])
  @@index([subjectUserId])
  @@map("mfa_recovery_audit_logs")
}

/// RLS: own row — `app_owns("userId")`.
model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  assignedBy String?

  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))

  @@unique([userId, roleId])
  @@map("user_roles")
}

/// RLS: own row — `app_owns("userId")`.
model UserPermission {
  id           String @id @default(uuid())
  userId       String
  permissionId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  /// Per-user override: ALLOW grants the permission; DENY revokes it even when a role grants it.
  effect AclEffect @default(ALLOW)

  assignedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  assignedBy String?
  expiresAt  BigInt?

  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

/// RLS: catalog — SELECT true; writes need `app_rls_bypass()`.
model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  assignedBy String?

  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Authorization Kernel — ACL, Policies, Audit
// ---------------------------------------------------------------------------

/// RLS: resource ACL entries — ALLOW/DENY per subject+action+resource.
/// Explicit DENY > Explicit ALLOW > Role ALLOW > default DENY.
model ResourceAcl {
  id             String           @id @default(uuid())
  subjectType    String           @map("subject_type") @db.VarChar(50) // "USER" | "ROLE"
  subjectId      String           @map("subject_id")
  action         String           @db.VarChar(50)
  resourceType   String           @map("resource_type") @db.VarChar(50)
  resourceId     String?          @map("resource_id") // null = all resources of type
  effect         AclEffect
  scope          PermissionScope?
  organizationId String?          @map("organization_id")
  locationId     String?          @map("location_id")
  conditions     Json?
  expiresAt      BigInt?          @map("expires_at")
  assignedBy     String?          @map("assigned_by")
  reason         String?          @db.Text
  isDeleted      Boolean          @default(false) @map("is_deleted")
  deletedAt      BigInt?          @map("deleted_at")
  createdAt      BigInt           @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedAt      BigInt           @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))

  @@index([subjectType, subjectId])
  @@index([resourceType, resourceId])
  @@index([organizationId])
  @@index([locationId])
  @@map("resource_acls")
}

/// RLS: catalog — Policy definitions with Zod-validated DSL.
model PolicyDefinition {
