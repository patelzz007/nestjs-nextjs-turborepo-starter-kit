/// Outcome of one audited HTTP request.
enum AuditOutcome {
  /// The handler completed and the response was sent with a 2xx/3xx status.
  SUCCEEDED
  /// The request failed (guard, validation, handler or server error) — `errorCode` says why.
  FAILED
}

/// How the caller of one audited HTTP request authenticated (NULL on the row = anonymous).
enum AuditAuthMethod {
  /// An access token sent as `Authorization: Bearer` (API clients, Swagger UI).
  BEARER_TOKEN
  /// The access-token cookie of a frontend session (web / admin / merchant cookie set).
  SESSION_COOKIE
  /// The refresh-token cookie of a browser client type (`/auth/refresh`, logout).
  REFRESH_COOKIE
  /// The refresh token in the request body (`{ refreshToken }`, client type `mobile` — ADR 029).
  REFRESH_BODY
  /// A machine API key (merchant POS terminals).
  API_KEY
}

/// What kind of address an audited request came from (IANA special-purpose registries).
enum IpAddressScope {
  /// Globally routable — a real client on the internet.
  PUBLIC
  /// RFC 1918 / RFC 4193 private network (10/8, 172.16/12, 192.168/16, fc00::/7).
  PRIVATE
  /// The machine itself (127/8, ::1).
  LOOPBACK
  /// Link-local (169.254/16, fe80::/10).
  LINK_LOCAL
  /// Carrier-grade NAT shared address space (100.64/10, RFC 6598).
  SHARED
  /// Documentation / benchmarking ranges (192.0.2/24, 198.51.100/24, 203.0.113/24, 198.18/15, 2001:db8::/32).
  DOCUMENTATION
  /// Multicast (224/4, ff00::/8).
  MULTICAST
  /// Any other IANA-reserved range (0/8, 240/4, 255.255.255.255, ::).
  RESERVED
}

/// Global HTTP audit trail (rules/10 → "Audit logging", docs/adr/025-global-http-audit-log.md):
/// exactly one append-only row per HTTP request (every method — reads included; only the health
/// probes and SSE streams are exempt), successful or failed, written by `AuditLogInterceptor` (success) / `GlobalExceptionFilter` (failure) under
/// the `audit.http_request.record` system operation — or inside the handler's own transaction
/// when the handler opts in (`AuditTrailService.recordInTransaction`). Bodies are redacted
/// (common/logging/redaction.ts) and size-capped before they are stored.
/// Domain audit tables (OrganizationAuditLog, RewardAuditLog, PermissionAuditLog,
/// ImpersonationAuditLog, AuthorizationAudit) keep their domain events; they correlate with
/// this table through `correlationId`. No foreign keys: an audit row outlives what it describes.
/// The organization is the tenant in this platform, so there is no separate tenant column.
/// RLS: INSERT only under a named system operation (or by the acting user inside their own
/// transaction); SELECT bypass-only; UPDATE/DELETE revoked from app_runtime (append-only).
/// Read by the admin audit viewer (`GET /admin/audit-logs`) under `audit.http_request.read`,
/// after the AUDIT_LOG permission check. Request-metadata columns added after the table was
/// created (trace id onwards) are NULL on rows written before them.
/// Not a business entity: never soft-deleted, never updated. Seed: prisma/seed/http-audit.ts.
/// @extends BaseModel
model AuditLog {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  correlationId          String           @db.VarChar(64)
  /// Distributed trace id (equal to `correlationId` until W3C trace context is propagated).
  traceId                String?          @db.VarChar(64)
  /// Request start (epoch ms).
  occurredAt             BigInt
  /// When the outcome was known (epoch ms).
  completedAt            BigInt
  method                 String           @db.VarChar(10)
  /// Route template (`/api/v1/geo/regions/:id`) — groups requests by endpoint.
  endpoint               String           @db.VarChar(512)
  /// Concrete request URL with sensitive query parameters redacted.
  path                   String           @db.VarChar(2048)
  outcome                AuditOutcome
  responseStatus         Int
  /// Machine error code (`errorCode` of the error envelope) for FAILED rows.
  errorCode              String?          @db.VarChar(64)
  actorUserId            String?          @db.VarChar(64)
  /// The real (super-admin) user behind an impersonation session.
  impersonatorUserId     String?          @db.VarChar(64)
  /// The server-side impersonation session (`ImpersonationSession.id`) the request ran under.
  impersonationSessionId String?          @db.VarChar(64)
  /// How the caller authenticated; NULL for an anonymous request.
  authMethod             AuditAuthMethod?
  apiKeyId               String?          @db.VarChar(64)
  terminalId             String?          @db.VarChar(64)
  organizationId         String?          @db.VarChar(64)
  storeId                String?          @db.VarChar(64)
  locationId             String?          @db.VarChar(64)
  ipAddress              String?          @db.VarChar(64)
  /// The calling device (User-Agent, bounded).
  userAgent              String?          @db.VarChar(512)
  /// Browser / HTTP client parsed from the User-Agent (`Chrome`, `Safari`, `curl`).
  browserName            String?          @db.VarChar(64)
  browserVersion         String?          @db.VarChar(32)
  /// Operating system parsed from the User-Agent (`macOS`, `Android`).
  osName                 String?          @db.VarChar(64)
  osVersion              String?          @db.VarChar(32)
  /// Device class parsed from the User-Agent.
  deviceType             DeviceType?
  /// Device model when the User-Agent names one (`iPhone`, `Pixel 8`, `SM-S918B`).
  deviceModel            String?          @db.VarChar(64)
  /// 4 or 6.
  ipVersion              Int?             @db.SmallInt
  /// Address class of `ipAddress` (public, private, loopback, …).
  ipScope                IpAddressScope?
  /// ISO 3166-1 alpha-2 country of the client, from the CDN edge's geo headers (trusted proxies only).
  geoCountry             String?          @db.VarChar(2)
  /// Region / subdivision from the CDN edge (`14`, `Selangor`).
  geoRegion              String?          @db.VarChar(64)
  /// City from the CDN edge.
  geoCity                String?          @db.VarChar(128)
  /// IANA time zone from the CDN edge (`Asia/Kuala_Lumpur`).
  geoTimeZone            String?          @db.VarChar(64)
  /// The frontend the caller CLAIMS to be (`X-Client-Type`, bounded, unverified — e.g. web / admin / merchant).
  clientType             String?          @db.VarChar(32)
  /// HTTP protocol version of the connection (`1.1`, `2.0`).
  httpVersion            String?          @db.VarChar(8)
  /// `Host` the request was addressed to.
  host                   String?          @db.VarChar(255)
  /// `Origin` header (browser requests).
  origin                 String?          @db.VarChar(512)
  /// `Referer` header, with sensitive query parameters redacted.
  referer                String?          @db.VarChar(2048)
  /// `Accept-Language` header.
  acceptLanguage         String?          @db.VarChar(256)
  /// `Content-Type` of the request body.
  requestContentType     String?          @db.VarChar(256)
  /// Declared request body size (`Content-Length`, bytes).
  requestBytes           Int?
  /// `Idempotency-Key` header the request carried (joins the idempotency record).
  idempotencyKey         String?          @db.VarChar(255)
  /// Route params + query string (redacted).
  requestParams          Json?
  requestBody            Json?
  responseBody           Json?
  /// Allowlisted system operations (RLS bypasses) the request ran, in first-use order.
  systemOperations       String[]

  @@index([organizationId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([impersonatorUserId, occurredAt])
  @@index([outcome, occurredAt])
  @@index([deviceType, occurredAt])
  @@index([correlationId])
  /// Trigram GIN indexes serve the viewer's case-insensitive `?search=` (ILIKE '%…%') without a scan.
  @@index([path(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([endpoint(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([errorCode(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([ipAddress(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([userAgent(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([occurredAt])
}

/// The kind of row change one `DataChangeLog` row records.
enum DataChangeOperation {
  INSERT
  UPDATE
  DELETE
  /// A whole-table `TRUNCATE` (statement level: no row id, no row images).
  TRUNCATE
}

/// Who a recorded row change is attributed to, from the session variables the change ran under.
enum DataChangeActorKind {
  /// `app.current_user_id` was set — a signed-in user (an impersonation session's target user;
  /// the impersonator is on the HTTP audit row with the same correlation id).
  USER
  /// `app.current_api_key_id` was set — a merchant API key (POS terminal or integration).
  API_KEY
  /// No user or key, but an allowlisted system operation — background work (jobs, schedulers, the outbox).
  SYSTEM
  /// None of the above: a write the application did not attribute (a migration, the seed, a manual
  /// `psql` session, or a code path that skipped its context — which is itself a finding).
  UNATTRIBUTED
}

/// Row-level data-change trail (docs/adr/051-database-change-audit-trail.md): one row per
/// INSERT / UPDATE / DELETE on every captured table, plus one per TRUNCATE, written by the
/// generated `data_change_capture` triggers (prisma/rls/data-change-capture.ts) in the SAME
/// transaction as the change — so a change can never commit without its record. Captures writes
/// from every path: HTTP requests, queue jobs, schedulers, consumers, CLIs and manual SQL.
/// `oldData` / `newData` are the full row images, secret columns `[REDACTED]`, personal data
/// masked and oversized values replaced by a truncation marker. `correlationId` joins a change
/// to the HTTP request (`AuditLog`) that caused it.
/// RLS: INSERT only from inside a trigger (`pg_trigger_depth() > 0`); SELECT bypass-only (the
/// admin viewer reads it under `audit.data_change.read`); UPDATE/DELETE withheld from app_runtime.
/// Not a business entity: never soft-deleted, never updated. Seed: prisma/seed/data-changes.ts.
/// @extends BaseModel
model DataChangeLog {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  id              String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Monotonic write order — orders the changes of one transaction exactly.
  changeSequence  BigInt              @unique @default(autoincrement())
  /// When the row changed (`clock_timestamp()`, epoch ms).
  occurredAt      BigInt
  /// PostgreSQL transaction id (`txid_current()`): the changes that committed together.
  transactionId   BigInt
  tableName       String              @db.VarChar(63)
  operation       DataChangeOperation
  /// The changed row's primary key (composite keys joined with `/`); NULL for TRUNCATE.
  rowId           String?             @db.VarChar(512)
  /// UPDATE: the columns whose value changed (before redaction, so a changed secret is still listed). Empty otherwise.
  changedColumns  String[]
  /// The row before the change (UPDATE, DELETE).
  oldData         Json?
  /// The row after the change (INSERT, UPDATE).
  newData         Json?
  actorKind       DataChangeActorKind
  actorUserId     String?             @db.VarChar(64)
  organizationId  String?             @db.VarChar(64)
  apiKeyId        String?             @db.VarChar(64)
  /// The allowlisted system operation (RLS bypass) the change ran under.
  systemOperation String?             @db.VarChar(100)
  /// Why the transaction ran (`app.actor_purpose`: the tenant purpose, or the system operation's reason).
  actorPurpose    String?             @db.VarChar(512)
  /// The request (or job) correlation id — joins `AuditLog.correlationId`.
  correlationId   String?             @db.VarChar(64)
  /// The PostgreSQL role that executed the statement (`app_runtime`, a system operation's role, the owner …).
  databaseRole    String              @db.VarChar(63)
  /// The role the connection logged in as (`session_user`).
  loginRole       String              @db.VarChar(63)
  /// The connecting client's `application_name` (`prisma-seed`, `psql`, …).
  applicationName String?             @db.VarChar(64)
  /// The connecting client's address; NULL over a Unix socket.
  clientAddress   String?             @db.VarChar(64)

  @@index([occurredAt])
  @@index([correlationId])
  @@index([tableName, rowId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([actorKind, occurredAt])
  @@index([transactionId])
}

/// Lifecycle of an idempotency record (platform/idempotency, docs/technical/api/routes.md → Idempotency).
enum IdempotencyRecordStatus {
  /// A request holding this key is executing; duplicates get 409 IDEMPOTENCY_REQUEST_IN_PROGRESS until `expiresAt` (the lease).
  IN_PROGRESS
  /// The response is stored in `responseBody` and replayed for identical requests until `expiresAt`.
  COMPLETED
}

/// Idempotency records for `@Idempotent()` HTTP endpoints.
/// Ephemeral infrastructure state (not a business entity): an expired row is
/// taken over in place by the next request with the same key — never deleted.
/// @extends BaseModel
model PlatformResourceIdempotencyRecord {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  scope          String                  @db.VarChar(200)
  idempotencyKey String                  @db.VarChar(128)
  requestHash    String                  @db.VarChar(128)
  status         IdempotencyRecordStatus
  /// Fencing token of the request that holds (or last held) the lease: complete/release only
  /// succeed for the holder, so a request whose lease expired can never overwrite its successor.
  leaseToken     String                  @db.Uuid
  /// Null while IN_PROGRESS.
  responseBody   Json?
  /// IN_PROGRESS: lease end (a crashed request frees the key). COMPLETED: end of the replay window.
  /// Always set explicitly by the app (no default).
  expiresAt      BigInt

  @@unique([scope, idempotencyKey])
  @@index([expiresAt])
}
