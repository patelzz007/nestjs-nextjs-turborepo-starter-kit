generator client {
  provider        = "prisma-client-js"
  // `@@unique(..., where: ...)` — uniqueness that ignores soft-deleted rows.
  // `postgresqlExtensions` — the datasource `extensions` list (citext below);
  // Prisma 7.10 rejects `extensions` without this preview feature.
  previewFeatures = ["partialIndexes", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  /// citext: case-insensitive text for email addresses (users, invitations) —
  /// uniqueness and lookups ignore case at the database, not only at the API.
  /// pg_trgm: trigram similarity (`similarity()`, `%`) behind the geo `?search=`
  /// filters (GeoRepository.fuzzySearchIds), served by the `*_name_trgm_idx`
  /// GIN indexes on the five geo tables.
  extensions = [citext, pg_trgm]
}

// ============================================================================
// The base model
// ============================================================================
// The fields every model carries: a UUID v7 id, who and when created / updated it, and soft delete. Prisma has
// no inheritance, so it is declared here as comments, and a model opts in with `/// @extends BaseModel` directly
// above it. `pnpm --filter @workspace/api db:schema` (run by every db:* script) writes these fields into each
// model as a managed block — edit them HERE, never inside a model. A model overrides a field by declaring it again
// below the managed block (e.g. an integer dataset id); a model with its own primary key gets no `id`. All times
// are epoch milliseconds; `createdBy` / `updatedBy` / `deletedBy` and `updatedAt` are filled by the database's row
// audit triggers (prisma/rls/row-audit.ts) from the session's actor. Engine: prisma/engine/schema-engine.ts.
//
// @base-model BaseModel
//   id        String  @id @default(uuid(7))
//   createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
//   createdBy String? @db.VarChar(128)
//   updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
//   updatedBy String? @db.VarChar(128)
//   isDeleted Boolean @default(false)
//   deletedAt BigInt?
//   deletedBy String? @db.VarChar(128)
// @end-base-model

// ============================================================================
// Identity
// ============================================================================

// ---------------------------------------------------------------------------
// Row Level Security (Postgres)
//
// Prisma 7 PSL cannot emit CREATE ROLE, GRANT, ENABLE/FORCE RLS, or POLICY.
// **Do not append RLS to migrations/*/migration.sql** — squashed migrations
// would drop it. Canonical SQL: `prisma/rls.sql` + `prisma/rls/*.sql`, applied
// automatically by `pnpm db:migrate` / `db:reset` / `db:deploy` (`db:apply-security`).
//
// Schema-owned pieces (columns, indexes, maps) always land in this file first.
// Each model may document its RLS profile with `/// RLS:` comments.
//
// Runtime (apps/api):
//   - Role `app_runtime` (NOLOGIN NOSUPERUSER NOINHERIT NOBYPASSRLS)
//   - RlsPool + TenantTransactionService: SET ROLE + transaction-local set_config
//   - Session: app.current_user_id, app.current_tenant_id, app.rls_bypass
//   - RBAC: roles/permissions (data) — guards, not per-role RLS policies
//   - ACL: Membership + location scopes — generic SQL helpers
// See docs/technical/security/database-security.md.
// ---------------------------------------------------------------------------
enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  BOT
  UNKNOWN
}

/// The app a device session belongs to (`X-Client-Type`, validated server-side). Mirrors `AuthClientTypeSchema`.
enum SessionClientType {
  web
  admin
  merchant
  mobile
}

/// How a device session was signed in — the proofs the login flow required. Mirrors `SessionSignInMethodSchema`.
enum SessionSignInMethod {
  /// Password only.
  PASSWORD
  /// Password, then the emailed new-device code.
  PASSWORD_NEW_DEVICE_CODE
  /// Password and an authenticator (TOTP) code.
  PASSWORD_TOTP
  /// Password, TOTP, then the emailed new-device code.
  PASSWORD_TOTP_NEW_DEVICE_CODE
  /// Password and a single-use backup code.
  PASSWORD_BACKUP_CODE
  /// Password, a backup code, then the emailed new-device code.
  PASSWORD_BACKUP_CODE_NEW_DEVICE_CODE
  /// A staff account created from a team invite (the password was set in the same request).
  TEAM_INVITE_REGISTRATION
  /// Team-invite registration, then the emailed new-device code.
  TEAM_INVITE_REGISTRATION_NEW_DEVICE_CODE
}

enum TwoFactorLoginChallengePurpose {
  LOGIN
  ROTATE
}

enum MfaRecoveryRequestStatus {
  PENDING
  APPROVED
  DENIED
  COMPLETED
}

// Tables
/// RLS: own row — `app_owns(id)`. Public login/signup uses bypass.
/// @extends BaseModel
model User {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  fullName     String  @db.VarChar(100)
  /// Case-insensitive (citext): `Alice@x.com` and `alice@x.com` are one account. The API stores the
  /// lower-cased canonical form (CanonicalEmailSchema, max 100 chars).
  email        String  @unique @db.Citext
  passwordHash String  @db.Text
  isActive     Boolean @default(true)
  isSuperAdmin Boolean @default(false)

  /// Platform ban (`POST /auth/admin/users/:userId/ban`): set together with `isActive = false`, so the
  /// account can neither sign in nor keep a session. Cleared by an unban. NULL = not banned.
  bannedAt       BigInt?
  bannedByUserId String?
  /// Why a platform admin banned the account (shown to admins only); trimmed, at most `USER_BAN_REASON_MAX_LENGTH`.
  banReason      String? @db.Text

  /// Optimistic-lock token of the self-service profile fields (`full_name`): every write of those
  /// fields increments it, and `PATCH /auth/profile` applies only while it still equals the
  /// `version` the client read (409 otherwise). Unrelated to `tokenVersion`.
  profileVersion Int @default(0)

  // Incremented on every role/permission mutation. The JWT carries this
  // value; the AuthorizationGuard rejects tokens with a stale version,
  // forcing the user to re-login (or refresh) after an authorization
  // change — without needing Redis or a token blacklist.
  tokenVersion Int @default(0)

  /// Epoch ms (database clock) of the last change to this account's access: stamped by the
  /// `users_authorization_change_stamp` trigger (prisma/rls/30-authorization-change-stamp.sql)
  /// whenever `tokenVersion`, `isActive` or `isDeleted` change, never by application code.
  /// Every API instance sweeps recent stamps and drops its cached authorization, so a change whose
  /// after-commit invalidation was lost (crash, Redis outage) stays stale for one sweep, not a TTL.
  authorizationChangedAt BigInt?

  failedLoginAttempts Int     @default(0)
  lockedUntil         BigInt?

  twoFactorEnabled          Boolean @default(false)
  twoFactorSecretCiphertext String? @db.Text
  twoFactorSecretIv         String? @db.VarChar(32)
  twoFactorSecretKeyVersion Int?
  twoFactorLastTotpStep     BigInt?
  mfaEnrolledAt             BigInt?
  mfaEnrollmentDeadline     BigInt?
  mfaAssuredAt              BigInt?

  // Relations
  refreshTokens   RefreshToken[]
  userRoles       UserRole[]
  userPermissions UserPermission[]

  emailVerifiedAt             BigInt?
  phone                       String?                   @db.VarChar(20)
  phoneVerifiedAt             BigInt?
  lastLoginAt                 BigInt?
  pendingAttributionToken     String?                   @db.VarChar(64)
  pendingAttributionExpiresAt BigInt?
  passwordResetTokens         PasswordResetToken[]
  passwordHistory             PasswordHistory[]
  backupCodes                 BackupCode[]
  twoFactorPendingSetup       TwoFactorPendingSetup?
  twoFactorLoginChallenges    TwoFactorLoginChallenge[]
  mfaRecoveryRequests         MfaRecoveryRequest[]
  impersonatedBy              ImpersonationAuditLog[]   @relation("Impersonator")
  impersonatedUser            ImpersonationAuditLog[]   @relation("ImpersonationTarget")
  impersonationSessionsRun    ImpersonationSession[]    @relation("ImpersonationSessionImpersonator")
  impersonationSessionsOf     ImpersonationSession[]    @relation("ImpersonationSessionTarget")

  memberships                          Membership[]                    @relation("Memberships")
  tenantInvitationsCreated             TenantInvitation[]              @relation("TenantInvitationCreator")
  tenantInvitationsAccepted            TenantInvitation[]              @relation("TenantInvitationAcceptor")
  tenantAccessRequests                 TenantAccessRequest[]           @relation("TenantAccessRequests")
  tenantAccessRequestsReviewed         TenantAccessRequest[]           @relation("TenantAccessRequestReviewer")
  authorizationPolicyDraftsCreated     AuthorizationPolicyDraft[]      @relation("AuthorizationPolicyDraftCreator")
  authorizationPolicyDraftsApproved    AuthorizationPolicyDraft[]      @relation("AuthorizationPolicyDraftApprover")
  authorizationPolicyVersionsPublished AuthorizationPolicyVersion[]    @relation("AuthorizationPolicyPublisher")
  authorizationPolicySimulations       AuthorizationPolicySimulation[] @relation("AuthorizationPolicySimulator")
  supportAccessGrants                  SupportAccessGrant[]            @relation("SupportAccessGrantSupportUser")
  tenantApiKeysCreated                 TenantApiKey[]                  @relation("TenantApiKeyCreator")
  bannedBy                             User?                           @relation("UserBannedBy", fields: [bannedByUserId], references: [id], onDelete: SetNull)
  usersBanned                          User[]                          @relation("UserBannedBy")
  tenantAppealsSubmitted               TenantSuspensionAppeal[]        @relation("TenantSuspensionAppealSubmitter")
  tenantAppealsReviewed                TenantSuspensionAppeal[]        @relation("TenantSuspensionAppealReviewer")
  merchantBansReceived                 TenantCustomerBan[]             @relation("TenantCustomerBanCustomer")
  merchantBansIssued                   TenantCustomerBan[]             @relation("TenantCustomerBanIssuer")
  merchantBansLifted                   TenantCustomerBan[]             @relation("TenantCustomerBanLifter")
  tenantTerminalsCreated               TenantTerminal[]                @relation("TenantTerminalCreator")
  tenantTerminalPairingCodesIssued     TenantTerminal[]                @relation("TenantTerminalPairingCodeIssuer")
  locationsRequested                   Location[]                      @relation("LocationRequestedBy")
  locationsReviewed                    Location[]                      @relation("LocationReviewedBy")
  rewardClaims                         RewardClaim[]
  rewardRedemptions                    RewardRedemption[]
  rewardSales                          RewardSale[]
  rewardReferralsAsReferrer            RewardReferral[]                @relation("ReferrerUser")
  rewardReferralsAsReferee             RewardReferral[]                @relation("RefereeUser")
  signupReferralCodes                  SignupReferralCode[]
  signupReferralsAsReferrer            SignupReferral[]                @relation("SignupReferrerUser")
  signupReferralsAsReferee             SignupReferral?                 @relation("SignupRefereeUser")
  rewardOtpChallenges                  RewardOtpChallenge[]
  rewardLegalAcceptances               RewardLegalAcceptance[]
  rewardNotifications                  RewardNotification[]
  rewardAuditLogs                      RewardAuditLog[]
  avatar                               UserAvatar?
  githubAccountLink                    GithubAccountLink?
  githubWebhookSubscriptions           GithubWebhookSubscription[]
  storedFilesUploaded                  StoredFile[]                    @relation("StoredFileUploader")
  kanbanTasksOwned                     KanbanTask[]                    @relation("KanbanTaskOwner")
  kanbanTasksAssigned                  KanbanTask[]                    @relation("KanbanTaskAssignee")
  kanbanTaskComments                   KanbanTaskComment[]             @relation("KanbanTaskCommentAuthor")
  kanbanChecklistItemsAssigned         KanbanChecklistItem[]           @relation("KanbanChecklistItemAssignee")
  kanbanTasksWatched                   KanbanTaskWatcher[]             @relation("KanbanTaskWatcherUser")
  kanbanActivity                       KanbanTaskActivity[]            @relation("KanbanTaskActivityActor")
  preferences                          UserPreference[]

  @@index([pendingAttributionToken])
  @@index([authorizationChangedAt])
}

// ---------------------------------------------------------------------------
// Password Reset Tokens
// ---------------------------------------------------------------------------

/// RLS: own row — `app_owns(userId)`.
/// @extends BaseModel
model PasswordResetToken {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  userId      String
  token       String  @unique @db.Text
  tokenDigest String? @unique @db.VarChar(64)
  expiresAt   BigInt
  usedAt      BigInt?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([tokenDigest])
}

/// RLS: own row — `app_owns(userId)`.
/// @extends BaseModel
model PasswordHistory {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  userId       String
  passwordHash String @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Soft-deleted (never DELETEd) when MFA is reset or recovered: a revoked set
/// keeps `isDeleted = true` + `deletedAt` + `deletedBy` (the user who reset
/// MFA, or the SuperAdmin who approved the recovery). Readers filter `isDeleted = false`.
/// RLS: own row — `app_owns(userId)`.
/// @extends BaseModel
model BackupCode {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  userId   String
  codeHash String  @db.Text
  usedAt   BigInt?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Temporary 2FA enrollment state — expires after 15 minutes.
/// RLS: own row — `app_owns(userId)`.
/// @extends BaseModel
model TwoFactorPendingSetup {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  userId            String @unique
  secretCiphertext  String @db.Text
  secretIv          String @db.VarChar(32)
  secretKeyVersion  Int
  backupCodesHashes Json
  expiresAt         BigInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// Short-lived MFA verification challenge during login or secret rotation.
/// RLS: own row — `app_owns(userId)`.
/// @extends BaseModel
model TwoFactorLoginChallenge {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  userId       String
  purpose      TwoFactorLoginChallengePurpose
  clientType   String?
  deviceInfo   String?                        @db.VarChar(255)
  ipAddress    String?                        @db.VarChar(45)
  attemptCount Int                            @default(0)
  maxAttempts  Int                            @default(5)
  consumedAt   BigInt?
  expiresAt    BigInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

/// Admin-reviewed MFA recovery / account unlock request.
/// Status transitions are compare-and-set on `status`; the reviewer must be a
/// SuperAdmin other than the requester. At most one open (PENDING or APPROVED)
/// request per user: creation runs under a per-user transaction advisory lock.
/// RLS: own row — `app_owns(userId)`.
/// @extends BaseModel
model MfaRecoveryRequest {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  userId            String
  status            MfaRecoveryRequestStatus @default(PENDING)
  requestedAt       BigInt
  reviewedBy        String?
  reviewedAt        BigInt?
  scheduledUnlockAt BigInt?
  completedAt       BigInt?
  notes             String?                  @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

/// Append-only domain audit of the MFA recovery lifecycle: one row per status
/// transition (requested / approved / denied / completed), written in the SAME
/// transaction as the transition. `actorUserId` is the real actor — the
/// requester, the reviewing SuperAdmin, or (for the scheduled unlock) the
/// SuperAdmin whose approval it executes. Correlates with `AuditLog` through
/// `correlationId`. No foreign keys: an audit row outlives what it describes.
/// Not a business entity: never updated or deleted.
/// RLS: bypass-only (`app_rls_bypass()`); UPDATE/DELETE revoked from app_runtime.
/// @extends BaseModel
model MfaRecoveryAuditLog {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  requestId      String
  subjectUserId  String
  actorUserId    String
  action         String                    @db.VarChar(64)
  fromStatus     MfaRecoveryRequestStatus?
  toStatus       MfaRecoveryRequestStatus
  /// The real SuperAdmin when the actor acted through an impersonation session.
  impersonatorId String?
  correlationId  String?                   @db.VarChar(64)
  ipAddress      String?                   @db.VarChar(64)
  userAgent      String?                   @db.VarChar(512)

  @@index([requestId, createdAt])
  @@index([subjectUserId])
}

/// One device session: the refresh token a signed-in device holds (rotated in place on every refresh,
/// so `id` is the stable session id — the `sid` claim of its access tokens, ADR 034).
/// Client-reported details (browser, OS, device model and name, app version) are display-only,
/// length-limited and zod-validated before storage; they never influence authorization.
/// Columns that are NULL on a session created before piece 4 of the mobile plan stay NULL.
/// RLS: own row — `app_owns("userId")`.
/// @extends BaseModel
model RefreshToken {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  token             String  @db.Text
  previousTokenHash String? @db.Text
  rotationVersion   Int     @default(0)
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The app that signed in (server-classified from `X-Client-Type`).
  clientType      SessionClientType?
  /// Browser / HTTP client parsed from the User-Agent (`Chrome`, `CFNetwork`).
  browserName     String?              @db.VarChar(64)
  browserVersion  String?              @db.VarChar(32)
  /// Operating system parsed from the User-Agent (`macOS`, `iOS`).
  osName          String?              @db.VarChar(64)
  osVersion       String?              @db.VarChar(32)
  /// Device class parsed from the User-Agent.
  deviceType      DeviceType?
  /// Device model: `X-Device-Model` for client type mobile, else the User-Agent's model (`iPhone 15 Pro`, `Pixel 8`).
  deviceModel     String?              @db.VarChar(64)
  /// The device's own name (`X-Device-Name`, client type mobile only).
  deviceName      String?              @db.VarChar(64)
  /// The mobile app's version (`X-App-Version`, client type mobile only).
  appVersion      String?              @db.VarChar(64)
  /// The login flow that created the session.
  signInMethod    SessionSignInMethod?
  /// Request IP at sign-in.
  ipAddress       String?              @db.VarChar(45)
  /// Request IP of the most recent refresh.
  lastIpAddress   String?              @db.VarChar(45)
  /// Set at sign-in and on every refresh.
  lastActiveAt    BigInt               @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  /// Location of the sign-in IP from the `SessionLocationResolver` port (ISO 3166-1 alpha-2); NULL while the port resolves nothing.
  locationCountry String?              @db.VarChar(2)
  locationRegion  String?              @db.VarChar(64)
  locationCity    String?              @db.VarChar(128)

  expiresAt BigInt

  @@index([userId])
  /// `GET /auth/sessions` default order (most recently active first) within one user.
  @@index([userId, lastActiveAt(sort: Desc), id(sort: Desc)])
  @@index([token])
}

// ---------------------------------------------------------------------------
// Impersonation Audit Log
// ---------------------------------------------------------------------------

/// RLS: INSERT + SELECT need `app_rls_bypass()`; UPDATE/DELETE revoked for `app_runtime` (immutable audit).
/// @extends BaseModel
model ImpersonationAuditLog {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  impersonatorId String
  targetUserId   String
  action         String // "START" | "STOP"
  ipAddress      String? @db.VarChar(45)
  userAgent      String? @db.Text
  /// The server-side impersonation session this START/STOP row belongs to.
  sessionId      String?

  impersonator User                  @relation("Impersonator", fields: [impersonatorId], references: [id], onDelete: Cascade)
  targetUser   User                  @relation("ImpersonationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  session      ImpersonationSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([impersonatorId])
  @@index([targetUserId])
  @@index([sessionId])
  @@index([createdAt])
}

/// Why an impersonation session ended before its `expiresAt`.
enum ImpersonationSessionEndReason {
  /// The super-admin stopped impersonating (`POST /auth/stop-impersonation`).
  STOPPED
}

/// Server-side record of one SuperAdmin impersonation session. The
/// impersonation access token carries this row's `id` as its
/// `impersonationSessionId` claim; `AuthGuard` rejects the token unless the
/// row exists, matches the token's impersonator + target, has not ended, has
/// not expired, and the impersonator is still an active, non-deleted
/// SuperAdmin. Stopping ends the row with a compare-and-set on `endedAt IS NULL`.
/// Rows are never deleted — an ended session is part of the forensic record.
/// RLS: bypass-only (`app_rls_bypass()`): written under `platform.superadmin` /
/// `route.rls_bypass`, read by `AuthGuard` under `request.pre_handler`.
/// @extends BaseModel
model ImpersonationSession {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
