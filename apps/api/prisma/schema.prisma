/// NOT_SCANNED = no scanner configured (MALWARE_SCANNER=none); never presented as CLEAN.
enum KybDocumentScanStatus {
  SCANNING
  CLEAN
  INFECTED
  NOT_SCANNED
}

enum FileStatus {
  PENDING
  UPLOADED
  PROCESSING
  SCANNING
  READY
  FAILED
  QUARANTINED
  DELETED
}

enum FileCategory {
  PRODUCT_IMAGE
  STORE_LOGO
  STORE_BANNER
  USER_AVATAR
  MERCHANT_KYB
}

enum FileVisibility {
  PUBLIC
  PRIVATE
}

enum StorageProvider {
  local
  s3
  firebase
}

enum OrganizationAssetType {
  LOGO
  BANNER
}

enum FileVariantKind {
  ORIGINAL
  THUMBNAIL
  MEDIUM
  LARGE
}

enum RewardType {
