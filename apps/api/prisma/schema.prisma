/// One device session: the refresh token a signed-in device holds (rotated in place on every refresh,
/// so `id` is the stable session id — the `sid` claim of its access tokens, ADR 034).
/// Client-reported details (browser, OS, device model and name, app version) are display-only,
/// length-limited and zod-validated before storage; they never influence authorization.
/// Columns that are NULL on a session created before piece 4 of the mobile plan stay NULL.
/// RLS: own row — `app_owns("userId")`.
model RefreshToken {
  id                String  @id @default(uuid())
  token             String  @db.Text
  previousTokenHash String? @map("previous_token_hash") @db.Text
  rotationVersion   Int     @default(0) @map("rotation_version")
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The app that signed in (server-classified from `X-Client-Type`).
  clientType      SessionClientType?   @map("client_type")
  /// Browser / HTTP client parsed from the User-Agent (`Chrome`, `CFNetwork`).
  browserName     String?              @map("browser_name") @db.VarChar(64)
  browserVersion  String?              @map("browser_version") @db.VarChar(32)
  /// Operating system parsed from the User-Agent (`macOS`, `iOS`).
  osName          String?              @map("os_name") @db.VarChar(64)
  osVersion       String?              @map("os_version") @db.VarChar(32)
  /// Device class parsed from the User-Agent.
  deviceType      DeviceType?          @map("device_type")
  /// Device model: `X-Device-Model` for client type mobile, else the User-Agent's model (`iPhone 15 Pro`, `Pixel 8`).
  deviceModel     String?              @map("device_model") @db.VarChar(64)
  /// The device's own name (`X-Device-Name`, client type mobile only).
  deviceName      String?              @map("device_name") @db.VarChar(64)
  /// The mobile app's version (`X-App-Version`, client type mobile only).
  appVersion      String?              @map("app_version") @db.VarChar(64)
  /// The login flow that created the session.
  signInMethod    SessionSignInMethod? @map("sign_in_method")
  /// Request IP at sign-in.
  ipAddress       String?              @db.VarChar(45)
  /// Request IP of the most recent refresh.
  lastIpAddress   String?              @map("last_ip_address") @db.VarChar(45)
  /// Set at sign-in and on every refresh.
  lastActiveAt    BigInt               @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("last_active_at")
  /// Location of the sign-in IP from the `SessionLocationResolver` port (ISO 3166-1 alpha-2); NULL while the port resolves nothing.
  locationCountry String?              @map("location_country") @db.VarChar(2)
  locationRegion  String?              @map("location_region") @db.VarChar(64)
  locationCity    String?              @map("location_city") @db.VarChar(128)

  expiresAt BigInt
  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  /// Who revoked the session: a user id (the user, or an admin) or a system marker (`SessionSystemRevokerSchema`).
  deletedBy String? @map("deleted_by") @db.VarChar(64)
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

/// RLS: own row — `app_owns(user_id)`. Public redirects use bypass.
model Url {
  id           String       @id @default(uuid())
  userId       String?      @map("user_id")
  shortCode    String       @unique @map("short_code")
  customAlias  String?      @unique @map("custom_alias")
  originalUrl  String       @map("original_url") @db.Text
  title        String?
  redirectType RedirectType @default(TEMPORARY) @map("redirect_type")
  isActive     Boolean      @default(true) @map("is_active")
  passwordHash String?      @map("password_hash")
  clickLimit   Int?         @map("click_limit")
  clickCount   Int          @default(0) @map("click_count")
  expiresAt    BigInt?      @map("expires_at")
  isDeleted    Boolean      @default(false) @map("is_deleted")
  deletedAt    BigInt?      @map("deleted_at")
  createdAt    BigInt       @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt    BigInt       @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  user   User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  clicks Click[]
  tags   UrlTag[]

  @@index([shortCode])
  @@index([userId])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("urls")
}

/// RLS: own row — `app_owns(user_id)`.
model Tag {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  name      String
  color     String  @default("#6366f1")
  isDeleted Boolean @default(false) @map("is_deleted")
