/// Why a consumer parked a Kafka message instead of applying it.
enum InboxDeadLetterReason {
  EMPTY_MESSAGE
  MALFORMED_JSON
  SCHEMA_VIOLATION
  PERMANENT_PROCESSING_ERROR
  /// A transient failure (connection loss, timeout, deadlock, …) outlasted the bounded retry budget.
  RETRIES_EXHAUSTED
}

/// Poison messages a Kafka consumer could not apply. Parking (instead of throwing) keeps the
/// partition flowing; the unique Kafka coordinates make re-parking the same record a no-op.
/// Operators inspect `rawValue` / `error`, fix the cause, and replay (docs/technical/messaging.md);
/// the consumer purges rows older than ANALYTICS_DEAD_LETTER_RETENTION_DAYS.
/// RLS: app_runtime bypass + the least-privilege analytics_consumer role (prisma/rls/90-analytics-consumer.sql).
/// Seed: the development scenario parks one sample record (prisma/seed).
/// @extends BaseModel
model InboxDeadLetter {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  consumer          String                @db.VarChar(100)
  topic             String                @db.VarChar(255)
  partition         Int
  /// Kafka offsets are int64 — stored as their decimal string form.
  offset            String                @db.VarChar(32)
  /// Stable event id when the message parsed far enough to carry one.
  eventId           String?               @db.Uuid
  reason            InboxDeadLetterReason
  /// Why it was parked (bounded; a cut is marked with the original length).
  error             String                @db.Text
  /// Processing attempts made before parking (1 when the record could not be decoded).
  attempts          Int                   @default(1)
  /// Raw message value as bytes (binary-safe) for diagnosis and replay — whole unless
  /// `rawValueTruncated`; null for a tombstone.
  rawValue          Bytes?
  /// Size of the ORIGINAL value in bytes (also when the stored copy is truncated).
  rawValueSizeBytes Int?
  /// SHA-256 (hex) of the ORIGINAL value — verifies a replay / identifies a truncated copy.
  rawValueSha256    String?               @db.Char(64)
  /// True when `rawValue` holds only the first ANALYTICS_DEAD_LETTER_MAX_PAYLOAD_BYTES bytes.
  rawValueTruncated Boolean               @default(false)
  receivedAt        BigInt                @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))

  @@unique([consumer, topic, partition, offset])
  @@index([consumer, receivedAt])
}

