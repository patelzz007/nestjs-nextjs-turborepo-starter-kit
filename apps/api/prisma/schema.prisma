/// Outbox row lifecycle. FAILED is the dead-letter state (malformed envelope or retries exhausted) —
/// an operator re-queues a row by setting it back to PENDING (docs/technical/messaging.md).
enum OutboxEventStatus {
  PENDING
  PUBLISHED
  FAILED
}

/// Transactional outbox for durable Kafka publishing (docs/adr/015-transactional-outbox-and-inbox.md).
/// Rows are INSERTed in the SAME transaction as the domain change they describe; `id` is the stable
/// event id carried on the wire (`eventId`) so consumer inboxes can dedupe redeliveries.
/// RLS: append-only INSERT of fresh PENDING rows from any app session; read/update is bypass-only
/// (dispatcher, `outbox.publish` system operation). Seed: intentionally empty (runtime ledger).
/// @extends BaseModel
model OutboxEvent {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
