  CLAIM
}

/// RLS: owner-scoped via uploaded_by_id and relation tables.
model StoredFile {
  id               String                 @id @default(uuid())
  category         FileCategory
  visibility       FileVisibility
  originalName     String                 @map("original_name") @db.VarChar(255)
  mimeType         String                 @map("mime_type") @db.VarChar(100)
  sizeBytes        Int                    @map("size_bytes")
  expectedChecksum String                 @map("expected_checksum") @db.VarChar(64)
  actualChecksum   String?                @map("actual_checksum") @db.VarChar(64)
  storageProvider  StorageProvider?       @map("storage_provider")
  storageContainer String?                @map("storage_container") @db.VarChar(255)
  objectRevision   String?                @map("object_revision") @db.VarChar(64)
  storageBucket    String                 @map("storage_bucket") @db.VarChar(255)
  storagePath      String                 @map("storage_path") @db.VarChar(500)
  publicPath       String?                @map("public_path") @db.VarChar(500)
  objectGeneration String?                @map("object_generation") @db.VarChar(64)
  status           FileStatus             @default(PENDING)
  scanStatus       KybDocumentScanStatus? @map("scan_status")
  scannedAt        BigInt?                @map("scanned_at")
  scanResult       String?                @map("scan_result") @db.VarChar(500)
  uploadedById     String                 @map("uploaded_by_id")
  organizationId   String?                @map("organization_id")
  /// Product a PRODUCT_IMAGE upload is bound to (set at upload-url time, never parsed from the object path).
  productId        String?                @map("product_id")
  isDeleted        Boolean                @default(false) @map("is_deleted")
  deletedAt        BigInt?                @map("deleted_at")
  deletedBy        String?                @map("deleted_by")
  createdAt        BigInt                 @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt        BigInt                 @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  uploadedBy         User                  @relation("StoredFileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  organization       Organization?         @relation("StoredFileOrganization", fields: [organizationId], references: [id], onDelete: SetNull)
  product            Product?              @relation("StoredFileProduct", fields: [productId], references: [id], onDelete: SetNull)
  variants           FileVariant[]
  productImages      ProductImage[]
  organizationAssets OrganizationAsset[]
  userAvatar         UserAvatar?
  kybFiles           OrganizationKybFile[]

  @@index([uploadedById])
  @@index([organizationId])
  @@index([productId])
  @@index([status])
  @@index([category])
  @@map("stored_files")
}

/// RLS: via stored_files ownership.
model FileVariant {
  id               String           @id @default(uuid())
  fileId           String           @map("file_id")
  kind             FileVariantKind
  mimeType         String           @map("mime_type") @db.VarChar(100)
  sizeBytes        Int              @map("size_bytes")
  storageProvider  StorageProvider? @map("storage_provider")
  storageContainer String?          @map("storage_container") @db.VarChar(255)
  objectRevision   String?          @map("object_revision") @db.VarChar(64)
  storageBucket    String           @map("storage_bucket") @db.VarChar(255)
  storagePath      String           @map("storage_path") @db.VarChar(500)
  publicPath       String?          @map("public_path") @db.VarChar(500)
  objectGeneration String?          @map("object_generation") @db.VarChar(64)
  isDeleted        Boolean          @default(false) @map("is_deleted")
  deletedAt        BigInt?          @map("deleted_at")
  deletedBy        String?          @map("deleted_by")
  createdAt        BigInt           @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt        BigInt           @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, kind])
  @@index([fileId])
  @@map("file_variants")
}

/// RLS: via product ownership (catalog).
model ProductImage {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  fileId    String  @map("file_id")
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")
  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  deletedBy String? @map("deleted_by")
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  file    StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  /// At most one live primary image per product (concurrent uploads cannot both become primary).
  @@unique([productId], map: "product_images_one_live_primary_key", where: { isPrimary: true, isDeleted: false })
  @@index([productId])
  @@index([fileId])
  @@map("product_images")
}

/// RLS: via organization_id membership.
model OrganizationAsset {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  assetType      OrganizationAssetType @map("asset_type")
  fileId         String                @map("file_id")
  isDeleted      Boolean               @default(false) @map("is_deleted")
  deletedAt      BigInt?               @map("deleted_at")
  deletedBy      String?               @map("deleted_by")
  createdAt      BigInt                @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt      BigInt                @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  file         StoredFile   @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([organizationId, assetType])
  @@index([fileId])
  @@map("organization_assets")
}

/// RLS: via user ownership.
model UserAvatar {
  id        String  @id @default(uuid())
  userId    String  @unique @map("user_id")
  fileId    String  @unique @map("file_id")
  isDeleted Boolean @default(false) @map("is_deleted")
  deletedAt BigInt? @map("deleted_at")
  deletedBy String? @map("deleted_by")
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@map("user_avatars")
}

/// RLS: via organization_id membership.
model OrganizationKybFile {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  fileId         String  @map("file_id")
  submissionId   String  @map("submission_id")
  isActive       Boolean @default(true) @map("is_active")
  isDeleted      Boolean @default(false) @map("is_deleted")
  deletedAt      BigInt? @map("deleted_at")
  deletedBy      String? @map("deleted_by")
  createdAt      BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt      BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  file         StoredFile   @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([submissionId])
  @@index([fileId])
  @@map("organization_kyb_files")
}

/// What a merchant API key may call. Mirrors `OrganizationApiKeyScopeSchema` (packages/shared).
enum OrganizationApiKeyScope {
  /// A till: only the POS redemption routes. Every key a terminal receives by pairing is POS.
  POS
  /// A back-office integration: the POS routes plus the organization reward / redemption / analytics API.
  INTEGRATION
}

/// RLS: org members write; POS auth uses key hash lookup with bypass.
model OrganizationApiKey {
  id                         String                  @id @default(uuid())
  organizationId             String                  @map("organization_id")
  locationId                 String?                 @map("location_id")
  name                       String                  @db.VarChar(100)
  keyHash                    String                  @unique @map("key_hash") @db.Text
  keyPrefix                  String                  @map("key_prefix") @db.VarChar(16)
  /// What the key may call (POS routes only, or also the organization API). Paired terminal keys are always POS.
  scope                      OrganizationApiKeyScope
  createdByUserId            String                  @map("created_by_user_id")
  revokedAt                  BigInt?                 @map("revoked_at")
  lastUsedAt                 BigInt?                 @map("last_used_at")
  /// POS code-guess lockout (see `PosCodeLockoutService`): unknown QR tokens / backup codes presented with this key in the current window.
  codeFailureCount           Int                     @default(0) @map("code_failure_count")
  /// Start of the current failure-counting window; null before the first failure.
  codeFailureWindowStartedAt BigInt?                 @map("code_failure_window_started_at")
  /// While in the future, every redemption call with this key is refused (429 POS_CODE_LOCKED).
  codeLockedUntil            BigInt?                 @map("code_locked_until")
  isDeleted                  Boolean                 @default(false) @map("is_deleted")
  deletedAt                  BigInt?                 @map("deleted_at")
  createdAt                  BigInt                  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt                  BigInt                  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     OrganizationLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy    User                  @relation("OrganizationApiKeyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sales        RewardSale[]
  terminal     OrganizationTerminal?

  @@index([organizationId])
  @@index([locationId])
  @@map("organization_api_keys")
}

/// RLS: via organization_id and location_id.
model OrganizationTerminal {
  id                        String  @id @default(uuid())
  organizationId            String  @map("organization_id")
  locationId                String  @map("location_id")
  terminalId                String  @map("terminal_id") @db.VarChar(100)
  label                     String? @db.VarChar(100)
  /// The member who registered the till. Required, and never changes after creation (a pairing-code
  /// issuer is recorded separately in `pairingCodeIssuedByUserId`).
  createdByUserId           String  @map("created_by_user_id")
  /// The member who issued the current/last pairing code; becomes the creator of the API key minted when a till pairs with it.
  pairingCodeIssuedByUserId String? @map("pairing_code_issued_by_user_id")
  pairingCodeIssuedAt       BigInt? @map("pairing_code_issued_at")
  /// The API key issued when the till paired (one key per terminal; re-pairing rotates it).
  apiKeyId                  String? @unique @map("api_key_id")
  /// Keyed hash (`v<version>:<HMAC-SHA256 hex>`, `REWARD_CODE_HASH_KEYS`) of the live one-time pairing code; cleared once used.
  pairingCodeHash           String? @unique @map("pairing_code_hash") @db.VarChar(80)
  pairingCodeExpiresAt      BigInt? @map("pairing_code_expires_at")
  pairedAt                  BigInt? @map("paired_at")
  lastSeenAt                BigInt? @map("last_seen_at")
  isDeleted                 Boolean @default(false) @map("is_deleted")
  deletedAt                 BigInt? @map("deleted_at")
  deletedBy                 String? @map("deleted_by")
  createdAt                 BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt                 BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location            OrganizationLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdBy           User                 @relation("OrganizationTerminalCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  pairingCodeIssuedBy User?                @relation("OrganizationTerminalPairingCodeIssuer", fields: [pairingCodeIssuedByUserId], references: [id], onDelete: SetNull)
  apiKey              OrganizationApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  /// Live tills only: a soft-deleted till must not block re-registering its id.
  @@unique([organizationId, terminalId], where: { isDeleted: false })
  @@index([locationId])
  @@map("organization_terminals")
}

/// RLS: organization members for writes; public read for published consumer rewards.
model Reward {
  id                     String                        @id @default(uuid())
  organizationId         String                        @map("organization_id")
  title                  String                        @db.VarChar(200)
  description            String                        @db.Text
  rewardType             RewardType                    @map("reward_type")
  rewardValue            Int                           @default(0) @map("reward_value")
  termsConditions        String?                       @map("terms_conditions") @db.Text
  rewardKind             RewardKind                    @default(CONSUMER) @map("reward_kind")
  category               String                        @db.VarChar(100)
  placeholderImageKey    String                        @map("placeholder_image_key") @db.VarChar(100)
  /// Reward rules other than the minimum spend (e.g. `maxUsePerUser`); validated by `RewardRulesSchema`.
  rules                  Json?
  /// Minimum bill, in integer minor units (sen), for redeeming this reward; null = no minimum.
  /// The single source of truth (API `rules.minSpendMyr` is converted on write and derived on read);
  /// Never negative: validated by `RewardRulesSchema` (`minSpendMyr` nonnegative) before every write.
  minSpendMinor          Int?                          @map("min_spend_minor")
  quantityTotal          Int                           @map("quantity_total")
  quantityRemaining      Int                           @map("quantity_remaining")
  quantityReserved       Int                           @default(0) @map("quantity_reserved")
  startDate              BigInt?                       @map("start_date")
  expiryDate             BigInt                        @map("expiry_date")
  status                 RewardStatus                  @default(DRAFT)
  claimCount             Int                           @default(0) @map("claim_count")
  redemptionCount        Int                           @default(0) @map("redemption_count")
  metadata               Json?
  referralsEnabled       Boolean                       @default(true) @map("referrals_enabled")
  referralPoolTotal      Int?                          @map("referral_pool_total")
  referralPoolRemaining  Int?                          @map("referral_pool_remaining")
  referrerRewardId       String?                       @map("referrer_reward_id")
  parentConsumerRewardId String?                       @map("parent_consumer_reward_id")
  locationScopeType      OrganizationLocationScopeType @default(ALL_LOCATIONS) @map("location_scope_type")
  submittedForReviewAt   BigInt?                       @map("submitted_for_review_at")
  autoPublishAt          BigInt?                       @map("auto_publish_at")
  reviewedAt             BigInt?                       @map("reviewed_at")
  reviewedByUserId       String?                       @map("reviewed_by_user_id")
  rejectionReason        String?                       @map("rejection_reason") @db.Text
  isDeleted              Boolean                       @default(false) @map("is_deleted")
  deletedAt              BigInt?                       @map("deleted_at")
  createdAt              BigInt                        @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt              BigInt                        @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint")) @map("updated_at")

