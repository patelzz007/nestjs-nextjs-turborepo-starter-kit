/// One remembered choice of a person (`board.execution.groupBy`), its value checked against the shared
/// preference registry (`USER_PREFERENCE_REGISTRY`) on every write and every read — a stored value the
/// registry no longer accepts reads as unset. "Reset to default" soft-deletes the row.
/// @extends BaseModel
model UserPreference {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  userId  String
  /// A registry key (`USER_PREFERENCE_KEY_MAX_LENGTH`).
  key     String @db.VarChar(120)
  value   Json
  /// Optimistic-lock token: each write increments it.
  version Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, key], where: { isDeleted: false })
  @@index([userId, isDeleted])
}

