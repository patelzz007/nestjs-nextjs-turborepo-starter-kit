/// Who performed an RBAC change recorded in `PermissionAuditLog`.
enum PermissionAuditActorKind {
  /// An authenticated user — `actorId` is a `User.id`.
  USER
  /// An allowlisted system operation (scheduled job) — `actorId` is the operation name from
  /// `src/prisma/system-operation.registry.ts`, e.g. `maintenance.permission_expiry`.
  SYSTEM_OPERATION
}

/// RLS: bypass only (`app_rls_bypass()`).
/// @extends BaseModel
model PermissionAuditLog {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  actorKind      PermissionAuditActorKind @default(USER)
  actorId        String
  targetUserId   String?
  targetRoleId   String?
  permissionId   String?
  action         String
  detail         String?                  @db.Text
  /// Request correlation id — joins this domain entry to the global HTTP audit entry and logs.
  correlationId  String?                  @db.VarChar(64)
  /// The real (super-admin) user behind an impersonation session, when the actor was impersonated.
  impersonatorId String?

  @@index([actorId])
  @@index([targetUserId])
  @@index([targetRoleId])
  @@index([createdAt])
  @@index([correlationId])
}

