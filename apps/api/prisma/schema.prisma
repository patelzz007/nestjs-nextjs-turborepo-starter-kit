/// RLS: TENANT — platform onboarding or team-member invite.
/// @extends BaseModel
model TenantInvitation {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  tenantId             String?
  /// Case-insensitive (citext), so the one-PENDING-per-(tenant, email, kind) unique ignores case.
  email                String                 @db.Citext
  tokenHash            String                 @unique @db.Text
  kind                 TenantInvitationKind   @default(PLATFORM_ONBOARDING)
  intendedRole         MembershipRole
  locationScopeType    LocationScopeType      @default(ALL_LOCATIONS)
  status               TenantInvitationStatus @default(PENDING)
  createdByAdminId     String
  acceptedByUserId     String?
  expiresAt            BigInt
  acceptedAt           BigInt?
  /// When the post-acceptance KYB document submission consumed this token (onboarding tokens are single-use).
  documentsSubmittedAt BigInt?

  tenant         Tenant?                         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdByAdmin User                            @relation("TenantInvitationCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  acceptedByUser User?                           @relation("TenantInvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  locationScopes TenantInvitationLocationScope[]

  @@unique([tenantId, email, kind], where: { status: "PENDING" })
  @@index([email])
  @@index([tenantId])
  @@index([tenantId, kind, status])
  /// `GET /tenants/:tenantSlug/members/invites`: one tenant's pending team invites, newest first.
  @@index([tenantId, kind, status, createdAt(sort: Desc), id(sort: Desc)])
}

