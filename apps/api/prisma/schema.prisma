/// Every Resend delivery webhook event received, verified and recorded once (history of an
/// email's lifecycle; `EmailLog.status` is only the latest outcome). `webhookId` (the signed
/// `webhook-id` / `svix-id` header) is UNIQUE, so a redelivered webhook is a no-op.
/// Infrastructure log, not a business entity: no soft delete. RLS: insert/select/update bypass-only.
/// @extends BaseModel
model EmailDeliveryEvent {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  webhookId  String               @unique @db.VarChar(255)
  eventType  String               @db.VarChar(64)
  resendId   String               @db.VarChar(255)
  emailLogId String?
  emailLog   EmailLog?            @relation(fields: [emailLogId], references: [id], onDelete: Restrict)
  /// The EmailLogStatus the event maps to; null for tracking events the log ignores.
  status     EmailLogStatus?
  detail     String?              @db.VarChar(300)
  /// Epoch ms when the provider observed the event (its `createdAt`).
  occurredAt BigInt
  /// What this event did to `EmailLog`.
  outcome    EmailDeliveryOutcome

  @@index([resendId])
  @@index([emailLogId, occurredAt])
  @@index([createdAt])
}

/// Lifecycle of one outbound email — mirrors `EmailLogStatusSchema` in @workspace/shared
/// (apps/api/src/modules/notifications/email/email-status.enums.spec.ts asserts they are identical).
/// Used by `EmailDeliveryEvent.status`. `EmailLog.status` is still TEXT: converting an
/// existing populated column to an enum needs a data-preserving cast Prisma does not generate.
enum EmailLogStatus {
  pending
  sent
  delivered
  bounced
  complained
  failed
}

/// What a verified delivery-webhook event did to its `EmailLog` row — mirrors
/// `DeliveryEventOutcomeSchema` in @workspace/shared.
enum EmailDeliveryOutcome {
  applied /// moved the row forward
  stale /// older than (or a regression of) the row's newest applied outcome
  unmatched /// no row: an email this system never sent
  ignored /// tracking event (opened / clicked / …) — never changes the row
}

