  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  tenantId                  String
  locationId                String
  terminalId                String  @db.VarChar(100)
  label                     String? @db.VarChar(100)
  /// The member who registered the till. Required, and never changes after creation (a pairing-code
  /// issuer is recorded separately in `pairingCodeIssuedByUserId`).
  createdByUserId           String
  /// The member who issued the current/last pairing code; becomes the creator of the API key minted when a till pairs with it.
  pairingCodeIssuedByUserId String?
  pairingCodeIssuedAt       BigInt?
  /// The API key issued when the till paired (one key per terminal; re-pairing rotates it).
  apiKeyId                  String? @unique
  /// Keyed hash (`v<version>:<HMAC-SHA256 hex>`, `REWARD_CODE_HASH_KEYS`) of the live one-time pairing code; cleared once used.
  pairingCodeHash           String? @unique @db.VarChar(80)
  pairingCodeExpiresAt      BigInt?
  pairedAt                  BigInt?
  lastSeenAt                BigInt?

  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location            Location      @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade)
  creator             User          @relation("TenantTerminalCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  pairingCodeIssuedBy User?         @relation("TenantTerminalPairingCodeIssuer", fields: [pairingCodeIssuedByUserId], references: [id], onDelete: SetNull)
  apiKey              TenantApiKey? @relation(fields: [tenantId, apiKeyId], references: [tenantId, id], onDelete: Restrict)

