/// RLS: TENANT — store/site within an organization.
/// @extends BaseModel
model OrganizationLocation {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  organizationId    String
  name              String                     @db.VarChar(200)
  code              String                     @db.VarChar(64)
  addressText       String?                    @db.Text
  city              PilotCity?
  contactPhone      String?                    @db.VarChar(20)
  status            OrganizationLocationStatus @default(PENDING_APPROVAL)
  rejectionReason   String?                    @db.Text
  requestedByUserId String?
  reviewedByUserId  String?
  reviewedAt        BigInt?
  isPrimary         Boolean                    @default(false)
  /// Why the store was closed (bankruptcy, lease ended, ...); set together with the soft-delete fields when it is closed.
  closureReason     String?                    @db.Text

  organization             Organization                          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy              User?                                 @relation("OrganizationLocationRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  reviewedBy               User?                                 @relation("OrganizationLocationReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  locationScopes           OrganizationMembershipLocationScope[]
  invitationLocationScopes OrganizationInvitationLocationScope[]
  rewardLocationScopes     RewardLocationScope[]
  terminals                OrganizationTerminal[]
  redemptions              RewardRedemption[]
  rewardSales              RewardSale[]
  apiKeys                  OrganizationApiKey[]
  store                    Store?

  @@unique([organizationId, code])
  /// At most one live primary location per organization (partial unique — soft-deleted rows ignored).
  @@unique([organizationId], where: { isPrimary: true, isDeleted: false })
  @@index([organizationId])
  @@index([organizationId, status])
}

/// RLS: MEMBERSHIP — user membership in an organization.
/// @extends BaseModel
model OrganizationMembership {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  organizationId String
  userId         String
  role           OrganizationMembershipRole
  status         OrganizationMembershipStatus @default(ACTIVE)
  /// The member's own name for this organization (`PATCH /orgs/:orgSlug/members/me`); trimmed, at most
  /// `ORGANIZATION_MEMBER_DISPLAY_NAME_MAX_LENGTH` (100) characters; NULL = show the account's full name.
  displayName    String?                      @db.VarChar(100)

  organization   Organization                          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                                  @relation("OrganizationMemberships", fields: [userId], references: [id], onDelete: Cascade)
  locationScopes OrganizationMembershipLocationScope[]

  @@unique([organizationId, userId], where: { isDeleted: false })
  @@index([userId])
  @@index([organizationId, status])
  /// `GET /orgs/:orgSlug/members` (join order within one organization) and `GET /orgs/memberships` (one user's, in join order).
  @@index([organizationId, createdAt, id])
  @@index([userId, createdAt, id])
}

