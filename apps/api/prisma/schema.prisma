// ── Feature-surface persistence (improvement 1 — history survives restarts) ──
// Jobs / alerts / annotations were memory-scoped in the first Postgres store;
// these tables make every surface durable. Schedules are re-registered at boot
// so they need no table.

/// RLS: INSERT open (capture); SELECT/UPDATE/DELETE need bypass.
model TelescopeJob {
  id            String  @id
  jobName       String  @map("job_name")
  status        String  @db.VarChar(20)
  durationMs    Int?    @map("duration_ms")
  payloadSize   Int     @default(0) @map("payload_size")
  error         String? @db.Text
  correlationId String? @map("correlation_id")
  enqueuedAt    BigInt  @map("enqueued_at")
  startedAt     BigInt? @map("started_at")
  finishedAt    BigInt? @map("finished_at")
  createdAt     BigInt  @default(dbgenerated("(EXTRACT(EPOCH FROM now()) * 1000)::bigint")) @map("created_at")

  @@index([createdAt])
  @@map("telescope_jobs")
}

/// RLS: INSERT open (capture); SELECT/UPDATE/DELETE need bypass.
model TelescopeAlert {
  id           String  @id
  requestId    String? @map("request_id")
