/// RLS: tenant members for writes; public read for published consumer rewards.
/// @extends BaseModel
model Reward {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  tenantId               String
  title                  String            @db.VarChar(200)
  description            String            @db.Text
  rewardType             RewardType
  rewardValue            Int               @default(0)
  termsConditions        String?           @db.Text
  rewardKind             RewardKind        @default(CONSUMER)
  category               String            @db.VarChar(100)
  /// Reward rules other than the minimum spend (e.g. `maxUsePerUser`); validated by `RewardRulesSchema`.
  rules                  Json?
  /// Minimum bill, in integer minor units (sen), for redeeming this reward; null = no minimum.
  /// The single source of truth (API `rules.minSpendMyr` is converted on write and derived on read);
  /// Never negative: validated by `RewardRulesSchema` (`minSpendMyr` nonnegative) before every write.
  minSpendMinor          Int?
  quantityTotal          Int
  quantityRemaining      Int
  quantityReserved       Int               @default(0)
  startDate              BigInt?
  expiryDate             BigInt
  status                 RewardStatus      @default(DRAFT)
  claimCount             Int               @default(0)
  redemptionCount        Int               @default(0)
  metadata               Json?
  referralsEnabled       Boolean           @default(true)
  referralPoolTotal      Int?
  referralPoolRemaining  Int?
  referrerRewardId       String?
  parentConsumerRewardId String?
  locationScopeType      LocationScopeType @default(ALL_LOCATIONS)
  submittedForReviewAt   BigInt?
  autoPublishAt          BigInt?
  reviewedAt             BigInt?
  reviewedByUserId       String?
  rejectionReason        String?           @db.Text

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referrerReward       Reward?               @relation("ConsumerReferrerReward", fields: [tenantId, referrerRewardId], references: [tenantId, id], onDelete: Restrict)
  consumerRewards      Reward[]              @relation("ConsumerReferrerReward")
  parentConsumerReward Reward?               @relation("ReferrerCloneParent", fields: [tenantId, parentConsumerRewardId], references: [tenantId, id], onDelete: Restrict)
  referrerClones       Reward[]              @relation("ReferrerCloneParent")
  claims               RewardClaim[]
  referrals            RewardReferral[]
  locationScopes       RewardLocationScope[]
  /// The reward's images in display order (1–10 live rows; position 0 is the cover).
  images               RewardImage[]

  /// Composite target of the tenant-scoped foreign keys (multi-tenancy plan §7): a child row
  /// can reference this row only from the same tenant.
  @@unique([tenantId, id])
  @@index([tenantId])
  /// `GET /tenants/:tenantSlug/rewards`: one tenant's catalog, newest first (a status tab narrows it).
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status])
  @@index([category])
  @@index([expiryDate])
  @@index([autoPublishAt])
  @@index([rewardKind])
}

/// RLS: tenant members write; readable whenever its reward is readable.
/// One image of a reward, in display order. Replacing a reward's images soft-deletes the old rows and
/// inserts the new ones in the same transaction; the files are READY, PUBLIC `REWARD_IMAGE`s of the
/// same tenant (checked under a row lock on every write).
/// @extends BaseModel
model RewardImage {
  // ── BaseModel: managed by `pnpm db:schema`, do not edit ──
  id        String  @id @default(uuid(7))
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  createdBy String? @db.VarChar(128)
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM now()) * (1000)::numeric))::bigint"))
  updatedBy String? @db.VarChar(128)
  isDeleted Boolean @default(false)
  deletedAt BigInt?
  deletedBy String? @db.VarChar(128)
  // ── end BaseModel ──

  tenantId String
  rewardId String
  fileId   String
  /// 0-based display position; position 0 is the reward's cover.
  position Int

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reward Reward     @relation(fields: [tenantId, rewardId], references: [tenantId, id], onDelete: Cascade)
  file   StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([rewardId, position], where: { isDeleted: false })
  @@unique([rewardId, fileId], where: { isDeleted: false })
  @@index([rewardId])
  @@index([fileId])
  @@index([tenantId])
}

