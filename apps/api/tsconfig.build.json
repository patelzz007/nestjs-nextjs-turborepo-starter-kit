{
	// Emitting program for `nest build`-style tooling (the API itself builds with Rspack/SWC,
	// which reads no tsconfig): the production program, writing to dist/.
	"extends": "./tsconfig.typecheck.json",
	"compilerOptions": {
		"noEmit": false,
		"outDir": "./dist",
		"emitDecoratorMetadata": true,
		"sourceMap": true
	}
}
