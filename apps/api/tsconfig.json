{
	"extends": "@workspace/typescript-config/nestjs.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"incremental": true
		// Do not add `"customConditions": ["development"]`. That condition
		// resolves @workspace/shared and @workspace/messaging to TypeScript
		// source, so type-aware ESLint typechecks their zod contracts inside
		// this program. After the referral and device-session contracts landed,
		// that program no longer fits in Node's default heap (ESLint exit 134).
		// Both packages publish dist/*.d.ts; tsc-alias writes resolvable
		// `import("…/index.js")` paths, so the declarations are the types.
		// `lint` waits for those builds (apps/api/turbo.json). Runtime already
		// loads dist: rspack leaves workspace packages external.
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "src/**/*.spec.ts"]
}
