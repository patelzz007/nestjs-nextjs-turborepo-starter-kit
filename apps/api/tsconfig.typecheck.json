{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"declaration": false,
		"declarationMap": false,
		"sourceMap": false,
		"incremental": false,
		"emitDecoratorMetadata": false
	},
	"include": ["src/**/*.ts"],
	"exclude": [
		"node_modules",
		"dist",
		"src/**/*.spec.ts",
		"src/**/*.test.ts",
		"src/**/__tests__/**"
	]
}