{
	// The PRODUCTION program: src/ without specs, and without the vitest globals, so
	// production code can never lean on a test-only type. The first `typecheck` pass.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"rootDir": "./src",
		"types": ["node"],
		"declaration": false,
		"declarationMap": false,
		"sourceMap": false,
		"emitDecoratorMetadata": false
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist", "src/**/*.spec.ts", "src/**/*.test.ts", "src/**/__tests__/**"]
}
