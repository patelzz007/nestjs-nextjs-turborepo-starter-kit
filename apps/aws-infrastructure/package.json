{
	"name": "@workspace/aws-infrastructure",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsrs -p tsconfig.json",
		"watch": "tsrs -w -p tsconfig.json",
		"cdk": "cdk",
		"synth": "cdk synth",
		"deploy": "cdk deploy --all",
		"diff": "cdk diff",
		"test": "vitest run",
		"typecheck": "tsrs --noEmit -p tsconfig.json",
		"lint": "oxfmt --check \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\" && oxlint",
		"format": "oxfmt \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\""
	},
	"dependencies": {
		"aws-cdk-lib": "^2.274.0",
		"constructs": "^10.8.1"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"@workspace/oxlint-config": "workspace:*",
		"@workspace/typescript-config": "workspace:*",
		"aws-cdk": "^2.1146.1",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "7.0.2005",
		"tsrs": "0.18.0-ts7.1.0-dev.20260929",
		"tsx": "^4.23.15",
		"typescript": "7.0.2",
		"vitest": "^5.0.5",
		"zod": "4.6.7"
	}
}
