{
	"name": "@workspace/docs",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite dev --port 3002",
		"build": "node scripts/check-links.ts && vite build && node scripts/check-baseline.ts",
		"preview": "vite preview --port 3002",
		"start": "vite preview --port 3002",
		"lint": "oxfmt --check \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\" && oxlint",
		"format": "oxfmt \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\"",
		"typecheck": "tsrs --noEmit",
		"test": "vitest run --coverage",
		"check:links": "node scripts/check-links.ts",
		"capture:api-samples": "node scripts/capture-api-samples.mjs",
		"check:baseline": "node scripts/check-baseline.ts"
	},
	"dependencies": {
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@tanstack/react-pacer": "^0.24.1",
		"@tanstack/react-query": "^5.105.0",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-start": "^1.169.4",
		"@tanstack/react-table": "^9.3.1",
		"@tanstack/start-static-server-functions": "^1.167.44",
		"@workspace/docs-renderer": "workspace:*",
		"@workspace/shared": "workspace:*",
		"@workspace/tokens": "workspace:*",
		"@workspace/ui": "workspace:*",
		"date-fns": "^4.4.0",
		"lucide-react": "^1.66.0",
		"pele": "^1.13.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"yaml": "^2.9.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@workspace/oxlint-config": "workspace:^",
		"@workspace/typescript-config": "workspace:*",
		"jsdom": "^30.1.3",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"tailwindcss": "^4.3.3",
		"tsrs": "0.20.1-ts7.1.0-beta",
		"typescript": "7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
