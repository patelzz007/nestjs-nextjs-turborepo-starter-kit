{
	"name": "@workspace/docs",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "astro dev --port 3002",
		"build": "node scripts/check-links.mjs && astro build --force",
		"preview": "astro preview --port 3002",
		"start": "astro preview --port 3002",
		"lint": "astro sync && oxfmt --check \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\" && oxlint",
		"format": "oxfmt \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\"",
		"typecheck": "astro check",
		"test": "vitest run",
		"check:links": "node scripts/check-links.mjs",
		"docs:api": "vitest run src/lib/api-reference/__tests__/api-reference.artifact.test.ts --update",
		"capture:api-samples": "node scripts/capture-api-samples.mjs"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.12",
		"@astrojs/markdown-remark": "^7.3.4",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
		"@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
		"@workspace/shared": "workspace:*",
		"@workspace/tokens": "workspace:*",
		"@workspace/ui": "workspace:*",
		"astro": "^7.4.2",
		"date-fns": "^4.4.0",
		"lucide": "^1.62.0",
		"mdast-util-to-hast": "^13.2.1",
		"pele": "^1.12.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"remark-gfm": "^4.0.1",
		"shiki": "^4.5.0",
		"unist-util-visit": "^5.2.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@workspace/oxlint-config": "workspace:^",
		"@workspace/typescript-config": "workspace:*",
		"jsdom": "^30.1.3",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"tailwindcss": "^4.3.3",
		"typescript": "6.0.3",
		"vitest": "^5.0.5"
	}
}
