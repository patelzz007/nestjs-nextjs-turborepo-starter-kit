{
	"name": "@workspace/docs",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "astro dev --port 3002 --force",
		"build": "node scripts/check-links.mjs && astro build --force",
		"preview": "astro preview --port 3002",
		"start": "astro preview --port 3002",
		"lint": "astro sync && eslint --max-warnings=0",
		"format": "prettier --write \"src/**/*.ts\" \"*.ts\" \"scripts/**/*.mjs\"",
		"typecheck": "astro check",
		"test": "vitest run",
		"check:links": "node scripts/check-links.mjs",
		"docs:api": "vitest run src/lib/api-reference/api-reference.artifact.test.ts --update",
		"capture:api-samples": "node scripts/capture-api-samples.mjs"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/markdown-remark": "^7.3.1",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@fontsource-variable/bricolage-grotesque": "5.3.0",
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"@workspace/ui": "workspace:*",
		"astro": "^7.3.5",
		"date-fns": "^4.4.0",
		"lucide": "^1.52.0",
		"mdast-util-to-hast": "^13.2.1",
		"mermaid": "^12.1.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"remark-gfm": "^4.0.1",
		"shiki": "^4.5.0",
		"unist-util-visit": "^5.1.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@workspace/eslint-config": "workspace:^",
		"@workspace/typescript-config": "workspace:*",
		"eslint": "^9.39.5",
		"jsdom": "^30.1.2",
		"tailwindcss": "^4.3.3",
		"typescript": "6.0.3",
		"vitest": "^5.0.3"
	}
}
