---
/**
 * A page's cover image (`coverImage` in its front matter) as a banner under the
 * breadcrumbs: the same art the page shares as its social preview. Decorative
 * (empty alt): the title right under it says what the page is.
 */
interface Props {
	readonly src: string | undefined;
}

/** The banner's intrinsic size: a 3:1 crop of the 1600px-wide source, so the page reserves its height before the image loads. */
const COVER_WIDTH = 1600;
const COVER_HEIGHT = 533;

const { src } = Astro.props;
---

{
	src !== undefined && (
		<figure class="page-cover">
			<img src={src} alt="" width={COVER_WIDTH} height={COVER_HEIGHT} loading="eager" fetchpriority="high" decoding="async" />
		</figure>
	)
}
