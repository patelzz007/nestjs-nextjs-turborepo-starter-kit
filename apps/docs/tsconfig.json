{
	"extends": "@workspace/typescript-config/react-library.json",
	"compilerOptions": {
		"declaration": false,
		"declarationMap": false,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"paths": {
			"@/*": ["./src/*"]
		},
		"types": ["node", "vite/client"],
		"customConditions": ["development"]
	},
	"include": ["src", "scripts", "vite.config.ts", "vitest.config.ts", "oxlint.config.ts"],
	"exclude": ["dist", "node_modules", ".output", ".tanstack"]
}
