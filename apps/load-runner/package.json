{
	"name": "@workspace/load-runner",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "The load runner (ADR 068): takes load tests from the queue and drives them with k6, never inside the API it measures.",
	"scripts": {
		"start": "tsx src/main.ts",
		"format": "oxfmt \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\"",
		"lint": "oxfmt --check \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\" && oxlint",
		"typecheck": "tsrs --noEmit",
		"test": "vitest run --config vitest.config.ts"
	},
	"dependencies": {
		"@workspace/messaging": "workspace:*",
		"@workspace/shared": "workspace:*",
		"bullmq": "^6.5.0",
		"ioredis": "^6.0.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"@workspace/oxlint-config": "workspace:^",
		"@workspace/typescript-config": "workspace:*",
		"dotenv": "^18.0.9",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"tsrs": "0.20.0-ts7.1.0-beta",
		"tsx": "^4.23.15",
		"typescript": "7.0.2",
		"vitest": "^5.0.5"
	}
}
