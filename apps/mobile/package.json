{
	"name": "@workspace/mobile",
	"version": "1.0.0",
	"private": true,
	"main": "index.ts",
	"scripts": {
		"dev": "expo start --clear",
		"start": "expo start --clear",
		"lint": "oxfmt --check \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\" && oxlint",
		"format": "oxfmt \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\"",
		"typecheck": "tsrs --noEmit",
		"test": "jest && cross-env EXPO_OFFLINE=1 expo install --check",
		"check:expo-latest": "expo install --check",
		"build": "expo export --platform ios --platform android --output-dir dist",
		"clean": "rm -rf dist .expo"
	},
	"dependencies": {
		"@expo-google-fonts/bricolage-grotesque": "0.4.1",
		"@expo-google-fonts/geist": "0.4.2",
		"@expo-google-fonts/geist-mono": "0.4.3",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.105.0",
		"@workspace/api-client": "workspace:*",
		"@workspace/shared": "workspace:*",
		"@workspace/tokens": "workspace:*",
		"@workspace/ui-native": "workspace:*",
		"expo": "~58.0.21",
		"expo-application": "~58.1.2",
		"expo-blur": "~58.0.5",
		"expo-camera": "~58.0.14",
		"expo-clipboard": "~58.0.4",
		"expo-constants": "~58.0.14",
		"expo-crypto": "~58.0.7",
		"expo-device": "~58.0.5",
		"expo-document-picker": "~58.0.4",
		"expo-file-system": "~58.0.13",
		"expo-font": "~58.0.11",
		"expo-haptics": "~58.0.7",
		"expo-image": "~58.0.18",
		"expo-image-picker": "~58.0.10",
		"expo-linking": "~58.0.15",
		"expo-local-authentication": "~58.0.2",
		"expo-network": "~58.0.4",
		"expo-router": "~58.0.28",
		"expo-secure-store": "~58.0.2",
		"expo-sharing": "~58.0.21",
		"expo-splash-screen": "~58.0.12",
		"expo-status-bar": "~58.0.4",
		"expo-system-ui": "~58.0.7",
		"lucide-react-native": "^1.63.0",
		"marked": "18.1.2",
		"nuqs": "2.10.2",
		"react": "19.3.0",
		"react-native": "0.88.1",
		"react-native-keyboard-controller": "1.22.7",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.10.1",
		"react-native-screens": "~4.30.1",
		"react-native-svg": "15.16.0",
		"react-native-url-polyfill": "^4.0.0",
		"react-native-worklets": "0.13.0",
		"tailwindcss": "^4.3.3",
		"uniwind": "^1.13.1",
		"zod": "4.6.7",
		"zustand": "^5.0.16"
	},
	"devDependencies": {
		"@babel/plugin-transform-dynamic-import": "7.29.7",
		"@react-native/jest-preset": "0.88.1",
		"@react-native/metro-config": "0.88.1",
		"@testing-library/react-native": "~14.1.0",
		"@types/jest": "^30.0.0",
		"@types/react": "^19.3.0",
		"@workspace/oxlint-config": "workspace:*",
		"@workspace/typescript-config": "workspace:*",
		"babel-preset-expo": "~58.0.22",
		"cross-env": "^10.1.0",
		"jest": "^30.5.2",
		"jest-expo": "~58.0.13",
		"metro": "0.87.1",
		"metro-cache": "0.87.1",
		"metro-transform-worker": "0.87.1",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"react-dom": "19.3.0",
		"react-native-web": "~0.21.4",
		"simple-icons": "16.36.0",
		"test-renderer": "^1.3.1",
		"tsrs": "0.20.1-ts7.1.0-beta",
		"typescript": "7.0.2"
	},
	"expo": {
		"install": {
			"exclude": [
				"metro",
				"typescript"
			]
		}
	}
}
