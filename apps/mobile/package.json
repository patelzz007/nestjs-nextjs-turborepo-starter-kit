{
	"name": "@workspace/mobile",
	"version": "1.0.0",
	"private": true,
	"main": "index.ts",
	"scripts": {
		"dev": "expo start --clear",
		"start": "expo start --clear",
		"lint": "eslint",
		"format": "prettier --write \"**/*.{ts,tsx}\" --ignore-path ../../.prettierignore",
		"typecheck": "tsrs --noEmit",
		"test": "jest && expo install --check",
		"build": "expo export --platform ios --platform android --output-dir dist",
		"clean": "rm -rf dist .expo"
	},
	"dependencies": {
