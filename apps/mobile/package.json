{
	"name": "@workspace/mobile",
	"version": "1.0.0",
	"private": true,
	"main": "index.ts",
	"scripts": {
		"dev": "expo start --clear",
		"start": "expo start --clear",
		"lint": "oxfmt --check \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\" && oxlint",
		"format": "oxfmt \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\"",
		"typecheck": "tsrs --noEmit && tsrs --noEmit -p scripts/tsconfig.json",
		"test": "jest --coverage && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/showcase.ts --check && cross-env EXPO_OFFLINE=1 expo install --check",
		"check:expo-latest": "expo install --check",
		"e2e:device": "node ../../packages/tooling/src/starter/mobile-device-tests/cli.ts",
		"cold-start": "node ../../packages/tooling/src/starter/mobile-cold-start/cli.ts",
		"screenshots:device": "node ../../packages/tooling/src/starter/mobile-readme-screenshots/cli.ts",
		"build": "expo export --platform ios --platform android --output-dir dist",
		"clean": "rm -rf dist .expo"
	},
	"dependencies": {
		"@casl/ability": "7.1.3",
		"@casl/react": "7.1.0",
		"@expo-google-fonts/bricolage-grotesque": "0.4.1",
