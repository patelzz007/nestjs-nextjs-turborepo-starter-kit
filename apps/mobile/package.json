		"@expo-google-fonts/geist-mono": "0.4.3",
		"@expo-google-fonts/jetbrains-mono": "0.4.1",
		"@react-native-firebase/app": "27.1.1",
		"@react-native-firebase/crashlytics": "27.1.1",
		"@react-native-firebase/installations": "27.1.1",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.107.1",
		"@tanstack/react-table": "^9.3.1",
		"@workspace/api-client": "workspace:*",
		"@workspace/shared": "workspace:*",
		"@workspace/tokens": "workspace:*",
		"@workspace/ui-kit-logic": "workspace:*",
		"@workspace/ui-native": "workspace:*",
		"emojibase-data": "18.0.0",
		"expo": "~58.0.24",
		"expo-application": "~58.1.2",
		"expo-blur": "~58.0.6",
		"expo-camera": "~58.0.14",
		"expo-clipboard": "~58.0.4",
		"expo-constants": "~58.0.16",
