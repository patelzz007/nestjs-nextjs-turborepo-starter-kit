		"@types/jest": "^30.0.0",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@workspace/oxlint-config": "workspace:*",
		"@workspace/tooling": "workspace:*",
		"@workspace/typescript-config": "workspace:*",
		"babel-plugin-react-compiler": "1.0.0",
		"babel-preset-expo": "~58.0.25",
		"cross-env": "^10.1.0",
		"devicon": "2.18.0",
		"jest": "^30.5.2",
		"jest-expo": "~58.0.14",
		"metro": "0.87.1",
		"metro-cache": "0.87.1",
		"metro-transform-worker": "0.87.1",
		"oxfmt": "0.78.0",
		"oxlint": "1.93.0",
		"oxlint-tsgolint": "7.0.2006",
		"react-dom": "19.3.0",
		"react-native-web": "~0.21.4",
		"simple-icons": "16.37.0",
		"test-renderer": "^1.3.1",
		"tsrs": "0.24.0-ts7.1.0-beta",
		"typescript": "7.0.2"
	},
	"expo": {
		"install": {
			"exclude": [
				"metro",
				"typescript"
			]
		}
	}
}
