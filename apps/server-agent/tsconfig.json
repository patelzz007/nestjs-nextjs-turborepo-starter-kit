{
	"extends": "@workspace/typescript-config/nestjs.json",
	"compilerOptions": {
		"outDir": "./dist",
		// The package root, not src/: the lint canary (src/__tests__) imports oxlint.config.ts.
		"rootDir": ".",
		// Resolve @workspace/* through their `development` export (src/), like every
		// other workspace — never through an unbuilt or stale dist/ (clean CI checkout).
		"customConditions": ["development"]
	},
	"include": ["src/**/*", "oxlint.config.ts"]
}
