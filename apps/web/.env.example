[TEMPLATE]
# ============================================
# apps/web/.env.example
# Copy to .env and fill in real values.
# NEVER commit the real .env (it is git-ignored).
#
# Validated by lib/env/env.client.ts (NEXT_PUBLIC_*) and lib/env/env.server.ts
# (server-only). A missing/invalid REQUIRED value fails `next build` /
# server start with an error naming the variable. See docs/technical/configuration/frontend.md.
# ============================================

# ── Public (NEXT_PUBLIC_*) — inlined into the browser bundle at BUILD time ──
# Every value here is public. Changing one requires a rebuild.

# REQUIRED. Base URL of the NestJS API (absolute http/https URL).
NEXT_PUBLIC_API_URL=http://localhost:8080

# REQUIRED. This app's own public origin. Sent as `Origin` when the proxy /
# SSR refreshes the session, so it must be listed in the API's CORS_ORIGINS.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Server-only — read at RUNTIME by the Node server, never bundled ──
# NODE_ENV is set by Next.js itself (development for `next dev`, production
# for `next build` / `next start`); do not set it here.

# OPTIONAL. Domain attribute used when the proxy CLEARS auth cookies. Must
# match the API's COOKIE_DOMAIN (e.g. `localhost` for local dev so cookies are
# shared across :3000 / :3001 / :3003 / :8080, `.example.com` in production).
# COOKIE_DOMAIN=localhost

