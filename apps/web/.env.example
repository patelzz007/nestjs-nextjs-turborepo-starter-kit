[TEMPLATE]
# ============================================
# apps/web/.env.example
# Copy to .env and fill in real values.
# NEVER commit the real .env (it is git-ignored).
# ============================================

# Base URL of the API (NestJS). Used by the AuthProvider for
# login/logout/me requests. Vars prefixed NEXT_PUBLIC_ are exposed
# to the browser bundle.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Auth cookies are set by the API (apps/api/.env). For local dev the API
# MUST set `COOKIE_DOMAIN=localhost` so httpOnly tokens are shared across
# localhost:3000 (web), :3001 (admin), and :8080 (API). Without it, login
# may appear to succeed (client store updates) but cookies stay on :8080 only.

# One-click demo accounts on the login page (local/dev convenience).
# Set to `true` locally; leave unset/`false` in production so the
# demo credentials never render.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
