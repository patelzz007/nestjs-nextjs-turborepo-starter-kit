{
	"extends": "@workspace/typescript-config/nextjs.json",
	"compilerOptions": {
		"paths": {
			"@/*": ["./*"]
		},
		"plugins": [
			{
				"name": "next"
			}
		],
		"customConditions": ["development"]
	},
	"include": ["next-env.d.ts", "next.config.ts", "**/*.ts", "**/*.tsx", "**/*.mts", "app/.well-known/**/*.ts", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
	"exclude": ["node_modules"]
}
