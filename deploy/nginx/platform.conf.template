# ============================================================================
# nginx in front of the platform on a Droplet (ADR 075). Rendered by step 12 of
# docs/technical/operations/digitalocean-deployment.md:
#
#   sed -e "s/__DOMAIN__/example.com/g" platform.conf.template > /etc/nginx/sites-available/platform.conf
#
# Four hosts, each proxied to its pm2 process on loopback. certbot (`certbot --nginx`) then adds the
# 443 listeners and the HTTP→HTTPS redirect to these blocks. The apps set their own security headers
# (the API through Helmet, the Next.js apps through proxy.ts), so nginx adds only HSTS.
# ============================================================================

# Real client IPs reach the apps through X-Forwarded-For; the API trusts it only from TRUST_PROXY=127.0.0.1.
map $http_upgrade $connection_upgrade {
	default upgrade;
	"" close;
}

upstream platform_api { server 127.0.0.1:8080; keepalive 32; }
upstream platform_web { server 127.0.0.1:3000; keepalive 16; }
upstream platform_admin { server 127.0.0.1:3001; keepalive 16; }
upstream platform_merchant { server 127.0.0.1:3003; keepalive 16; }

# Shared proxy settings.
proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $connection_upgrade;
proxy_read_timeout 75s;

server {
	listen 80;
	server_name api.__DOMAIN__;
	# Uploads go to object storage directly; the API takes JSON and small multipart bodies only.
	client_max_body_size 12m;

	location / {
		proxy_pass http://platform_api;
		# Server-sent events (notifications, audit trail, live updates) must stream, not buffer.
		proxy_buffering off;
		proxy_cache off;
		proxy_read_timeout 1h;
	}
}

server {
	listen 80;
	server_name __DOMAIN__ www.__DOMAIN__;
	location / { proxy_pass http://platform_web; }
}

server {
	listen 80;
	server_name admin.__DOMAIN__;
	location / { proxy_pass http://platform_admin; }
}

server {
	listen 80;
	server_name merchant.__DOMAIN__;
	location / { proxy_pass http://platform_merchant; }
}
