  "ClamAvScanner2C8BC9B2": {
   "Type": "AWS::Lambda::Function",
   "Properties": {
    "Code": {
     "ZipFile": "\nconst { S3Client, GetObjectCommand } = require(\"@aws-sdk/client-s3\");\n\nconst EICAR_SIGNATURE = \"X5O!P%@AP[4\\\\PZX54(P^)7CC)7}$EICAR-STANDARD-ANTIVIRUS-TEST-FILE!$H+H*\";\n\nfunction resolvePayload(event) {\n  if (event.bucket && event.key && event.fileId) {\n    return { bucket: event.bucket, key: event.key, fileId: event.fileId };\n  }\n  throw new Error(\"Invalid scanner invoke payload\");\n}\n\nasync function readObjectBody(stream) {\n  const chunks = [];\n  for await (const chunk of stream) {\n    chunks.push(chunk);\n  }\n  return Buffer.concat(chunks);\n}\n\nexports.handler = async (event) => {\n  const { bucket, key } = resolvePayload(event);\n  const s3 = new S3Client({});\n  const object = await s3.send(new GetObjectCommand({ Bucket: bucket, Key: key }));\n  const body = await readObjectBody(object.Body);\n  const haystack = body.toString(\"utf8\");\n  const infected = haystack.includes(EICAR_SIGNATURE);\n  return {\n    clean: !infected,\n    scanResult: infected ? \"EICAR-TEST-SIGNATURE\" : \"OK\",\n  };\n};\n"
    },
    "Environment": {
     "Variables": {
      "PRIVATE_BUCKET": {
       "Ref": "PrivateBucket35D9C6C6"
      }
     }
    },
    "FunctionName": "app-development-clamav-scanner",
    "Handler": "index.handler",
    "MemorySize": 2048,
    "Role": {
     "Fn::GetAtt": [
      "ClamAvScannerServiceRole559F68FC",
      "Arn"
     ]
    },
    "Runtime": "nodejs22.x",
    "Timeout": 600
   },
   "DependsOn": [
    "ClamAvScannerServiceRoleDefaultPolicy8F8A0A02",
    "ClamAvScannerServiceRole559F68FC"
   ],
   "Metadata": {
    "aws:cdk:path": "StoragePlatform-development/ClamAvScanner/Resource"
   }
  },
