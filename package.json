{
	"name": "hello-world",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"dev:web": "turbo dev --filter @workspace/web",
		"dev:admin": "turbo dev --filter @workspace/admin",
		"dev:api": "turbo dev --filter @workspace/api",
		"lint": "turbo lint",
		"format": "turbo format",
		"typecheck": "turbo typecheck",
		"db:all": "turbo run db:seed",
		"db:deploy": "pnpm --filter @workspace/api db:deploy",
		"db:migrate": "pnpm --filter @workspace/api db:migrate",
		"db:migrate:create": "pnpm --filter @workspace/api db:migrate:create",
		"db:migrate:status": "pnpm --filter @workspace/api db:migrate:status",
		"db:generate": "pnpm --filter @workspace/api db:generate",
		"db:push": "pnpm --filter @workspace/api db:push",
		"db:seed": "pnpm --filter @workspace/api db:seed",
		"db:studio": "pnpm --filter @workspace/api db:studio",
		"db:reset": "pnpm --filter @workspace/api db:reset",
		"deps:check": "turbo run deps:check",
		"deps:fix": "turbo run deps:fix",
		"deps:list": "turbo run deps:list"
	},
	"devDependencies": {
		"@darraghor/eslint-plugin-nestjs-typed": "^7.2.9",
		"@eslint/js": "^9.39.5",
		"@next/eslint-plugin-next": "^16.2.12",
		"@types/node": "^22.20.1",
		"@workspace/eslint-config": "workspace:*",
		"@workspace/typescript-config": "workspace:*",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-only-warn": "^1.2.1",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-turbo": "^2.10.7",
		"globals": "^17.8.0",
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"syncpack": "^15.3.2",
		"turbo": "^2.10.7",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.65.0"
	},
	"packageManager": "pnpm@11.18.0",
	"engines": {
		"node": ">=20"
	},
	"onlyBuiltDependencies": [
		"bcrypt",
		"esbuild"
	]
}
