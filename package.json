{
	"name": "hello-world",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"dev:web": "turbo dev --filter @workspace/web --log-prefix=none",
		"dev:admin": "turbo dev --filter @workspace/admin --log-prefix=none",
		"dev:api": "turbo dev --filter @workspace/api --log-prefix=none",
		"dev:docs": "turbo dev --filter @workspace/docs --log-prefix=none",
		"lint": "turbo lint",
		"format": "turbo format",
		"typecheck": "turbo typecheck",
		"test": "turbo test",
		"db:all": "turbo run db:seed",
		"db:deploy": "pnpm --filter @workspace/api db:deploy",
		"db:migrate": "pnpm --filter @workspace/api db:migrate",
		"db:migrate:create": "pnpm --filter @workspace/api db:migrate:create",
		"db:migrate:status": "pnpm --filter @workspace/api db:migrate:status",
		"db:generate": "pnpm --filter @workspace/api db:generate",
		"db:push": "pnpm --filter @workspace/api db:push",
		"db:seed": "pnpm --filter @workspace/api db:seed",
		"db:studio": "pnpm --filter @workspace/api db:studio",
		"db:reset": "pnpm --filter @workspace/api db:reset",
		"deps:check": "turbo run deps:check",
		"deps:fix": "turbo run deps:fix",
		"deps:list": "turbo run deps:list",
		"kill:api": "PIDS=$(lsof -ti :8080 2>/dev/null); if [ -n \"$PIDS\" ]; then kill -9 $PIDS; echo \"Freed port 8080 (killed $PIDS)\"; else echo \"Port 8080 is already free\"; fi",
		"kill:admin": "PIDS=$(lsof -ti :3001 2>/dev/null); if [ -n \"$PIDS\" ]; then kill -9 $PIDS; echo \"Freed port 3001 (killed $PIDS)\"; else echo \"Port 3001 is already free\"; fi",
		"kill:web": "PIDS=$(lsof -ti :3000 2>/dev/null); if [ -n \"$PIDS\" ]; then kill -9 $PIDS; echo \"Freed port 3000 (killed $PIDS)\"; else echo \"Port 3001 is already free\"; fi",
		"kill:docs": "PIDS=$(lsof -ti :3002 2>/dev/null); if [ -n \"$PIDS\" ]; then kill -9 $PIDS; echo \"Freed port 3002 (killed $PIDS)\"; else echo \"Port 3002 is already free\"; fi",
		"kill:all": "pnpm kill:api && pnpm kill:admin && pnpm kill:web && pnpm kill:docs"
	},
	"devDependencies": {
		"@darraghor/eslint-plugin-nestjs-typed": "^7.3.0",
		"@eslint/js": "^9.39.5",
		"@next/eslint-plugin-next": "^16.3.0",
		"@types/node": "^26.1.2",
		"@workspace/eslint-config": "workspace:*",
		"@workspace/typescript-config": "workspace:*",
		"concurrently": "^10.0.4",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-only-warn": "^1.2.1",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-turbo": "^2.10.8",
		"globals": "^17.9.0",
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"syncpack": "^15.3.2",
		"turbo": "^2.10.8",
		"typescript": "7.0.2",
		"typescript-eslint": "^8.66.0"
	},
	"packageManager": "pnpm@11.18.0",
	"engines": {
		"node": ">=20"
	},
	"onlyBuiltDependencies": [
		"bcrypt",
		"esbuild"
	],
	"dependencies": {
		"rxjs": "^7.8.2"
	}
}
