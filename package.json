{
	"name": "hello-world",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"prepare": "husky",
		"setup": "pnpm install && pnpm --filter @workspace/shared build",
		"setup:db": "pnpm --filter @workspace/shared build && turbo run db:seed",
		"build": "turbo build",
		"dev": "turbo dev",
		"dev:web": "turbo dev --filter @workspace/web --log-prefix=none",
		"dev:admin": "turbo dev --filter @workspace/admin --log-prefix=none",
		"dev:api": "turbo dev --filter @workspace/api --log-prefix=none",
		"dev:merchant": "turbo dev --filter @workspace/merchant --log-prefix=none",
		"dev:mobile": "turbo dev --filter @workspace/mobile --log-prefix=none",
		"lint": "turbo lint",
		"format": "turbo format",
		"typecheck": "turbo typecheck",
		"test": "turbo run test --concurrency=1",
		"test:e2e": "pnpm --filter @workspace/api test:e2e && pnpm --filter @workspace/analytics-consumer test:e2e",
		"ci:local": "node packages/tooling/scripts/ci-local.mjs",
		"tools": "node packages/tooling/scripts/tools.mjs",
		"db:migrate": "pnpm --filter @workspace/api db:migrate",
		"db:migrate:create": "pnpm --filter @workspace/api db:migrate:create",
		"db:generate": "pnpm --filter @workspace/api db:generate",
		"db:seed": "pnpm --filter @workspace/api db:seed",
		"db:studio": "pnpm --filter @workspace/api db:studio",
		"db:reset": "pnpm --filter @workspace/api db:reset",
		"kill:all": "for PORT in 8080 3001 3000 3002 3003; do PIDS=$(lsof -ti :$PORT 2>/dev/null); if [ -n \"$PIDS\" ]; then kill -9 $PIDS; echo \"Freed port $PORT (killed $PIDS)\"; else echo \"Port $PORT is already free\"; fi; done",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"mailpit": "docker compose up -d mailpit",
		"mail:latest": "pnpm --silent --filter @workspace/api mail:latest"
	},
	"devDependencies": {
		"@next/bundle-analyzer": "^16.4.3",
		"@playwright/test": "1.64.1",
		"@types/node": "^26.6.5",
		"@workspace/typescript-config": "workspace:*",
		"concurrently": "^10.0.6",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"syncpack": "^15.3.3",
		"turbo": "^2.11.10",
		"typescript": "7.0.2"
	},
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=24.22.1"
	},
	"onlyBuiltDependencies": [
		"bcrypt",
		"esbuild"
	],
	"dependencies": {
		"rxjs": "^7.8.2"
	}
}
