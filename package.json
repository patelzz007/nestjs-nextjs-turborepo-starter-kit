{
	"name": "hello-world",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"setup": "pnpm install && pnpm build:shared",
		"setup:db": "pnpm build:shared && pnpm db:all",
		"build": "turbo build",
		"build:shared": "pnpm --filter @workspace/shared build",
		"tokens:generate": "pnpm --filter @workspace/tokens generate",
		"dev": "turbo dev",
		"dev:web": "turbo dev --filter @workspace/web --log-prefix=none",
		"dev:admin": "turbo dev --filter @workspace/admin --log-prefix=none",
		"dev:api": "turbo dev --filter @workspace/api --log-prefix=none",
		"dev:merchant": "turbo dev --filter @workspace/merchant --log-prefix=none",
		"dev:mobile": "turbo dev --filter @workspace/mobile --log-prefix=none",
		"dev:tunnel": "pnpm --silent --filter @workspace/api dev:tunnel",
		"dev:timing": "node packages/tooling/src/dev-timing/cli.mjs",
		"lint": "turbo lint",
		"format": "turbo format",
		"typecheck": "turbo typecheck",
		"test": "turbo run test --concurrency=1",
		"test:e2e": "pnpm --filter @workspace/api test:e2e && pnpm --filter @workspace/analytics-consumer test:e2e",
		"ci:local": "node packages/tooling/scripts/ci-local.mjs",
		"bundle:check": "node packages/tooling/src/bundle-budget/cli.mjs",
		"openapi:export": "turbo run openapi:export --filter=@workspace/api",
		"docs:check-links": "pnpm --filter @workspace/docs check:links",
		"docs:api": "pnpm --filter @workspace/docs docs:api",
		"secrets:scan": "node packages/tooling/scripts/check-env-example-secrets.mjs",
		"secrets:generate": "node packages/tooling/scripts/generate-app-secrets.mjs",
		"db:all": "turbo run db:seed",
		"db:deploy": "pnpm --filter @workspace/api db:deploy",
		"db:check-tenant-integrity": "pnpm --filter @workspace/api db:check-tenant-integrity",
		"db:carry-github-link": "pnpm --filter @workspace/api db:carry-github-link",
		"db:migrate": "pnpm --filter @workspace/api db:migrate",
		"db:migrate:create": "pnpm --filter @workspace/api db:migrate:create",
		"db:migrate:status": "pnpm --filter @workspace/api db:migrate:status",
		"db:generate": "pnpm --filter @workspace/api db:generate",
		"db:push": "pnpm --filter @workspace/api db:push",
		"db:apply-security": "pnpm --filter @workspace/api db:apply-security",
		"db:rls": "pnpm --filter @workspace/api db:rls",
		"db:check-rls-manifest": "pnpm --filter @workspace/api db:check-rls-manifest",
		"db:seed": "pnpm --filter @workspace/api db:seed",
		"db:studio": "pnpm --filter @workspace/api db:studio",
		"db:reset": "pnpm --filter @workspace/api db:reset",
		"deps:check": "turbo run deps:check",
		"deps:fix": "turbo run deps:fix",
		"deps:list": "turbo run deps:list",
		"kill:all": "for PORT in 8080 3001 3000 3002 3003; do PIDS=$(lsof -ti :$PORT 2>/dev/null); if [ -n \"$PIDS\" ]; then kill -9 $PIDS; echo \"Freed port $PORT (killed $PIDS)\"; else echo \"Port $PORT is already free\"; fi; done",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"docker:restart": "docker compose down && docker compose up -d",
		"docker:logs": "docker compose logs -f",
		"docker:ps": "docker compose ps",
		"mailpit": "mailpit --listen 127.0.0.1:8025 --smtp 127.0.0.1:1025",
		"mail:latest": "pnpm --silent --filter @workspace/api mail:latest",
		"dev:analytics-consumer": "turbo dev --filter @workspace/analytics-consumer --log-prefix=none"
	},
	"devDependencies": {
		"@next/bundle-analyzer": "^16.4.3",
		"@playwright/test": "1.64.1",
		"@types/node": "^26.6.5",
		"@workspace/typescript-config": "workspace:*",
		"concurrently": "^10.0.6",
		"syncpack": "^15.3.3",
		"turbo": "^2.11.10",
		"typescript": "7.0.2"
	},
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=22.12"
	},
	"onlyBuiltDependencies": [
		"bcrypt",
		"esbuild"
	],
	"dependencies": {
		"rxjs": "^7.8.2"
	}
}
