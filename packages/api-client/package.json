{
	"name": "@workspace/api-client",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "tsrs -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
		"dev": "node ../tooling/src/watch-runner/cli.mjs \"tsrs -p tsconfig.build.json --watch --preserveWatchOutput\" \"tsc-alias -p tsconfig.build.json --resolve-full-paths --watch\"",
		"lint": "oxfmt --check \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\" && oxlint",
		"format": "oxfmt \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\"",
		"typecheck": "tsrs --noEmit",
		"test": "vitest run",
		"clean": "rm -rf dist"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"development": {
				"types": "./src/index.ts",
				"default": "./src/index.ts"
			},
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./react": {
			"development": {
				"types": "./src/react/index.ts",
				"default": "./src/react/index.ts"
			},
			"types": "./dist/react/index.d.ts",
			"default": "./dist/react/index.js"
		},
		"./testing": {
			"development": {
				"types": "./src/testing/index.ts",
				"default": "./src/testing/index.ts"
			},
			"types": "./dist/testing/index.d.ts",
			"default": "./dist/testing/index.js"
		}
	},
	"dependencies": {
		"@workspace/shared": "workspace:*",
		"zod": "4.6.7"
	},
	"peerDependencies": {
		"@tanstack/react-query": "^5.104.1",
		"react": "19.3.0"
	},
	"peerDependenciesMeta": {
		"@tanstack/react-query": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@tanstack/react-query": "^5.104.5",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@workspace/oxlint-config": "workspace:*",
		"@workspace/typescript-config": "workspace:*",
		"jsdom": "^30.1.3",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "7.0.2005",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"tsc-alias": "^1.9.9",
		"tsrs": "0.18.0-ts7.1.0-dev.20260929",
		"typescript": "7.0.2",
		"vitest": "^5.0.5"
	}
}
