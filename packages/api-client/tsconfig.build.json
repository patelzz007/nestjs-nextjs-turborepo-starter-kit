{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		// Emit real ESM + .d.ts files with tsc (no bundler). Source is authored
		// extensionless; `tsc-alias --resolve-full-paths` adds the `.js` extensions
		// Node's ESM runtime needs (see package.json build script).
		"noEmit": false,
		"outDir": "./dist",
		"rootDir": "./src",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		// Incremental, with the build info inside dist/: the dev watcher (`tsc --watch` + `tsc-alias --watch`)
		// starts on an up-to-date build and emits nothing, so it never replaces the prebuilt, extension-
		// resolved dist with raw extensionless output that a starting API would fail to import. Deleting
		// dist deletes the info too, so the next build always emits.
		"incremental": true,
		"tsBuildInfoFile": "./dist/.tsbuildinfo"
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
