{
	"name": "@workspace/cli",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"bin": {
		"app": "./dist/bin/app.js"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node ../../packages/tooling/scripts/fix-dist-extensions.mjs dist",
		"dev": "tsx watch src/bin/app.ts",
		"start": "tsx src/bin/app.ts",
		"lint": "eslint",
		"format": "prettier --write \"**/*.{ts,tsx}\"",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"clean": "rm -rf dist && find src -name '*.js' -delete"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"development": {
				"types": "./src/index.ts",
				"default": "./src/index.ts"
			},
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./generator": {
			"development": {
				"types": "./src/generator/browser.ts",
				"default": "./src/generator/browser.ts"
			},
			"types": "./dist/generator/browser.d.ts",
			"default": "./dist/generator/browser.js"
		},
		"./generator/server": {
			"development": {
				"types": "./src/generator/server.ts",
				"default": "./src/generator/server.ts"
			},
			"types": "./dist/generator/server.d.ts",
			"default": "./dist/generator/server.js"
		}
	},
	"dependencies": {
		"@clack/prompts": "^1.8.0",
		"@workspace/shared": "workspace:*",
		"commander": "^15.0.0",
		"picocolors": "^1.1.1",
		"zod": "4.6.2"
	},
	"devDependencies": {
		"@types/node": "^26.4.1",
		"@workspace/eslint-config": "workspace:*",
		"@workspace/typescript-config": "workspace:*",
		"eslint": "^9.39.5",
		"tsx": "^4.23.13",
		"typescript": "6.0.2",
		"vitest": "^5.0.0"
	}
}
