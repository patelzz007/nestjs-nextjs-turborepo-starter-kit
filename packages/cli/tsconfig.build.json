{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		// Emit real ESM + .d.ts files with tsc. Source is authored extensionless for
		// tsx/dev (`moduleResolution: bundler`); Node's ESM runtime needs `.js`
		// extensions, so fix-dist-extensions rewrites dist/ after emit.
		"noEmit": false,
		"declaration": true,
		"declarationMap": true,
		"lib": ["es2022"]
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist", "**/*.test.ts"]
}
