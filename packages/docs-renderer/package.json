{
	"name": "@workspace/docs-renderer",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"lint": "oxfmt --check \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\" && oxlint",
		"format": "oxfmt \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\"",
		"typecheck": "tsrs --noEmit",
		"test": "vitest run --coverage",
		"docs:api": "vitest run src/api-reference/__tests__/api-reference.artifact.test.ts --update"
	},
	"exports": {
		"./pipeline": "./src/pipeline.ts",
		"./markdown/*": "./src/markdown/*.ts",
		"./code-block/*": "./src/code-block/*.ts",
		"./media/*": "./src/media/*.ts",
		"./api-reference/*": "./src/api-reference/*.ts"
	},
	"dependencies": {
		"@workspace/shared": "workspace:*",
		"@workspace/ui": "workspace:*",
		"github-slugger": "^2.0.0",
		"hast-util-to-string": "^3.0.1",
		"lucide-react": "^1.66.0",
		"mdast-util-to-hast": "^13.2.1",
		"pele": "^1.13.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"rehype-raw": "^7.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"remark-smartypants": "^3.0.2",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.2.0",
		"vfile": "^6.0.3",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@workspace/oxlint-config": "workspace:*",
		"@workspace/typescript-config": "workspace:*",
		"hast-util-to-html": "^9.0.6",
		"jsdom": "^30.1.3",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"tsrs": "0.20.1-ts7.1.0-beta",
		"typescript": "7.0.2",
		"vitest": "^5.0.5"
	}
}
