# A manual `pnpm docs:sync`. Copy to packages/docs-sync/.env (never committed). CI keeps these as GitHub secrets.

# Which writing tool to read. NOTION today.
DOCS_SOURCE=NOTION
# Used when a guide names no author.
DOCS_DEFAULT_AUTHOR=Platform Team

# Notion: an internal integration with read content only, shared with the two Published databases and nothing else.
NOTION_READ_TOKEN=
NOTION_DOCS_DATA_SOURCE_ID=
NOTION_BLOG_DATA_SOURCE_ID=

# Only for `pnpm docs:notion:setup` and `pnpm docs:import`. Revoke it straight after the import.
NOTION_WRITE_TOKEN=

# Optional: report runs to the Operations console.
DOCS_SYNC_API_URL=http://localhost:8080
DOCS_SYNC_REPORT_TOKEN=
