{
	"extends": "@workspace/typescript-config/base.json",
	"compilerOptions": {
		// The CLI runs on Node directly (type stripping), so this package must use erasable syntax only. That cannot be
		// switched on here: `development` type-checks @workspace/shared's source, which uses parameter properties.
		"allowImportingTsExtensions": true,
		"customConditions": ["development"],
		"declaration": false,
		"declarationMap": false,
		"lib": ["esnext"],
		"noEmit": true,
		"target": "ESNext",
		"types": ["node"],
		"verbatimModuleSyntax": true
	},
	"include": ["src", "*.ts"],
	"exclude": ["node_modules"]
}
