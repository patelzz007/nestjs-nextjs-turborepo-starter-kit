{
	"name": "@workspace/messaging",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
		"lint": "eslint --max-warnings=0",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"clean": "rm -rf dist"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"development": {
				"types": "./src/index.ts",
				"default": "./src/index.ts"
			},
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./nest": {
			"development": {
				"types": "./src/nest/index.ts",
				"default": "./src/nest/index.ts"
			},
			"types": "./dist/nest/index.d.ts",
			"default": "./dist/nest/index.js"
		},
		"./inbox": {
			"development": {
				"types": "./src/inbox/index.ts",
				"default": "./src/inbox/index.ts"
			},
			"types": "./dist/inbox/index.d.ts",
			"default": "./dist/inbox/index.js"
		},
		"./kafka": {
			"development": {
				"types": "./src/kafka/index.ts",
				"default": "./src/kafka/index.ts"
			},
			"types": "./dist/kafka/index.d.ts",
			"default": "./dist/kafka/index.js"
		}
	},
	"dependencies": {
		"@confluentinc/kafka-javascript": "1.10.1",
		"@nestjs/bullmq": "^12.0.0",
		"@nestjs/common": "^12.1.1",
		"@nestjs/core": "^12.1.1",
		"@workspace/shared": "workspace:*",
		"bullmq": "^6.3.4",
		"ioredis": "^6.0.0",
		"pg": "^8.23.0",
		"zod": "4.6.2"
	},
	"devDependencies": {
		"@types/pg": "^8.23.1",
		"@workspace/eslint-config": "workspace:*",
		"@workspace/typescript-config": "workspace:*",
		"eslint": "^9.39.5",
		"tsc-alias": "^1.9.7",
		"typescript": "6.0.2",
		"vitest": "^5.0.0"
	}
}
