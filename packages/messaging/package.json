{
	"name": "@workspace/messaging",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "tsrs -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
		"dev": "node ../tooling/src/watch-runner/cli.mjs \"tsrs -p tsconfig.build.json --watch --preserveWatchOutput\" \"tsc-alias -p tsconfig.build.json --resolve-full-paths --watch\"",
		"format": "oxfmt \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\"",
		"lint": "oxfmt --check \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\" && oxlint",
		"typecheck": "tsrs --noEmit",
		"test": "vitest run",
		"clean": "rm -rf dist"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"development": {
				"types": "./src/index.ts",
				"default": "./src/index.ts"
			},
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./nest": {
			"development": {
				"types": "./src/nest/index.ts",
				"default": "./src/nest/index.ts"
			},
			"types": "./dist/nest/index.d.ts",
			"default": "./dist/nest/index.js"
		},
		"./inbox": {
			"development": {
				"types": "./src/inbox/index.ts",
				"default": "./src/inbox/index.ts"
			},
			"types": "./dist/inbox/index.d.ts",
			"default": "./dist/inbox/index.js"
		},
		"./kafka": {
			"development": {
				"types": "./src/kafka/index.ts",
				"default": "./src/kafka/index.ts"
			},
			"types": "./dist/kafka/index.d.ts",
			"default": "./dist/kafka/index.js"
		}
	},
	"dependencies": {
		"@confluentinc/kafka-javascript": "1.11.0",
		"@nestjs/bullmq": "^12.0.0",
		"@nestjs/common": "^12.3.2",
		"@nestjs/core": "^12.3.2",
		"@workspace/shared": "workspace:*",
		"bullmq": "^6.5.0",
		"ioredis": "^6.0.0",
		"pg": "^8.23.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/pg": "8.23.1",
		"@workspace/oxlint-config": "workspace:*",
		"@workspace/typescript-config": "workspace:*",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"tsc-alias": "^1.9.9",
		"tsrs": "0.20.1-ts7.1.0-beta",
		"typescript": "7.0.2",
		"vitest": "^5.0.5"
	}
}
