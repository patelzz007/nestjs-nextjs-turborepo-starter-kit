{
	"extends": "@workspace/typescript-config/base.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noUncheckedIndexedAccess": false,
		"lib": ["es2022"],
		"stripInternal": true,
		"noEmit": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}
