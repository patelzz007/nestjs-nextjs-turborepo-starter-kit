{
	"name": "@workspace/shared",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
		"dev": "node ../tooling/src/watch-runner/cli.mjs \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"tsc-alias -p tsconfig.build.json --resolve-full-paths --watch\"",
		"lint": "eslint",
		"format": "prettier --write \"**/*.{ts,tsx}\" --ignore-path ../../.prettierignore",
		"typecheck": "tsrs --noEmit",
		"test": "vitest run",
		"clean": "rm -rf dist"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"development": {
				"types": "./src/index.ts",
				"default": "./src/index.ts"
			},
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./contexts/*": {
			"development": {
				"types": "./src/contexts/*/index.ts",
				"default": "./src/contexts/*/index.ts"
			},
			"types": "./dist/contexts/*/index.d.ts",
			"default": "./dist/contexts/*/index.js"
		}
	},
	"sideEffects": false,
	"dependencies": {
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"@workspace/eslint-config": "workspace:*",
		"@workspace/typescript-config": "workspace:*",
		"eslint": "^9.39.5",
		"tsc-alias": "^1.9.9",
		"tsrs": "0.18.0-ts7.1.0-dev.20260929",
		"typescript": "6.0.3",
		"vitest": "^5.0.5"
	}
}
