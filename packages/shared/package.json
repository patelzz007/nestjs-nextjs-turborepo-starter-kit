{
	"name": "@workspace/shared",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "tsup",
		"lint": "eslint",
		"format": "prettier --write \"**/*.{ts,tsx}\"",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"development": {
				"types": "./src/index.ts",
				"default": "./src/index.ts"
			},
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"dependencies": {
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@workspace/eslint-config": "workspace:*",
		"@workspace/typescript-config": "workspace:*",
		"eslint": "^9.39.5",
		"tsup": "^8.5.0",
		"typescript": "6.0.3"
	}
}
