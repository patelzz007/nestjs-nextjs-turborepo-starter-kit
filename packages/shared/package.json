{
	"name": "@workspace/shared",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node ../../packages/tooling/scripts/fix-dist-extensions.mjs dist",
		"lint": "eslint",
		"format": "prettier --write \"**/*.{ts,tsx}\"",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"clean": "rm -rf dist"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"development": {
				"types": "./src/index.ts",
				"default": "./src/index.ts"
			},
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"dependencies": {
		"@workspace/messaging": "workspace:*",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@workspace/eslint-config": "workspace:*",
		"@workspace/typescript-config": "workspace:*",
		"eslint": "^9.39.5",
		"typescript": "7.0.2",
		"vitest": "^4.1.10"
	}
}
