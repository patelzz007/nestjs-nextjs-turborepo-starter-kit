{
	"name": "@workspace/shared",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "tsrs -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
		"dev": "node ../tooling/src/watch-runner/cli.mjs \"tsrs -p tsconfig.build.json --watch --preserveWatchOutput\" \"tsc-alias -p tsconfig.build.json --resolve-full-paths --watch\"",
		"lint": "oxfmt --check \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\" && oxlint",
		"format": "oxfmt \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\"",
		"typecheck": "tsrs --noEmit",
		"test": "vitest run",
		"clean": "rm -rf dist"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"development": {
				"types": "./src/index.ts",
				"default": "./src/index.ts"
			},
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./contexts/*": {
			"development": {
				"types": "./src/contexts/*/index.ts",
				"default": "./src/contexts/*/index.ts"
			},
			"types": "./dist/contexts/*/index.d.ts",
			"default": "./dist/contexts/*/index.js"
		}
	},
	"sideEffects": false,
	"dependencies": {
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"@workspace/oxlint-config": "workspace:*",
		"@workspace/typescript-config": "workspace:*",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"tsc-alias": "^1.9.9",
		"tsrs": "0.20.1-ts7.1.0-beta",
		"typescript": "7.0.2",
		"vitest": "^5.0.5"
	}
}
