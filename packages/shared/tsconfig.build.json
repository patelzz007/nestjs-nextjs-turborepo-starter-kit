{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		// Emit real ESM + .d.ts files with tsc (no bundler, no tsup).
		// Source is authored extensionless for Turbopack/dev (`module: ESNext` +
		// `moduleResolution: bundler`, inherited from tsconfig.json); Node's ESM
		// runtime still needs `.js` extensions, so `packages/tooling/scripts/fix-dist-extensions.mjs`
		// rewrites dist/ after emit (see package.json build script).
		"noEmit": false,
		"outDir": "./dist",
		"rootDir": "./src",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		// The base config ships with DOM lib; this package only needs ES.
		"lib": ["es2022"]
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist", "**/*.test.ts"]
}
