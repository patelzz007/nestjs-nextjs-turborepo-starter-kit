{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		// Emit real ESM + .d.ts files with tsc (no bundler, no tsup).
		// Source is authored extensionless for Turbopack/dev (`module: ESNext` +
		// `moduleResolution: bundler`, inherited from tsconfig.json); Node's ESM
		// runtime still needs `.js` extensions, so `tsc-alias --resolve-full-paths`
		// rewrites dist/ after emit (see package.json build script).
		"noEmit": false,
		"outDir": "./dist",
		"rootDir": "./src",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		// Incremental, with the build info inside dist/: the dev watcher (`tsc --watch` + `tsc-alias --watch`)
		// starts on an up-to-date build and emits nothing, so it never replaces the prebuilt, extension-
		// resolved dist with raw extensionless output that a starting API would fail to import. Deleting
		// dist deletes the info too, so the next build always emits.
		"incremental": true,
		"tsBuildInfoFile": "./dist/.tsbuildinfo",
		// The base config ships with DOM lib; this package only needs ES.
		"lib": ["es2022"]
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist", "**/*.test.ts"]
}
