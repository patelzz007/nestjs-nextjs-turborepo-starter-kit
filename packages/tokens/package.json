{
	"name": "@workspace/tokens",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"description": "The single source of the design tokens (ADR 030): TypeScript token data plus a generator that writes the committed web and mobile CSS. No runtime dependencies.",
	"scripts": {
		"generate": "tsx scripts/generate.ts",
		"lint": "oxfmt --check \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\" && oxlint",
		"format": "oxfmt \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\"",
		"typecheck": "tsrs --noEmit",
		"test": "vitest run"
	},
	"exports": {
		".": "./src/index.ts",
		"./palette.css": "./generated/palette.css",
		"./web.css": "./generated/web.css",
		"./mobile.css": "./generated/mobile.css",
		"./icons/*": "./generated/*"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"@workspace/oxlint-config": "workspace:*",
		"@workspace/typescript-config": "workspace:*",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "7.0.2005",
		"tsrs": "0.18.0-ts7.1.0-dev.20260929",
		"tsx": "^4.23.15",
		"typescript": "7.0.2",
		"vitest": "^5.0.5",
		"zod": "4.6.7"
	}
}
