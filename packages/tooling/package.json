{
	"name": "@workspace/tooling",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Repo-wide tooling scripts. Owns the syncpack dependency-hygiene commands so they can run as turbo tasks (turbo 2.x doesn't execute root package.json scripts).",
	"scripts": {
		"lint": "oxfmt --check \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\" && oxlint",
		"test": "vitest run",
		"deps:check": "cd ../.. && syncpack lint && pnpm peers check",
		"deps:fix": "cd ../.. && syncpack fix-mismatches",
		"deps:list": "cd ../.. && syncpack list",
		"deps:review": "node scripts/check-dependency-exceptions.mjs",
		"format": "oxfmt \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\""
	},
	"dependencies": {
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@workspace/oxlint-config": "workspace:*",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "7.0.2005",
		"pg": "^8.23.1",
		"syncpack": "^15.3.3",
		"typescript": "7.0.2",
		"vitest": "^5.0.5"
	}
}
