{
	"extends": "@workspace/typescript-config/base.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		// @workspace/shared resolves to its TypeScript source, as in every package that imports it.
		"customConditions": ["development"],
		"lib": ["es2022"],
		"noEmit": true,
		"types": ["node"]
	},
	"include": ["src", "vitest.config.ts", "oxlint.config.ts"],
	"exclude": ["node_modules"]
}
