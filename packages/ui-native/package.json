{
	"name": "@workspace/ui-native",
	"version": "0.0.0",
	"private": true,
	"description": "The React Native UI kit: low-level, stateless, token-styled components for every mobile app (the web kit is @workspace/ui).",
	"scripts": {
		"lint": "eslint",
		"format": "prettier --write \"**/*.{ts,tsx}\" --ignore-path ../../.prettierignore",
		"typecheck": "tsrs --noEmit",
		"test": "jest"
	},
	"exports": {
		"./components/*": "./src/components/*.tsx",
		"./lib/*": "./src/lib/*.ts",
		"./jest/native-runtime-resolver": "./jest/native-runtime-resolver.cjs"
	},
	"dependencies": {
		"@workspace/shared": "workspace:*",
		"@workspace/tokens": "workspace:*",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.7.0",
		"zod": "4.6.7"
	},
	"peerDependencies": {
		"expo-camera": "*",
		"expo-constants": "*",
		"expo-haptics": "*",
		"expo-image": "*",
		"lucide-react-native": "*",
		"react": "*",
		"react-native": "*",
		"react-native-keyboard-controller": "*",
		"react-native-reanimated": "*",
		"react-native-safe-area-context": "*",
		"react-native-svg": "*",
		"react-native-worklets": "*",
		"uniwind": "*"
	},
	"devDependencies": {
		"@react-native/jest-preset": "0.88.0",
		"@testing-library/react-native": "~14.1.0",
		"@types/jest": "^30.0.0",
		"@types/react": "^19.3.0",
		"@workspace/eslint-config": "workspace:*",
		"@workspace/typescript-config": "workspace:*",
		"eslint": "^9.39.5",
		"expo": "~58.0.19",
		"expo-camera": "~58.0.12",
		"expo-constants": "~58.0.13",
		"expo-haptics": "~58.0.7",
		"expo-image": "~58.0.17",
		"jest": "^30.5.2",
		"jest-expo": "~58.0.12",
		"lucide-react-native": "^1.61.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.88.0",
		"react-native-keyboard-controller": "1.22.7",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.10.1",
		"react-native-svg": "15.16.0",
		"react-native-web": "~0.21.4",
		"react-native-worklets": "0.13.0",
		"test-renderer": "^1.3.1",
		"tsrs": "0.18.0-ts7.1.0-dev.20260929",
		"typescript": "6.0.3",
		"uniwind": "^1.13.0"
	}
}
