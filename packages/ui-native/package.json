		"@workspace/ui-kit-logic": "workspace:*",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"libphonenumber-js": "^1.13.16",
		"pele": "^1.13.0",
		"tailwind-merge": "^3.7.0",
		"zod": "4.6.7"
	},
	"peerDependencies": {
		"expo-camera": "*",
		"expo-constants": "*",
		"expo-document-picker": "*",
		"expo-haptics": "*",
		"expo-image": "*",
