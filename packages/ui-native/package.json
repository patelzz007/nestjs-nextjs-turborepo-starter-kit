{
	"name": "@workspace/ui-native",
	"version": "0.0.0",
	"private": true,
	"description": "The React Native UI kit: low-level, stateless, token-styled components for every mobile app (the web kit is @workspace/ui).",
	"scripts": {
		"lint": "eslint",
		"format": "prettier --write \"**/*.{ts,tsx}\" --ignore-path ../../.prettierignore",
		"typecheck": "tsc --noEmit",
		"test": "jest"
	},
	"exports": {
		"./components/*": "./src/components/*.tsx",
		"./lib/*": "./src/lib/*.ts"
	},
	"dependencies": {
		"@workspace/shared": "workspace:*",
		"@workspace/tokens": "workspace:*",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.7.0",
		"zod": "4.6.5"
	},
	"peerDependencies": {
		"expo-camera": "*",
		"expo-constants": "*",
		"expo-haptics": "*",
		"expo-image": "*",
		"lucide-react-native": "*",
		"react": "*",
		"react-native": "*",
		"react-native-keyboard-controller": "*",
		"react-native-reanimated": "*",
		"react-native-safe-area-context": "*",
		"react-native-svg": "*",
		"react-native-worklets": "*",
		"uniwind": "*"
	},
	"devDependencies": {
		"@react-native/jest-preset": "0.86.3",
		"@testing-library/react-native": "~14.0.1",
		"@types/jest": "^29.5.14",
		"@types/react": "~19.2.18",
		"@workspace/eslint-config": "workspace:*",
		"@workspace/typescript-config": "workspace:*",
		"eslint": "^9.39.5",
		"expo": "~57.0.31",
		"expo-camera": "~57.0.6",
		"expo-constants": "~57.0.22",
		"expo-haptics": "~57.0.3",
		"expo-image": "~57.0.5",
		"jest": "^29.7.0",
		"jest-expo": "~57.0.6",
		"lucide-react-native": "^1.53.0",
		"react": "19.2.3",
		"react-native": "0.86.3",
		"react-native-keyboard-controller": "1.21.9",
		"react-native-reanimated": "4.5.1",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-svg": "15.15.4",
		"react-native-worklets": "0.10.1",
		"test-renderer": "^1.3.0",
		"typescript": "6.0.3",
		"uniwind": "^1.12.2"
	}
}
