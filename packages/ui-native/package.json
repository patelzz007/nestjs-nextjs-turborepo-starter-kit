{
	"name": "@workspace/ui-native",
	"version": "0.0.0",
	"private": true,
	"description": "The React Native UI kit: low-level, stateless, token-styled components for every mobile app (the web kit is @workspace/ui).",
	"scripts": {
		"lint": "oxfmt --check \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\" && oxlint",
		"format": "oxfmt \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\"",
		"typecheck": "tsrs --noEmit",
		"test": "jest --coverage"
	},
	"exports": {
		"./components/*": "./src/components/*.tsx",
		"./lib/*": "./src/lib/*.ts",
		"./jest/native-runtime-resolver": "./jest/native-runtime-resolver.cjs"
	},
	"dependencies": {
		"@tanstack/react-table": "^9.3.1",
		"@workspace/shared": "workspace:*",
