{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalEnv": [
		"ADMIN_EMAIL",
		"ADMIN_PASSWORD",
		"APP_NAME",
		"APP_URL",
		"BACKUP_DIR",
		"BACKUP_DOWNLOAD_RATE_LIMIT",
		"BACKUP_DOWNLOAD_SECRET",
		"BACKUP_DOWNLOAD_TTL_MINUTES",
		"BACKUP_ENABLED",
		"BACKUP_EXCLUDE_TABLES",
		"BACKUP_MIN_FREE_MB",
		"BACKUP_RATE_LIMIT",
		"BACKUP_RATE_LIMIT_SUPERADMIN",
		"BACKUP_RETENTION_DAYS",
		"BCRYPT_SALT_ROUNDS",
		"COOKIE_DOMAIN",
		"CORS_ORIGINS",
		"DATABASE_URL",
		"EMAIL_FROM_ADDRESS",
		"EMAIL_MAX_ATTEMPTS",
		"EMAIL_MODE",
		"EMAIL_RATE_LIMIT_PER_MINUTE",
		"EMAIL_REPLY_TO",
		"EMAIL_TEST_TO",
		"EMAIL_TIMEOUT_MS",
		"EMAIL_VERIFICATION_SECRET",
		"HOST",
		"JWT_ACCESS_EXPIRY",
		"JWT_ACCESS_SECRET",
		"JWT_REFRESH_EXPIRY",
		"JWT_REFRESH_SECRET",
		"KAFKA_BROKERS",
		"LOG_LEVEL",
		"NEXT_PUBLIC_API_URL",
		"NEXT_RUNTIME",
		"NODE_ENV",
		"OBSERVE_APP_KEY",
		"OBSERVE_APP_SECRET",
		"OBSERVE_ENABLED",
		"OBSERVE_SERVICE_ID",
		"PORT",
		"RABBITMQ_URL",
		"REDIS_URL",
		"BULLMQ_PREFIX",
		"REDIS_NAMESPACE",
		"RESEND_API_KEY",
		"RESEND_WEBHOOK_SECRET",
		"STORAGE_PROVIDER",
		"STORAGE_PRIVATE_CONTAINER",
		"STORAGE_PUBLIC_CONTAINER",
		"FIREBASE_PROJECT_ID",
		"FIREBASE_STORAGE_BUCKET",
		"GOOGLE_APPLICATION_CREDENTIALS",
		"STORAGE_CLOUDFRONT_PUBLIC_DOMAIN",
		"STORAGE_CLOUDFRONT_DISTRIBUTION_ID",
		"STORAGE_DOWNLOAD_TTL_SECONDS",
		"STORAGE_PHYSICAL_DELETE_DELAY_MS",
		"STORAGE_PROCESSING_CALLBACK_SECRET",
		"MALWARE_SCANNER",
		"STORAGE_S3_BUCKET",
		"STORAGE_S3_PRIVATE_BUCKET",
		"STORAGE_S3_PUBLIC_BUCKET",
		"AWS_ACCESS_KEY_ID",
		"AWS_REGION",
		"AWS_SECRET_ACCESS_KEY",
		"SHUTDOWN_TIMEOUT_MS",
		"SWAGGER_ENABLED",
		"TENANCY_ENABLED",
		"DEFAULT_ORGANIZATION_ID",
		"TENANT_ENCRYPTION_MASTER_KEY",
		"TENANT_ENCRYPTION_MASTER_KEY_VERSION",
		"TENANT_ENCRYPTION_PREVIOUS_MASTER_KEYS",
		"TENANT_KMS_PROVIDER",
		"TENANT_JOB_HMAC_SECRET",
		"TRUST_PROXY",
		"WEBHOOK_RATE_LIMIT_PER_MINUTE",
		"WEBHOOK_URL"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"],
			"env": [
				"EXPO_PUBLIC_API_URL",
				"EXPO_PUBLIC_API_PORT",
				"EXPO_PUBLIC_IOS_STORE_URL",
				"EXPO_PUBLIC_ANDROID_STORE_URL",
				"MOBILE_APP_NAME",
				"MOBILE_APP_SLUG",
				"MOBILE_BUNDLE_ID",
				"MOBILE_SCHEME"
			]
		},
		"lint": {
			"dependsOn": ["^lint"],
			"env": ["REWARD_CODE_HASH_KEYS"]
		},
		"format": {
			"dependsOn": ["^format"],
			"cache": false
		},
		"typecheck": {
			"dependsOn": ["^build", "^typecheck"]
		},
		"test": {
			"dependsOn": ["^build"],
			"env": ["TZ"]
		},
		"test:e2e": {
			"dependsOn": ["^build"],
			"cache": false,
			"env": ["E2E_BULLMQ_PREFIX"]
		},
		"test:browser": {
			"dependsOn": ["^build"],
			"cache": false,
			"env": ["WEB_E2E_BASE_URL", "ADMIN_E2E_BASE_URL", "ADMIN_E2E_EMAIL", "ADMIN_E2E_PASSWORD"]
		},
		"openapi:export": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"db:generate": {
			"cache": false
		},
		"db:deploy": {
			"cache": false
		},
		"db:apply-security": {
			"cache": false
		},
		"db:rls": {
			"cache": false
		},
		"db:migrate": {
			"cache": false,
			"interactive": true
		},
		"db:migrate:create": {
			"cache": false,
			"interactive": true
		},
		"db:migrate:status": {
			"cache": false
		},
		"db:push": {
			"cache": false
		},
		"db:seed": {
			"cache": false,
			"env": ["REWARD_CODE_HASH_KEYS"],
			"dependsOn": ["^build", "db:generate", "db:deploy"]
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		},
		"db:reset": {
			"cache": false,
			"env": ["REWARD_CODE_HASH_KEYS"],
			"dependsOn": ["^build", "db:generate"]
		},
		"deps:check": {
			"cache": false
		},
		"deps:fix": {
			"cache": false
		},
		"deps:list": {
			"cache": false
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		}
	}
}
